<Project Sdk="Microsoft.NET.Sdk">
  <!-- AC-1896 spike only (G1, G2, G4-G6): YDotNet against Depot's /hubs/notes with a Playwright web tab beside it. Not part of Cockpit.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- YDotNet.Native.Linux 0.6.0 ships its binaries under distribution-specific runtime folders (a packaging bug), which the SDK flags. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YDotNet" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Win32" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Linux" Version="0.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>
</Project>
