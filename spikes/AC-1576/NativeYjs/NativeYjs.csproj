<Project Sdk="Microsoft.NET.Sdk">
  <!-- AC-1576 spike only: a .NET Yjs client (YDotNet over yrs) on Depot's /hubs/notes. Not part of Cockpit.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- YDotNet.Native.Linux 0.6.0 ships its binaries under distribution-specific runtime folders (a packaging bug), which the SDK flags. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YDotNet" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Win32" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Linux" Version="0.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>
</Project>
