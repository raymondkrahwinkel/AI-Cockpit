<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC-1588: shows a silent Windows toast and reports its click, which the cockpit itself cannot hear: the app is
       plain net10.0 with no WinRT, and PowerShell 5.1 cannot subscribe to a WinRT event. Windows only; built and
       copied beside Cockpit.App.exe by Cockpit.App's own target, never part of the Linux or macOS build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
