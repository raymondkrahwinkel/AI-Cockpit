<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC-1389 (F2.1): the half of the plugin SDK that needs a window — ICockpitPluginUi, ICockpitUiHost and the
       UI side of a plugin's own channel. The one project besides the desktop that names Avalonia, so that
       Cockpit.Plugins.Abstractions can drop it at the contract flip (F2.14, abstractionsVersion 3) and a
       backend without a UI stack can load a plugin's backend part. Plugins reference it like the SDK itself:
       compile-only (<Private>false</Private>), so the host's copy is the one loaded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- AC-1402: exempt from the "/// only on interface methods" sweep like Cockpit.Plugins.Abstractions (see its csproj):
         the /// on the window types moved here is the IntelliSense a plugin author sees in the NuGet package. -->
    <!-- Moves in step with Cockpit.Plugins.Abstractions: the same version, whose major is the contract. The
         AssemblyVersion stays fixed like the SDK's, so a plugin built against a later minor still binds to the
         host's copy. -->
    <!-- 3.3.0 (AC-1511): ICockpitUiHost.AddServerSettings (default no-op), a view for a server the plugin is installed
         on, with a channel to its backend part there. A plugin that calls it sets minHostVersion 0.92.0. -->
    <!-- 3.4.0 (AC-1504): ICockpitUiHost.AddFirstStartRoute (default no-op) and FirstStartRoute, a way to begin on the first-run
         wizard's "How do you want to start?" step. A plugin that calls it sets minHostVersion 0.94.0. -->
    <!-- 3.5.0 (AC-1509): IFirstStartPluginUi and IFirstStartHost, first-start routes that exist from the very first start,
         before the plugins initialize, with a restore from a backup target and a manifest apply. A plugin that implements
         it sets minHostVersion 0.102.0. -->
    <!-- 3.6.0 (AC-1660): ICockpitUiHost.SignOutMcpServerAsync (default no-op), the settings view's sign-out of its own MCP
         server. A plugin that calls it sets minHostVersion 0.105.0. -->
    <!-- 3.4.0 (AC-1710): DockPanelRegistration.KeepAlive and CanFloat (init, default false). A plugin that relies on
         either sets minHostVersion 0.111.0; an older host ignores them. -->
    <!-- 3.5.0 (AC-1737): ICockpitUiHost.ActiveProjectId and GetProjectsAsync (both default), the selected session's
         project and the projects. A plugin that reads them sets minHostVersion 0.112.0. -->
    <!-- 3.6.0 (AC-1711): ICockpitUiHost.OpenDockPanelAsync, default no-op; shows one of the plugin's own dock panels. A
         plugin that calls it sets minHostVersion 0.113.0. -->
    <!-- 3.7.0 (AC-1711): WorkspaceTypeRegistration.HeaderActions (init, empty by default), tab-strip buttons while that
         workspace is active. A plugin that relies on them sets minHostVersion 0.115.0; an older host ignores them. -->
    <!-- 3.8.0 (AC-1711): ICockpitUiHost.SetStatusText (default no-op), one line of the plugin's own text in the status
         bar. A plugin that calls it sets minHostVersion 0.116.0. -->
    <!-- 3.9.0 (AC-1722): ICockpitUiHost adds the icon-bearing side-menu badge overload. A plugin that uses it sets minHostVersion 0.120.0. -->
    <!-- 3.9.0 (AC-1726): FocusSessionAsync selects an existing pane without changing its input, host 0.122.0. -->
    <!-- 3.11.0 (AC-1497): combines the Depot SaaS UI contracts with main's 3.10.0 Productivity contracts. -->
    <!-- 3.12.0 (AC-1790): ICockpitUiHost adds the icon-bearing side-menu button overload. A plugin that uses it sets minHostVersion 0.126.0. -->
    <!-- 3.13.0 (AC-1750): ICockpitUiHost.OpenWorkspaceAsync with WorkspaceOpenOptions (instance key, title, preview). A plugin that relies on it sets minHostVersion 0.131.0. -->
    <!-- 3.14.0 (AC-1778): ICockpitUiHost.AddLinkHandler lets plugins claim recognized transcript links. -->
    <!-- 3.15.0 (AC-1753): ICockpitUiHost.CreateMarkdownEditor and IMarkdownEditor, the host's live-preview Markdown editor. A plugin that calls it sets minHostVersion 0.134.0. -->
    <!-- 3.16.0 (AC-1751): WorkspaceTypeRegistration.CanFloat, Pop out / Dock back for a workspace type. A plugin that sets it sets minHostVersion 0.135.0; an older host ignores it. -->
    <!-- 3.17.0: host-owned file workspaces; requires host 0.137.0 (AC-1754). -->
    <!-- 3.18.0 (AC-1781): FileWorkspaceOpenOptions.Preview, ICockpitUiHost.GetOpenWorkspaces and OpenWorkspacesChanged. A plugin that relies on them sets minHostVersion 0.138.0. -->
    <Version>3.18.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>Cockpit.Plugins.Abstractions.UI</PackageId>
    <Title>Cockpit Plugin SDK — UI</Title>
    <Description>The window half of the Cockpit plugin SDK: ICockpitPluginUi (the UI part's entry point), ICockpitUiHost (settings, menus, panels, dialogs, the active session) and the UI side of a plugin's own channel to its backend part.</Description>
    <Authors>Raymond Krahwinkel</Authors>
    <Company>Krahwinkel-IT</Company>
    <Copyright>Copyright (c) 2026 Raymond Krahwinkel / Krahwinkel-IT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/raymondkrahwinkel/AI-Cockpit/blob/main/docs/plugins/PLUGIN-SDK.md</PackageProjectUrl>
    <RepositoryUrl>https://github.com/raymondkrahwinkel/AI-Cockpit</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
  </ItemGroup>

</Project>
