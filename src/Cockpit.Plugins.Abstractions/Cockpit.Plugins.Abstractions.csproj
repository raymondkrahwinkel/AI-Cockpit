<Project Sdk="Microsoft.NET.Sdk">

  <!-- The single assembly shared by the host and every plugin (#14). Plugins reference this with
       <Private>false</Private> so the host's copy is the one loaded — see the plugin build plan's
       type-identity pitfall. Kept dependency-light on purpose: only the DI abstractions (for the
       ConfigureServices hook) and Avalonia (for the Control-factory contribution points). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- This assembly is the plugin SDK (#14): authors reference it to build a plugin. It is packable
         so it can be published as a NuGet for out-of-repo authoring; its Version's major must equal
         AbstractionsContract.Version (the manifest's abstractionsVersion the host gates on). XML docs
         ship for author IntelliSense; CS1591 is not enforced (the SDK guide is the reference). -->
    <!-- AC-593: exempt from the "/// only on interface methods" sweep and its gate. Everywhere else in
         the repo a /// on an implementation carries no reader beyond this codebase, so CodeQuality.md
         §3 turns it into a plain comment. Here the /// on public SDK types (not just interfaces) is
         the IntelliSense a plugin author sees when referencing the NuGet package above, and turning it
         into // would remove that for every consumer outside this repo, which is a different kind of
         loss than the sweep is written for. Decided with Raymond 2026-08-02: keep /// throughout this
         assembly rather than apply the rule here. -->
