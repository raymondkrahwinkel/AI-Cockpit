<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- SessionSwitch (lock/unlock) presence events for the Windows presence detector. The package is
         Windows-only at runtime but restores/builds on any host, keeping Infrastructure a plain net10.0
         assembly (no Windows target framework needed). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
    <!-- Windows has no /proc and .NET exposes no parent-process id, so the resource meter (#78) reads
         Win32_Process through WMI to see which processes a session spawned. The package restores everywhere;
         only the Windows-gated reader touches it. -->
    <PackageReference Include="System.Management" Version="10.0.9" />
    <!-- Multi-provider (#26): the local-LLM session driver (Ollama/LM Studio) talks to their
         OpenAI-compatible /v1 endpoints through Microsoft.Extensions.AI's IChatClient. The .OpenAI
         package brings the OpenAI SDK plus the AsIChatClient() adapter; a custom Endpoint points it at
         localhost. Later (#26 tool-loop) the same IChatClient hosts MCP tools via ModelContextProtocol. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <!-- 2.0.0 (AC-505): the client's ClientOAuthProvider now requests `offline_access` itself whenever the
         authorization server advertises it (SEP-2207) — the reason McpOAuthAuthorizer no longer has to derive
         a scope list by hand. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <!-- #26 tools/MCP: the MCP client (namespace ModelContextProtocol.Client) that connects the local-LLM
         tool-loop to the user's MCP servers. Kept on the same line as the AspNetCore server package. -->
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
    <!-- Read-aloud TTS (#35): sherpa-onnx (Apache-2.0) running the multilingual SupertonicTTS model in-proc —
         no Python, no subprocess. OfflineTts.Generate returns normalized float32 mono PCM plus the model's own
         sample rate; playback plays at that rate (SoundFlowAudioPlaybackService opens the device on
         whatever AudioFormat.SampleRate is handed in), so no resampling step is needed. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <!-- Extracts the .tar.bz2 SupertonicTTS model archive sherpa-onnx's model releases ship as (the ONNX graphs +
         tts.json + unicode_indexer.bin) — .NET's built-in System.Formats.Tar has no bzip2 decompressor. -->
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <!-- Rasterises an SVG project logo to a PNG when it is stored (AC-162). The core Svg.Skia, not its Avalonia
         binding: that one still tracks Avalonia 11 while this app is on 12, whereas this needs only SkiaSharp —
         the same 3.119 Avalonia already brings — so the logo path carries no UI-framework version coupling. -->
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <!-- Mermaid-text -> SVG for the diagram builder (AC-807). Pure managed .NET, no browser/Node/Chromium
         subprocess — a NuGet reference is the whole install. -->
    <PackageReference Include="Mermaider" Version="0.12.2" />
    <!-- Rasterises page 1 of a PDF preview to a bitmap (AC-730). PDFium (native, the renderer Chrome ships) +
         SkiaSharp — the marginal native weight is PDFium alone, since Svg.Skia above already pulls in Skia's own
         natives. MIT-licensed; picked over pure-managed Melville.Pdf.SkiaSharp for the renderer maturity a
         preview must not fall over on (see AC-730 for the full library comparison).
         Pinned to 5.2.1, not the newer 5.3.0: that release bumps its SkiaSharp floor to 4.150.1, which forces
         the whole solution onto a SkiaSharp major every plugin's bundled native asset was built against
         (they still ship 3.119.x/native ABI 119.0) — every Avalonia.Skia plugin test then fails at startup on
         a managed/native SkiaSharp version mismatch, not just this project. 5.2.1 only needs SkiaSharp
         >= 3.119.2, already satisfied by the 3.119.4 pinned elsewhere, so it adds no floor at all. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- Linux/macOS pty host for TTY mode (#9): forkpty()+execvp() run entirely in a native shim
         (avoids the .NET 7+ W^X/fork pitfall of forking from managed code), env injection via
         PtyOptions.Environment. Windows keeps the existing hand-rolled ConPtyProcess. -->
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <PackageReference Include="SharpHook" Version="7.1.1" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
    <PackageReference Include="Tmds.DBus" Version="0.92.0" />
    <!-- Voice input (STT+VAD): Whisper.net core plus the CPU runtimes only. WhisperBackendPlanner
         (Cockpit.Core) decides the try-order per VoiceBackendPreference + OS; Whisper.net's own
         NativeLibraryLoader walks that order at model-load time and picks the first one that loads here.
         The CPU runtimes stay bundled because they are small, work on every platform, and are the floor
         transcription can always fall back to.
         The GPU runtimes (CUDA/Vulkan) are deliberately NOT referenced — they cost a win-x64 publish 1.5 GB,
         since the natives weigh ~748 MB and a single-file publish shipped them twice (embedded in the exe,
         and again in runtimes/ via the packages' own .targets). Which GPU a machine has
         is not knowable at build time, so bundling them ships every runtime to every install to serve the
         one that happens to fit. WhisperRuntimeCache fetches the right one from NuGet on first dictation
         and caches it under %APPDATA%\Cockpit — the same lazy shape WhisperModelCache uses for the model,
         and it keeps the backend "auto" option meaningful (it can only pick from what is present).
         See docs/binary-size-and-on-demand-runtimes.md. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <!-- In-app updates (AC-108): the updater implementations live beside GitHubUpdateService in this project.
         Kept on the same pinned version as Cockpit.App — see the note there for why both declare it. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Core\Cockpit.Core.csproj" />
    <!-- #45: the plugin-provider driver adapter (PluginSessionDriverAdapter) and registry live here, so
         Infrastructure needs the shared plugin-contract types (IPluginSessionDriver, SessionProviderRegistration)
         to translate a plugin's narrow driver into the app's own ISessionDriver. -->
    <ProjectReference Include="..\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Core.Tests" />
    <InternalsVisibleTo Include="Cockpit.Infrastructure.Tests" />
    <!-- The one place a store and a view converter can be put end to end: the converter needs a real Avalonia
         platform to decode with, which only the view tests have. -->
    <InternalsVisibleTo Include="Cockpit.App.ViewTests" />
    <!-- AC-889: DiagramAccessRegistry stays in this assembly (the plugin only sees it through
         IDiagramAccessRegistry), but its own test project drives the concrete class directly, the same way
         Cockpit.Plugin.Autopilot.Tests reaches into Cockpit.App for its render tests — test-only, the shipped
         plugin never gets this grant. -->
    <InternalsVisibleTo Include="Cockpit.Plugin.Diagram.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
