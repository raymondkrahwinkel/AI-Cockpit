<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- Cockpit dark theme: flat, hairline-bordered, quiet. Tokens are consumed as
         DynamicResource so a future light/alt theme can swap this dictionary wholesale. -->
    <Styles.Resources>
        <ResourceDictionary>

            <!-- Surfaces -->
            <Color x:Key="CockpitWindowBgColor">#0f1116</Color>
            <Color x:Key="CockpitPanelBgColor">#1a1d24</Color>
            <Color x:Key="CockpitSecondaryBgColor">#0c0e12</Color>
            <Color x:Key="CockpitHairlineColor">#2a2f39</Color>

            <SolidColorBrush x:Key="CockpitWindowBgBrush" Color="{StaticResource CockpitWindowBgColor}"/>
            <SolidColorBrush x:Key="CockpitPanelBgBrush" Color="{StaticResource CockpitPanelBgColor}"/>
            <SolidColorBrush x:Key="CockpitSecondaryBgBrush" Color="{StaticResource CockpitSecondaryBgColor}"/>
            <SolidColorBrush x:Key="CockpitHairlineBrush" Color="{StaticResource CockpitHairlineColor}"/>

            <!-- The layer above the panel (chips, the markdown code-chip, a table header) — one step lighter than
                 CockpitPanelBgColor so a chip sitting on a panel still reads as raised. -->
            <Color x:Key="CockpitInsetBgColor">#202430</Color>
            <SolidColorBrush x:Key="CockpitInsetBgBrush" Color="{StaticResource CockpitInsetBgColor}"/>

            <!-- The band a window's title bar and a dialog's footer sit on (the mockup's "top" surface). It is a
                 shade *lighter* than the window fill, which is why the rail colour cannot stand in for it:
                 CockpitSecondaryBgColor is darker than the window and reads as recessed, and a header that
                 recedes puts the quietest surface where the dialog's name is. Its seam is softer than the
                 general hairline (the mockup's soft line) so the header reads as joined to the content below
                 rather than boxed off from it. -->
            <Color x:Key="CockpitChromeBgColor">#12141a</Color>
            <Color x:Key="CockpitHairlineSoftColor">#20242c</Color>

            <SolidColorBrush x:Key="CockpitChromeBgBrush" Color="{StaticResource CockpitChromeBgColor}"/>
            <SolidColorBrush x:Key="CockpitHairlineSoftBrush" Color="{StaticResource CockpitHairlineSoftColor}"/>

            <!-- The edge a secondary control lifts to under the pointer. The mockup answers hover on a
                 neutral button by brightening its *edge* and leaving the fill alone, which keeps a row of
                 buttons still while the pointer crosses it — a fill that changes moves the eye to whatever
                 the pointer happens to be over rather than to what the operator is looking for. -->
            <Color x:Key="CockpitHairlineHoverColor">#38404d</Color>
            <SolidColorBrush x:Key="CockpitHairlineHoverBrush" Color="{StaticResource CockpitHairlineHoverColor}"/>

            <!-- Text on an accent fill. Not CockpitTextPrimaryColor: that is a near-white tuned to sit on the
                 dark surfaces, and on the blue it loses the bit of contrast the label needs to stay crisp. -->
            <Color x:Key="CockpitTextOnAccentColor">#ffffff</Color>
            <SolidColorBrush x:Key="CockpitTextOnAccentBrush" Color="{StaticResource CockpitTextOnAccentColor}"/>

            <!-- Text and glyphs on a *status* fill — a "needs you" badge, a "the CEO is working…" band, the number
                 inside a step's dot. The status colours are bright by design (they have to catch the eye across a
                 grid), so the white that answers the accent is unreadable on them: 1.55:1 on the cyan, 2.03:1 on the
                 amber. This is the other end — the app's own near-black, which clears 10.6:1 on busy, 9.2:1 on
                 waiting and 6.6:1 on done. Not CockpitWindowBgColor, which happens to be the same value today:
                 naming it after the window would tie an ink to a surface, and the next repaint moves those two for
                 different reasons. -->
            <Color x:Key="CockpitTextOnStatusColor">#0f1116</Color>
            <SolidColorBrush x:Key="CockpitTextOnStatusBrush" Color="{StaticResource CockpitTextOnStatusColor}"/>

            <!-- Accent at 16% (#29 alpha) — the fill behind a selected row in an open dropdown. A solid accent
                 there would make the list read as one loud band; tinted, the row is picked out without the
                 text on it having to fight the fill. -->
            <Color x:Key="CockpitAccentSelectionColor">#293b82f6</Color>
            <SolidColorBrush x:Key="CockpitAccentSelectionBrush" Color="{StaticResource CockpitAccentSelectionColor}"/>

            <!-- White at 4% (#0a alpha) — the wash under a chromeless button on hover. A token rather than a
                 literal because it is the one place the theme paints with light instead of with a surface
                 colour: a ghost button has no fill to brighten, so it borrows one from whatever it sits on. -->
            <Color x:Key="CockpitGhostHoverColor">#0affffff</Color>
            <SolidColorBrush x:Key="CockpitGhostHoverBrush" Color="{StaticResource CockpitGhostHoverColor}"/>

            <!-- The dim a modal busy layer lays over what it blocks (AC-420) — the window fill at 70% (#b3
                 alpha), not black. Black over these blue-grey surfaces reads as a smudge; the app's own
                 darkest surface leaves the covered content recognisable while plainly out of reach. -->
            <Color x:Key="CockpitScrimColor">#b30f1116</Color>
            <SolidColorBrush x:Key="CockpitScrimBrush" Color="{StaticResource CockpitScrimColor}"/>

            <!-- Text -->
            <Color x:Key="CockpitTextPrimaryColor">#e8eaef</Color>
            <Color x:Key="CockpitTextSecondaryColor">#949aa5</Color>
            <Color x:Key="CockpitTextFaintColor">#656c78</Color>

            <SolidColorBrush x:Key="CockpitTextPrimaryBrush" Color="{StaticResource CockpitTextPrimaryColor}"/>
            <SolidColorBrush x:Key="CockpitTextSecondaryBrush" Color="{StaticResource CockpitTextSecondaryColor}"/>
            <SolidColorBrush x:Key="CockpitTextFaintBrush" Color="{StaticResource CockpitTextFaintColor}"/>

            <!-- User message bubble (T2): a calm cool-slate fill, distinct from the warm-neutral panel so
                 the operator's own lines read as "mine" on the right without shouting. -->
            <Color x:Key="CockpitUserBubbleColor">#28313B</Color>
            <SolidColorBrush x:Key="CockpitUserBubbleBrush" Color="{StaticResource CockpitUserBubbleColor}"/>

            <!-- The session header's "isolated" badge (a session running in its own git worktree, AC-334): its own
                 violet, apart from the grey kind chip and the status colours, so an isolated session is recognisable
                 at a glance regardless of what the accent/status colours are set to. -->
            <Color x:Key="CockpitIsolatedBadgeBgColor">#332b47</Color>
            <Color x:Key="CockpitIsolatedBadgeTextColor">#a78bda</Color>
            <SolidColorBrush x:Key="CockpitIsolatedBadgeBgBrush" Color="{StaticResource CockpitIsolatedBadgeBgColor}"/>
            <SolidColorBrush x:Key="CockpitIsolatedBadgeTextBrush" Color="{StaticResource CockpitIsolatedBadgeTextColor}"/>

            <!-- Accent + status -->
            <Color x:Key="CockpitAccentColor">#3b82f6</Color>
            <Color x:Key="CockpitAccentHoverColor">#4a8bf7</Color>
            <Color x:Key="CockpitAccentPressedColor">#2563eb</Color>
            <!-- Cyan rather than a second blue: the accent moved onto blue (AC-334), and a blue "busy" dot next to a
                 blue accent border would stop reading as its own signal. Raymond's call, 2026-07-27. -->
            <Color x:Key="CockpitStatusBusyColor">#22D3EE</Color>
            <Color x:Key="CockpitStatusWaitingColor">#E0A33E</Color>
            <Color x:Key="CockpitStatusDoneColor">#5AA576</Color>
            <!-- "Working (background)": sub-agents still running while the main agent is quiet. Purple so it reads apart from the cyan "busy" and green "done" dots. -->
            <Color x:Key="CockpitStatusBackgroundColor">#A67CD8</Color>
            <!-- Error toast severity (#61) — no session status used red before this, so a new token. -->
            <Color x:Key="CockpitStatusErrorColor">#D64545</Color>

            <SolidColorBrush x:Key="CockpitAccentBrush" Color="{StaticResource CockpitAccentColor}"/>
            <SolidColorBrush x:Key="CockpitAccentHoverBrush" Color="{StaticResource CockpitAccentHoverColor}"/>
            <SolidColorBrush x:Key="CockpitAccentPressedBrush" Color="{StaticResource CockpitAccentPressedColor}"/>
            <SolidColorBrush x:Key="CockpitStatusBusyBrush" Color="{StaticResource CockpitStatusBusyColor}"/>
            <SolidColorBrush x:Key="CockpitStatusWaitingBrush" Color="{StaticResource CockpitStatusWaitingColor}"/>
            <SolidColorBrush x:Key="CockpitStatusDoneBrush" Color="{StaticResource CockpitStatusDoneColor}"/>
            <SolidColorBrush x:Key="CockpitStatusBackgroundBrush" Color="{StaticResource CockpitStatusBackgroundColor}"/>
            <SolidColorBrush x:Key="CockpitStatusErrorBrush" Color="{StaticResource CockpitStatusErrorColor}"/>

            <!-- Geometry. The mockup's control radius (9px) is what every input, select and button
                 carries. Its window radius (14px) belongs to the rounded card a web page draws to
                 stand in for a window; a desktop app gets that corner from the OS, so no token
                 answers to it. The panel radius follows the mockup's cards instead: 12px for the
                 large ones, 10px for the compact ones. -->
            <CornerRadius x:Key="CockpitControlRadius">9</CornerRadius>
            <CornerRadius x:Key="CockpitPanelRadius">12</CornerRadius>
            <Thickness x:Key="CockpitHairlineThickness">1</Thickness>

            <!-- Fully round, for the things that are read as a word rather than as a box: a chip, a count
                 badge, a switch track. 20 is past half the height of all three, so each one ends in a
                 semicircle no matter how the text inside it grows. -->
            <CornerRadius x:Key="CockpitPillRadius">20</CornerRadius>

            <!-- The sub-navigation rail's width (Border.subnavRail below). A token rather than a literal on the
                 setter because a plugin's settings dialog has to widen itself by exactly this before the rail
                 exists to be measured (PluginDialogHost) — two hand-kept copies of one number would drift. -->
            <x:Double x:Key="CockpitSubnavRailWidth">184</x:Double>

            <!-- Typography: the transcript uses a terminal font so tool blocks and code read as a
                 Claude-TTY surface; the same family the TTY panel renders with. -->
            <FontFamily x:Key="CockpitMonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

            <!-- Fluent's own scroll-bar keys, redefined because the values sit inside its template at Template
                 priority, where a style setter of ours cannot reach them (AC-405). The groove keeps one colour
                 whether or not the pointer is over it; the thumb is the part that answers. -->
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource CockpitInsetBgColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource CockpitInsetBgColor}"/>
            <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="{StaticResource CockpitInsetBgColor}"/>

        </ResourceDictionary>
    </Styles.Resources>

    <!-- A small "?" glyph that carries a longer explanation in its tooltip, so an Options row can stay a single
         line instead of a paragraph of faint helper text. Usage: a MaterialIcon with Classes="hint" and a
         ToolTip.Tip next to the option's label. -->
    <Style Selector="materialIcons|MaterialIcon.hint">
        <Setter Property="Kind" Value="HelpCircleOutline"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.hint:pointerover">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>

    <!-- Window chrome -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource CockpitWindowBgBrush}"/>
    </Style>


    <!-- Base text. :is() so SelectableTextBlock (transcript rows, T3) inherits the same treatment as
         plain TextBlock — an exact-type selector would skip the derived SelectableTextBlock.
         ⚠️ This rule names the text element itself, and a rule that names an element outranks a value
         inherited from an ancestor. So a control cannot tint its own label by setting Foreground on itself:
         the label keeps this colour regardless. Any variant that needs another one has to name the text too
         (`Button.Ghost :is(TextBlock)`), which is what the rules below do. Measured, not assumed — the
         disabled states looked enabled until a render showed it (AC-336).
         Setting the base colour on the top level instead, so it would inherit, was tried and does not work:
         a popup is its own root and does not inherit from the window, which left every open dropdown, menu
         and tooltip drawn in Fluent's white. -->
    <Style Selector=":is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
    </Style>

    <!-- Transcript row surface (T2 + look&feel pass). Assistant/tool/thinking rows are flat — no card,
         so the transcript reads calm (the approved mockup); only a user row is a right-aligned, tinted
         bubble. State is set only through these classes — never inline on the Border — so the setters
         win (the Avalonia local-value gotcha). -->
    <Style Selector="Border.transcriptRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.transcriptRow.userRow">
        <Setter Property="Background" Value="{StaticResource CockpitUserBubbleBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="MaxWidth" Value="520"/>
    </Style>

    <!-- Sender identity: a small model avatar badge to the left of a reply, so a glance tells you who
         is speaking (the SDK/Local-LLM chat had no such cue). Subtle by design — panel fill + hairline,
         the glyph carries the accent. Sized for the per-reply badge; the empty-state reuses it larger. -->
    <Style Selector="Border.avatarBadge">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- The "who" line above a reply — quiet secondary text, trims rather than pushes the reply down. -->
    <Style Selector="TextBlock.senderName">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Per-reply action row (copy · read aloud): hidden until the row is hovered or focused, so a
         resting transcript stays calm and the controls surface where the eye already is (Claude web).
         Kept in the visual tree (opacity, not collapse) so the layout never jumps as it fades in. -->
    <Style Selector="StackPanel.rowActions">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.transcriptRow:pointerover StackPanel.rowActions">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.transcriptRow:focus-within StackPanel.rowActions">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Tool-use / thinking toggles as a quiet chip rather than bare text, so background activity reads
         as a discrete, secondary object indented under the reply it belongs to. -->
    <Style Selector="Button.toolChip">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="Padding" Value="8,3"/>
        <!-- Mono for the command/tool text (e.g. "Bash · dotnet build") so it reads as code, not prose. -->
        <Setter Property="FontFamily" Value="{StaticResource CockpitMonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.toolChip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>

    <!-- A slowly pulsing dot, reused by the "still starting" banner and the "Thinking…" indicator so the
         opacity keyframes live in one place rather than being copied inline at each call site. -->
    <Style Selector="materialIcons|MaterialIcon.pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Buttons: flat, hairline border, rounded corners. Accent reserved for primary actions
         via the "Accent" style class (applied explicitly, not globally).
         Every state below is spelled out. A Fluent button answers hover, press, disable and keyboard
         focus out of the box in Fluent's own colours; the moment the theme takes one of them over it
         owns them all, because an unclaimed state falls back to a palette this app never uses. -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <!-- Hover brightens the edge and leaves the fill; press is the one that moves the surface, so the
         two states stay distinguishable without either of them shouting. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <!-- Disabled keeps the shape: the control still reads as a button you cannot use now, rather than as the
         grey slab Fluent paints, which reads as a mis-styled one. The label is faded by a third rule further
         down (`Button:disabled :is(TextBlock)`) — setting Foreground here is not enough on its own, and that
         rule has to come after every variant to be able to override them. -->
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
    </Style>
    <!-- :focus-visible, not :focus — a click focuses too, and a ring left behind by the pointer marks the
         last thing touched rather than where the keyboard is. -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>

    <Style Selector="Button.Accent">
        <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.Accent :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.Accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentPressedBrush}"/>
    </Style>
    <!-- A disabled primary drops the accent entirely. Dimming the blue would leave a washed-out blue that
         still reads as "the button to press", which is the opposite of what disabled has to say. -->
    <Style Selector="Button.Accent:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="Button.Accent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
    </Style>

    <!-- Ghost: the dismissing half of a dialog footer (Cancel next to a primary). It carries no chrome at
         rest so the pair reads as one decision with one obvious answer, and gains a wash on hover so it
         is still visibly a button and not a line of text that happens to be clickable. Distinct from
         Button.Subtle, which is a chromeless *icon* button at 2px padding — this one keeps the full
         button footprint so it lines up with the primary beside it. -->
    <Style Selector="Button.Ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.Ghost :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.Ghost:pointerover :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.Ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitGhostHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.Ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.Ghost:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="Button.Ghost:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Subtle buttons used as toggles (chevrons, "Thinking..." collapsers) — no chrome, just text. -->
    <Style Selector="Button.Subtle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
    </Style>
    <!-- No text-colour setter here (AC-406): Subtle sets no Foreground at rest, so its label is already
         CockpitTextPrimaryBrush via the base :is(TextBlock) rule above. A hover rule that named the same
         brush would be dead by construction — not just unreachable like the TextBlock.Foreground form this
         replaced, but a no-op even if it worked. -->
    <Style Selector="Button.Subtle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Disabled Subtle button (e.g. Remove with nothing selected): stay chromeless — without this the
         default theme paints a grey disabled box, which reads as a broken/mis-styled button. -->
    <Style Selector="Button.Subtle:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Compact button: denser secondary action (Stop) that must not compete with the accent. Shares
         the compact selectors' height/surface so the session top bar (Stop + mode/model/effort) reads
         as one aligned row of controls. -->
    <Style Selector="Button.Compact">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>

    <!-- Row-action button (Worktrees dialog list rows): unlike the chromeless Subtle buttons, these sit on the
         lighter secondary row surface and must READ as buttons — so they keep the base panel fill + hairline
         border and only shrink to a compact footprint. Disabled dims the whole button (fill, border and text) so
         "you can't do this now" is unmistakable at a glance, while the button shape stays visible. -->
    <Style Selector="Button.RowAction">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Text colour has to name the label itself (AC-406): the Foreground this used to set on the button was
         inherited by the label, and the base :is(TextBlock) rule above names the label directly — a named rule
         always beats an inherited value, so the row read primary at rest instead of secondary. -->
    <Style Selector="Button.RowAction :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.RowAction:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitHairlineBrush}"/>
    </Style>
    <Style Selector="Button.RowAction:pointerover :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
    </Style>
    <!-- Disabled keeps the button shape (fill + border) so it still reads as a button, but dims the whole thing
         and fades the text — deterministically, rather than letting the base theme paint its own grey box. The
         text fade itself comes from the shared Button:disabled :is(TextBlock) rule below, which has to be
         declared after this so it can override the rest/hover rules just above. -->
    <Style Selector="Button.RowAction:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="Button.RowAction:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>

    <!-- ToggleButton (e.g. the Zoom toggle): flat like a neutral button, cockpit accent when
         checked instead of the Fluent blue, so the active state matches the theme. -->
    <Style Selector="ToggleButton">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentHoverBrush}"/>
    </Style>
    <!-- Collapser toggle: a chevron and a line of text that open a section — a heading you can click, not a
         button. It needs its own styling because the checked state above fills a ToggleButton with the accent,
         which would make the quietest row in a dialog the loudest thing on the screen the moment it is opened.
         Note the selector is by exact type: Button.Subtle does not reach a ToggleButton. -->
    <Style Selector="ToggleButton.Collapser">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.Collapser /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.Collapser:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.Collapser:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.Collapser:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Compact toggle: same dense footprint as Button.Compact, so a toggle sitting in a compact control
         row (e.g. the TTY header's Read aloud beside Redraw) lines up at the same height. -->
    <Style Selector="ToggleButton.Compact">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ComboBox: the same box as a TextBox, so a form reads as one column of controls rather than as
         inputs and pickers drawn by two different hands. -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- Border#Background's own Background/BorderBrush are a TemplateBinding back to the ComboBox (Template
         priority), which already carries the control's own colours through at rest — a plain style rule setting
         the same properties on this part would sit at Style priority and never be reached. Hover is different:
         Fluent's own ComboBox theme re-claims Background on this part while the pointer is over it, behind a
         pseudo-class (StyleTrigger priority, above Template), so it has to be reclaimed here or it falls back to
         Fluent's #99000000. Measured on a plain picker and on ComboBox.Compact. Focus reclaims nothing here, so
         there is nothing to hold on to in that state. Focus is declared after hover for the same reason as the
         input below: clicking a picker makes both true, and the later rule wins. -->
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{TemplateBinding Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <!-- A disabled picker recedes. Left to Fluent it goes *lighter* than the fields around it and steps
         forward instead — the "Provider (fixed after creation)" row was the loudest thing in a form whose
         other controls were all still editable. -->
    <Style Selector="ComboBox:disabled /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineSoftBrush}"/>
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <!-- Same as the disabled button: the chosen value has to be named to be faded, not inherited into. -->
    <Style Selector="ComboBox:disabled :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="ComboBox:disabled /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>

    <!-- ComboBox dropdown items: the selected row is an accent *tint*, not the Fluent-blue fill and not
         the old panel-bg, which was indistinguishable from a hovered row on a dark list. -->
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentSelectionBrush}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentSelectionBrush}"/>
    </Style>

    <!-- Compact selectors: the per-session mode/model/effort pickers are context controls, not the
         focus — shrink them (smaller font, tighter padding, faint text) so the transcript dominates. -->
    <Style Selector="ComboBox.Compact">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>

    <!-- TextBox: an input sits a step *above* the window rather than sunk into it, so a form reads as a
         column of things you can type in. It shares its fill, radius and padding with ComboBox, which is
         what makes a label/field grid line up whether the row is typed or picked. -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- PART_Placeholder, measured off the Avalonia 12 template. The selector this replaced named
         PART_Watermark, which no longer exists there: it had been matching nothing, and every placeholder
         in the app was drawing in Fluent's grey rather than the theme's. -->
    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <!-- Fluent's own TextBox theme re-claims Background (hover, focus) and BorderThickness (focus) on this
         part behind a pseudo-class, which outranks the template binding that carries the control's own value
         through — so naming BorderBrush alone left a field asking for no fill and no border drawn with both
         (the Insert prompt search bar and the command palette's query box, AC-425). Handing the control's
         value back keeps that field bare and an ordinary one on its own style. Focus comes second because
         both states name the same element and the later rule wins: the other way round, clicking into a
         field looked exactly like hovering it. This edge only exists for a field that asks for a border at
         all: one with BorderThickness="0" has nothing to draw here and gets no state marker. That suits a
         field that is the only input on its surface and takes focus when it opens, and not one sitting in a
         toolbar — which is why the flow-name field asks for a transparent border rather than none. -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{TemplateBinding Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{TemplateBinding Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
    </Style>
    <!-- A disabled field recedes, for the same reason a disabled picker does. This matches :disabled only —
         IsEnabled="False" — not IsReadOnly, which carries no pseudo-class here and is untouched by this rule.
         Unlike pointerover/focus above, Fluent's own :disabled rule for this part does not touch BorderThickness
         (measured: a TextBox with a local BorderThickness="0" still shows 0 while disabled), so there is nothing
         here to lose. -->
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineSoftBrush}"/>
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="TextBox:disabled :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>

    <!-- NumericUpDown (e.g. the idle-minutes input): match the cockpit inputs — secondary background,
         hairline border, rounded — instead of the bare default that clashed with the theme. -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ScrollBar: the theme never claimed one, so every scrollable surface kept Fluent's greys. Only the thumb
         is reachable from here — the track and the corner take their colour inside Fluent's template, at
         Template priority, above a style setter, so they are redefined as resource keys in Styles.Resources.
         The thumb sits several steps lighter than its groove: theme-correct and invisible is the way to get
         this wrong. -->
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pressed">
        <Setter Property="Background" Value="{StaticResource CockpitTextPrimaryBrush}"/>
    </Style>

    <!-- CheckBox: the box follows CockpitAccentColor. Until now it drew with Avalonia's *system* accent —
         they happen to coincide since the theme moved onto blue (AC-334), but nothing connects them, so a
         change to the token would have quietly left every tick behind on the old colour. -->
    <!-- Named "CheckBox:unchecked" rather than the bare "CheckBox" this used to be (AC-422): Fluent's own
         template sets Background/BorderBrush on this same Border directly in markup (Template priority), which
         outranks a plain Style-priority setter with no pseudoclass. The setter never lost an argument, it just
         never got to make one — an unticked box rendered Fluent's own transparent fill and translucent stroke
         regardless of what this rule asked for. A pseudoclass promotes the rule to StyleTrigger priority, which
         is the one thing here that outranks Template. -->
    <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource CockpitAccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentHoverBrush}"/>
    </Style>
    <Style Selector="CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{StaticResource CockpitTextOnAccentBrush}"/>
    </Style>
    <Style Selector="CheckBox:disabled /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineSoftBrush}"/>
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>

    <!-- RadioButton: the CheckBox story one control along — it kept Avalonia's system accent (#0078d7). It gets
         a template of its own because Fluent's builds no named parts to reach into, and the parts are Ring and
         Dot rather than Fluent's OuterEllipse/CheckGlyph because Fluent's rules are still loaded and match by
         name: one of them fades OuterEllipse to Opacity 0 on :checked, which rendered a picked button as a dot
         with no ring while every colour was correct. -->
    <Style Selector="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Name="Ring" Width="18" Height="18" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource CockpitPanelBgBrush}"
                             Stroke="{StaticResource CockpitHairlineBrush}"
                             StrokeThickness="1"/>
                    <!-- Same margin as the ring, so the dot centres on the ring rather than on the cell. -->
                    <Ellipse Name="Dot" Width="8" Height="8" Margin="0,0,8,0"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{StaticResource CockpitTextOnAccentBrush}"
                             IsVisible="False"/>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton:pointerover /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="RadioButton:checked:pointerover /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{StaticResource CockpitAccentHoverBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource CockpitAccentHoverBrush}"/>
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#Dot">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="RadioButton:focus-visible /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="RadioButton:disabled /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource CockpitHairlineSoftBrush}"/>
    </Style>
    <Style Selector="RadioButton:disabled /template/ Ellipse#Dot">
        <Setter Property="Fill" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="RadioButton:disabled">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>

    <!-- Switch: a setting that is on or off, drawn as a track the knob slides along rather than as a box
         you tick. Applied by class, not to every CheckBox: a list of options you pick from is a set of
         checkboxes and stays one — a switch says "this is running now", which is a different sentence.
         Built on CheckBox because that is the control these settings already bind to; swapping them for
         ToggleSwitch would change the views to gain a shape the template can give them here.
         The knob moves by transform, so it slides instead of jumping — HorizontalAlignment cannot animate. -->
    <Style Selector="CheckBox.Switch">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <Border Name="Track" Width="34" Height="19" VerticalAlignment="Top" Margin="0,2,11,0"
                            CornerRadius="{StaticResource CockpitPillRadius}"
                            Background="{StaticResource CockpitInsetBgBrush}"
                            BorderBrush="{StaticResource CockpitHairlineBrush}"
                            BorderThickness="{StaticResource CockpitHairlineThickness}">
                        <Ellipse Name="Knob" Width="15" Height="15" Margin="2,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{StaticResource CockpitTextFaintBrush}"
                                 RenderTransform="translateX(0px)">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </Border>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Top"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.Switch:pointerover /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineHoverBrush}"/>
    </Style>
    <Style Selector="CheckBox.Switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="CheckBox.Switch:checked:pointerover /template/ Border#Track">
        <Setter Property="Background" Value="{StaticResource CockpitAccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentHoverBrush}"/>
    </Style>
    <Style Selector="CheckBox.Switch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource CockpitTextOnAccentBrush}"/>
        <Setter Property="RenderTransform" Value="translateX(15px)"/>
    </Style>
    <Style Selector="CheckBox.Switch:focus-visible /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="CheckBox.Switch:disabled /template/ Border#Track">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineSoftBrush}"/>
    </Style>

    <!-- Tag: the small label that classifies the thing next to it — a session's kind, a branch's state, a
         plugin's category. The app had nine of these, each with its own hand-written radius, padding and
         size; the shape is the same thing nine times, so it belongs here, while the colour stays at the
         call site because that is the part that actually differs (a kind tag is grey, an isolated one
         violet, a branch state amber). Sits on the layer above the panel so a tag on a card still reads
         as raised.
         Named for the mockup's `.ctag` (5px radius, a classifying label), not its `.chip` (a full 20px
         pill naming a thing — an MCP server that is on). The app has no surface carrying that second shape
         yet; it arrives with the projects flow, and calling this one "chip" would take the name it needs. -->
    <Style Selector="Border.tag">
        <Setter Property="Background" Value="{StaticResource CockpitInsetBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineSoftBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Direct child, so a ToolTip.Tip hung on the tag keeps its own text colour.
         Secondary rather than faint, which is what the mockup asks for and what the contrast needs: faint on
         the inset fill is 2.93:1, below the 4.5:1 a label has to clear, and worse than the 3.65:1 these tags
         had on the darker surface they used to sit on. Secondary on inset is 5.47:1. -->
    <Style Selector="Border.tag > :is(TextBlock)">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
    </Style>

    <!-- Transcript body text: terminal font for the Claude-TTY reading surface. -->
    <Style Selector=":is(TextBlock).transcript">
        <Setter Property="FontFamily" Value="{StaticResource CockpitMonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style Selector=":is(TextBlock).toolBody">
        <Setter Property="FontFamily" Value="{StaticResource CockpitMonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Structured/code result box (T6): a monospace panel a shade darker than the row, so JSON/code
         results read as a code block rather than prose. The copy button floats top-right. -->
    <Style Selector="Border.codeBox">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Button.copyBtn">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,2,2,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
    </Style>
    <!-- Text colour has to name the label itself (AC-406): same defect as RowAction — the Foreground this
         used to set on the button was inherited, and the base :is(TextBlock) rule above names the label
         directly, so the faint copy-button ink at rest never actually reached it. -->
    <Style Selector="Button.copyBtn :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>
    <Style Selector="Button.copyBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <Style Selector="Button.copyBtn:pointerover :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
    </Style>

    <!-- Declared after every variant that names the label directly — Ghost and Accent above, RowAction and
         copyBtn here — so it can win over each of their rest/hover colours (AC-336, widened by AC-406). Avalonia
         has no CSS specificity: between two rules that both name :is(TextBlock), the later-declared one wins, so
         disabled has to come last among all of them to be able to override Ghost's grey, Accent's white,
         RowAction's secondary/primary pair and copyBtn's faint/primary pair in one rule. -->
    <Style Selector="Button:disabled :is(TextBlock)">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
    </Style>

    <!-- Cockpit sidebar session item. State is driven only by classes (never inline on the Border) so
         style setters actually win: the base row is flat and transparent, blending into the sidebar; the
         active row lifts to a filled card with an accent-coloured left edge so the selected session is
         unmistakable. The 2px left gutter is reserved as transparent on every row so text doesn't shift
         when selection moves. Order matters: .attention is declared after .active so its tinted fill wins
         for a row that is both selected and waiting, while .active still supplies the accent edge. -->
    <Style Selector="Border.sessionItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.sessionItem:pointerover">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <Style Selector="Border.sessionItem.active">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>

    <!-- Active session panel (main grid): the selected panel carries the accent edge so the
         one you're driving jumps out of the grid; inactive panels keep the quiet hairline. -->
    <Style Selector="Border.panel">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
    </Style>
    <!-- Needs-attention grid panel: an amber edge so a session that needs you jumps out of the grid
         even while you're driving another one. The active panel's accent edge below still wins when a
         panel is both selected and waiting (that one already has your eye). -->
    <Style Selector="Border.panel.attention">
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitStatusWaitingBrush}"/>
    </Style>
    <Style Selector="Border.panel.active">
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>

    <!-- Needs-attention sidebar item: a soft accent-tinted fill so it reads louder than a plain dot.
         Declared after .active so an active+waiting row keeps this tint (with .active's accent edge).
         2A-alpha echo of CockpitStatusWaitingColor (AC-406) — was a pre-mixed opaque literal that would
         have held the old waiting colour through a repaint. Picked by rendering the real row against the
         sidebar's own background (CockpitSecondaryBgColor) and matching the previous pixels, not by eye
         against a mockup background — see ThemeHexColorGuardTests.AllowedLiterals for the measurement. -->
    <Style Selector="Border.sessionItem.attention">
        <Setter Property="Background" Value="#2AE0A33E"/>
    </Style>

    <!-- ListBox (profile manager): flat, transparent; the selected row gets a quiet panel-bg fill
         (matching the sidebar's active treatment) instead of the default Fluent-blue highlight. -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <!-- Selected *and* focused — the state a row is in the moment you click it, and the one that was
         missing. Without these three the row fell through to Fluent and turned light grey with dark text
         in the middle of a dark list, which reads as a rendering fault rather than as a selection
         (Discover in the plugin store, the picked profile in ManageProfiles). -->
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:focus-within /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>

    <!-- TabControl / TabItem: a compact segmented "pill" bar instead of Avalonia's default underlined
         text tabs (Options dialog). Each tab is a rounded chip on the dark tab strip; the selected one
         fills with the cockpit accent, an unselected one lifts to a quiet panel fill on hover. The
         TabItem template is replaced wholesale so the Fluent selected-underline is gone entirely — the
         accent fill is the state signal, so it stays obvious regardless of text-colour inheritance. -->
    <!-- Bootstrap-style nav-tabs (Options dialog): an inactive tab is flat text; the selected tab is a
         top-rounded "card" outlined on top+left+right with an open bottom, so it reads as connected to the
         content below it. The TabControl body sits on the dialog's panel background (transparent), so the
         selected tab's matching fill + open-bottom border merge into the content like Bootstrap's .active. -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,10,10,0"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6,6,0,0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Options sub-navigation (AC-69): the left rail inside each Options tab. It splits a tab into
         sub-pages so a tab scales by gaining a rail item instead of growing into one long scroll — the
         top tab-bar stays short while a full tab (Voice) fans out below it. The rail is a recessed
         secondary surface with a hairline against the detail column; the active sub-page carries the
         accent bar, the same accent the top tabs use as their selected fill. A ListBox drives it so a
         single-page tab can show a one-item rail today and grow items later without a structural change. -->
    <Style Selector="Border.subnavRail">
        <Setter Property="Width" Value="{StaticResource CockpitSubnavRailWidth}"/>
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="10,12"/>
    </Style>
    <Style Selector="TextBlock.subnavGroup">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextFaintBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="8,2,8,6"/>
    </Style>
    <Style Selector="ListBox.subnav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.subnav ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="7"/>
                    <Border Name="Accent" Width="3" HorizontalAlignment="Left" Margin="0,7"
                            CornerRadius="0,2,2,0" Background="{StaticResource CockpitAccentBrush}" IsVisible="False"/>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.subnav ListBoxItem:pointerover /template/ Border#ItemBg">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <!-- Neutralise the default ListBoxItem fills (they paint the inner ContentPresenter); the rail's own
         ItemBg border is the surface, so the accent bar reads as the state signal, not a box fill. -->
    <Style Selector="ListBox.subnav ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.subnav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.subnav ListBoxItem:selected">
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ListBox.subnav ListBoxItem:selected /template/ Border#ItemBg">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
    </Style>
    <Style Selector="ListBox.subnav ListBoxItem:selected /template/ Border#Accent">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Plugin store (#62) catalogue rows. The store's middle column is a list of full-width rows
         (categories | plugins | details), not a card grid — each row is a quiet secondary surface that
         lifts on hover (a lighter panel fill + an accent-tinted border) so the catalogue reads as a list
         of clickable entries. Background/border live here, not inline on the row, so the hover transition
         has base values to animate from. -->
    <Style Selector="Border.storeRow">
        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.storeRow:pointerover">
        <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <!-- Featured row: a persistent accent left-edge so a store's hand-picked plugins read as picked,
         both in the Featured group and wherever else they land in the list. -->
    <Style Selector="Border.storeRow.featured">
        <Setter Property="BorderThickness" Value="3,1,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>

    <!-- The store row's primary call-to-action (Install / Update): a filled accent pill at the compact
         height, switched on via Classes.accentCta only while the action does something — an up-to-date
         "Installed" keeps the plain Compact treatment. Declared after Button.Compact so the accent fill
         wins over the compact surface when a row's button carries both classes. -->
    <Style Selector="Button.accentCta">
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}"/>
    </Style>
    <Style Selector="Button.accentCta:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.accentCta:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CockpitAccentPressedBrush}"/>
    </Style>

    <!-- Store section rails ("Featured", "All plugins"): a store-header scale, so the Discover page reads
         as sections rather than bold words the same size as the body. -->
    <Style Selector="TextBlock.storeSectionHeader">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

</Styles>
