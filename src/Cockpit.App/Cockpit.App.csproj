<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The icon Windows Explorer and the taskbar read off the executable itself; the window's own Icon
         (MainWindow.axaml) does not reach either. Both point at the same .ico. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Defensive: nothing in the repo sets GC mode explicitly, so it defaults to Server GC because
       Microsoft.Extensions.Hosting pulls in Microsoft.AspNetCore.App. Server GC's per-core heap adds baseline
       footprint a desktop app doesn't need, worse on macOS. Not a fix for a measured issue (see AC-686).
       AC-733: Workstation GC also does not hand freed segments back to the OS without memory pressure, which a
       single-user desktop workstation rarely has — see runtimeconfig.template.json (ConserveMemory) and
       Services/AdaptiveGcCompactor.cs (the part that actually reclaims it, without a long pause). -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- AC-1042: the plugin guides stay in `docs/plugins/`, where GitHub, the published SDK package's README and
       eleven store manifests already point at them, and ship from there — one file, two readers. The scanner
       (AC-1033) matches on the resource name, so LogicalName is all it takes; WithCulture keeps a future
       `PLUGIN-SDK.nl.md` out of a satellite assembly the scanner never reads. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\docs\plugins\*.md"
                      Exclude="$(MSBuildThisFileDirectory)..\..\docs\plugins\README.md"
                      LogicalName="Cockpit.App.Docs.%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- The host provides the DataGrid (control + theme) so plugins can use it via Private=false and share
         its type identity + app-wide theme, instead of each shipping and theming their own copy (#14). -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <!-- The host provides the Material Design icon set (control + styles), app-wide, so the UI draws icons as
         paths that inherit Foreground instead of emoji glyphs the machine's font renders (AC-33). Plugins use it
         via Private=false/ExcludeAssets=runtime — same host-provided pattern as the DataGrid above, so its type
         identity is shared and the plugin folder ships no copy. 3.0.2 targets Avalonia 12. -->
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <!-- The host provides the SVG control (AC-809), same host-provided pattern as above: shipped from a
         plugin's own zip it drags along a second SkiaSharp/HarfBuzzSharp copy and fails to render at all. -->
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <!-- TTY-mode experiment (#9): Exclr8.Terminal (MIT), a pure Avalonia terminal-emulator control with
         no PTY plumbing baked in — Write(bytes) feeds pty output in, the Input/Output events carry bytes
         the terminal wants written back (user keystrokes and protocol replies alike), Resized reports
         cell-grid changes. Verified pty-agnostic (no seam that wants to own the process), so the cockpit
         still hosts the pty itself (ConPtyProcess on Windows, PortaPtyProcess on Linux/macOS, both with
         our profile-aware env injection of CLAUDE_CONFIG_DIR + TERM) and renders into this control.
         Vendored from source under third_party/ (see that project) instead of the NuGet package: 1.0.7 is
         the last published release, and the renderer's glyph-drift (AC-66) and reflow/cols (AC-129) bugs
         are fixed in-tree there — a ProjectReference below. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <!-- In-app updates (AC-108). Referenced here as well as in Cockpit.Infrastructure because Program.Main
         calls VelopackApp directly: installing, updating and uninstalling all re-run this executable with
         arguments Velopack itself handles, and that hook has to be the first thing Main does. Leaning on the
         transitive reference would make a direct API call depend on another project's dependency list.
         Pinned rather than floating: the version here is the one the release pipeline installs `vpk` at, and
         the two are a matched pair — the tool writes the feed this library reads. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Core\Cockpit.Core.csproj" />
    <ProjectReference Include="..\Cockpit.Infrastructure\Cockpit.Infrastructure.csproj" />
    <ProjectReference Include="..\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
    <!-- Vendored terminal renderer (MIT), patched in-tree — see third_party/Exclr8.Terminal. -->
    <ProjectReference Include="..\..\third_party\Exclr8.Terminal\Exclr8.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Core.Tests" />
    <InternalsVisibleTo Include="Cockpit.App.ViewTests" />
    <!-- AC-1220: so the harness judges Avalonia's cut-off with RenderClockRecovery instead of a copy of its message. -->
    <InternalsVisibleTo Include="Cockpit.MeasurementHarness" />
  </ItemGroup>

  <!-- Plugins that ship with the app (#: bundled plugins): features that used to be core and moved out to a
       plugin, so an operator has them out of the box instead of having to know they exist. Referenced with
       ReferenceOutputAssembly=false so they are *built* but never referenced — a bundled plugin must load
       through the plugin loader like any other, in its own load context, or shared types lose their identity.
       BundledPluginInstaller copies them into the operator's plugins directory on startup. -->
  <!-- These plugins live outside Cockpit.slnx, so a solution build has no configuration mapping for them and
       MSBuild — which by default strips Configuration/Platform when descending into a project reference — built
       them as Debug even in a Release build, while CopyBundledPlugins below looks under $(Configuration). On a
       machine with stale Debug output the copy quietly succeeded with yesterday's bytes; on a clean checkout
       (CI) the Release build failed outright, which is how this was found. Keeping the parent configuration is
       exactly what we want here: a bundled plugin is part of this build, not a separate one. -->
  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.TranscriptSearch\Cockpit.Plugin.TranscriptSearch.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.GitStatus\Cockpit.Plugin.GitStatus.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- The clock: a Dashboard workspace with nothing to put on it is a worse first impression than one that
         already has a clock, and it proves the widget SDK end to end from outside the host. Its former other
         half, the system monitor, is its own plugin from the store — one plugin per widget, so wanting a clock
         is not also wanting a CPU meter. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.Clock\Cockpit.Plugin.Clock.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- The usage-trend widget (AC-54): bundled beside the clock so the ctx/5h/wk trend is there out of the box,
         and it exercises the AC-54 read surface (ICockpitSessionObserver.ActiveSessionUsage) from a real plugin. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.UsageTrend\Cockpit.Plugin.UsageTrend.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- The example workspace (AC-122): bundled so the plugin-owned full-surface workspace type is there out of
         the box, and it exercises the workspace-type SDK — a plugin drawing a whole workspace with a real host
         session embedded in it — from a real plugin, the way UsageTrend exercises the widget SDK. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.ExampleWorkspace\Cockpit.Plugin.ExampleWorkspace.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- The example companion tool (AC-240): bundled so the plugin-owned companion-window mini-tool is there out
         of the box, and it exercises the companion-tool SDK — a plugin drawing an icon and handling a click in
         the companion window — from a real plugin, the way ExampleWorkspace exercises the workspace-type SDK. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.ExampleCompanionTool\Cockpit.Plugin.ExampleCompanionTool.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- Autopilot (AC-94, skeleton AC-149): bundled so its workspace and settings are there out of the box; it
         registers a plugin workspace type through the AC-122 SDK. The run flow lands in later sub-tickets. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.Autopilot\Cockpit.Plugin.Autopilot.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- Fan-out (AC-467): bundled beside Autopilot, the other surface that runs agents in their own worktrees.
         Where Autopilot drives one run through to a merge-ready PR, this puts several agents on one task at once
         and tiles them, so the operator picks the take. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.FanOut\Cockpit.Plugin.FanOut.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- Claude as a provider plugin (Fase 4): Claude used to be a core feature and is now a plugin like the
         others here, so an operator gets it out of the box. Both its routes register — the interactive TUI (TTY)
         and the headless SDK route, whose tool approvals ride the control protocol in-band. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.ClaudeProvider\Cockpit.Plugin.ClaudeProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <!-- AC-1390: the bundled plugins, by project folder and installed folder id. Each one's files are taken from its
       output folder by wildcard (*.dll, *.deps.json, plugin.json) rather than by name, so a plugin that splits into
       a backend and a UI part, two assemblies in that one folder, needs no change in this file. -->
  <ItemGroup>
    <BundledPlugin Include="TranscriptSearch" FolderId="transcript-search" />
    <BundledPlugin Include="GitStatus" FolderId="git-status" />
    <BundledPlugin Include="Clock" FolderId="clock" />
    <BundledPlugin Include="UsageTrend" FolderId="usage-trend" />
    <BundledPlugin Include="ExampleWorkspace" FolderId="example-workspace" />
    <BundledPlugin Include="ExampleCompanionTool" FolderId="example-companion-tool" />
    <BundledPlugin Include="Autopilot" FolderId="autopilot" />
    <BundledPlugin Include="FanOut" FolderId="fan-out" />
    <BundledPlugin Include="ClaudeProvider" FolderId="claude-provider" />
  </ItemGroup>

  <!-- Resolved in a target, after the plugins are built: at evaluation time, and before ResolveProjectReferences,
       a clean checkout has no output folder yet and a wildcard would quietly match nothing. -->
  <Target Name="ResolveBundledPluginFiles">
    <ItemGroup>
      <_BundledPluginOutput Include="@(BundledPlugin->'$(MSBuildThisFileDirectory)..\..\plugins-dev\Cockpit.Plugin.%(Identity)\bin\$(Configuration)\$(TargetFramework)\')" />
      <BundledPluginFile Include="%(_BundledPluginOutput.Identity)*.dll;%(_BundledPluginOutput.Identity)*.deps.json;%(_BundledPluginOutput.Identity)plugin.json"
                         FolderId="%(_BundledPluginOutput.FolderId)" />
    </ItemGroup>
    <Error Condition="'@(BundledPlugin->Count())' != '@(BundledPluginFile->WithMetadataValue('Filename', 'plugin')->Count())'"
           Text="A bundled plugin has no plugin.json in its output folder; was it built for $(Configuration)?" />
  </Target>

  <!-- A single-file build is one file, so the bundled plugins ride inside it: the same files are embedded as
       resources under their folder names, and BundledPluginResources unpacks them at startup. Only for single-file:
       a normal build keeps its folder, which is what a developer edits and rebuilds. -->
  <Target Name="EmbedBundledPlugins" AfterTargets="ResolveProjectReferences" DependsOnTargets="ResolveBundledPluginFiles"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <EmbeddedResource Include="@(BundledPluginFile)"
                        LogicalName="bundled-plugins/%(BundledPluginFile.FolderId)/%(BundledPluginFile.Filename)%(BundledPluginFile.Extension)" />
    </ItemGroup>
  </Target>

  <!-- Publish takes a different output root, and a release bundle without its bundled plugins would ship a cockpit
       missing the features that used to be core. -->
  <Target Name="CopyBundledPlugins" AfterTargets="Build;Publish" DependsOnTargets="ResolveBundledPluginFiles">
    <Copy SourceFiles="@(BundledPluginFile)" DestinationFolder="$(OutDir)bundled-plugins\%(BundledPluginFile.FolderId)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BundledPluginFile)" DestinationFolder="$(PublishDir)bundled-plugins\%(BundledPluginFile.FolderId)"
          SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
