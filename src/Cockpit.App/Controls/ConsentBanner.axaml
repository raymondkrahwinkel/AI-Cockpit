<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Controls.ConsentBanner"
             x:DataType="vm:ConsentPromptViewModel">

    <!-- The one Approve/Deny consent surface (#AC-47): the literal action shown verbatim, a coloured left edge
         (amber for a dangerous action, accent for low-risk), and the operator's decision. Hosted in the pane
         chrome above the session content, so it reads on the session it belongs to. -->
    <!-- Outer wrapper carries the BoxShadow (no clip — ClipToBounds would clip the shadow away): the
         shadow gives the card lift now that it overlays the terminal (AC-47) rather than docking in the
         chrome, separating it from the text scrolling behind it. The inner card keeps ClipToBounds so the
         coloured left edge is rounded into the corners. -->
    <Panel>
    <Border CornerRadius="{StaticResource CockpitControlRadius}" BoxShadow="0 6 20 0 #66000000" IsVisible="{Binding IsPlain}">
    <Border CornerRadius="{StaticResource CockpitControlRadius}" ClipToBounds="True"
            Background="{DynamicResource CockpitPanelBgBrush}"
            BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Left edge: the risk colour, so a dangerous action is legible at a glance before a word is read. -->
            <Border DockPanel.Dock="Left" Width="3"
                    Background="{Binding EdgeBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>

            <!-- AC-1523: title and decision rows stay put, and only the action between them scrolls, so a long request can
                 no longer push Approve/Deny out of the window. The host's own height bounds the middle row. -->
            <Grid Margin="11,9,11,10" RowDefinitions="Auto,*,Auto">
                <!-- Title row: glyph + host-framed title on the left, the source on the right. -->
                <DockPanel Grid.Row="0">
                    <materialIcons:MaterialIcon DockPanel.Dock="Left" Kind="{Binding Glyph}" Width="14" Height="14" Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding EdgeBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SourceLabel}" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Ground truth: the literal action, verbatim, selectable so it can be copied and checked. -->
                <Border Grid.Row="1" Margin="0,6" Background="{DynamicResource CockpitSecondaryBgBrush}"
                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CockpitControlRadius}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding Action}" TextWrapping="Wrap" Margin="9,8"
                                             FontFamily="{StaticResource CockpitMonoFont}" FontSize="12"
                                             Foreground="{DynamicResource CockpitTextPrimaryBrush}"/>
                    </ScrollViewer>
                </Border>

                <!-- Decision row: remember (low-risk only) on the left, Deny/Approve on the right. -->
                <DockPanel Grid.Row="2">
                    <CheckBox DockPanel.Dock="Left" Content="Remember for this session"
                              IsChecked="{Binding Remember}" IsVisible="{Binding CanRemember}"
                              FontSize="11.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                        <Button Content="Deny" Classes="Compact" Command="{Binding DenyCommand}"/>
                        <Button Content="Approve" Classes="Accent Compact" Command="{Binding ApproveCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
    </Border>

    <!-- AC-1714: a card the operator answers by picking, after the browser's share card (mockup screen 4): the
         subject with its host in bold, the questions, what it never covers in red, and an approve button naming
         the act. Same broker and same answer path as the card above; only the layout differs. -->
    <Border CornerRadius="10" BoxShadow="0 10 30 0 #80000000" IsVisible="{Binding IsOverlayChoices}"
            Background="{DynamicResource CockpitPanelBgBrush}"
            BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1" Padding="20,18">
        <StackPanel Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="Lock" Width="12" Height="12" IsVisible="{Binding IsSecure}" VerticalAlignment="Center"
                                                Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap">
                        <Run Text="{Binding SubjectHost}" FontWeight="SemiBold"/><Run Text="{Binding SubjectRest}" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
                <SelectableTextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsentChoiceViewModel">
                        <StackPanel Spacing="6" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                      IsVisible="{Binding IsSingle}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConsentOptionViewModel">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding AllowMultiple}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConsentOptionViewModel">
                                        <Border Margin="0,0,0,6" Padding="11,9" BorderThickness="1" CornerRadius="8"
                                                BorderBrush="{Binding BorderKey, Converter={x:Static conv:StatusBrushConverter.Instance}}">
                                            <CheckBox IsChecked="{Binding IsPicked}" IsEnabled="{Binding Enabled}">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Label}" FontSize="13"/>
                                                        <Border IsVisible="{Binding HasNote}" CornerRadius="8" Padding="6,1" BorderThickness="1"
                                                                BorderBrush="{DynamicResource CockpitStatusWaitingBrush}" Background="{DynamicResource CockpitStatusWaitingChipTintBrush}">
                                                            <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11.5"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="3" IsVisible="{Binding HasNever}">
                <TextBlock Text="Never, not even later" FontSize="11.5" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                <TextBlock Text="{Binding Never}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CockpitStatusErrorBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Cancel" Command="{Binding DenyCommand}"/>
                <Button Content="{Binding ApproveLabel}" Classes="Accent" Command="{Binding ApproveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- AC-1715: the same card under the conversation, after mockup screen 6: the subject, what it sees and never
         covers, then the approve button, the button that lists the other options, and No. -->
    <Border CornerRadius="10" IsVisible="{Binding IsInline}" Padding="14,12"
            Background="{DynamicResource CockpitPanelBgBrush}"
            BorderBrush="{DynamicResource CockpitStatusWaitingBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <materialIcons:MaterialIcon Kind="Lock" Width="12" Height="12" IsVisible="{Binding IsSecure}" VerticalAlignment="Center"
                                            Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                <TextBlock FontSize="12" TextWrapping="Wrap">
                    <Run Text="{Binding SubjectHost}" FontWeight="SemiBold"/><Run Text="{Binding SubjectRest}" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                </TextBlock>
            </StackPanel>
            <SelectableTextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasNever}" Foreground="{DynamicResource CockpitStatusErrorBrush}">
                <Run Text="Never: "/><Run Text="{Binding Never}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ApproveLabel}" Classes="Accent" Command="{Binding ApproveCommand}"/>
                <Button Content="{Binding OtherLabel}" IsVisible="{Binding HasOther}" Command="{Binding ToggleOthersCommand}"/>
                <Button Content="No" Command="{Binding DenyCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding OtherOptions}" IsVisible="{Binding ShowOthers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsentOptionViewModel">
                        <Button Classes="Compact" Margin="0,0,6,6" Content="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:ConsentPromptViewModel)DataContext).PickCommand}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
    </Panel>
</UserControl>
