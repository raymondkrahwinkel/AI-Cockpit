<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="using:Cockpit.Core.Projects"
             x:Class="Cockpit.App.Controls.ProjectInfoList"
             x:Name="Root">

    <!-- A project's extra information wherever a project is read (AC-295): the overview's cards and the manager's
         rows. One control, because both draw the same thing and two copies of it is how the logo well drifted apart
         in three places before it became ProjectLogoBadge. -->
    <ItemsControl ItemsSource="{Binding #Root.Fields}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="projects:ProjectInfoField">
                <!-- Label above the value, not beside it: a label the operator invented can be any length, and a
                     two-column row would either clip the label or squeeze the value it introduces. -->
                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="{Binding Label}" FontSize="10"
                               Foreground="{StaticResource CockpitTextFaintBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- A web address is a button so it can be followed and shows itself on hover; anything else is
                         plain text rather than something that looks clickable and is not. The text inside trims
                         instead of the button growing — a long URL would otherwise push a card wider than its row.
                         Accent and underlined, the same treatment the markdown renderer gives an inline link, and set
                         on the TextBlock itself: Foreground does not inherit into it from the button around it, so a
                         link styled only on the button rendered in ordinary text colour and read as a label. -->
                    <Button Classes="Subtle" Padding="0" FontSize="12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            ToolTip.Tip="{Binding Value}"
                            IsVisible="{Binding IsWebLink}"
                            Click="OnOpenLink"
                            DoubleTapped="OnLinkDoubleTapped">
                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CockpitAccentBrush}"
                                   TextDecorations="Underline"/>
                    </Button>
                    <!-- Bounded at three lines with the rest trimmed away, and the whole value on hover: a card is a
                         fixed width in a wrapping panel, so an ordinary value that wraps without limit — a pasted
                         paragraph, an address — would make one card several times the height of its neighbours. The
                         value itself is stored in full; only what the card draws is cut. -->
                    <TextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Value}"
                               Foreground="{StaticResource CockpitTextSecondaryBrush}"
                               IsVisible="{Binding !IsWebLink}"/>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
