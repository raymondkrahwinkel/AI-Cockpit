<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:controls="using:Cockpit.App.Controls"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Controls.SimpleConversationHeader"
             x:DataType="vm:SessionPanelViewModel">

    <!-- AC-1529 (mockup simple-view-conversation.png): no usage pill, no Tune, no ctx-% — those are ⋯ → Details. -->
    <Border Background="{DynamicResource CockpitChromeBgBrush}" Padding="20,10"
            BorderBrush="{DynamicResource CockpitHairlineSoftBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
            <Button x:Name="SimpleStopButton" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,6"
                    IsVisible="{Binding ShowsSimpleStop}" Command="{Binding SimpleStopCommand}"
                    ToolTip.Tip="Stop what it is doing now">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="StopCircleOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Stop" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding $parent[controls:SimpleConversationHeader].ProjectName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" VerticalAlignment="Center"
                                                Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <TextBlock x:Name="SimpleHeaderProject" VerticalAlignment="Center"
                               Text="{Binding $parent[controls:SimpleConversationHeader].ProjectName}"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center"
                                                Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                </StackPanel>
                <TextBlock x:Name="SimpleHeaderTitle" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <!-- The tree's own labels (AC-1526 decision 2): the provider badge and the profile. -->
                <Border Background="{DynamicResource CockpitSecondaryBgBrush}"
                        BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                        IsVisible="{Binding ProviderBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ProviderBadge}" FontSize="9" Foreground="{DynamicResource CockpitAccentBrush}"/>
                </Border>
                <TextBlock Text="{Binding ActiveProfileLabel}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                <Border Padding="9,3" VerticalAlignment="Center" CornerRadius="{StaticResource CockpitPillRadius}"
                        BorderThickness="1" BorderBrush="{DynamicResource CockpitHairlineBrush}"
                        Background="{DynamicResource CockpitSecondaryBgBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                        <TextBlock x:Name="SimpleHeaderStand" Text="{Binding SimpleStatusLabel}" FontSize="12"
                                   VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
