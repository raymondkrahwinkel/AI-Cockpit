<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:conv="using:Cockpit.App.Converters"
             x:Class="Cockpit.App.Controls.BackgroundWorkList"
             x:DataType="vm:SessionViewModel">

    <!-- AC-531's "Running now" list, shared by the composer's Background button in Panels and the header's
         indicator in the Simple stand (AC-1526), so both open the same list. -->
    <StackPanel Spacing="0" Width="410">
        <DockPanel Margin="10,9,10,7">
            <TextBlock DockPanel.Dock="Left" Text="Running now" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundTaskSummary}" FontSize="11.5"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
        </DockPanel>

        <Border BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

        <!-- Empty state (AC-531 #3, mockup beeld 3): a provider that reports no background
             work at all lands here without error — same list, just nothing in it. -->
        <TextBlock Text="No background work." FontSize="12.5" Margin="10,16"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource CockpitTextFaintBrush}"
                   IsVisible="{Binding !HasBackgroundWorkEntries}"/>

        <StackPanel IsVisible="{Binding HasBackgroundWorkEntries}" Margin="0,4,0,0">
            <TextBlock Text="SUB-AGENTS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                       Foreground="{DynamicResource CockpitTextFaintBrush}" IsVisible="{Binding HasChildAgents}"/>
            <ScrollViewer MaxHeight="350" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChildAgents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChildAgentViewModel">
                            <Button Command="{Binding OpenCommand}" Classes="Subtle" Padding="8,6" Margin="6,1,6,3"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{DynamicResource CockpitSecondaryBgBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <Grid Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top">
                                        <Ellipse StrokeThickness="1" Stroke="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                        <Ellipse Opacity="{Binding DotFillOpacity}" Fill="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,10,0">
                                        <Border Background="{DynamicResource CockpitStatusBackgroundChipTintBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TypeText}" FontSize="10.5" Foreground="{DynamicResource CockpitStatusBackgroundBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="1">
                                        <TextBlock Text="{Binding TimeText}" FontSize="11.5" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding LastToolText, StringFormat='Last tool: {0}'}" FontSize="11" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                        <TextBlock Text="{Binding TokensText, StringFormat='· Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Open ›" FontSize="11" Margin="8,4,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="SUB-AGENTS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                       IsVisible="{Binding ShowsLegacySubAgents}"/>
            <ItemsControl ItemsSource="{Binding BackgroundSubAgents}"
                          ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                          IsVisible="{Binding ShowsLegacySubAgents}"/>

            <TextBlock Text="SHELLS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                       IsVisible="{Binding HasBackgroundShells}"/>
            <ItemsControl ItemsSource="{Binding BackgroundShells}"
                          ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                          IsVisible="{Binding HasBackgroundShells}"/>

            <!-- A task_type this build does not recognise (AC-276's Unknown): carried
                 rather than dropped, so it still shows up here instead of vanishing from
                 the count silently. -->
            <TextBlock Text="OTHER" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                       IsVisible="{Binding HasBackgroundOtherTasks}"/>
            <ItemsControl ItemsSource="{Binding BackgroundOtherTasks}"
                          ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                          IsVisible="{Binding HasBackgroundOtherTasks}"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"
                Padding="10,7" IsVisible="{Binding HasBackgroundWorkEntries}">
            <TextBlock Text="The badge counts active work. Known sub-agents remain available here after finishing." TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
