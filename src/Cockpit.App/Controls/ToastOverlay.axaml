<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Controls.ToastOverlay"
             x:DataType="vm:CockpitViewModel"
             Background="{x:Null}">

    <UserControl.Styles>
        <Style Selector="TextBlock.bundle">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <!-- The toasts (#61), stacked bottom-right. Pulled out of CockpitView so a plugin's own window can show the
         same ones: a toast raised from a dialog used to appear on the window behind it, which is to say nowhere.

         The overlay spans the whole window, so it must have no Background at all: a *transparent* background still
         hit-tests in Avalonia, and the overlay then swallowed every click in the app. Null takes no pointer, while
         the toasts themselves — which do have a background — still take theirs. -->
    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" HorizontalAlignment="Right"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToastViewModel">
                <Border Width="320" Padding="12,10" CornerRadius="{StaticResource CockpitControlRadius}"
                        Background="{DynamicResource CockpitPanelBgBrush}" BorderThickness="1"
                        BorderBrush="{Binding BrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <materialIcons:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="{Binding Glyph}" Width="14" Height="14"
                                   Foreground="{Binding BrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <!-- AC-1853: a title in bold over the message in grey; the startup bundle lists its items (screen 02). -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock IsVisible="{Binding !HasTitle}" Classes.bundle="{Binding HasLines}" TextWrapping="Wrap" FontSize="12.5">
                                <Run Text="{Binding Message}"/><Run Text="{Binding Note}" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" IsVisible="{Binding HasTitle}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToastLineViewModel">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <materialIcons:MaterialIcon Kind="{Binding Glyph}" Width="12" Height="12" Margin="0,1,6,0" VerticalAlignment="Top"
                                                       Foreground="{Binding BrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Source}" FontWeight="SemiBold"/><Run Text=" — " Foreground="{DynamicResource CockpitTextSecondaryBrush}"/><Run Text="{Binding Text}" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding MoreLabel}" IsVisible="{Binding MoreLabel, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       FontSize="12" Margin="18,0,0,0" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="2" Classes="Subtle" Padding="4,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                Command="{Binding CloseCommand}" ToolTip.Tip="Dismiss">
                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                        </Button>
                        <!-- AC-1549: every action as its own button, the first one primary (a reminder's Done). -->
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Actions}" Margin="0,8,0,0"
                                      IsVisible="{Binding HasAction}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToastActionViewModel">
                                    <Button Content="{Binding Label}" Classes="Compact" Classes.Accent="{Binding IsPrimary}"
                                            Margin="0,0,6,4" Command="{Binding InvokeCommand}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
