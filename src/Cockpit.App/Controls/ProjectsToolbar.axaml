<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Cockpit.App.Controls.ProjectsToolbar"
             x:DataType="vm:ProjectsViewModel">

    <!-- AC-1600: B2's toolbar, over the full width of the Projects workspace. Refresh stands straight after the search
         field; what it does while it runs is AC-1602's. The count beside the title gives way below 1300 px, as in the
         mockup, so the search field keeps its room. -->
    <Border Background="{DynamicResource CockpitChromeBgBrush}"
            BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,0,1"
            Padding="16,10">
        <!-- The density switch and + New project hold the right edge; the rest wraps, chips first, when the workspace
             is narrower than the row (mockup `.tools`, flex-wrap). -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Border CornerRadius="{StaticResource CockpitPillRadius}" Padding="2" VerticalAlignment="Center"
                        Background="{DynamicResource CockpitInsetBgBrush}"
                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                        ToolTip.Tip="Density — remembered for next time">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <Button Classes="Segment" Classes.on="{Binding IsComfortable}" Content="Comfortable"
                                Command="{Binding SetDensityCommand}" CommandParameter="Comfortable"/>
                        <Button Classes="Segment" Classes.on="{Binding IsCompact}" Content="Compact"
                                Command="{Binding SetDensityCommand}" CommandParameter="Compact"/>
                    </StackPanel>
                </Border>
                <Button Classes="Compact" VerticalAlignment="Center"
                        Content="+ New project" Command="{Binding AddProjectCommand}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,0,8,0">
                <TextBlock Text="Projects" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="CountText" Text="{Binding CountSummary}" FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                <TextBox Text="{Binding SearchText}" Width="280" VerticalAlignment="Center"
                         PlaceholderText="Find a project, description or organisation…"/>
                <Button VerticalAlignment="Center" Command="{Binding RefreshSharedProjectsCommand}"
                        ToolTip.Tip="Ask Depot again for every organisation">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15"
                                                    Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding CategoryChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectsCategoryChip">
                            <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Name}"
                                    Command="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).SelectCategoryCommand}"
                                    CommandParameter="{Binding Name}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </DockPanel>
    </Border>
</UserControl>
