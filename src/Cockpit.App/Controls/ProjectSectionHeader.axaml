<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Cockpit.App.Controls.ProjectSectionHeader"
             x:Name="Root"
             IsRefreshing="{Binding $parent[views:CockpitView].((vm:CockpitViewModel)DataContext).Projects.IsRefreshingSharedProjects}"
             x:DataType="vm:ProjectSectionViewModel">

    <!-- AC-1600: one source/organisation section's heading (mockup `.shd`). The left half folds the section; the right
         half is where the source says how its last read went, with Try again when it failed (AC-1602 fills the rest). -->
    <Border Background="{DynamicResource CockpitWindowBgBrush}"
            BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,0,1"
            Padding="16,14,16,8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <Button Grid.Row="0" Grid.Column="0" Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding #Root.ToggleCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="Fold or open this section">
                <WrapPanel Orientation="Horizontal">
                    <Panel Width="12" Margin="0,0,10,0" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                    IsVisible="{Binding !IsCollapsed}"
                                                    Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="12" Height="12"
                                                    IsVisible="{Binding IsCollapsed}"
                                                    Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                    </Panel>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14">
                        <Run Text="{Binding Title}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding HostLabel}" IsVisible="{Binding HasHost}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Summary}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                </WrapPanel>
            </Button>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Subtle" Padding="0" VerticalAlignment="Center" IsVisible="{Binding HasHiddenProjects}"
                        Content="{Binding HiddenLabel}" Command="{Binding #Root.UnhideCommand}"
                        CommandParameter="{Binding SharedProjectSection}"/>
                <StackPanel IsVisible="{Binding !IsThisMachine}">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding #Root.IsRefreshing}">
                        <ProgressBar Width="13" Height="13" MinWidth="0" MinHeight="0" IsIndeterminate="True"/>
                        <TextBlock Text="Loading from Depot…" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding !#Root.IsRefreshing}">
                    <TextBlock Text="{Binding UpdatedText}" IsVisible="{Binding HasUpdatedText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <Button Classes="Compact" VerticalAlignment="Center"
                            IsVisible="{Binding ShowsTryAgain}" Command="{Binding #Root.TryAgainCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13"/>
                            <TextBlock Text="Try again" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- The reason gets its own line under the title: a server's error is a sentence, and beside the title it
                 squeezed the title out. -->
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" IsVisible="{Binding HasError}"
                       FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0"
                       Foreground="{DynamicResource CockpitStatusErrorBrush}"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"
                       FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0"
                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
        </Grid>
    </Border>
</UserControl>
