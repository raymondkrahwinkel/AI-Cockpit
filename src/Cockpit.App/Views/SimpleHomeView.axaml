<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:controls="using:Cockpit.App.Controls"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Views.SimpleHomeView"
             x:DataType="vm:CockpitViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.stand">
            <Setter Property="Foreground" Value="{DynamicResource CockpitStatusBusyBrush}"/>
        </Style>
        <Style Selector="TextBlock.stand.waiting">
            <Setter Property="Foreground" Value="{DynamicResource CockpitStatusWaitingBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- AC-1528 (mockup simple-view-home-en.png); labels leave room for 35% longer translations (AC-861). -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" Margin="24,64,24,32" Spacing="0">
            <TextBlock x:Name="HomeGreeting" Text="{Binding SimpleHome.Greeting}" FontSize="27" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="What do you want to get done?" FontSize="14" Margin="0,6,0,22"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>

            <Border Padding="14,12,12,10" Background="{DynamicResource CockpitPanelBgBrush}"
                    BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CockpitPanelRadius}">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding SimpleHome.PendingAttachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageAttachmentViewModel">
                                <Border Background="{DynamicResource CockpitSecondaryBgBrush}"
                                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CockpitControlRadius}" Padding="4" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="{Binding Thumbnail}" Height="44" MaxWidth="72" Stretch="Uniform"/>
                                        <Button Command="{Binding RemoveCommand}" Classes="Subtle" VerticalAlignment="Top"
                                                Padding="4,0" ToolTip.Tip="Remove image">
                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The dictation key, not F10: F10 talks to the assistant, and this box is not the assistant. -->
                    <TextBox x:Name="HomeInput" Text="{Binding SimpleHome.InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="48" MaxHeight="160" VerticalContentAlignment="Top" Padding="0,2,0,0"
                             Background="Transparent" BorderThickness="0"
                             PlaceholderText="{Binding VoicePushToTalkKeyName, StringFormat='Ask something or describe what needs doing — or hold {0} to dictate…'}"/>
                    <DockPanel>
                        <Button x:Name="HomeSendButton" DockPanel.Dock="Right" Content="Send" Classes="Accent" Margin="8,0,0,0"
                                Padding="16,6" VerticalAlignment="Center" Command="{Binding SimpleHome.SendCommand}"/>
                        <controls:SimpleComposerBar x:Name="HomeComposerBar" Target="{Binding SimpleHome}"
                                                    ProjectLabel="{Binding SimpleHome.TargetLabel}" CanChooseProject="True"
                                                    ProjectChipClicked="_OnProjectChipClicked"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- AC-1532: secondary to Send — outlined, no accent fill. -->
            <Button x:Name="HomeEarlierConversations" Margin="0,10,0,0" HorizontalAlignment="Right" Height="34" Padding="14,0"
                    VerticalContentAlignment="Center" Command="{Binding EarlierConversations.OpenCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="History" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Earlier conversations" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel x:Name="WaitingForYou" Margin="0,22,0,0" Spacing="8" IsVisible="{Binding HasSimpleWaitingForYou}">
                <TextBlock Text="Waiting for you" FontSize="14" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SimpleWaitingForYou}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionPanelViewModel">
                            <Border Padding="14,10" CornerRadius="{StaticResource CockpitPanelRadius}" BorderThickness="1"
                                    Background="{DynamicResource CockpitStatusWaitingRowTintBrush}"
                                    BorderBrush="{DynamicResource CockpitStatusWaitingRingTintBrush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Review" Padding="14,6" VerticalAlignment="Center"
                                            CommandParameter="{Binding}"
                                            Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).GoToConsentAlertCommand}"/>
                                    <materialIcons:MaterialIcon DockPanel.Dock="Left" Kind="HandBackLeftOutline" Width="20" Height="20"
                                                                Margin="0,0,12,0" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                                                       Text="{Binding StartedAt, Converter={x:Static conv:LastOpenedConverter.Instance}, ConverterParameter=Started}"/>
                                            <TextBlock FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static conv:ProjectNameConverter.Instance}" ConverterParameter="in {0}">
                                                        <Binding Path="ProjectId"/>
                                                        <Binding Path="$parent[UserControl].((vm:CockpitViewModel)DataContext).Projects.Projects"/>
                                                        <Binding Path="WorkingDirectory"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Border Background="{DynamicResource CockpitSecondaryBgBrush}" Margin="0,0,6,0"
                                                    BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                                                    IsVisible="{Binding ProviderBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding ProviderBadge}" FontSize="9" Foreground="{DynamicResource CockpitAccentBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding ActiveProfileLabel}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <DockPanel Margin="0,26,0,10">
                <Button x:Name="HomeAllProjects" DockPanel.Dock="Right" Classes="Subtle" Padding="6,2"
                        Content="All projects →" Command="{Binding ShowSimpleProjectsCommand}"
                        Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                <TextBlock Text="Your projects" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Panel IsVisible="{Binding !Projects.HasProjects}">
                <controls:StartingPointsView DataContext="{Binding Projects}"/>
            </Panel>
            <ItemsControl x:Name="HomeProjectCards" ItemsSource="{Binding SimpleHome.ProjectCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimpleHomeProjectCard">
                        <!-- The card starts a new conversation in the project; its stand line opens the running one. -->
                        <Button Margin="0,0,12,12" Padding="14,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                CornerRadius="{StaticResource CockpitPanelRadius}" BorderThickness="1"
                                Background="{DynamicResource CockpitPanelBgBrush}" BorderBrush="{DynamicResource CockpitHairlineBrush}"
                                CommandParameter="{Binding Project}"
                                Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).StartProjectSessionCommand}"
                                ToolTip.Tip="Start a new conversation in this project">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" FontSize="12" Margin="0,10,0,0"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"
                                           Text="{Binding Project.LastOpenedAt, Converter={x:Static conv:LastOpenedConverter.Instance}}"/>
                                <Button x:Name="HomeCardStand" DockPanel.Dock="Bottom" Classes="Subtle" Padding="0" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" IsVisible="{Binding Running, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        CommandParameter="{Binding Running}"
                                        Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).SelectSimpleSessionCommand}"
                                        ToolTip.Tip="Open this conversation">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Stand, StringFormat='● {0}'}" FontSize="12" VerticalAlignment="Center"
                                                   Classes="stand" Classes.waiting="{Binding IsWaiting}"/>
                                        <Border Background="{DynamicResource CockpitSecondaryBgBrush}"
                                                BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                                                IsVisible="{Binding Running.ProviderBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                                            <TextBlock Text="{Binding Running.ProviderBadge}" FontSize="9" Foreground="{DynamicResource CockpitAccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Running.ActiveProfileLabel}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <controls:ProjectLogoBadge Size="30" LogoPath="{Binding Project.LogoPath}"
                                                                   ProjectName="{Binding Project.Name}"
                                                                   WellBackground="{DynamicResource CockpitSecondaryBgBrush}"/>
                                        <TextBlock Text="{Binding Project.Name}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Project.Description}" FontSize="12.5" TextWrapping="Wrap" MaxLines="3"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
