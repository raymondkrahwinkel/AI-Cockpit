<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:plugins="using:Cockpit.App.Plugins"
             xmlns:controls="using:Cockpit.App.Controls"
             xmlns:layout="using:Cockpit.Core.Layout"
             xmlns:projects="using:Cockpit.Core.Projects"
             xmlns:ws="using:Cockpit.Core.Workspaces"
             xmlns:widgets="using:Cockpit.Plugins.Abstractions.Widgets"
             xmlns:docking="using:Cockpit.Plugins.Abstractions.Docking"
             xmlns:sharedProjects="using:Cockpit.Core.Projects"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:avconv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Cockpit.App.Views.CockpitView"
             x:DataType="vm:CockpitViewModel"
             Background="{DynamicResource CockpitWindowBgBrush}">

    <Design.DataContext>
        <vm:CockpitViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <!-- AC-1302: a row in the Simple stand's rail. It says what the sidebar's row already says (see the
             sessionItem template further down) and nothing more: the same properties, the same Border.sessionItem
             classes, the same StatusBrushConverter. Rename, drag-reorder, the context menu and the close button
             stay out — the rail selects, it does not manage. -->
        <DataTemplate x:Key="SimpleRailSessionRow" x:DataType="vm:SessionPanelViewModel">
            <Button Classes="Subtle" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).SelectSimpleSessionCommand}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    ToolTip.Tip="{Binding SidebarCardTooltip}"
                    AutomationProperties.HelpText="{Binding SidebarCardTooltip}">
                <!-- The picked row lifts to the same filled card with the accent left edge the sidebar's active row
                     gets (Theme.axaml Border.sessionItem.active) — off this stand's own selection, not the other's. -->
                <Border Classes="sessionItem" Padding="8,6" CornerRadius="{StaticResource CockpitControlRadius}"
                        Classes.active="{Binding IsSelectedInSimpleStand}"
                        Classes.attention="{Binding SessionStatus, Converter={x:Static conv:IsNeedsAttentionConverter.Instance}}">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Kind="AlertOutline" Width="13" Height="13"
                                       Foreground="{DynamicResource CockpitStatusWaitingBrush}"
                                       IsVisible="{Binding SessionStatus, Converter={x:Static conv:IsNeedsAttentionConverter.Instance}}"
                                       ToolTip.Tip="Needs attention"/>
                            <materialIcons:MaterialIcon Kind="HandBackLeftOutline" Width="13" Height="13"
                                       Foreground="{DynamicResource CockpitAccentBrush}"
                                       IsVisible="{Binding PendingConsent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       ToolTip.Tip="Waiting for your consent"/>
                            <materialIcons:MaterialIcon Kind="ProgressClock" Width="12" Height="12"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                                       IsVisible="{Binding HasOutstandingBackgroundShells}"
                                       ToolTip.Tip="Something of this session is still running in the background"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{DynamicResource CockpitSecondaryBgBrush}"
                                    BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                                    IsVisible="{Binding ProviderBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ProviderBadge}" FontSize="9"
                                           Foreground="{DynamicResource CockpitAccentBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding ActiveProfileLabel}"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SessionStatusLabel}"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ProcessActivityLabel}"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}" FontSize="11"
                                       IsVisible="{Binding ProcessActivityLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <!-- AC-13: hidden rather than blanked when the agent has nothing to report, so the row gets
                             shorter — the same thing the sidebar does, and criterion 2(b) of this ticket. -->
                        <TextBlock x:Name="SimpleRailStatusline" Text="{Binding Statusline}" FontSize="11"
                                   Foreground="{DynamicResource CockpitAccentBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Statusline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- AC-1527: the assistant's own row — its role under the title, not its profile (annotation A5). -->
        <DataTemplate x:Key="SimpleRailAssistantRow" x:DataType="vm:SessionPanelViewModel">
            <Button Classes="Subtle" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).SelectSimpleSessionCommand}"
                    CommandParameter="{Binding}"
                    Cursor="Hand">
                <Border Classes="sessionItem" Padding="8,6" CornerRadius="{StaticResource CockpitControlRadius}"
                        Classes.active="{Binding IsSelectedInSimpleStand}"
                        Classes.attention="{Binding SessionStatus, Converter={x:Static conv:IsNeedsAttentionConverter.Instance}}">
                    <StackPanel Spacing="2">
                        <DockPanel>
                            <!-- Assistant threads: the open questions, the dock tab's count for the stand that has no
                                 dock tab. Its own click target: it opens Questions for you in this column. -->
                            <Button x:Name="SimpleAssistantQuestions" DockPanel.Dock="Right" Classes="Subtle" Padding="0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).AssistantIndicator.HasOpenQuestions, FallbackValue=False}"
                                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).OpenAssistantQuestionsCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Questions for you">
                                <Border Classes="waitingCount">
                                    <TextBlock Text="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).AssistantIndicator.OpenQuestionCount, FallbackValue=0}"/>
                                </Border>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8"
                                         Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Your steady helper" FontSize="11"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SessionStatusLabel}" FontSize="11"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- AC-1306: the sidebar tree nests these rows one level down, so the row lives here rather than
             inline in an ItemsControl the row can no longer name. Unchanged otherwise (§6): same context menu,
             same hover-✕, same inline close confirm. The commands reach the cockpit view model through
             $parent[UserControl] and not $parent[ItemsControl], which now resolves to the per-node one. -->
        <DataTemplate x:Key="SidebarSessionRow" x:DataType="vm:SessionPanelViewModel">
            <!-- Selection + attention are driven entirely by the style classes below
                 (see Theme.axaml Border.sessionItem*): the active session lifts to a
                 filled card with an accent left-edge, inactive ones stay flat against
                 the sidebar. Background/border are NOT set inline here — a local value
                 would beat the style setters and both rows would look identical. -->
            <!-- AC-1063: tooltip on the row, not the statusline TextBlock — that block is
                 IsVisible-gated on a non-empty statusline, so an empty one has no hover target.
                 Also the only way to read the hard-clipped title in full. Repeated as HelpText. -->
            <Border Classes="sessionItem" Margin="0,0,0,4" Padding="8,6" CornerRadius="{StaticResource CockpitControlRadius}"
                    Classes.active="{Binding IsSelected}"
                    Classes.attention="{Binding SessionStatus, Converter={x:Static conv:IsNeedsAttentionConverter.Instance}}"
                    Cursor="Hand"
                    ToolTip.Tip="{Binding SidebarCardTooltip}"
                    AutomationProperties.HelpText="{Binding SidebarCardTooltip}"
                    PointerPressed="OnSessionItemPointerPressed">
                <Border.ContextMenu>
                    <!-- Each item's DataContext is the session the menu was opened on; the command
                         lives on the cockpit view model, so the Click handler routes through it with
                         the session as parameter (see _InvokeSessionCommand). AC-561: this depends on
                         the row's own Border staying alive for as long as the menu is open, which is
                         what CockpitViewModel.VisibleSessions now guarantees (see its remarks) — the
                         sidebar's ItemsControl only tears down and rebuilds the containers a
                         reconcile actually touches, not every row on every change. -->
                    <ContextMenu Opened="OnSessionContextMenuOpened">
                        <MenuItem Header="Rename" Click="OnRenameSession"/>
                        <MenuItem Header="Duplicate" Click="OnDuplicateSession"/>
                        <!-- AC-564: only the SDK route, which has no /clear of its own — a TTY
                             session is a real TUI and the operator types it there. -->
                        <MenuItem Header="Clear context…" Click="OnClearSessionContext"
                                  IsVisible="{Binding SupportsClearContext}"/>
                        <Separator/>
                        <MenuItem Header="Set status…" Click="OnSetSessionStatus"/>
                        <MenuItem Header="Resume later…" Click="OnScheduleSessionResume"/>
                        <MenuItem Header="Clear status" Click="OnClearSessionStatus"
                                  IsEnabled="{Binding Statusline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Separator/>
                        <!-- AC-674/AC-703: submenu items built in code-behind on ContextMenu.Opened — a popup ContextMenu
                             can't reach CockpitViewModel via $parent, and opening a second ContextMenu from a Click inside
                             this one never showed (Avalonia closes it as part of this menu's own close). -->
                        <MenuItem Header="Move to workspace"/>
                        <Separator/>
                        <MenuItem Header="Move up" Click="OnMoveSessionUp"/>
                        <MenuItem Header="Move down" Click="OnMoveSessionDown"/>
                        <Separator/>
                        <MenuItem Header="Close" Click="OnCloseSessionMenu"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8"
                                         Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           IsVisible="{Binding !IsRenaming}"/>
                                <TextBox Text="{Binding EditTitle}" IsVisible="{Binding IsRenaming}"
                                         Classes="Compact" MinWidth="110" FontWeight="SemiBold"
                                         KeyDown="OnRenameBoxKeyDown" LostFocus="OnRenameBoxLostFocus"
                                         AttachedToVisualTree="OnRenameBoxAttached"/>
                                <materialIcons:MaterialIcon Kind="AlertOutline" Width="13" Height="13"
                                           Foreground="{DynamicResource CockpitStatusWaitingBrush}"
                                           IsVisible="{Binding SessionStatus, Converter={x:Static conv:IsNeedsAttentionConverter.Instance}}"
                                           ToolTip.Tip="Needs attention"/>
                                <!-- A consent request is waiting on this session (#AC-47): the same
                                     "Ask me first" hand the cockpit.approve step uses, in the accent
                                     colour, so the sidebar shows it even when the pane is off screen. -->
                                <materialIcons:MaterialIcon Kind="HandBackLeftOutline" Width="13" Height="13"
                                           Foreground="{DynamicResource CockpitAccentBrush}"
                                           IsVisible="{Binding PendingConsent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           ToolTip.Tip="Waiting for your consent"/>
                                <!-- AC-1311: a marker, not a fourth status class — sits next to
                                     whichever class the dot above already shows, for a session
                                     with a backgrounded shell still running under it. -->
                                <materialIcons:MaterialIcon Kind="ProgressClock" Width="12" Height="12"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"
                                           IsVisible="{Binding HasOutstandingBackgroundShells}"
                                           ToolTip.Tip="Something of this session is still running in the background"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- Mirrors the session-header provider pill (SessionView.axaml) so a local
                                     (Ollama/LM Studio) session is identifiable from the sidebar too, not just once
                                     opened; hidden for Claude-CLI sessions, which leave ProviderBadge empty (#26). -->
                                <Border Background="{DynamicResource CockpitSecondaryBgBrush}"
                                        BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                                        IsVisible="{Binding ProviderBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding ProviderBadge}" FontSize="9"
                                               Foreground="{DynamicResource CockpitAccentBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding ActiveProfileLabel}"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SessionStatusLabel}"
                                           Foreground="{DynamicResource CockpitTextSecondaryBrush}" FontSize="11"/>
                                <!-- AC-1096: what this session's processes still hold. Beside the status because that is
                                     the claim it qualifies: Idle says the agent stopped, not that its build did. -->
                                <TextBlock Text="{Binding ProcessActivityLabel}"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}" FontSize="11"
                                           IsVisible="{Binding ProcessActivityLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <!-- AC-13: what this session is working on, set by the agent (via MCP) or a workflow;
                                 accented so it stands out, hidden when blank. -->
                            <TextBlock Text="{Binding Statusline}" FontSize="11"
                                       Foreground="{DynamicResource CockpitAccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Statusline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
        
                        <!-- Hover-revealed close, hidden while the confirm prompt is up. -->
                        <Button Grid.Column="1" Classes="Subtle closeSession"
                                VerticalAlignment="Top" Padding="4,0"
                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                IsVisible="{Binding !IsConfirmingClose}"
                                Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).RequestCloseSessionCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Close session">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                        </Button>
                    </Grid>
        
                    <!-- Inline close confirm for a busy session (L11 pattern): Close / Keep. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConfirmingClose}">
                        <TextBlock Text="Close?" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                        <Button Content="Close" Classes="Compact"
                                Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).ConfirmCloseSessionCommand}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Keep" Classes="Compact"
                                Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).CancelCloseSessionCommand}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The per-session close ✕ stays invisible until its sidebar row is hovered, so the overview
             reads calm; hovering reveals the affordance. Opacity (not IsVisible) keeps the row layout
             stable, and the target is only practically clickable while hovered (thus visible). -->
        <Style Selector="Border.sessionItem Button.closeSession">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover Button.closeSession">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- The project rows' ▶ hides the same way, for the same reason (AC-164): a column of play buttons
             reads as a list of things to launch, where the sidebar's job is to show what is already running. -->
        <Style Selector="Border.sessionItem Button.startProject">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover Button.startProject">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- A workspace tab reads as a tab only once one of them is clearly the current one, so the active tab
             takes the panel background and full-strength text while the rest stay flat and faint. Same
             hover-to-reveal ✕ as the session rows, for the same reason: a row of close buttons makes the strip
             read as a list of things to get rid of. -->
        <Style Selector="Border.workspaceTab">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.workspaceTab TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CockpitTextFaintBrush}"/>
        </Style>
        <Style Selector="Border.workspaceTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource CockpitPanelBgBrush}"/>
        </Style>
        <Style Selector="Border.workspaceTab.active">
            <Setter Property="Background" Value="{DynamicResource CockpitPanelBgBrush}"/>
        </Style>
        <Style Selector="Border.workspaceTab.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CockpitTextPrimaryBrush}"/>
        </Style>
        <!-- A widget is being dragged over this tab and would land there: the same accent outline the drop ghost
             draws on the grid, because it answers the same question in the same gesture — only here the answer
             is "on that desk" rather than "on this cell".
             The class goes on the generated container (the strip's children) and the selector reaches through to
             the Border. Outline only, deliberately: the tab sets Background="Transparent" inline — it has to, or
             it would not be hit-testable — and a local value beats a style setter, so a Background here would
             silently do nothing. BorderBrush/BorderThickness carry no local value, so they land. -->
        <Style Selector="ContentPresenter.dropTarget > Border.workspaceTab">
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ContentPresenter.dropTarget > Border.workspaceTab TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CockpitTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.workspaceTab Button.closeWorkspace">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- AC-1750: the preview tab (v003), an italic title the next preview replaces until it is pinned. -->
        <Style Selector="Border.workspaceTab.preview TextBlock.workspaceTabName">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Padding" Value="0,0,2,0"/>
        </Style>
        <Style Selector="Border.workspaceTab:pointerover Button.closeWorkspace">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- AC-1306: a node in the sidebar's workspace tree. It marks the workspace the tab strip marks too — the
             same fact in a second place, so a click on either has to be visible on both. The accent left edge is
             the sidebar's own word for "this is the one" (Border.sessionItem.active uses it), and the thickness is
             always there so nothing shifts when the mark moves. Not Background: the node sets it inline to stay
             hit-testable, and a local value beats a style setter — the drop-target style above says the same. -->
        <Style Selector="Border.workspaceNode">
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.workspaceNode.active">
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitAccentBrush}"/>
        </Style>

        <!-- The figures in the status bar are a button, and have to look like one before they are hovered: a strip of
             grey text that happens to be clickable is a feature nobody finds. So it carries a chevron pointing at the
             panel it opens, lifts on hover and takes the hand cursor — enough to say "press me" without putting a
             button-shaped box in a bar that is meant to be quiet. -->
        <Style Selector="Button.statusMeter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- AC-1794: open above the bar. The default placement does not fit below a bottom bar, slides onto the
                 pointer, and the tip then flickers open and closed. -->
            <Setter Property="ToolTip.Placement" Value="Top"/>
            <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
        </Style>
        <Style Selector="Button.statusMeter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CockpitPanelBgBrush}"/>
        </Style>

        <!-- The resource panel (#78) rises out of the status bar rather than appearing: closed it is not merely
             hidden but out of the way — no opacity, no pointer — so it never eats a click at the bottom-right of a
             window it is not in. Animated on opacity and position rather than toggled on IsVisible, because a panel
             that snaps into existence reads as a glitch, and one that slides up reads as the bar opening. -->
        <Style Selector="Border.resourcePanel">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform" Value="translateY(10px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.resourcePanel.open">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransform" Value="translateY(0)"/>
        </Style>

        <!-- AC-1305: the Simple stand's consent notification, rising out of the same corner in the same way and for
             the same reason — a panel that snaps into existence reads as a glitch. Closed it takes no pointer, so it
             never eats a click in a corner it is not in. -->
        <Style Selector="ScrollViewer.consentAlerts">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform" Value="translateY(10px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer.consentAlerts.open">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransform" Value="translateY(0)"/>
        </Style>

        <!-- AC-962: the band the assistant's floating chat is dropped on to dock it. Faint while the drag is
             merely running and accent-lit once the pointer is inside — same accent language the rail's own open
             tab uses, so "this is where it lands" reads the same in both places. -->
        <Style Selector="Border.assistantDropZone">
            <Setter Property="Background" Value="{DynamicResource CockpitCategoryTintBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitHairlineBrush}"/>
        </Style>
        <Style Selector="Border.assistantDropZone.active">
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitAccentBrush}"/>
            <!-- The tint the rail tab wears is 9% accent, which reads on a 40px strip and all but vanishes over a
                 quarter of the screen. Same colour, carried far enough that a band this wide is unmistakable. -->
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource CockpitAccentColor}" Opacity="0.22"/>
            </Setter>
        </Style>

        <!-- Border.sharedProjectBadge lived here until AC-772, when the card it styles became a control the
             Manage-projects window hosts too — a local style does not cross that boundary, so it moved to
             Styles/Theme.axaml. -->
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <!-- Persistent update banner (AC-73). A newer build was too easy to miss as a startup toast: it
             auto-dismisses, and it fires before the freshly-opened window has focus. This bar stays until the
             operator opens the release or dismisses it, and returns when a build newer than the dismissed one is
             found. Docked above the whole window — over sidebar and content both — so it reads as "the application
             has an update", not "this panel does". The tint is the accent at low alpha, so it tracks the accent
             colour rather than pinning a second brown. Collapsed (not just transparent) when there is nothing to
             say, so it costs no height until a build is waiting. -->
        <!-- AC-860: update banner intentionally follows CockpitAccentSelectionBrush's alpha. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding UpdateBannerVisible}"
                Background="{DynamicResource CockpitAccentSelectionBrush}"
                BorderBrush="{DynamicResource CockpitAccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Self-updating build (AC-385, AC-388): download-and-restart lives here instead of the plain
                         "Open release" link, which stays for a copy the updater did not install. -->
                    <!-- AC-1515: what the update brings, for either kind of copy — so it is not gated on self-update. -->
                    <Button Classes="Subtle" Padding="12,5"
                            Content="What's new"
                            Command="{Binding ShowWhatsNewCommand}"
                            ToolTip.Tip="The changelog entries between the build you are on and the one on offer"/>
                    <Button Classes="Accent" Padding="12,5"
                            Content="Update now"
                            Command="{Binding UpdateNowCommand}"
                            IsVisible="{Binding ShowSelfUpdateButtons}"
                            IsEnabled="{Binding !IsUpdateDownloading}"/>
                    <Button Classes="Subtle" Padding="12,5"
                            Content="Install on next start"
                            Command="{Binding InstallUpdateOnNextStartCommand}"
                            IsVisible="{Binding ShowSelfUpdateButtons}"
                            IsEnabled="{Binding !IsUpdateDownloading}"
                            ToolTip.Tip="Downloads now and applies the next time the cockpit starts, without restarting it now"/>
                    <Button Classes="Accent" Padding="12,5"
                            Content="Open release"
                            Command="{Binding OpenUpdateCommand}"
                            IsVisible="{Binding ShowOpenReleaseButton}"
                            ToolTip.Tip="{Binding UpdateUrl}"/>
                    <Button Classes="Subtle" Padding="6,4"
                            Command="{Binding DismissUpdateCommand}"
                            ToolTip.Tip="Dismiss — reappears when a newer build is available">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ArrowUpBoldCircleOutline" Width="18" Height="18"
                                                Foreground="{DynamicResource CockpitAccentBrush}"
                                                VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                               Text="A new build is available —"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                               Text="{Binding UpdateName}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                               Text="{Binding CurrentBuild, StringFormat='· you’re on {0}'}"/>
                    <!-- Download progress (AC-388): only costs space while a download is actually in flight. -->
                    <ProgressBar VerticalAlignment="Center" Width="120" MinWidth="0" Height="6" MinHeight="0" Margin="8,0,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding UpdateDownloadProgress}"
                                 IsVisible="{Binding IsUpdateDownloading}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                               IsVisible="{Binding IsUpdateDownloading}"
                               Text="{Binding UpdateDownloadProgress, StringFormat='{}{0}%'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Awareness banner (AC-41): the API keys and tokens in cockpit.json are readable at rest. Amber, not
             red, and never modal — it states a fact and offers the one-click fix, it does not steal focus or block
             the cockpit. Docked above the whole window like the update banner, so it reads as "the application",
             not "this panel". Collapsed (not just transparent) when there is nothing to say, so it costs no height
             once encryption is on or the operator dismisses it. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding Security.ShowUnprotectedBanner}"
                Background="{DynamicResource CockpitStatusWaitingRowTintBrush}"
                BorderBrush="{DynamicResource CockpitStatusWaitingBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- While the migration runs, the action is replaced by its own inline "Encrypting…" so the
                         banner shows its work rather than going quiet mid-rewrite. -->
                    <TextBlock Text="Encrypting…" VerticalAlignment="Center"
                               IsVisible="{Binding Security.IsMigrating}"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <Button Classes="Accent" Padding="12,5" Content="Enable now"
                            IsVisible="{Binding !Security.IsMigrating}"
                            Click="OnEnableEncryption"
                            ToolTip.Tip="Encrypt your API keys and tokens with a password"/>
                    <Button Classes="Subtle" Padding="6,4"
                            Command="{Binding Security.DismissBannerCommand}"
                            ToolTip.Tip="Dismiss — returns when you add a new credential">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ShieldAlertOutline" Width="18" Height="18"
                                                Foreground="{DynamicResource CockpitStatusWaitingBrush}"
                                                VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                               Text="Your API keys and tokens are stored unencrypted."/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                               Text="Turn on encryption to protect them at rest — it only takes a moment."/>
                </StackPanel>
            </DockPanel>
        </Border>

    <Grid x:Name="RootGrid">
        <!-- One row for AI-Cockpit, one for the status bar (#78). Row 0 holds the two stands (AC-1301) and
             the overlays that belong to both of them; the status bar and the window chrome are the same in
             either stand and sit outside them. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- AC-1303: the one root both stands are drawn in, replacing AC-1301's two sibling roots. A session may
             have exactly one live view — `TtyView` owns the pty, and `OnUnloaded` disposes it *and* reports the
             pane closed — so a second root could neither copy a live pane nor be handed one. Each stand therefore
             changes the chrome around the one session grid: the left column, the tab strip, the toolbar and the
             dock rail each say which stand they belong to. §6 holds by those conditions, not by a hidden sibling.
             The code-behind that sizes the columns names this grid. -->
        <Grid x:Name="PanelsRoot" Grid.Row="0" SizeChanged="OnPanelsRootSizeChanged">
        <Grid.ColumnDefinitions>
            <!-- Width set from CockpitViewModel.SidebarWidth in code-behind (#49) — a GridLength column
                 can't compiled-bind straight to the VM's double, so CockpitView.axaml.cs applies it on
                 load/change and reads it back once the GridSplitter drag below ends (via RootGrid, since
                 x:Name on a ColumnDefinition itself doesn't generate a code-behind field). Min/Max keep
                 both the drag and a hand-edited persisted value inside a sane range. -->
            <ColumnDefinition Width="180"
                               MinWidth="{x:Static layout:LayoutSettings.MinSidebarWidth}"
                               MaxWidth="{x:Static layout:LayoutSettings.MaxSidebarWidth}"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <!-- Dock rail (AC-951): the sidebar's mirror image on the right — same "code-behind applies the
                 VM's double, GridSplitter reads it back" reasoning as column 0 above. Width starts at the
                 collapsed rail's fixed 40px; MinWidth/MaxWidth only bind the drag once expanded. -->
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="40"
                               MinWidth="{x:Static layout:LayoutSettings.MinDockRailWidth}"
                               MaxWidth="{Binding MaxDockRailWidth}"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: always visible in both grid and zoom mode — the constant overview/status anchor.
             AC-1303: except in the Simple stand, where the rail above holds this column instead. -->
        <Border Grid.Column="0" Background="{DynamicResource CockpitSecondaryBgBrush}"
                IsVisible="{Binding ShowPanelsSidebar}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8">

                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                    <!-- Collapse the sidebar out of the way; a matching » button appears over the content to bring it back. -->
                    <Button Content="«" HorizontalAlignment="Right" Padding="8,2" Classes="Subtle"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Collapse the sidebar"/>
                    <!-- SDK vs TTY is chosen inside the New-session dialog (#32) — the primary action covers both.
                         The caret adds a plain terminal (#AC-25) without pushing it into the common one-click path:
                         "new session" stays a single click, "new terminal" is one flyout down. One accent pill with
                         a hairline divider, so it reads as a single split-button rather than two loose buttons. -->
                    <!-- AC-1487: a remote window starts on its server, from the group's own start line. -->
                    <Border CornerRadius="{StaticResource CockpitControlRadius}" ClipToBounds="True"
                            Background="{DynamicResource CockpitAccentBrush}" IsVisible="{Binding !IsRemoteWindow}"
                            BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="Subtle" Padding="11,6"
                                    VerticalAlignment="Stretch" ToolTip.Tip="New session or terminal">
                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="New session" Command="{Binding NewSessionCommand}"
                                                  ToolTip.Tip="An AI session — SDK or TTY, chosen in the dialog">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ChatOutline" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New terminal" Command="{Binding NewTerminalCommand}"
                                                  ToolTip.Tip="A plain shell (your default, else the OS default) in a terminal pane">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!-- AC-967: Windows-only. Opens a separate elevated console window, not a pane. -->
                                        <MenuItem Header="New administrator terminal (separate window)" Command="{Binding NewElevatedTerminalCommand}"
                                                  IsVisible="{Binding IsWindowsPlatform}"
                                                  ToolTip.Tip="Windows UAC opens an administrator window, not a pane — Cockpit cannot show its transcript or status, list it as a session, or close it.">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ShieldAccountOutline" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Border DockPanel.Dock="Right" Width="1" Margin="0,4"
                                    Background="{DynamicResource CockpitAccentPressedBrush}"/>
                            <Button Classes="Subtle" Content="+ New session" Command="{Binding NewSessionCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,6"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- AC-543: the assistant chip, at the very bottom of the sidebar (Raymond: "linksonder").
                     Declared as the FIRST Dock="Bottom" child on purpose — a DockPanel stacks those from the
                     outer edge inward, so first-declared is the one actually against the bottom and everything
                     below in this file sits above it. It is also why it must not be the last child at all: the
                     panel fills with its last child, which ignores Dock and takes the middle. -->
                <views:AssistantIndicator DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                          IsVisible="{Binding !$parent[UserControl].((vm:CockpitViewModel)DataContext).IsRemoteWindow}"
                                          DataContext="{Binding AssistantIndicator}"/>

                <!-- AC-1301: the stand switch, as low in the column as it can go — the second Dock="Bottom"
                     child, so it sits directly above the chip rather than under it. The chip's own place at the
                     very bottom is Raymond's ("linksonder", AC-543) and this does not take it. -->
                <views:ViewModeSwitch DockPanel.Dock="Bottom" IsVisible="{Binding !IsRemoteWindow}"/>

                <!-- Footer (Plugin store, Menu, Help): its own control, placed in both stands. AC-1487: not in a
                     remote window, whose Options would be this machine's and which keeps no state here. -->
                <views:SidebarFooter DockPanel.Dock="Bottom" IsVisible="{Binding !IsRemoteWindow}"/>

                <!-- Plugin-contributed left-menu cards (#14, AC-1763), docked above the footer and below the session
                     list, where the plugins always stood. Built in code-behind from CockpitViewModel.PluginMenuGroups;
                     hidden entirely when no plugin contributes anything. -->
                <StackPanel DockPanel.Dock="Bottom" x:Name="PluginSectionsHost" Spacing="4" IsVisible="False"/>

                <!-- AC-1790: Projects scroll with the sessions, so a tall list never runs under the plugin cards docked
                     below; with room to spare it stands exactly where it did. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <!-- AC-1829: until the first project read lands, a few placeholder rows hold the place of the section. -->
                <StackPanel Spacing="8" Margin="2,2,2,12" IsVisible="{Binding IsLoadingProjects}" IsHitTestVisible="False">
                    <controls:SkeletonBlock Width="44" Height="10" HorizontalAlignment="Left" Stagger="0"/>
                    <controls:SkeletonBlock Height="16" Stagger="1"/>
                    <controls:SkeletonBlock Height="16" Width="130" HorizontalAlignment="Left" Stagger="2"/>
                    <controls:SkeletonBlock Height="16" Width="150" HorizontalAlignment="Left" Stagger="3"/>
                </StackPanel>
                <!-- Projects (AC-164): the few most recently worked on, one click from starting one. Hidden
                     entirely when there are none, so a cockpit that does not use projects looks exactly as it did.
                     ▶ starts on the project's own defaults and skips the dialog; the context menu holds the slower
                     routes for when the operator wants to change something the project would otherwise decide.
                     Deliberately the recent few and not all of them: this strip is for reaching what you are busy
                     with, and the overview is where the whole list lives. -->
                <StackPanel Spacing="2" Margin="0,0,0,10"
                            IsVisible="{Binding Projects.HasProjects}">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0,0,2">
                        <TextBlock Grid.Column="0" Text="Projects" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        <!-- The way to the overview: without it, reaching it means knowing a workspace type exists
                             and finding it in the "+" menu — which is exactly the knowledge it is built to spare. -->
                        <Button Grid.Column="1" Classes="Subtle" Padding="4,0"
                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                Command="{Binding OpenProjectsWorkspaceCommand}"
                                ToolTip.Tip="Open the projects overview">
                            <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="12" Height="12"/>
                        </Button>
                        <Button Grid.Column="2" Classes="Subtle" Padding="4,0"
                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                Command="{Binding Projects.AddProjectCommand}"
                                ToolTip.Tip="New project">
                            <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12"/>
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="ProjectListStrip" ItemsSource="{Binding Projects.SidebarProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="projects:Project">
                                <!-- Same row treatment as a session (Border.sessionItem): both are things in the
                                     sidebar you point at, and a second look for the same gesture would only say
                                     they behave differently. Background/border stay out of the markup for the
                                     reason the session rows document — a local value beats the style. -->
                                <Border Classes="sessionItem" Margin="0,0,0,2" Padding="8,5"
                                        CornerRadius="{StaticResource CockpitControlRadius}"
                                        ToolTip.Tip="{Binding Description}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Start session" Click="OnStartProjectSession"/>
                                            <MenuItem Header="New session…" Click="OnNewSessionForProject"/>
                                            <Separator/>
                                            <MenuItem Header="Open folder" Click="OnOpenProjectFolder"
                                                      IsEnabled="{Binding SourceDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <MenuItem Header="Edit project" Click="OnEditProject"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                        <controls:ProjectLogoBadge Grid.Column="0" Size="17" ShowsInitial="False"
                                                                   VerticalAlignment="Center"
                                                                   LogoPath="{Binding LogoPath}"
                                                                   ProjectName="{Binding Name}"
                                                                   IsVisible="{Binding LogoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Hover-revealed quick start, mirroring the session rows' hover ✕. -->
                                        <Button Grid.Column="2" Classes="Subtle startProject"
                                                Padding="4,0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource CockpitAccentBrush}"
                                                Command="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).StartProjectSessionCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Start a session on this project">
                                            <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="Subtle" Padding="8,2" FontSize="11" HorizontalAlignment="Left"
                            Foreground="{DynamicResource CockpitTextFaintBrush}"
                            IsVisible="{Binding Projects.HasMoreThanSidebarShows}"
                            Command="{Binding OpenProjectsWorkspaceCommand}"
                            Content="All projects →"
                            ToolTip.Tip="Open the projects overview"/>
                </StackPanel>

                    <StackPanel Spacing="2">
                        <!-- AC-1306: the session list as a workspace tree.
                             WHAT THIS TREE GROUPS: *where a session stands* — a workspace tab, and the sessions
                             placed on it. That is all it claims. AC-1302's rail in the Simple stand groups *who
                             drives what* (the assistant and the sessions it started). Two trees with the same
                             shape and a different meaning: they may never be folded into one, because half of
                             that one would be untrue.
                             It replaces a flat list that showed only the tab now on screen, so that it never
                             offered a session the grid was hiding. It shows the others now — and pays that debt
                             the other way round instead: picking one walks to its tab first (see SelectSession).
                             Drag-reorder (AC-115) sits on the per-node ItemsControl, so a drag reorders inside
                             one node and never carries a session across to another tab. -->
                        <!-- AC-1487: this laptop's desks, which a remote window does not have. -->
                        <StackPanel Spacing="2" IsVisible="{Binding !IsRemoteWindow}">
                            <!-- AC-1456: once a server group stands below, this laptop's desks get their own heading. -->
                            <Grid ColumnDefinitions="*,Auto" Margin="2,0,4,2" IsVisible="{Binding HasServerGroups}">
                                <TextBlock Text="This laptop" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Sessions.Count}" FontSize="11"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            </Grid>
                            <ItemsControl x:Name="SessionListStrip" ItemsSource="{Binding SessionWorkspaceGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionWorkspaceGroupViewModel">
                                        <StackPanel Spacing="2" Margin="0,0,0,6">
                                            <!-- Two targets in one row (§D4b): the chevron folds, the rest walks. One
                                                 target for both would cost the operator a tab switch every time they
                                                 only wanted to tidy a node away. -->
                                            <Border Classes="workspaceNode" Classes.active="{Binding IsActive}"
                                                    Padding="2,3" CornerRadius="{StaticResource CockpitControlRadius}"
                                                    Background="Transparent" Cursor="Hand"
                                                    PointerPressed="OnSessionWorkspaceNodePressed"
                                                    ToolTip.Tip="Switch to this workspace tab">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                                    <Button Grid.Column="0" Classes="Subtle" Padding="2,0"
                                                            Foreground="{DynamicResource CockpitTextFaintBrush}"
                                                            Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).Workspaces.ToggleSidebarCollapsedCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            ToolTip.Tip="Fold this workspace tab away — it does not switch to it">
                                                        <Panel>
                                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="12" Height="12"
                                                                                        IsVisible="{Binding !IsExpanded}"/>
                                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                                        IsVisible="{Binding IsExpanded}"/>
                                                        </Panel>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                                </Grid>
                                            </Border>

                                            <!-- 13 px, measured: at 21 the measure line inside a row wraps to two -->
                                            <ItemsControl ItemsSource="{Binding Sessions}" Margin="13,0,0,0"
                                                          IsVisible="{Binding IsExpanded}"
                                                          ItemTemplate="{StaticResource SidebarSessionRow}"
                                                          PointerMoved="OnSessionItemPointerMoved"
                                                          PointerReleased="OnSessionItemPointerReleased"/>

                                            <!-- Criterion 4(b): the tab you are standing on keeps its node even with
                                                 nothing on it, and says so. -->
                                            <TextBlock Margin="13,0,0,0" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                                                       Text="No session on this workspace tab yet">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="ShowEmptyNote"/>
                                                        <Binding Path="!$parent[UserControl].((vm:CockpitViewModel)DataContext).IsRestoringSessions"/>
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                            <!-- AC-1829: while the saved sessions are still coming back, a placeholder instead of that claim. -->
                                            <controls:SkeletonBlock Margin="13,2,0,0" Width="110" HorizontalAlignment="Left"
                                                                    IsVisible="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).IsRestoringSessions}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Criterion 4(a): an empty tab is left out of the tree, but never left unmentioned —
                                 the strip above the grid is where it still is. -->
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="2,2,0,0"
                                       IsVisible="{Binding HasOmittedEmptyWorkspaces}"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                                       Text="{Binding OmittedEmptyWorkspacesLabel}"/>
                        </StackPanel>

                        <!-- AC-1456 (variant A): each connect server as a group beside this laptop. Only what the
                             key may see is listed, and nothing counts what it may not. -->
                        <ItemsControl ItemsSource="{Binding ServerGroups}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerGroupViewModel">
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4" Margin="2,3">
                                            <ToggleButton Grid.Column="0" Classes="Subtle" Padding="2,0"
                                                          IsChecked="{Binding IsExpanded}"
                                                          Foreground="{DynamicResource CockpitTextFaintBrush}"
                                                          ToolTip.Tip="Fold this server away, or open it with its header above the sessions">
                                                <Panel>
                                                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="12" Height="12"
                                                                                IsVisible="{Binding !IsExpanded}"/>
                                                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                                IsVisible="{Binding IsExpanded}"/>
                                                </Panel>
                                            </ToggleButton>
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Server" Width="13" Height="13"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource CockpitAccentBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource CockpitAccentBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SidebarStatus}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="13,0,0,0" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ServerSessionRowViewModel">
                                                    <Button Classes="Subtle" Margin="0,0,0,4" Padding="8,6"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).OpenServerSessionCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Open this session; it runs on the server">
                                                        <StackPanel Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                         Fill="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="Subtle" Padding="8,2" FontSize="11" Margin="13,0,0,0"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsExpanded}"
                                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                                Content="{Binding Start.SidebarLabel}"
                                                Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).OpenServerStartCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Collapsed rail: a slim strip in the sidebar's own column (so it never overlaps the session
             content) with the expand chevron and a compact New session. Shown only while collapsed. -->
        <Border Grid.Column="0" Background="{DynamicResource CockpitSecondaryBgBrush}"
                IsVisible="{Binding SidebarCollapsed}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="4,8">
                <StackPanel DockPanel.Dock="Top" Spacing="6" HorizontalAlignment="Center">
                    <Button Content="»" Classes="Subtle" Padding="6,2"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Expand the sidebar"/>
                    <Button Content="+" Classes="Accent" Padding="7,2"
                            Command="{Binding NewSessionCommand}"
                            ToolTip.Tip="New session"/>
                </StackPanel>

                <!-- The same component, which drops to its bare badge when collapsed. It survives the rail
                     deliberately: a narrow sidebar is exactly when you still need to see that something is
                     listening, and to whom. -->
                <views:AssistantIndicator DockPanel.Dock="Bottom" HorizontalAlignment="Center"
                                          IsVisible="{Binding !$parent[UserControl].((vm:CockpitViewModel)DataContext).IsRemoteWindow}"
                                          DataContext="{Binding AssistantIndicator}"/>

                <!-- Fills the gap between the two so the chip stays at the bottom. -->
                <Panel/>
            </DockPanel>
        </Border>

        <!-- AC-1303: the same left column, carrying the Simple stand's rail where the sidebar stands in the
             other. One root with two chromes rather than two roots, because a session may have exactly one live
             view: both stands have to reach the one session grid instead of each holding a grid of its own. -->
        <Border Grid.Column="0" IsVisible="{Binding SimpleView}"
                Background="{DynamicResource CockpitSecondaryBgBrush}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8">
                <!-- AC-1527: no Plugin store, Menu or Simple|Panels switch here — everything for the advanced user
                     sits behind More options, which is Panels itself. -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                    <Border Height="1" Background="{DynamicResource CockpitHairlineBrush}" Margin="0,4,0,6"/>
                    <Button x:Name="SimpleRailSettings" Classes="Subtle" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,7"
                            Command="{Binding OptionsCommand}" ToolTip.Tip="Options — Ctrl+O">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SimpleRailHelp" Classes="Subtle" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,7"
                            ToolTip.Tip="The online guide, a glossary of terms, and re-running first-run setup">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                            <TextBlock Text="Help" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Right">
                                <views:HelpMenu/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SimpleRailMoreOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="10,8" Margin="0,4,0,0"
                            Command="{Binding ShowPanelsViewCommand}"
                            ToolTip.Tip="The sessions grid with the sidebar, the workspace strip and the dock rail">
                        <DockPanel>
                            <materialIcons:MaterialIcon DockPanel.Dock="Left" Kind="ViewGridOutline" Width="16" Height="16"
                                                        Margin="0,0,10,0" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                            <materialIcons:MaterialIcon DockPanel.Dock="Right" Kind="ArrowRight" Width="14" Height="14"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            <StackPanel Spacing="1">
                                <TextBlock Text="More options" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                <TextBlock Text="Go to Panels, for advanced use" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>

                <!-- AC-1790: the same plugin cards as the panels sidebar, above Settings and Help, so a plugin's buttons and
                     its stopwatch are there in this stand too (Raymond). Filled in code-behind with PluginSectionsHost. -->
                <StackPanel DockPanel.Dock="Bottom" x:Name="SimplePluginSectionsHost" Spacing="4" Margin="0,0,0,8"
                            IsVisible="False"/>

                <!-- AC-1304: the first of the three doors onto the start screen. It does not open the New-session
                     dialog the panels stand's own "+ New session" opens — in this stand the question comes first
                     and the settings come from whichever project answers it. -->
                <Button DockPanel.Dock="Top" x:Name="SimpleRailNewSession" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Classes="Accent" Padding="12,8" Content="+ New conversation"
                        Command="{Binding ShowSimpleStartScreenCommand}"
                        ToolTip.Tip="Pick what to work on next"/>

                <!-- AC-1527: the fixed entries, marked off `SimplePage` the way a picked row is off its selection. -->
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                    <Button x:Name="SimpleRailHome" Classes="Subtle" Padding="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Command="{Binding ShowSimpleStartScreenCommand}">
                        <Border Classes="sessionItem" Padding="10,7" CornerRadius="{StaticResource CockpitControlRadius}"
                                Classes.active="{Binding SimpleStandShowsTheStartScreen}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="HomeOutline" Width="16" Height="16"/>
                                <TextBlock Text="Home" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="SimpleRailProjects" Classes="Subtle" Padding="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Command="{Binding ShowSimpleProjectsCommand}">
                        <Border Classes="sessionItem" Padding="10,7" CornerRadius="{StaticResource CockpitControlRadius}"
                                Classes.active="{Binding SimpleStandShowsTheProjects}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Projects.Projects.Count}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="16" Height="16"/>
                                    <TextBlock Text="Projects" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- AC-1302: the tree of sessions. It groups *who drives what* — the assistant and the sessions
                     it started. AC-1305's rail groups *where something stands* (workspace -> sessions). Two trees
                     with the same shape and a different meaning: they may never become one tree, because half of
                     that one would be untrue.
                     The children come from `SessionsStartedByTheAssistant` (AC-1300) and never from
                     `LiveSessions`: a session the operator opened themselves lives too, and on the same
                     workspace, but the assistant did not start it and it does not hang under it. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">
                        <StackPanel x:Name="SimpleRailAssistantBranch" Spacing="2"
                                    IsVisible="{Binding AssistantRootSession, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="ASSISTANT" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,2"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            <ContentControl x:Name="SimpleRailAssistantRoot"
                                            Content="{Binding AssistantRootSession}"
                                            ContentTemplate="{StaticResource SimpleRailAssistantRow}"/>
                            <!-- The one level the tree has. A session that starts sessions of its own is not
                                 designed and not drawn; that is a new conversation, not a deeper rail. -->
                            <Border Margin="10,0,0,0" Padding="8,0,0,0" BorderThickness="1,0,0,0"
                                    BorderBrush="{DynamicResource CockpitHairlineBrush}">
                                <ItemsControl x:Name="SimpleRailAssistantSessions"
                                              ItemsSource="{Binding AssistantChat.SessionsStartedByTheAssistant}"
                                              ItemTemplate="{StaticResource SimpleRailSessionRow}"/>
                            </Border>
                        </StackPanel>

                        <!-- AC-1528 criterion 8: what the operator started, so it can be found again after Home. -->
                        <StackPanel x:Name="SimpleRailOwnBranch" Spacing="2" Margin="0,6,0,0">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="AssistantRootSession" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                                    <Binding Path="AssistantChat.HasSessionsStartedByYou"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <TextBlock Text="CONVERSATIONS" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,2"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            <ItemsControl x:Name="SimpleRailOwnSessions"
                                          ItemsSource="{Binding AssistantChat.SessionsStartedByYou}"
                                          ItemTemplate="{StaticResource SimpleRailSessionRow}"/>
                        </StackPanel>

                        <!-- Criterion 4(b): no assistant session, so no root to hang anything under. The rail
                             lists the sessions flat rather than drawing an "Assistant" node with nothing behind
                             it. Unfiltered by workspace on purpose: the Simple stand shows one conversation at
                             a time and offers no way to switch desks. -->
                        <StackPanel x:Name="SimpleRailFlatBranch" Spacing="2"
                                    IsVisible="{Binding AssistantRootSession, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="SESSIONS" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,2"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            <ItemsControl x:Name="SimpleRailFlatSessions"
                                          ItemsSource="{Binding Sessions}"
                                          ItemTemplate="{StaticResource SimpleRailSessionRow}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Sidebar-width splitter (#49): drags SidebarColumn between its min/max, then
             OnSidebarSplitterDragCompleted reads the settled width back and persists it. -->
        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"
                      IsVisible="{Binding ShowPanelsSidebar}"
                      DragCompleted="OnSidebarSplitterDragCompleted"/>

        <!-- Main area: empty-state welcome until a session exists (#31), then the grid/zoom. -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">

            <!-- The workspace strip sits ABOVE both the empty state and the grid, deliberately outside the
                 HasSessions gate below: a Dashboard workspace holds widgets and no sessions at all, so a strip
                 that only appeared once a session existed would be a strip you could never reach a dashboard
                 from. Hidden while there is only one workspace (ShowTabStrip) — that is the cockpit as it has
                 always looked, and a lone tab is chrome that earns nothing — but the + stays, since it is what
                 makes the second workspace that reveals the strip.
                 AC-1303: and it stands down in the Simple stand, which shows one conversation and offers no way
                 to switch desks — a strip there would be chrome you cannot act on. -->
            <!-- AC-1487: nor in a remote window, whose desks would be this machine's. -->
            <Border Grid.Row="0" Margin="12,12,12,0" Padding="0,0,0,6"
                    BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,0,1">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!SimpleView"/>
                        <Binding Path="!IsRemoteWindow"/>
                    </MultiBinding>
                </Border.IsVisible>
                <DockPanel>
                    <!-- Dock the + first so the tab list never pushes it off the edge when the strip fills up. -->
                    <Button DockPanel.Dock="Right" Classes="Subtle" Padding="8,3" Content="+"
                            ToolTip.Tip="New workspace">
                        <Button.Flyout>
                            <!-- A plain Flyout over an ItemsControl of buttons rather than a MenuFlyout with an
                                 ItemsSource: the latter's containers never materialise (the same shape and reason
                                 the widget gallery uses), which a plugin-contributed type needs. Host types and
                                 plugin types share one list and one command; the type is asked up front and is an
                                 invariant afterwards, since it decides what the workspace can hold. -->
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ItemsControl ItemsSource="{Binding Workspaces.WorkspaceMenuOptions}" MinWidth="200">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:WorkspaceMenuOption">
                                            <Button Classes="Subtle" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Padding="8,6"
                                                    Command="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).Workspaces.AddWorkspaceOptionCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding Description}">
                                                <DockPanel>
                                                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- AC-1040: the `?` for the strip itself — what a workspace is, and why its kind was asked
                         before it was made. Empty, and so invisible, until the code-behind fills it. -->
                    <StackPanel x:Name="WorkspacesHelp" DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- The quick actions (AC-772). Here rather than in the session grid's own header, which is
                         where they used to sit: that header only exists on a Sessions workspace that already has a
                         session in it, so Depot's servers were unreachable from the Projects page the operator
                         lands on. The strip itself is always on screen, so this is the one row that is. Docked
                         after the +, which puts it to the left of it and keeps the + on the edge where it was.
                         Renders nothing at all when no action is registered — a fresh install loses no height. -->
                    <controls:PluginToolbarHost DockPanel.Dock="Right" Margin="0,0,6,0"/>

                    <!-- AC-1711: the active plugin workspace's own header buttons, only while it is active. -->
                    <controls:WorkspaceHeaderActionsHost DockPanel.Dock="Right" Margin="0,0,6,0"/>

                    <!-- The drag lives on the strip, not on the tabs: a move rebuilds the tabs, so a handler on
                         the dragged Border would stop firing the moment it did its job once. -->
                    <ItemsControl x:Name="WorkspaceTabStrip" ItemsSource="{Binding Workspaces.Tabs}"
                                  IsVisible="{Binding Workspaces.ShowTabStrip}"
                                  PointerMoved="OnWorkspaceTabPointerMoved"
                                  PointerReleased="OnWorkspaceTabPointerReleased">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceTabViewModel">
                                <!-- Double-click renames in place — the same inline edit a session row uses,
                                     rather than a dialog for one short string. On a preview tab it pins it (AC-1750). -->
                                <Border Classes="workspaceTab" Classes.active="{Binding IsActive}" Classes.preview="{Binding IsPreview}"
                                        CornerRadius="6" Padding="10,4" Background="Transparent"
                                        PointerPressed="OnWorkspaceTabPressed"
                                        DoubleTapped="OnWorkspaceTabDoubleTapped">
                                    <!-- Right-click is where people look for "rename"; the double-click stays as
                                         the shortcut for those who know it, but it is not discoverable on its
                                         own (Raymond). Same menu shape as the session rows' own. -->
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename…" Click="OnRenameWorkspaceRequested" IsVisible="{Binding CanRename}"/>
                                            <MenuItem Header="Close" Click="OnCloseWorkspaceRequested"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <!-- Routed through the same handler as the menu's Close, so the close button asks
                                             before discarding a workspace too — it is the easier of the two to
                                             hit by accident. -->
                                        <Button DockPanel.Dock="Right" Classes="Subtle closeWorkspace"
                                                Padding="4,0" Margin="6,0,0,0"
                                                IsVisible="{Binding !IsRenaming}"
                                                Click="OnCloseWorkspaceRequested"
                                                ToolTip.Tip="Close workspace">
                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10"/>
                                        </Button>
                                        <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource CockpitStatusWaitingBrush}"
                                                 IsVisible="{Binding HasMarker}" ToolTip.Tip="Unsaved changes"/>
                                        <Border DockPanel.Dock="Right" Margin="7,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                                                IsVisible="{Binding IsPreview}"
                                                ToolTip.Tip="Preview: the next preview replaces it. Double-click to keep it open.">
                                            <TextBlock Text="preview" FontSize="10.5" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                        </Border>
                                        <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Classes="workspaceTabName" Text="{Binding Name}" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsRenaming}"/>
                                        <!-- Sized and aligned to sit in the tab rather than on top of it: a
                                             default TextBox brings its own padding and min-height, which made
                                             the tab jump and the box hang out of it. Attached, it takes focus
                                             and selects everything, so the first keystroke replaces the name —
                                             which is what you came to do. -->
                                        <TextBox Text="{Binding EditName}" IsVisible="{Binding IsRenaming}"
                                                 MinWidth="90" MinHeight="0" Height="19" Padding="4,0"
                                                 FontSize="12" VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 AttachedToVisualTree="OnWorkspaceRenameAttached"
                                                 KeyDown="OnWorkspaceRenameKeyDown" LostFocus="OnWorkspaceRenameLostFocus"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- AC-1793: the Panels stand's workspace bodies, one switch for all of them. Simple has no workspace tabs,
                 so a tab left open here would draw under its pages; hidden, not rebuilt, it comes back as it was left. -->
            <Panel Grid.Row="1" IsVisible="{Binding !SimpleView}">
                <!-- Dashboard: the widget grid, shown instead of the session content when a Dashboard workspace is
                     active. Its own empty state says "add a widget", never "no sessions yet" — the workspace type
                     drives the affordance, so a dashboard never asks for something it cannot hold. -->
                <DockPanel IsVisible="{Binding Workspaces.IsDashboardActive}">

                    <!-- The dashboard's own toolbar. "Add widget" used to live only in the centred empty state,
                         which put it underneath the widgets the moment there were any — it needs a home that does
                         not move, and the dashboard's other controls belong beside it rather than scattered. -->
                    <DockPanel DockPanel.Dock="Top" Margin="12,12,12,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <!-- Disabled, not hidden, while no plugin contributes a widget: the button is the answer
                                 to "how do I fill this dashboard", so it has to stay visible and say why it cannot. -->
                            <Button Content="+ Add widget" Classes="Accent" Padding="10,4"
                                    IsEnabled="{Binding Workspaces.HasAvailableWidgets}"
                                    ToolTip.Tip="Widgets come from plugins — install one that contributes widgets first">
                            <!-- A plain Flyout over an ItemsControl of buttons rather than a MenuFlyout with an
                                 ItemsSource: the latter's containers never materialised here, leaving an enabled
                                 button that opened an empty popup. This shape is the gallery — icon, title and the
                                 one-liner the widget describes itself with. -->
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ItemsControl ItemsSource="{Binding Workspaces.AvailableWidgets}" MinWidth="220">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="widgets:WidgetRegistration">
                                                <Button Classes="Subtle" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="8,6"
                                                        Command="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).Workspaces.PlaceWidgetCommand}"
                                                        CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <Panel Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                                                        IsVisible="{Binding IconKind, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"/>
                                                            <TextBlock Text="{Binding Icon}"
                                                                       IsVisible="{Binding IconKind, Converter={x:Static avconv:ObjectConverters.IsNull}}"/>
                                                        </Panel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7"
                                                                       TextWrapping="Wrap" MaxWidth="180"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                            </Button>

                            <!-- The dashboard's grid shape. Its own settings, not the app's — each dashboard is laid
                                 out on its own, and this is where §4g's Columns/Rows live. -->
                            <Button Classes="Subtle" Padding="7,4" ToolTip.Tip="Dashboard settings">
                                <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="10" MinWidth="200" Margin="4">
                                            <TextBlock Text="Dashboard grid" FontWeight="SemiBold"/>
                                            <DockPanel>
                                                <NumericUpDown DockPanel.Dock="Right" Width="104" Increment="1" FormatString="0"
                                                               Minimum="1" Maximum="256"
                                                               Value="{Binding Workspaces.DashboardColumnsSetting}"/>
                                                <TextBlock Text="Columns" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <!-- The bounds match DashboardLayout's Min/Max constants; the record
                                                     clamps anyway, so a drifted literal here cannot reach the grid. -->
                                                <NumericUpDown DockPanel.Dock="Right" Width="104" Increment="1" FormatString="0"
                                                               Minimum="1" Maximum="256"
                                                               Value="{Binding Workspaces.DashboardRowsSetting}"/>
                                                <TextBlock Text="Rows" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="Rows are a starting height — the dashboard grows past it as you add widgets."
                                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" MaxWidth="190"/>
                                            <CheckBox Content="Show grid lines" IsChecked="{Binding Workspaces.DashboardShowGridLines}"
                                                      ToolTip.Tip="Draw the cells widgets snap to — handy while arranging"/>

                                            <!-- Export/import live with the dashboard's other controls rather than in
                                                 the toolbar: they are things you do once, not affordances the
                                                 arranging needs in front of it. -->
                                            <Border BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
                                            <Button Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="6,4" Content="Export this dashboard…" Click="OnExportDashboardPressed"
                                                    ToolTip.Tip="Save it to a file — to keep, or to hand to someone. Credentials are left out."/>
                                            <Button Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="6,4" Content="Import a dashboard…" Click="OnImportDashboardPressed"
                                                    ToolTip.Tip="Add a dashboard from a file, alongside the ones you have"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding Workspaces.Active.Name}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- The grid, its drag ghost and the empty state share one cell. A Panel rather than more
                         DockPanel children: only a DockPanel's last child fills, so the grid would be docked to the
                         left the moment anything followed it. -->
                    <Panel>

                    <!-- The cells, under everything and never in the way of a pointer. Same margin as the grid it
                         traces, so the lines land on the boundaries the widgets actually snap to. -->
                    <controls:DashboardGridLines Margin="12" IsHitTestVisible="False"
                                                 IsVisible="{Binding Workspaces.DashboardShowGridLines}"
                                                 Columns="{Binding Workspaces.DashboardColumns}"
                                                 Rows="{Binding Workspaces.DashboardRows}"
                                                 LineBrush="{DynamicResource CockpitHairlineBrush}"/>

                    <!-- Column/row counts come from the view model, not the XAML: the row count grows past the
                         configured height as widgets are added (rows are a starting height, not a cap). The panel
                         builds its definitions from them itself — the view cannot, because it has to find the panel
                         to do it and the panel does not exist until a layout pass creates it. -->
                    <!-- The drop lives on the grid, not the panes: an arrangement rebuilds nothing, but the pointer
                         has to be tracked across cells the dragged pane does not occupy. -->
                    <ItemsControl x:Name="DashboardGrid" Margin="12"
                                  ItemsSource="{Binding Workspaces.WidgetPanes}"
                                  IsVisible="{Binding !Workspaces.ShowDashboardEmptyState}"
                                  PointerMoved="OnDashboardPointerMoved"
                                  PointerReleased="OnDashboardPointerReleased">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:DashboardCellsPanel Columns="{Binding Workspaces.DashboardColumns}"
                                                              Rows="{Binding Workspaces.DashboardRows}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter" x:DataType="vm:WidgetPaneViewModel">
                                <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:WidgetPaneViewModel">
                                <Border Margin="4" CornerRadius="8" Background="{DynamicResource CockpitPanelBgBrush}"
                                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <!-- Pane chrome. The gear is bound to HasConfig: a widget that declared no
                                             settings form shows no gear at all, rather than one that opens nothing. -->
                                        <!-- The header is the drag handle: dragging the widget's own body would fight
                                             whatever the plugin's control does with a pointer, and a header is where
                                             a pane is grabbed everywhere else in the cockpit. -->
                                        <DockPanel DockPanel.Dock="Top" Margin="8,6,6,6" Background="Transparent"
                                                   Cursor="Hand" PointerPressed="OnWidgetHeaderPressed">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                                                <Button Classes="Subtle" Padding="5,0" Click="OnWidgetRefreshPressed"
                                                        ToolTip.Tip="Refresh">
                                                    <materialIcons:MaterialIcon Kind="Refresh" Width="12" Height="12"/>
                                                </Button>
                                                <Button Classes="Subtle" Padding="5,0" Click="OnWidgetConfigPressed"
                                                        IsVisible="{Binding HasConfig}" ToolTip.Tip="Widget settings">
                                                    <materialIcons:MaterialIcon Kind="Cog" Width="12" Height="12"/>
                                                </Button>
                                                <Button Classes="Subtle" Padding="5,0" Click="OnWidgetRemovePressed"
                                                        ToolTip.Tip="Remove widget">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                            <Panel Margin="0,0,6,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14"
                                                                            IsVisible="{Binding IconKind, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"/>
                                                <TextBlock Text="{Binding Icon}"
                                                           IsVisible="{Binding IconKind, Converter={x:Static avconv:ObjectConverters.IsNull}}"/>
                                            </Panel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <!-- The plugin's own control, built once per instance and hosted as-is. The
                                             resize grip sits over its bottom-right corner: a widget is sized by
                                             dragging the corner, and the grip has to be reachable whatever the
                                             plugin drew underneath it. -->
                                        <Panel>
                                            <ContentControl Margin="8,0,8,8" Content="{Binding View}"/>
                                            <Border Width="14" Height="14" Margin="0,0,2,2" Background="Transparent"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Cursor="BottomRightCorner" PointerPressed="OnWidgetResizePressed"
                                                    ToolTip.Tip="Drag to resize">
                                                <Path Data="M 10,0 L 10,10 L 0,10" Stroke="{DynamicResource CockpitTextFaintBrush}"
                                                      StrokeThickness="1.5" Margin="2"/>
                                            </Border>
                                        </Panel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Where the dragged or resized widget will land. Shown during the gesture and applied on
                         release: without it you are dragging blind, and applying on every pointer move rewrote
                         cockpit.json on every pixel. Its rectangle is set in code — it is measured in the grid's
                         cells, which nothing here can bind to. -->
                    <Border x:Name="WidgetDropGhost" IsVisible="False" IsHitTestVisible="False" ZIndex="100"
                            Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                            CornerRadius="8" BorderThickness="2"
                            BorderBrush="{DynamicResource CockpitAccentBrush}"
                            Background="{DynamicResource CockpitPanelBgBrush}" Opacity="0.55"/>

                    <!-- The dashboard's empty state carries no button of its own: the toolbar's "Add widget" is
                         always there, and two buttons doing one thing is how the old one ended up buried under the
                         widgets it created. -->
                    <StackPanel IsVisible="{Binding Workspaces.ShowDashboardEmptyState}" MaxWidth="320"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="14"
                                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="24" Height="24"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No widgets yet" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Use “+ Add widget” above to fill this dashboard. Widgets come from plugins — install more from the store."
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    </StackPanel>
                    </Panel>
                </DockPanel>

                <!-- The B2 Projects host owns the responsive list/detail navigation. -->
                <DockPanel IsVisible="{Binding Workspaces.IsProjectsActive}">
                    <controls:ProjectsToolbar DockPanel.Dock="Top" DataContext="{Binding Projects}"/>
                    <controls:ProjectsWorkspace DataContext="{Binding Projects}"/>
                </DockPanel>

                <!-- AC-1829: the saved sessions are still coming back — placeholder cards in the shape of the grid, so
                     the area is neither empty ("No sessions yet" would be a lie) nor jumps when the real ones land. -->
                <UniformGrid Columns="2" Rows="2" Margin="12" IsVisible="{Binding ShowSessionsSkeleton}" IsHitTestVisible="False">
                    <Border Margin="6" Padding="12"
                            Background="{DynamicResource CockpitPanelBgBrush}" BorderBrush="{DynamicResource CockpitHairlineBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CockpitPanelRadius}">
                        <StackPanel Spacing="10">
                            <controls:SkeletonBlock Height="30" Stagger="0"/>
                            <controls:SkeletonBlock Width="240" HorizontalAlignment="Left" Stagger="1"/>
                            <controls:SkeletonBlock Width="330" HorizontalAlignment="Left" Stagger="2"/>
                            <controls:SkeletonBlock Width="180" HorizontalAlignment="Left" Stagger="3"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="6" Padding="12"
                            Background="{DynamicResource CockpitPanelBgBrush}" BorderBrush="{DynamicResource CockpitHairlineBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CockpitPanelRadius}">
                        <StackPanel Spacing="10">
                            <controls:SkeletonBlock Height="30" Stagger="1"/>
                            <controls:SkeletonBlock Width="240" HorizontalAlignment="Left" Stagger="2"/>
                            <controls:SkeletonBlock Width="330" HorizontalAlignment="Left" Stagger="3"/>
                            <controls:SkeletonBlock Width="180" HorizontalAlignment="Left" Stagger="4"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Empty state: no session opens on startup; one only exists once the operator creates it. Gated on
                     a Sessions workspace being active, so a dashboard never shows it. -->
                <StackPanel MaxWidth="320" IsVisible="{Binding ShowSessionEmptyState}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- The mark, where a tile with the letters "AI" in it used to stand in for one (AC-430). Only
                         the height is set: the mark is wider than it is tall and squaring it off would deform it. -->
                    <Image Source="/Assets/BrandMark.png" Height="56" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="No sessions yet" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Start a session to begin. You pick the profile — and with it the provider — and its defaults up front."
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}" Margin="0,0,0,16"/>
                    <Button Content="+ New session" Command="{Binding NewSessionCommand}"
                            Classes="Accent" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Plugin workspace: the plugin owns the whole body (AC-122). Shown instead of the session/widget
                     grids when a plugin-registered type is active. An unknown type — its plugin is not installed —
                     shows a placeholder rather than an empty surface, and the body appears the moment the plugin
                     registers. -->
                <ContentControl Content="{Binding Workspaces.ActivePluginBody}"
                                IsVisible="{Binding Workspaces.ActivePluginBody, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"/>
                <Border IsVisible="{Binding Workspaces.ShowUnknownPluginWorkspace}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="8" MaxWidth="360">
                        <materialIcons:MaterialIcon Kind="PuzzleOutline" Width="28" Height="28"
                                                    HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="This workspace's plugin is not installed."
                                   HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="Install or enable the plugin that provides it, and this workspace comes back."
                                   HorizontalAlignment="Center" TextAlignment="Center" FontSize="12"
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Session grid + zoom, shown once at least one session exists and a Sessions workspace is active. -->
            <DockPanel Grid.Row="1" Margin="12" IsVisible="{Binding ShowSessionGrid}">
                <!-- This workspace's toolbar. The ⚙ lives here rather than inside the Zoom row because that row
                     hides itself in single-session layout (#24) — and that is exactly the layout you would open
                     the ⚙ to get back out of.
                     AC-1303: gone in the Simple stand, where every control on it (zoom, the layout ⚙) speaks
                     about a grid of panes that stand shows exactly one of. -->
                <!-- AC-1303 criterion 4(a): the way back, in the strip above the agent's pane — the slot the
                     panels stand's toolbar has. Shown only while the assistant is actually in the dock, so with
                     no assistant there is no button pointing nowhere (4(b)). It picks the assistant's own row,
                     which is the other way back, so both land in one state rather than two that resemble it. -->
                <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8"
                        Classes="Subtle Compact" Content="← Assistant"
                        IsVisible="{Binding SimpleStandDocksTheAssistant}"
                        Command="{Binding SelectSimpleSessionCommand}"
                        CommandParameter="{Binding AssistantRootSession}"
                        ToolTip.Tip="Put the assistant back in this column"/>

                <!-- AC-1456: an open server group's header line, the assistant line and, when asked for, the start
                     card. Health opens the server's health tab, with "scheduled · Discord" beside the name (AC-1457);
                     Admin opens Options on the server for an admin key (AC-1446), and an operate key sees it locked. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding OpenServerGroups}" IsVisible="{Binding !SimpleView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerGroupViewModel">
                            <StackPanel Spacing="8" Margin="0,0,0,8">
                                <Border Padding="14,10" Background="{DynamicResource CockpitPanelBgBrush}"
                                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CockpitControlRadius}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Classes="Subtle Compact" IsVisible="{Binding IsConnected}"
                                                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).ToggleServerHealthCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="The server's sign-ins, scheduled runs and facts">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Health"/>
                                                    <Border CornerRadius="9" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding Health.HasBadge}"
                                                            Background="{DynamicResource CockpitStatusErrorChipTintBrush}">
                                                        <TextBlock Text="{Binding Health.BadgeText}" FontSize="11"
                                                                   Foreground="{DynamicResource CockpitStatusErrorBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <Border Classes="tag" IsVisible="{Binding IsOperateKey}" VerticalAlignment="Center"
                                                    ToolTip.Tip="Admin needs an admin key; this key may operate only">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Admin" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                                    <materialIcons:MaterialIcon Kind="Lock" Width="11" Height="11"
                                                                                Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Classes="Subtle Compact" Content="Admin" IsVisible="{Binding IsAdminKey}"
                                                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).OpenServerAdminCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Options on this server: its connect keys and audit log"/>
                                            <Button Classes="Subtle Compact" Content="Disconnect"
                                                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).DisconnectServerCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Close the connection for this run; what runs on the server keeps running"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <Border CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                                                    Background="{DynamicResource CockpitStatusDoneChipTintBrush}" IsVisible="{Binding IsConnected}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource CockpitStatusDoneBrush}"/>
                                            </Border>
                                            <Border CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                                                    Background="{DynamicResource CockpitStatusWaitingChipTintBrush}" IsVisible="{Binding !IsConnected}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding HeaderDetail}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Health.Summary}" FontSize="12" VerticalAlignment="Center"
                                                       IsVisible="{Binding Health.HasSummary}"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <StackPanel IsVisible="{Binding Health.IsOpen}">
                                    <controls:ServerHealthView DataContext="{Binding Health}"/>
                                </StackPanel>

                                <Border Padding="14,10" Background="{DynamicResource CockpitPanelBgBrush}" IsVisible="{Binding HasAssistantLine}"
                                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CockpitControlRadius}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Classes="tag" VerticalAlignment="Center" IsVisible="{Binding HoldsAssistant}"
                                                Background="{DynamicResource CockpitCategoryTintBlueBrush}">
                                            <TextBlock Text="holds the assistant" Foreground="{DynamicResource CockpitAccentBrush}"/>
                                        </Border>
                                        <Ellipse DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource CockpitAccentBrush}" Opacity="0.85"/>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AssistantTitle}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding AssistantDetail}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Padding="16,14" Background="{DynamicResource CockpitPanelBgBrush}" IsVisible="{Binding Start.IsOpen}"
                                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1" MaxWidth="560"
                                        HorizontalAlignment="Left" CornerRadius="{StaticResource CockpitControlRadius}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Start.Heading}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Runs on the server. Only SDK sessions; profiles and projects are the server's own. No project uses the server's scratch directory."
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Project" FontSize="11.5" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding Start.Projects}" SelectedItem="{Binding Start.SelectedProject}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NodeProjectChoice">
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{Binding Start.ProjectHint}" FontSize="11"
                                                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Profile" FontSize="11.5" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding Start.Profiles}" SelectedItem="{Binding Start.SelectedProfile}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NodeProfileChoice">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{Binding Start.ProfileHint}" FontSize="11"
                                                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Prompt" FontSize="11.5" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            <TextBox Text="{Binding Start.Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Start.Error}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource CockpitStatusErrorBrush}"
                                                   IsVisible="{Binding Start.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                         <StackPanel Spacing="4" IsVisible="{Binding Start.Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                             <TextBox Text="{Binding Start.Reason}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                                      FontSize="11.5"/>
                                             <Button Classes="Subtle Compact" HorizontalAlignment="Left" Click="_OnCopyServerStartReason"
                                                     Tag="{Binding Start.Reason}" ToolTip.Tip="Copy the node's reason">
                                                 <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13"/>
                                             </Button>
                                         </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Classes="Subtle" Content="Cancel"
                                                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).CancelServerStartCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="Accent" Content="{Binding Start.StartLabel}" IsEnabled="{Binding !Start.IsBusy}"
                                                    Command="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).StartOnServerCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="{Binding !SimpleView}">
                    <!-- The transient Zoom toggle is hidden in the persistent single-session layout (#24),
                         where it would be a no-op (the single pane is always shown) — no dead control. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowZoomButton}">
                        <ToggleButton Content="Zoom" IsChecked="{Binding IsZoomed}"
                                      IsEnabled="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      ToolTip.Tip="Zoom in on the selected session / back to the grid"/>
                    </StackPanel>

                    <!-- Mirrors the dashboard's gear (its columns/rows/grid lines): each workspace type sets what it
                         actually has, in the same place. -->
                    <!-- The quick actions used to sit here, left of the gear; they moved to the workspace tab strip
                         (AC-772) so they are reachable from every workspace type, not only from a Sessions
                         workspace with a session in it. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button x:Name="WorkspaceLayoutButton" Padding="8,4"
                                ToolTip.Tip="How this workspace arranges its sessions">
                        <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" MinWidth="300" Margin="4">
                                    <TextBlock Text="Layout" FontWeight="SemiBold"/>
                                    <CheckBox Content="Use the default layout (Options)"
                                              IsChecked="{Binding WorkspaceFollowsGlobalLayout}"/>
                                    <TextBlock Text="Off: this workspace arranges itself, and Options no longer moves it."
                                               Foreground="{DynamicResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    <!-- Disabled rather than hidden while following: they show what this desk is
                                         doing, which is the thing you came here to read before changing it. -->
                                    <CheckBox Content="Show one session at a time (no grid)"
                                              IsChecked="{Binding WorkspaceSingleSessionLayout}"
                                              IsEnabled="{Binding !WorkspaceFollowsGlobalLayout}"/>
                                    <CheckBox Content="Stack sessions vertically (one column)"
                                              IsChecked="{Binding WorkspaceStackSessionsVertically}"
                                              IsEnabled="{Binding !WorkspaceFollowsGlobalLayout}"/>
                                    <CheckBox Content="Focus + rail (one session large, the rest as a mini-rail)"
                                              IsChecked="{Binding WorkspaceFocusRailLayout}"
                                              IsEnabled="{Binding !WorkspaceFollowsGlobalLayout}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- One live session grid serves both layouts: grid mode shows every panel; single-pane
                     mode (#24 / Zoom) collapses all but the selected one to a single column so it fills
                     the width. Keeping one set of views means a session's view (and its TTY pty) is built
                     once and merely hidden when deselected — not rebuilt by a separate single-pane control
                     on every switch, which stranded a relaunched TTY on "Launching TUI...". -->
                <!-- The session grid plus, on top, a hit-transparent accent outline that marks the cell a
                     dragged pane will drop into (#54 follow-up). Both share the same Grid cell so the
                     code-behind can place the outline in the grid's coordinate space. -->
                <Grid>
                <ItemsControl x:Name="SessionGrid" ItemsSource="{Binding GridPanes}">
                    <!-- The panel measures its direct children (the generated item containers), so pane
                         visibility must gate the CONTAINER, not a Border inside the template — otherwise a
                         collapsed panel still claims a tile. -->
                    <!-- Scoped to this grid's own containers on purpose: a bare "ContentPresenter" selector
                         matches every presenter BELOW this control too — every ContentControl's
                         #PART_ContentPresenter inside every session view, whose DataContext is a transcript
                         entry, not a pane. Each one then re-evaluates IsPaneVisible against
                         TranscriptEntryViewModel, fails, and logs; a streaming SDK session did that thousands
                         of times a second, which is what ran the app out of memory.
                         "> " is the LOGICAL parent, and a generated container's logical parent is the
                         ItemsControl itself — not the SessionTilePanel it is measured in, which is only its
                         visual parent. Naming the grid keeps it off the nested ItemsControls inside a pane. -->
                    <ItemsControl.Styles>
                        <Style Selector="ItemsControl#SessionGrid > ContentPresenter">
                            <Setter Property="IsVisible" Value="{ReflectionBinding IsPaneVisible}"/>
                            <!-- Focus+rail (AC-441/444): which pane is the focus candidate and where each
                                 sorts in the rail, pushed onto the container as plain properties so
                                 `SessionTilePanel` can arrange without knowing what a `SessionPanelViewModel`
                                 is — the same reason `IsPaneVisible` above is a Setter and not a binding
                                 inside the pane template. -->
                            <Setter Property="controls:SessionTilePanel.IsFocusCandidate" Value="{ReflectionBinding IsSelected}"/>
                            <Setter Property="controls:SessionTilePanel.RailSortKey" Value="{ReflectionBinding RailSortKey}"/>
                            <!-- AC-696: which panes the grid sizes itself from. A container exists here for every
                                 session alive, the other desks' included — counting those laid a two-pane tab out
                                 as a 2x2. Distinct from IsPaneVisible, which zoom clears for this desk's own too. -->
                            <Setter Property="controls:SessionTilePanel.IsOnActiveDesk" Value="{ReflectionBinding IsOnActiveDesk}"/>
                        </Style>
                        <!-- AC-670: a tile is a miniature of the terminal, so everything you operate the session
                             with goes and everything that says what it is doing stays.
                             These key off the pane element's OWN inherited SessionTilePanel.IsMiniature (a self
                             selector), NOT a descendant selector rooted on the long-lived SessionGrid. A descendant
                             selector (`SessionGrid > CP[IsMiniature] :is(Control).paneChrome`) registers an
                             IClassesChangedListener that pins every recycled transcript row of a streaming pane
                             (measured ~600 leaked rows / 360MB; the row leaves the tree but the listener holds it
                             until teardown). IsMiniature is an inherited attached property, so the self form reaches
                             the same elements with the same effect and no long-lived listener. -->
                        <Style Selector=":is(Control).paneChrome[(controls|SessionTilePanel.IsMiniature)=True]">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <!-- AC-670 #7: hit-testing off on the host lets the press fall through to `PaneRoot`. -->
                        <Style Selector="controls|MiniatureHost[(controls|SessionTilePanel.IsMiniature)=True]">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Style>
                        <!-- AC-670: chrome that may not be collapsed, only blanked — anything that gives up space
                             inside the scaled subtree hands it to the terminal and resizes the pty. -->
                        <Style Selector=":is(Control).paneChromeBlank[(controls|SessionTilePanel.IsMiniature)=True]">
                            <Setter Property="Opacity" Value="0"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:SessionTilePanel
                                StackVertically="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).StackSessionsVertically}"
                                FocusRailLayout="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).ShowFocusRail}"
                                RailWeight="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).FocusRailWeight}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionPanelViewModel">
                            <!-- The active panel carries the accent edge (Theme "panel.active") so the
                                 session you're driving jumps out of the grid; others keep the hairline.
                                 Outside the MiniatureHost on purpose (AC-444 #3): a border scaled down with
                                 the content it wraps would thin from 1.5px to a fraction of a device pixel in
                                 the rail and wash out, exactly what "niet mee weggeschaald tot onzichtbaar"
                                 forbids. Drawn at its own full thickness regardless of what scale the content
                                 inside draws at. -->
                            <!-- PaneRoot is a Grid, NOT a Border: a Border that parents the transcript's
                                 VirtualizingStackPanel pins every recycled row through the border's
                                 CompositionBorderVisual — rows leave the visual tree but the border's composition
                                 visual holds their draw-lists until the pane tears down (measured ~660 leaked rows /
                                 360MB per streaming pane; a Grid/Panel/Decorator parent releases them normally). The
                                 accent edge is drawn by a sibling Border overlay at the end of this Grid instead.
                                 A Grid also overlays the identity strip rather than docking it (AC-670): 16px docked
                                 above the host is 16/scale (~53px) less pane, which resizes a TTY pane's pty.
                                 Transparent so a miniature press falls through to it (AC-670 #7). -->
                            <Grid x:Name="PaneRoot" Margin="4" Background="Transparent">
                                <!-- Permanently here at scale 1, not wrapped around a pane on its way into the
                                     rail (AC-442): switching is then one number and never the rebuild the grid
                                     comment above describes. Draws the pane small without laying it out small.
                                     `SessionTilePanel` drives the scale directly in rail mode (AC-444) via the
                                     attached property it wrote onto `PaneRoot` (`Children[i]`, the container it
                                     already holds) — read by element name here rather than round-tripped
                                     through a bindable view-model property, one fewer moving part. -->
                                <controls:MiniatureHost
                                        TileSize="{Binding #PaneRoot.(controls:SessionTilePanel.MiniatureTileSize)}"
                                        FocusSize="{Binding #PaneRoot.(controls:SessionTilePanel.MiniatureFocusSize)}"
                                        FocusChildBox="{Binding #PaneRoot.(controls:SessionTilePanel.MiniatureFocusChildBox)}">
                                <DockPanel>
                                    <!-- Drag-reorder grip (#54 follow-up): a grab bar above each pane, shown only when
                                         the draggable multi-pane grid is on. Dragging it picks the pane up and drops it
                                         into any cell; the gutters between panes are separately draggable to resize
                                         (handled by SessionTilePanel). Collapsed in single/zoom = no dead control. -->
                                    <Border x:Name="PaneDragHandle" DockPanel.Dock="Top" Height="14" Margin="0,0,0,2"
                                            Background="{DynamicResource CockpitSecondaryBgBrush}"
                                            CornerRadius="{StaticResource CockpitControlRadius}"
                                            Cursor="SizeAll" ToolTip.Tip="Drag to move this pane"
                                            IsVisible="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).StackSessionsInStack}"
                                            PointerPressed="OnPaneDragHandlePressed"
                                            PointerMoved="OnPaneDragHandleMoved"
                                            PointerReleased="OnPaneDragHandleReleased">
                                        <TextBlock Text="⣿⣿⣿" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                    </Border>
                                    <!-- AC-1529: the Simple stand's header, here so both routes get it (AC-294). -->
                                    <controls:SimpleConversationHeader DockPanel.Dock="Top" IsVisible="{Binding IsShownInSimpleStand}"
                                        EarlierCommand="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).EarlierConversations.OpenCommand}">
                                        <controls:SimpleConversationHeader.ProjectName>
                                            <MultiBinding Converter="{x:Static conv:ProjectNameConverter.Instance}">
                                                <Binding Path="ProjectId"/>
                                                <Binding Path="$parent[ItemsControl].((vm:CockpitViewModel)DataContext).Projects.Projects"/>
                                            </MultiBinding>
                                        </controls:SimpleConversationHeader.ProjectName>
                                    </controls:SimpleConversationHeader>
                                    <!-- ContentControl + ViewLocator picks SessionView (SDK) or
                                         TtyView (TTY) from the panel view model's type. -->
                                    <ContentControl Content="{Binding}"/>
                                </DockPanel>
                                </controls:MiniatureHost>
                                <!-- AC-670: the tile's identity strip, drawn at full size over the miniature so it
                                     stays legible at any scale. Hit-transparent, so it never eats the promoting click. -->
                                <Border x:Name="MiniatureLabel"
                                        IsVisible="{Binding #PaneRoot.(controls:SessionTilePanel.IsMiniature)}"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Top" Height="16" Padding="6,0"
                                        Background="{DynamicResource CockpitChromeBgBrush}"
                                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="False">
                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SessionStatusLabel}" FontSize="9"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="9" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource CockpitTextPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                                <!-- Accent/hairline frame: a SIBLING overlay, never the PARENT of the transcript
                                     subtree (see the PaneRoot note above — a wrapping Border leaks recycled rows via
                                     its CompositionBorderVisual). Drawn on top at its own full thickness, hit-
                                     transparent so it never eats the promoting click. -->
                                <Border Classes="panel" IsHitTestVisible="False"
                                        Classes.attention="{Binding SessionStatus, Converter={x:Static conv:IsNeedsAttentionConverter.Instance}}"
                                        Classes.active="{Binding IsSelected}"
                                        CornerRadius="{StaticResource CockpitPanelRadius}"/>
                                </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Drop-target cell outline: sized/positioned from the panel's cell rect in code-behind
                     while a pane is dragged; hit-transparent so it never blocks the drag. -->
                <Border x:Name="DropIndicator" IsVisible="False" IsHitTestVisible="False" ZIndex="100"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="2"
                        BorderBrush="{DynamicResource CockpitAccentBrush}"
                        CornerRadius="{StaticResource CockpitPanelRadius}"/>
                </Grid>
            </DockPanel>

            <!-- Startup banners: safe mode (AC-478), plugin failures (#14) and pending approvals (AC-208) stack
                 top-down in a StackPanel rather than each sitting at a fixed Margin — any of them can be one or two
                 lines, and a fixed offset would either overlap or leave a gap. More than one can show at once: e.g.
                 a plugin can fail to load while a different one awaits approval.
                 Out of layout while none shows: its margin alone held the row open, which put a gap above the Simple
                 stand's assistant column. -->
            <StackPanel VerticalAlignment="Top" Margin="12,12,12,0" Spacing="8">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="IsSafeMode"/>
                        <Binding Path="HasPluginFailures"/>
                        <Binding Path="HasPendingApprovals"/>
                        <Binding Path="HasIncomingPairing"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <!-- Safe-mode banner (AC-478): not dismissible, unlike the two below — it describes how this whole
                     run was started, not a one-off event to acknowledge. "Restart" reuses the same RestartAppCommand
                     the Voice options page offers (AppRestartService), which always drops the safe-mode launch
                     argument on the way out (see AppRestartService.BuildLaunchArguments), so this is the one button
                     back to a normal, fully-plugged-in cockpit. -->
                <Border IsVisible="{Binding IsSafeMode}"
                        Background="{DynamicResource CockpitSecondaryBgBrush}" BorderBrush="{DynamicResource CockpitStatusErrorBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CockpitControlRadius}" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="Accent" Padding="10,4"
                                Command="{Binding RestartAppCommand}"
                                IsEnabled="{Binding CanRestartApp}"
                                Content="Restart"/>
                        <TextBlock Text="{Binding SafeModeBanner}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource CockpitStatusErrorBrush}" FontSize="12"/>
                    </DockPanel>
                </Border>

                <!-- Plugin-failure banner (#14): the app kept running; details live in the Plugin store → Installed. -->
                <Border IsVisible="{Binding HasPluginFailures}"
                        Background="{DynamicResource CockpitSecondaryBgBrush}" BorderBrush="{DynamicResource CockpitStatusWaitingBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CockpitControlRadius}" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="Subtle" Padding="6,0"
                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                Command="{Binding DismissPluginFailuresCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                        </Button>
                        <TextBlock Text="{Binding PluginFailureBanner}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CockpitStatusWaitingBrush}" FontSize="12"/>
                    </DockPanel>
                </Border>

                <!-- Pending-approval banner (AC-208): plugins sitting at awaiting-approval (new, or bytes changed
                     since approved) otherwise showed up nowhere except a row in Plugin Manager. -->
                <Border IsVisible="{Binding HasPendingApprovals}"
                        Background="{DynamicResource CockpitSecondaryBgBrush}" BorderBrush="{DynamicResource CockpitStatusWaitingBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CockpitControlRadius}" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="Subtle" Padding="6,0"
                                Foreground="{DynamicResource CockpitTextFaintBrush}"
                                Command="{Binding DismissPendingApprovalsCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                        </Button>
                        <TextBlock Text="{Binding PendingApprovalBanner}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CockpitStatusWaitingBrush}" FontSize="12"/>
                    </DockPanel>
                </Border>

                <!-- Incoming-pairing banner (AC-1291): the offer lives two minutes and showed up nowhere unless the
                     Nodes page happened to be open. No dismiss button — see the view model. -->
                <Border IsVisible="{Binding HasIncomingPairing}"
                        Background="{DynamicResource CockpitSecondaryBgBrush}" BorderBrush="{DynamicResource CockpitStatusWaitingBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CockpitControlRadius}" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Review it" Margin="8,0,0,0"
                                Command="{Binding ShowIncomingPairingCommand}"/>
                        <TextBlock Text="{Binding IncomingPairingBanner}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CockpitStatusWaitingBrush}" FontSize="12"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- AC-1301: the assistant's conversation, filled in code-behind from
                 `CockpitViewModel.CreateSimpleViewChatView` — the dock rail's pattern: a factory that hands the
                 standing conversation between hosts, not a binding that would build a second one.
                 AC-1303: it takes this column only while the assistant is the thing being worked in. Pick an
                 agent and it steps aside for that agent's own pane, which is drawn by the session grid behind
                 this, and moves to the dock rail on the right.
                 AC-1316: it holds the column before the assistant has started too, and with it switched off —
                 the chat view says so itself, and typing is what starts it.
                 AC-1528: hidden under Home, which is not the assistant. -->
            <ContentControl Grid.Row="1" x:Name="SimpleChatHost">
                <ContentControl.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="SimpleStandShowsTheAssistantInTheMainColumn"/>
                        <Binding Path="!SimpleStandShowsTheStartScreen"/>
                    </MultiBinding>
                </ContentControl.IsVisible>
            </ContentControl>

            <views:SimpleHomeView Grid.Row="1" x:Name="SimpleHomePage" IsVisible="{Binding SimpleStandShowsTheStartScreen}"/>

            <!-- AC-1527: the Simple stand's Projects page — the overview's own cards (`ProjectCategoryGroups`), whose
                 Start is the dialog-free quick start, so a click lands in the new conversation. -->
            <ScrollViewer Grid.Row="1" x:Name="SimpleProjectsPage" IsVisible="{Binding SimpleStandShowsTheProjects}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="52,40,52,32">
                    <DockPanel Margin="8,0,8,12">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Padding="12,6"
                                Command="{Binding Projects.AddProjectCommand}"
                                ToolTip.Tip="Add a project — from a folder on this computer, or one your team shares">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                                <TextBlock Text="New project" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Your projects" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="A project keeps a folder, the instructions for the assistant and its conversations together."
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <Panel IsVisible="{Binding !Projects.HasProjects}">
                        <controls:StartingPointsView DataContext="{Binding Projects}"/>
                    </Panel>
                    <ItemsControl ItemsSource="{Binding Projects.ProjectCategoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCategoryGroupViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding CategoryName}" FontSize="13" FontWeight="SemiBold" Margin="8,8,0,0"
                                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                                               IsVisible="{Binding HasHeader}"/>
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProjectCardViewModel">
                                                <controls:ProjectCardView
                                                    JobCommand="{Binding $parent[UserControl].((vm:CockpitViewModel)DataContext).StartProjectJobNowCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- AC-1305: a session that is not the one in this column is waiting for consent. The card itself
                 (ConsentBanner, over the conversation) stays where the question belongs, so this only names who is
                 waiting and takes you there. No timer: the barrier goes when it is answered or waved away, and the
                 stack scrolls rather than pushing the one underneath off the window.
                 AC-1303: it used to hang inside the Simple stand's own root, which is what kept it off the panels
                 stand; that root is gone, so it now says which stand it belongs to itself. -->
            <!-- AC-1528: not over Home, whose "Waiting for you" already names every one of them. -->
            <ScrollViewer Grid.Row="1" Classes="consentAlerts" Classes.open="{Binding HasSimpleConsentAlerts}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                          MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="SimpleView"/>
                        <Binding Path="!SimpleStandShowsTheStartScreen"/>
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <ItemsControl ItemsSource="{Binding SimpleConsentAlerts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionPanelViewModel">
                            <Border Width="320" Padding="12,10" BoxShadow="0 6 20 0 #66000000"
                                    CornerRadius="{DynamicResource CockpitControlRadius}"
                                    Background="{DynamicResource CockpitPanelBgBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource CockpitStatusWaitingBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <!-- The same hand the sidebar carries for a pending consent (AC-47). -->
                                        <materialIcons:MaterialIcon Kind="HandBackLeftOutline" Width="14" Height="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                                        <TextBlock Text="Waiting for your consent" FontSize="12.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PendingConsent.Title}" FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                                        <Button Content="Ignore" Classes="Compact" CommandParameter="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).IgnoreConsentAlertCommand}"/>
                                        <Button Content="Go there" Classes="Accent Compact" CommandParameter="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).GoToConsentAlertCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- AC-1532: over the main area and not a page, so closing it leaves you where you were. -->
            <views:EarlierConversationsSheet Grid.Row="1" x:Name="EarlierConversations" DataContext="{Binding EarlierConversations}">
                <views:EarlierConversationsSheet.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[UserControl].((vm:CockpitViewModel)DataContext).SimpleView"/>
                        <Binding Path="$parent[UserControl].((vm:CockpitViewModel)DataContext).EarlierConversations.IsOpen"/>
                    </MultiBinding>
                </views:EarlierConversationsSheet.IsVisible>
            </views:EarlierConversationsSheet>
        </Grid>

        <!-- Dock rail (AC-951): the sidebar's mirror image on the right. This GridSplitter (column 3) resizes
             the rail column (4) while the star-sized content column (2) absorbs the difference — the same
             relationship column 1's splitter has with columns 0 and 2. -->
        <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns"
                      IsVisible="{Binding EffectiveOpenDockPanelId, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"
                      DragCompleted="OnDockRailSplitterDragCompleted"/>

        <!-- Stretches the full row like the sidebar (column 0) does — confirmed against the approved mockup's
             render, where the rail's background runs uninterrupted down to the status bar. Toasts and the
             resource panel (declared after this Border, so drawn in front of it) still read on top rather than
             appearing to run underneath the rail — acceptance criterion 3 (AC-951). -->
        <Border Grid.Column="4"
                IsVisible="{Binding ShowDockRail}"
                Background="{DynamicResource CockpitSecondaryBgBrush}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- Tab strip: one button per registered panel, icon over rotated title, anchored to the top of
                     the rail. Stays on screen in both the collapsed and the expanded state, so switching panels
                     or closing the open one is always a single click away. -->
                <!-- AC-1824: the Simple stand lists the plugin panels only; its assistant follows the picked session. -->
                <Panel DockPanel.Dock="Right" Width="40" VerticalAlignment="Stretch"
                       IsVisible="{Binding HasRailTabs}">
                    <!-- The host edge divides collapsed rail/content; this divider separates an open panel from its tabs. -->
                    <Border Width="1" HorizontalAlignment="Left"
                            Background="{DynamicResource CockpitHairlineBrush}"
                            IsVisible="{Binding EffectiveOpenDockPanelId, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"/>
                    <ItemsControl Width="40" VerticalAlignment="Top" ItemsSource="{Binding RailTabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="docking:DockPanelRegistration">
                                <!-- AC-1762: square corners — a tab meets the window edge and its neighbours, so a
                                 rounded one read as a loose button floating in the strip. -->
                            <Button Classes="Subtle" Width="40" Padding="0" HorizontalContentAlignment="Stretch"
                                    CornerRadius="0"
                                    BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,0,1"
                                    Command="{Binding $parent[ItemsControl].((vm:CockpitViewModel)DataContext).ToggleDockPanelCommand}"
                                    CommandParameter="{Binding Id}"
                                    ToolTip.Tip="{Binding Title}">
                                <Grid>
                                    <!-- The open tab's highlight (AC-951 mockup): the same accent-tint + edge
                                         language as Border.sessionItem.active, using the existing
                                         CockpitCategoryTintBlueBrush rather than a second resource at the same
                                         hex (see its definition in Theme.axaml for why that would fail the
                                         palette-baseline test). -->
                                    <Border Background="{DynamicResource CockpitCategoryTintBlueBrush}"
                                            BorderBrush="{DynamicResource CockpitAccentBrush}" BorderThickness="0,0,2,0">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static conv:DockPanelActiveConverter.Instance}">
                                                <Binding Path="Id"/>
                                                <Binding Path="$parent[ItemsControl].((vm:CockpitViewModel)DataContext).EffectiveOpenDockPanelId"/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                    </Border>
                                    <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,10">
                                        <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"/>
                                        <LayoutTransformControl>
                                            <LayoutTransformControl.LayoutTransform>
                                                <RotateTransform Angle="-90"/>
                                            </LayoutTransformControl.LayoutTransform>
                                            <TextBlock Text="{Binding Title}" FontSize="10.5"/>
                                        </LayoutTransformControl>
                                    </StackPanel>
                                    <!-- Assistant threads (§ 7.3): what in the panel waits on the operator. The
                                         count is its own click target: it opens the panel on what it counts,
                                         where the tab opens it where it was. -->
                                    <Button x:Name="DockTabBadge" Classes="Subtle" Padding="0" Margin="0,2,2,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            IsVisible="{Binding Badge.HasCount, FallbackValue=False}"
                                            Click="OnDockTabBadgeClick" ToolTip.Tip="Open what waits for you">
                                        <Border Classes="waitingCount" Padding="3,0" MinWidth="13">
                                            <TextBlock Text="{Binding Badge.Count, FallbackValue=0}" FontSize="9"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>

                <!-- AC-1710 (mockup AC-1708 screen 2): the open panel's name and its undock button, only for a panel that
                     can float and has no window of its own to bring — filled in by the code-behind with the content. -->
                <Border x:Name="DockPanelHeader" DockPanel.Dock="Top" IsVisible="False" Padding="12,0,4,0" Height="34"
                        BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="DockPanelUndock" DockPanel.Dock="Right" Classes="Subtle" Padding="6"
                                Command="{Binding UndockOpenDockPanelCommand}"
                                ToolTip.Tip="Undock into its own window">
                            <materialIcons:MaterialIcon Kind="DockWindow" Width="15" Height="15"/>
                        </Button>
                        <controls:DockPanelHeaderActionsHost x:Name="DockPanelHeaderActions" DockPanel.Dock="Right"/>
                        <!-- AC-1862: the Simple stand's way back to the assistant this panel replaced in the rail. -->
                        <Button x:Name="DockPanelBack" DockPanel.Dock="Left" Classes="Ghost Compact" IsVisible="False"
                                Margin="0,0,8,0" Command="{Binding BackToAssistantCommand}"
                                ToolTip.Tip="Back to the assistant">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="ArrowLeft" Width="13" Height="13"/>
                                <TextBlock Text="Assistant"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DockPanelHeaderTitle" VerticalAlignment="Center" FontSize="12.5"/>
                    </DockPanel>
                </Border>

                <!-- The open panel's content — rebuilt by the code-behind whenever OpenDockPanelId changes
                     (DockPanelRegistration.CreateView is a plain Func<Control>, not a compiled binding). -->
                <ContentControl x:Name="DockPanelContent"
                                IsVisible="{Binding EffectiveOpenDockPanelId, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"/>
            </DockPanel>
        </Border>

        <!-- Assistant threads (§ 7.2): something for the operator arrived while the docked assistant is not open,
             so a floating card says so beside the strip instead of a count alone. A status line never raises one. -->
        <Border x:Name="AssistantFloatingCard" Grid.Column="2" ZIndex="20" Margin="0,8,8,0" MaxWidth="300"
                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,10"
                Background="{DynamicResource CockpitFloatingCardBrush}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitPanelRadius}"
                IsVisible="{Binding AssistantFloatingCard, Converter={x:Static avconv:ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Creation" Width="14" Height="14" VerticalAlignment="Center"
                                                Foreground="{DynamicResource CockpitAccentBrush}"/>
                    <TextBlock Text="{Binding AssistantFloatingCard.Title, FallbackValue=''}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding AssistantFloatingCard.Body, FallbackValue=''}" TextWrapping="Wrap" MaxLines="3"
                           TextTrimming="CharacterEllipsis" FontSize="12"
                           Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="Accent Compact" Content="Open" Command="{Binding OpenAssistantFloatingCardCommand}"/>
                    <Button Classes="Ghost Compact" Content="Dismiss" Command="{Binding DismissAssistantFloatingCardCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        </Grid>

        <!-- The toasts (#61), now a control of their own so a plugin's own window shows the same ones. -->
        <controls:ToastOverlay/>

        <!-- The breakdown (#78), rising out of the status bar in the corner the figures are in. It sits in the content
             row, so it floats over the sessions rather than pushing the bar around, and it is anchored bottom-right so
             it lines up with the button that opens it. -->
        <Border Grid.Row="0"
                Classes="resourcePanel"
                Classes.open="{Binding IsResourcePanelOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,6"
                Width="320"
                Background="{DynamicResource CockpitPanelBgBrush}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 24 0 #40000000">
            <StackPanel Margin="14,12" Spacing="10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="Subtle" Padding="6,0"
                            Command="{Binding CloseResourcePanelCommand}"
                            ToolTip.Tip="Close">
                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                    <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- The total, big enough to be the thing you came for. It is the whole process tree, so the sessions
                     below are already in it — which the line under them says, rather than leaving it to be inferred
                     from figures that do not add up. -->
                <TextBlock Text="{Binding ResourceSummary}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource CockpitTextPrimaryBrush}"/>

                <Border Height="1" Background="{DynamicResource CockpitHairlineBrush}"/>

                <!-- Above the list, not below it: it says what the list is. -->
                <TextBlock Text="{Binding ResourceDetail}"
                           FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>

                <ItemsControl ItemsSource="{Binding ResourceRows}" IsVisible="{Binding HasResourceRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResourceRowViewModel">
                            <StackPanel Spacing="3" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Memory}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                </DockPanel>

                                <!-- How much of the app's memory this one session is: the figure says 700 MB, the bar
                                     says it is most of what is being used, and that is the part you would act on. -->
                                <ProgressBar Height="4" Minimum="0" Maximum="1"
                                             Value="{Binding MemoryShare}"
                                             Foreground="{DynamicResource CockpitAccentBrush}"
                                             Background="{DynamicResource CockpitSecondaryBgBrush}"/>

                                <TextBlock Text="{Binding Cpu}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The local model servers (#78). They run beside AI-Cockpit rather than under it — one Ollama serves
                     every session — so they are shown apart from the total above rather than folded into it: a model
                     can weigh more than the whole app, and putting it in a figure the operator reads as "what the
                     AI-Cockpit costs" would be a lie. -->
                <StackPanel Spacing="10" IsVisible="{Binding HasModelServers}">
                    <Border Height="1" Background="{DynamicResource CockpitHairlineBrush}"/>

                    <TextBlock Text="Local model servers"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>

                    <ItemsControl ItemsSource="{Binding ModelServerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResourceRowViewModel">
                                <StackPanel Spacing="3" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Memory}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource CockpitTextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                    </DockPanel>

                                    <ProgressBar Height="4" Minimum="0" Maximum="1"
                                                 Value="{Binding MemoryShare}"
                                                 Foreground="{DynamicResource CockpitAccentBrush}"
                                                 Background="{DynamicResource CockpitSecondaryBgBrush}"/>

                                    <TextBlock Text="{Binding Cpu}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Runs beside the cockpit, not under it: one server answers every session, so this is not part of the total above."
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status bar (#78): what AI-Cockpit is using right now. The total is AI-Cockpit's own process tree,
             so it already contains every session it spawned; the figures open the breakdown per session. -->
        <Border Grid.Row="1"
                Background="{DynamicResource CockpitSecondaryBgBrush}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <Panel>
                <!-- AC-1487 (mockup v2 tab 5): a remote window measures nothing here; it says where it is connected. -->
                <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Right" Margin="0,2"
                            IsVisible="{Binding IsRemoteWindow}">
                    <TextBlock Text="{Binding RemoteWindowStatus}" FontSize="11" Foreground="{DynamicResource CockpitStatusBusyBrush}"/>
                    <TextBlock Text="Close this window: nothing on the server stops" FontSize="11"
                               Foreground="{DynamicResource CockpitStatusBusyBrush}"/>
                </StackPanel>
                <DockPanel IsVisible="{Binding !IsRemoteWindow}">
                    <!-- AC-1802: the bell, outermost right, below where toasts appear. Amber with the waiting count when
                         something needs you, the accent count for unread otherwise. -->
                    <Button x:Name="NotificationsBell" DockPanel.Dock="Right"
                            Classes="statusMeter"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleNotificationsCommand}"
                            ToolTip.Tip="Notifications — every toast of this session, with its buttons still live">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                            <materialIcons:MaterialIcon Kind="BellOutline" Width="13" Height="13"
                                       IsVisible="{Binding !Notifications.HasNeedsYou}"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                            <materialIcons:MaterialIcon Kind="BellRingOutline" Width="13" Height="13"
                                       IsVisible="{Binding Notifications.HasNeedsYou}"
                                       Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                            <Border Classes="waitingCount" IsVisible="{Binding Notifications.HasNeedsYou}">
                                <TextBlock Text="{Binding Notifications.NeedsYouCount}"/>
                            </Border>
                            <Border IsVisible="{Binding Notifications.ShowsUnreadOnly}"
                                    Background="{DynamicResource CockpitAccentBrush}" CornerRadius="{StaticResource CockpitPillRadius}"
                                    Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource CockpitTextOnAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- AC-1829: what the window is still waiting for after the splash, so a skeleton is never unexplained. -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="8,0,8,0" VerticalAlignment="Center">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsRestoringSessions"/>
                                <Binding Path="IsLoadingProjects"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <materialIcons:MaterialIcon Classes="pulse" Kind="Circle" Width="8" Height="8"
                                                    Foreground="{DynamicResource CockpitStatusBusyBrush}" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" VerticalAlignment="Center"
                                   Text="Restoring sessions…" IsVisible="{Binding IsRestoringSessions}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" VerticalAlignment="Center"
                                   Text="Loading projects…" IsVisible="{Binding !IsRestoringSessions}"/>
                    </StackPanel>
                    <!-- The memory figure is its own TextBlock so it alone can change colour: amber as it climbs, red at
                         the point where the system starts killing things. A number that turns while you work is something
                         you can act on without being interrupted. -->
                    <!-- The figures are a button, and the breakdown is a panel it opens (#78). It used to be a tooltip,
                         which meant relying on the platform to hit-test a strip of text and to place a popup where it was
                         asked to — and on this one it did neither. A button is hit like any other button, and a panel the
                         operator opened is one that stays open while they read it. -->
                    <Button DockPanel.Dock="Right"
                            Classes="statusMeter"
                            Padding="8,2"
                            Command="{Binding ToggleResourcePanelCommand}"
                            ToolTip.Tip="What the cockpit and its sessions are using — click for the breakdown per session">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="{Binding ResourceCpu}"
                                       FontSize="11"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ResourceMemory}"
                                       FontSize="11"
                                       Foreground="{Binding ResourceMemoryBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                       VerticalAlignment="Center"/>
                            <!-- Points at the panel: up while it is closed (that is where it will come from), down while it
                                 is open (that is where it will go). -->
                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="10" Height="10" Margin="0,2,0,0"
                                       IsVisible="{Binding !IsResourcePanelOpen}"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                                       VerticalAlignment="Center"/>
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="10" Height="10" Margin="0,-2,0,0"
                                       IsVisible="{Binding IsResourcePanelOpen}"
                                       Foreground="{DynamicResource CockpitTextFaintBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- The delegated tasks (#67) run as sessions without a tab, so the status bar is where they are
                         visible at all: work is happening on your behalf that nothing else on screen would tell you
                         about. Always there, including at nought: a meter that shows up only when it has something to
                         report leaves you unable to tell "nothing is running" from "the meter is gone". The colour carries
                         that — blue while something works, grey while nothing does. -->
                    <Button DockPanel.Dock="Right"
                            Classes="statusMeter"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            Command="{Binding ShowDelegatedTasksCommand}"
                            ToolTip.Tip="Work your sessions handed to another profile — click to read what they produced, or stop them">
                        <TextBlock Text="{Binding DelegatedTasks.ActiveTaskCount, StringFormat='Delegated tasks: {0}'}"
                                   FontSize="11"
                                   Foreground="{Binding DelegatedTasks.ActiveTaskBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <!-- AC-1456: each connect server's connection, as its group's header says it. -->
                    <ItemsControl DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding ServerStatusLabels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource CockpitAccentBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Managed worktrees (AC-85): the git worktrees the cockpit created for isolated sessions. Shown only
                         while there are any — click to see each one's state, reattach a gone one, or clean up finished. -->
                    <Button DockPanel.Dock="Right"
                            Classes="statusMeter"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            Command="{Binding ShowWorktreesCommand}"
                            IsVisible="{Binding Worktrees.HasWorktrees}"
                            ToolTip.Tip="Git worktrees the cockpit created for isolated sessions — click to view them, reattach a gone one, or clean up">
                        <TextBlock Text="{Binding Worktrees.Count, StringFormat='⑂ Managed worktrees: {0}'}"
                                   FontSize="11"
                                   Foreground="{Binding Worktrees.CountBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <!-- Plugin-registered supervised activities (AC-82): a counter per source (e.g. "Port-forwards: 2"),
                         shown only while it has activities, opening a panel with a Kill per item. -->
                    <controls:PluginStatusBarHost DockPanel.Dock="Right"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>

                    <!-- AC-1711: one line per plugin (`ICockpitUiHost.SetStatusText`), e.g. the browser's
                         "Browser · profile Raymond · 3 tabs". Nothing at all while no plugin sets one. -->
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding PluginStatusTexts}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="plugins:PluginStatusText">
                                <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,0,12,0"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ResourceSessions}"
                               FontSize="11"
                               Foreground="{DynamicResource CockpitTextFaintBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Panel>
        </Border>

        <!-- AC-962: where the assistant's floating chat docks if it is let go here. Declared last so it lies over
             everything, and never hit-testable — the pointer belongs to the window being dragged, and a zone that
             took it would end the gesture it exists to guide. Width comes from AssistantChatWindow. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Classes="assistantDropZone"
                Classes.active="{Binding IsAssistantDropZoneActive}"
                IsVisible="{Binding IsAssistantDropZoneVisible}"
                IsHitTestVisible="False"
                HorizontalAlignment="Right"
                Width="{Binding AssistantDropZoneWidth}"
                BorderThickness="2,0,0,0"/>

        <!-- AC-1714: a card with choices that belongs to no session — sharing a browser tab picks the session on the
             card itself — over the whole window, with the same card a pane shows. Escape denies, as on the pane. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource CockpitScrimBrush}"
                IsVisible="{Binding WindowConsent, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding WindowConsent.DenyCommand, FallbackValue={x:Null}}"/>
            </Border.KeyBindings>
            <ContentControl Content="{Binding WindowConsent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="520" Margin="24">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ConsentPromptViewModel">
                        <controls:ConsentBanner/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

    </Grid>
    </DockPanel>
</UserControl>
