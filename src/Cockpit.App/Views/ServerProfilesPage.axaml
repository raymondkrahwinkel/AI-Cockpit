<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             x:Class="Cockpit.App.Views.ServerProfilesPage"
             x:DataType="vm:ServerProfilesViewModel">

    <!-- AC-1585: Options › Profiles on a server is this cockpit's own profile editor (ProfilesEditor), with the server
         behind it. A secret reads "(set on the server)": sent back unchanged it stays, cleared it goes. -->
    <DockPanel Margin="24,16,24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Profiles" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="on the server" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
            </StackPanel>
            <TextBlock Text="The profiles sessions on the server start under: provider, session defaults, delegation and environment." Classes="optionsHint"/>
            <TextBlock Classes="optionsHint" TextWrapping="Wrap"
                       Text="Use is governed by your own agreement with each provider. Each person needs their own provider login. Personal subscriptions are for individual use and must not be shared with others; for shared use, use an API-key profile."/>
            <TextBlock Classes="optionsHint" Classes.error="{Binding StatusIsError}" TextWrapping="Wrap"
                       IsVisible="{Binding Status.Length}" Text="{Binding Status}"/>
            <Border Height="1" Background="{DynamicResource CockpitHairlineBrush}" Margin="0,4"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Revert" Command="{Binding LoadCommand}" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="Read the profiles from the server again, dropping what was not saved"/>
                <Button x:Name="SaveButton" Classes="Accent" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </DockPanel>

        <Panel IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
            <views:ProfilesEditor DataContext="{Binding Editor}" Height="540"/>
        </Panel>
    </DockPanel>
</UserControl>
