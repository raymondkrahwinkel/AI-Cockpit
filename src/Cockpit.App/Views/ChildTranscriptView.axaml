<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:controls="using:Cockpit.App.Controls"
             x:Class="Cockpit.App.Views.ChildTranscriptView"
             x:DataType="vm:ChildTranscriptViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="{Binding Child.Detail}" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            <TextBlock Text="Read-only · This child shares its parent's process and permissions."
                       TextWrapping="Wrap" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Read next window" Classes="Subtle Compact" Command="{Binding LoadMoreCommand}"/>
            <Button Content="Refresh" Classes="Subtle Compact" Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TranscriptEntryViewModel">
                        <controls:TranscriptRowView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
