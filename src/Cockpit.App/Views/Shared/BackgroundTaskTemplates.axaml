<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Cockpit.App.ViewModels"
                    xmlns:conv="using:Cockpit.App.Converters">

    <!-- One row template shared by all three background-work groups (AC-531) — sub-agents, shells and any kind this
         build does not recognise render identically bar their StatusBrushKey/KindLabel. Merged app-wide (App.axaml)
         rather than living in SessionView, because the assistant's chat window shows the same pop-out (AC-630) and a
         second copy is the one thing that pop-out must not be. Row click goes through the row's own ToggleCommand
         rather than a PointerPressed handler: a shared dictionary has no code-behind to put one in. -->
    <DataTemplate x:Key="BackgroundTaskRowTemplate" x:DataType="vm:BackgroundTaskViewModel">
        <StackPanel Margin="6,1,6,3">
            <Button Command="{Binding ToggleCommand}" Classes="Subtle" Padding="8,6"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    CornerRadius="{StaticResource CockpitControlRadius}"
                    Background="{DynamicResource CockpitSecondaryBgBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Fill="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="11.5"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Text="{Binding LastToolText, StringFormat='Last tool: {0}'}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AgeText, StringFormat='Time: {0}'}" FontSize="11"
                                   Margin="8,0,0,0" ToolTip.Tip="Time since first observed"
                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TokensText, StringFormat='Tokens: {0}'}" FontSize="11"
                                   Margin="8,0,0,0" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                    </Grid>
                </Grid>
            </Button>

            <Border IsVisible="{Binding IsSelected}" Margin="0,3,0,0" Padding="9,7"
                    Background="{DynamicResource CockpitSecondaryBgBrush}"
                    BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CockpitControlRadius}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
