<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cockpit.App.Views.ImagePreviewWindow"
        Width="640" Height="560"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,16,10">
      <TextBlock Grid.Column="0" Name="CountText" FontSize="13.5" FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Name="FitButton" Classes="Compact" Content="Fit" Click="_OnFit"/>
        <Button Name="ActualSizeButton" Classes="Compact" Content="1:1" Click="_OnActualSize"/>
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center"
          Margin="16,10,16,14" Name="NavigationRow">
      <Button Grid.Column="0" Name="PreviousButton" Classes="Ghost" Content="Previous" Click="_OnPrevious"
              Margin="0,0,8,0"/>
      <Button Grid.Column="1" Name="NextButton" Classes="Ghost" Content="Next" Click="_OnNext"/>
    </Grid>

    <Border Background="{StaticResource CockpitSecondaryBgBrush}">
      <!-- Scrolling off while Fit sits at zoom 1, on otherwise — see _ApplyZoom. Pointer events drive panning. -->
      <ScrollViewer Name="BodyScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                    PointerPressed="_OnBodyPointerPressed" PointerMoved="_OnBodyPointerMoved"
                    PointerReleased="_OnBodyPointerReleased" PointerCaptureLost="_OnBodyPointerCaptureLost">
        <Border Name="Checkerboard" Padding="16">
          <!-- LayoutTransform (not RenderTransform) so zooming grows the layout size the ScrollViewer sees —
               a render transform leaves the extent untouched and there is nothing left to pan to (AC-804). -->
          <LayoutTransformControl Name="PreviewImageZoom" HorizontalAlignment="Center" VerticalAlignment="Center">
            <LayoutTransformControl.LayoutTransform>
              <ScaleTransform/>
            </LayoutTransformControl.LayoutTransform>
            <Image Name="PreviewImage" Stretch="Uniform"/>
          </LayoutTransformControl>
        </Border>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
