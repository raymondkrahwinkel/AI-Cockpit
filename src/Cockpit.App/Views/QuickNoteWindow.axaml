<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:projects="using:Cockpit.Core.Projects"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.QuickNoteWindow"
        x:DataType="vm:QuickNoteViewModel"
        Title="Quick note"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:QuickNoteViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CockpitChromeBgBrush}"
                BorderBrush="{DynamicResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Two buttons on purpose (AC-492): the one that starts a session is never the default, never
                     Enter, and never what a hurried Ctrl+Enter lands on. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="Ghost" Content="Save and start" Command="{Binding SaveAndStartCommand}"
                            IsEnabled="{Binding !IsSaving}"
                            ToolTip.Tip="Saves the note, then opens a session on this project with the note in its composer."/>
                    <Button Classes="Accent" Content="Save" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding !IsSaving}"
                            ToolTip.Tip="Ctrl+Enter. Writes the note into the project's memory and starts nothing."/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,18" Spacing="10">
            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                      HorizontalAlignment="Stretch" PlaceholderText="No project has a memory a note can go into"
                      IsEnabled="{Binding HasProjects}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="projects:Project">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Name="NoteBox" Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="110" MaxHeight="260" VerticalContentAlignment="Top"
                     PlaceholderText="What do you want to remember about this project?"
                     IsEnabled="{Binding HasProjects}" KeyDown="OnNoteBoxKeyDown"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource CockpitStatusWaitingBrush}"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
    </DockPanel>
</Window>
