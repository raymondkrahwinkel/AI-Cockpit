<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:controls="using:Cockpit.App.Controls"
             x:Class="Cockpit.App.Views.ServerProjectsPage"
             x:DataType="vm:ServerAdminViewModel">

    <!-- AC-1472: Options › Projects on a server (mockup v2, tab 4): the server's projects, and "clone onto the server"
         with the server's own git credentials. No path is typed here; the server reports where the clone landed. -->
    <StackPanel Margin="24,16,24,20" MaxWidth="900" Spacing="10" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Projects" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="clone onto the server" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
        </StackPanel>
        <TextBlock Classes="optionsHint" Classes.error="{Binding StatusIsError}" TextWrapping="Wrap"
                   IsVisible="{Binding Status.Length}" Text="{Binding Status}"/>

        <Border Padding="4" CornerRadius="{StaticResource CockpitControlRadius}" BorderThickness="1" IsEnabled="{Binding !IsBusy}"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" Background="{DynamicResource CockpitPanelBgBrush}">
            <StackPanel>
                <Grid ColumnDefinitions="170,*,90" Margin="8,6">
                    <TextBlock Grid.Column="0" Classes="optionsSectionHeader" Text="NAME"/>
                    <TextBlock Grid.Column="1" Classes="optionsSectionHeader" Text="FOLDER ON THE SERVER"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerProjectRowViewModel">
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CockpitHairlineSoftBrush}" Padding="8,7">
                                <Grid ColumnDefinitions="170,*,90">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12" FontFamily="Consolas,monospace" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                    <Button Grid.Column="2" Classes="Subtle Compact" Content="Remove" HorizontalAlignment="Right"
                                            ToolTip.Tip="Removes the project from the server's list. Its folder stays on the server."
                                            Command="{Binding $parent[UserControl].((vm:ServerAdminViewModel)DataContext).RemoveProjectCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No projects on the server yet." FontSize="12" Margin="8,4,8,6"
                           Foreground="{DynamicResource CockpitTextFaintBrush}" IsVisible="{Binding !Projects.Count}"/>
            </StackPanel>
        </Border>

        <!-- AC-1514: "From Depot", what the server's own sources share, added as the desktop's "Add to my projects…" does:
             the server clones the repository the definition names, and memory, MCP choice and behaviour come with it. -->
        <Border Padding="14,12" CornerRadius="{StaticResource CockpitControlRadius}" BorderThickness="1" Margin="0,4,0,0"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" Background="{DynamicResource CockpitPanelBgBrush}">
            <StackPanel Spacing="8">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" MinWidth="180" ItemsSource="{Binding SharedProfiles}" SelectedItem="{Binding SharedProfile}"
                              ToolTip.Tip="The server profile the project's sessions run under."/>
                    <TextBlock Classes="optionsSectionHeader" Text="FROM DEPOT" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding SharedNotices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding SharedProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerSharedProjectRowViewModel">
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CockpitHairlineSoftBrush}" Padding="0,7">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="Subtle Compact" VerticalAlignment="Center"
                                            Content="{Binding $parent[UserControl].((vm:ServerAdminViewModel)DataContext).AddSharedLabel}"
                                            Command="{Binding $parent[UserControl].((vm:ServerAdminViewModel)DataContext).AddSharedCommand}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding HasRepository}"/>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="{Binding SourceName, Mode=OneWay, StringFormat=' · {0}'}" FontWeight="Normal" FontSize="12"
                                                 Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding NoRepositoryHint}" FontSize="12" TextWrapping="Wrap"
                                                   IsVisible="{Binding NoRepositoryHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Padding="14,12" CornerRadius="{StaticResource CockpitControlRadius}" BorderThickness="1" Margin="0,4,0,0"
                BorderBrush="{DynamicResource CockpitHairlineBrush}" Background="{DynamicResource CockpitPanelBgBrush}">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Repository URL" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                    <TextBox Text="{Binding CloneUrl}" FontFamily="Consolas,monospace" PlaceholderText="https://github.com/org/repo.git"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Branch" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                        <TextBox Text="{Binding CloneBranch}" FontFamily="Consolas,monospace"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                        <TextBox Text="{Binding CloneName}" PlaceholderText="the repository's name"/>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="8" IsVisible="{Binding HasGitHubCredentials}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="GitHub" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GitHubStatus}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Classes="Ghost Compact" VerticalAlignment="Center"
                                Command="{Binding RefreshGitHubCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Grid.Column="2" Content="Sign in…" Classes="Compact" VerticalAlignment="Center"
                                Command="{Binding SignInGitHubCommand}" IsVisible="{Binding GitHubCanSignIn}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Grid.Column="3" Content="Sign out" Classes="Compact" VerticalAlignment="Center"
                                Command="{Binding SignOutGitHubCommand}" IsVisible="{Binding GitHubCanSignOut}" IsEnabled="{Binding !IsBusy}"/>
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding HasGitHubSignIn}">
                        <controls:LoginFlowView DataContext="{Binding GitHubSignIn}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Paste a token instead" Classes="Compact" Command="{Binding PasteGitHubTokenCommand}"
                                    IsVisible="{Binding !GitHubSignIn.Succeeded}" IsEnabled="{Binding !IsBusy}"/>
                            <Button Content="Close sign-in" Classes="Ghost Compact" Command="{Binding CloseGitHubSignInCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Cloned with the server's own git credentials." FontSize="12"
                           TextWrapping="Wrap" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                <Button Classes="Accent" HorizontalAlignment="Left" Content="{Binding CloneLabel}" Command="{Binding CloneCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
                <Border IsVisible="{Binding HasCloneResult}" Padding="10,8" CornerRadius="{StaticResource CockpitControlRadius}"
                        Background="{DynamicResource CockpitStatusDoneChipTintBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource CockpitStatusDoneBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="✓" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource CockpitStatusDoneBrush}"/>
                        <TextBlock FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="Cloned into "/>
                            <Run Text="{Binding ClonedInto}" FontFamily="Consolas,monospace"/>
                            <Run Text="{Binding CloneDetail}"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
