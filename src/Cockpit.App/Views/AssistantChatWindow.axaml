<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:views="using:Cockpit.App.Views"
        xmlns:conv="using:Cockpit.App.Converters"
        xmlns:controls="using:Cockpit.App.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="520"
        x:Class="Cockpit.App.Views.AssistantChatWindow"
        x:DataType="vm:AssistantChatViewModel"
        Title="Assistant"
        Width="420" Height="560" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{StaticResource CockpitPanelBgBrush}">

    <!-- AC-543 criterion 5/7: a pop-out onto the assistant's own standing conversation, not a pane in the
         workspace grid — precedent is Autopilot's plan pop-out (AutopilotPlanWorkspaceBody._ShowPlanningPopoutAsync),
         a small floating window rather than another tab. No "bigger" affordance (COMMENT 6 #1, decided): an
         affordance that does not know where it would go is worse than none. -->
    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
        <DockPanel>

            <!-- Header: profile name, the read-aloud switch (criterion 9 — the same switch Options carries, via
                 IAssistantSpeakToggle), and Close. Nothing else — no reading-level picker, no live-control tune
                 button, no background-work badge: those belong to a full session pane, and this window is a
                 peephole, not one. Draggable by the bar, like every other chromeless window in this app
                 (Controls/CockpitWindowChrome does the same for dialogs; not reused here because it has no room
                 for a toggle button, only a title and caption buttons). -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CockpitChromeBgBrush}"
                    BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,0,0,1"
                    Padding="12,9" PointerPressed="_OnHeaderPressed">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                    <Border Grid.Column="0" Classes="avatarBadge" Width="28" Height="28" CornerRadius="9" Margin="0,0,8,0">
                        <materialIcons:MaterialIcon Kind="Creation" Width="14" Height="14"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Assistant" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Session.ActiveProfileLabel}" FontSize="11"
                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                   IsVisible="{Binding Session.ActiveProfileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- AC-575, criterion 5. This window is where the assistant's work is read, so it is also
                             where "some of these were never shown to you" has to be legible. Says that it is on,
                             not which sources — that list is Options', and a header is not a settings page. -->
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ConsentBypassActive}">
                            <materialIcons:MaterialIcon Kind="ShieldOffOutline" Width="11" Height="11"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                            <TextBlock Text="Consent card skipped for some sources" FontSize="10.5"
                                       Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                       ToolTip.Tip="Set in Options → Voice. Every skipped card is still written to the consent trail."/>
                        </StackPanel>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" IsChecked="{Binding SpeakReplies}" Classes="Subtle Compact"
                                  VerticalAlignment="Center" Margin="0,0,4,0"
                                  ToolTip.Tip="{Binding SpeakReplies, Converter={x:Static conv:ReadAloudIconConverter.Tip}}">
                        <materialIcons:MaterialIcon Kind="{Binding SpeakReplies, Converter={x:Static conv:ReadAloudIconConverter.Icon}}"
                                                    Width="14" Height="14"/>
                    </ToggleButton>

                    <!-- AC-545 criterion 5: "what has this thing ever started" — the spawn trail, not the
                         transcript. The transcript above shows this conversation's own start_agent/stop_agent tool
                         rows; it goes blank on a fresh window and says nothing once scrolled past. The trail
                         answers the question across restarts and across a conversation that has since been
                         replaced, which is why it gets its own affordance instead of riding on the transcript's.
                         Loaded lazily — only when this flyout actually opens, not on every window open — because
                         reading it is a file read (AssistantChatViewModel.LoadSpawnLogCommand), and a window that
                         is opened far more often than this history is actually consulted should not pay for it
                         every time. -->
                    <Button Grid.Column="3" Classes="Subtle Compact" VerticalAlignment="Center" Margin="0,0,4,0"
                            ToolTip.Tip="What the assistant has started or stopped">
                        <materialIcons:MaterialIcon Kind="History" Width="14" Height="14"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opened="_OnSpawnLogFlyoutOpened">
                                <StackPanel Width="280" Spacing="0">
                                    <TextBlock Text="Spawn log" FontSize="11.5" FontWeight="SemiBold"
                                               Margin="10,8,10,6"
                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

                                    <!-- Empty state: nothing recorded yet — a fresh install, or a window opened
                                         before the assistant has ever asked to start anything. -->
                                    <TextBlock Text="The assistant has not started anything yet." FontSize="11.5"
                                               Margin="10,14" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"
                                               IsVisible="{Binding !HasSpawnLogEntries}"/>

                                    <ScrollViewer MaxHeight="320" IsVisible="{Binding HasSpawnLogEntries}">
                                        <ItemsControl ItemsSource="{Binding SpawnLogEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AssistantSpawnLogRowViewModel">
                                                    <StackPanel Spacing="2" Margin="10,7">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding When}" FontSize="10.5"
                                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                            <TextBlock Text="{Binding What}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                                                            <!-- Criterion 5's first field. One word today, because
                                                                 the assistant is the only caller there is; the day
                                                                 AC-436's coordinator writes to this trail its rows
                                                                 are otherwise indistinguishable from these. -->
                                                            <TextBlock Text="{Binding Who}" FontSize="10.5"
                                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Where}" FontSize="11"
                                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        <!-- The session by name, so the trail reads without anyone
                                                             having to match pane ids by eye. Absent on a refused
                                                             start, which produced no session to name. -->
                                                        <TextBlock Text="{Binding Session}" FontSize="10.5"
                                                                   IsVisible="{Binding HasSession}"
                                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding StartDetails}" FontSize="10.5" TextWrapping="Wrap"
                                                                   IsVisible="{Binding HasStartDetails}"
                                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                        <TextBlock Text="{Binding Refusal}" FontSize="10.5" FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                                   IsVisible="{Binding HasRefusal}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Save the conversation as text. This window is the assistant's only surface, so a
                         conversation that went wrong here can only be shown to anyone else by describing it from
                         memory or photographing the screen. Plain text, every row, folded ones included. -->
                    <Button Grid.Column="4" Classes="Subtle Compact" VerticalAlignment="Center" Margin="0,0,4,0"
                            Click="_OnExportClick" ToolTip.Tip="Save this conversation as a text file">
                        <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="14" Height="14"/>
                    </Button>

                    <!-- No restart button here, deliberately. It was here first, on the reasoning that a restart is
                         a handling and this window carries handlings — which argues that it *may* stand here, not
                         that it belongs. It belongs beside the setting that needs it: the permission mode in
                         Options → Voice → Assistant Profile, where the sentence "this applies at the next start"
                         and the start that answers it are one thing instead of two windows apart. -->
                    <Button Grid.Column="5" Classes="Subtle Compact" VerticalAlignment="Center"
                            Click="_OnCloseClick" ToolTip.Tip="Close (the conversation keeps running)">
                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Footer: one text field, nothing else (COMMENT 6 / criterion 8 — no send button, no attachment,
                 no screenshot: fully usable with a keyboard alone). Enter sends, Shift+Enter inserts a newline,
                 same convention as the main session composer (SessionView._OnInputKeyDown). -->
            <Border DockPanel.Dock="Bottom" Padding="10,6,10,10" BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="6">
                    <!-- Progress, read straight off the session the same way SessionView.axaml reads it. The window
                         is a narrower frame on the same SDK view, so it owes the operator the same answer to "is it
                         doing anything" — and without these it did not have one: a turn that called two tools showed
                         an unchanged window until the rows landed afterwards, which reads exactly like an assistant
                         that did not hear you. No new state; all three of these are properties SessionViewModel
                         already maintains for the main view. -->

                    <!-- "Thinking…" from send until the first output, and only while no tool is running — the same
                         ShowThinkingIndicator that already encodes that rule, rather than a second opinion here. -->
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                IsVisible="{Binding Session.ShowThinkingIndicator, FallbackValue=False}">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="9" Height="9"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="Thinking…" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Replaces "Thinking…" for the stretch it used to leave blank (AC-532): a tool call is the
                         longest wait in a turn, and naming the running step is the difference between a window that
                         looks stuck and one that is visibly working. Same slot, one row. -->
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                IsVisible="{Binding Session.HasActiveToolActivity, FallbackValue=False}">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="9" Height="9"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="{Binding Session.ActiveToolActivityLabel}" FontSize="11.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Background work (AC-531): a detached sub-agent or shell outlives both indicators above, and
                         this count is what still says so. No badge at zero rather than a "0" one, the same rule the
                         main view applies. The flyout with the detail stays in the main view — this window is a
                         peephole, and its job here is that the work is not invisible, not to manage it. -->
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                IsVisible="{Binding Session.HasBackgroundTasks, FallbackValue=False}">
                        <TextBlock Text="Background" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                        <Border Background="{StaticResource CockpitStatusBackgroundBrush}"
                                CornerRadius="{StaticResource CockpitPillRadius}"
                                Padding="6,1" MinWidth="18">
                            <TextBlock Text="{Binding Session.BackgroundTaskCount}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource CockpitTextOnStatusBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Criterion 9: read-aloud off is a text-assistant, said plainly rather than left to a
                         silent speaker icon — a switched-off toggle a few pixels up in the header is easy to miss
                         the one time it matters (a reply that never gets read out loud). -->
                    <TextBlock Text="Read-aloud is off — replies land here only." FontSize="10.5"
                               Foreground="{StaticResource CockpitTextFaintBrush}"
                               IsVisible="{Binding !SpeakReplies}"/>
                    <TextBox x:Name="InputBox" Text="{Binding InputText}"
                             PlaceholderText="Type, or hold F10 to talk…"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" VerticalContentAlignment="Top"/>
                </StackPanel>
            </Border>

            <Grid>
                <!-- The assistant cannot be reached at all (criterion 1): says why, rather than sitting on an
                     empty transcript that looks like nothing was ever said. -->
                <StackPanel IsVisible="{Binding IsUnavailable}" MaxWidth="280" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="24" Height="24"
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource CockpitTextFaintBrush}"/>
                    <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Empty state: no session started yet, or one with nothing said in it yet — same message
                     either way, since both read as "nothing to show" to the operator. -->
                <StackPanel IsVisible="{Binding !IsUnavailable}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="260" Spacing="10">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsUnavailable"/>
                            <Binding Path="!HasMessages"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <Border Classes="avatarBadge" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Creation" Width="22" Height="22"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                    </Border>
                    <TextBlock Text="Type a message to start talking with the assistant." TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                </StackPanel>

                <!-- The transcript itself: the existing SDK chat rendering (markdown replies, collapsible tool
                     calls, copyable results) — the same MarkdownView control, the same TranscriptEntryViewModel
                     bindings and the same toolChip/toolBody/codeBox/transcriptRow style classes SessionView.axaml
                     uses, just laid out in a narrower frame (HARDE EISEN: "geen tweede renderer"). This template
                     could not be factored into a shared resource without editing SessionView.axaml, which is
                     outside this strand's file ownership (AC-543-seams.md) — see the final report for that
                     follow-up. Trimmed to what the assistant can produce today (AC-542: acting is [c]'s, not this
                     ticket's): no permission Allow/Deny row, no reasoning/thinking section, no sub-agent nesting. -->
                <ScrollViewer x:Name="TranscriptScroll" IsVisible="{Binding HasMessages}">
                    <ItemsControl ItemsSource="{Binding Session.Transcript}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TranscriptEntryViewModel">
                                <Border Classes="transcriptRow" Classes.userRow="{Binding IsUserRow}"
                                        Padding="8,5" Margin="8,2" CornerRadius="{StaticResource CockpitControlRadius}">
                                    <StackPanel Spacing="4">

                                        <!-- The user's own message: right-aligned bubble, plain text. -->
                                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                             Classes="transcript" IsVisible="{Binding IsUserRow}"/>

                                        <!-- Assistant reply: markdown through the app's own renderer — the piece
                                             this whole requirement turns on. -->
                                        <views:MarkdownView Markdown="{Binding Text}" HorizontalAlignment="Stretch"
                                                             IsVisible="{Binding IsAssistantMarkdown}"/>

                                        <!-- Question/error/turn-result rows: plain wrapped text. -->
                                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                             Classes="transcript"
                                                             IsVisible="{Binding IsPlainNonMarkdown}"/>

                                        <!-- Tool-use row: collapsed by default (IsExpanded starts false), the
                                             same chevron chip and expandable body/result SessionView.axaml uses. -->
                                        <StackPanel IsVisible="{Binding IsToolUse}" Spacing="4">
                                            <Button Command="{Binding ToggleExpandedCommand}" Classes="toolChip" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="{Binding ToggleIconKind}" Width="12" Height="12"/>
                                                    <TextBlock Text="{Binding ToolHeader}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- The consent decision, once it has been made, so a resolved call reads
                                                 "WebSearch  ·  …   Allowed" rather than looking identical to one still
                                                 waiting. Same field the main view shows. -->
                                            <TextBlock Text="{Binding PermissionDecision}" FontStyle="Italic" FontSize="11"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}"
                                                       IsVisible="{Binding PermissionDecision, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                            <!-- Allow/Deny. This window used to leave these out — "trimmed to what the
                                                 assistant can produce today" — on the reading that acting is [c]'s. That
                                                 was wrong the moment the assistant got tools at all: it launches in
                                                 "Ask permissions" (SessionOptionCatalog.DefaultPermissionMode), so an
                                                 ordinary WebSearch raises a consent, and this window is the assistant's
                                                 ONLY surface — it has no pane, so it is not in the grid and not in the
                                                 sidebar's session rows where the pending-consent hand is drawn. The
                                                 request was therefore invisible and unanswerable, and the turn simply
                                                 stopped: the operator saw a tool row and then nothing, for good.
                                                 AC-542 decision 1 settles which way to fix it — "consent is always
                                                 visual; the assistant may ask, never receive" — so the row belongs here
                                                 rather than the assistant being launched in bypass to make the prompt
                                                 go away. Bypass would invert that promise in exactly the window that is
                                                 meant to be the audit surface. -->
                                            <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsPendingPermission}">
                                                <Button Content="Allow" Classes="Accent Compact" Margin="0,4,6,0"
                                                        Command="{Binding $parent[Window].((vm:AssistantChatViewModel)DataContext).Session.AllowToolCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Deny" Classes="Compact" Margin="0,4,6,0"
                                                        Command="{Binding $parent[Window].((vm:AssistantChatViewModel)DataContext).Session.DenyToolCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6" Margin="14,2,0,2">
                                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                     Classes="toolBody"
                                                                     Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                <StackPanel IsVisible="{Binding HasResult}" Spacing="4">
                                                    <Border IsVisible="{Binding ResultIsCodeLike}" Classes="codeBox">
                                                        <Grid>
                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="220">
                                                                <SelectableTextBlock Text="{Binding ResultDisplayText}" Classes="toolBody"/>
                                                            </ScrollViewer>
                                                            <Button Content="Copy" Classes="copyBtn" Click="_OnCopyResultClick"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    ToolTip.Tip="Copy result to clipboard"/>
                                                        </Grid>
                                                    </Border>
                                                    <SelectableTextBlock Text="{Binding ResultText}" TextWrapping="Wrap"
                                                                         Classes="toolBody"
                                                                         Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                                         IsVisible="{Binding !ResultIsCodeLike}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Standalone tool results: same collapsed-by-default chip. -->
                                        <StackPanel IsVisible="{Binding IsToolResult}" Spacing="4">
                                            <Button Command="{Binding ToggleExpandedCommand}" Classes="toolChip" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="{Binding ToggleIconKind}" Width="12" Height="12"/>
                                                    <TextBlock Text="{Binding ToggleLabel}"/>
                                                </StackPanel>
                                            </Button>
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                 Classes="toolBody"
                                                                 Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                                 IsVisible="{Binding IsExpanded}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- The cockpit's own consent gate (#AC-47), which is a different thing from the SDK's Allow/Deny row in
             the transcript above: a k8s, docker or terminal tool asks the host, not the model's runtime. It is
             routed here because the assistant has no pane and CockpitViewModel cannot find it — until it was, every
             one of those requests was denied before anything reached the screen, and the tool came back "the
             operator did not approve this action" for an action they were never shown. Same control the session
             panes use, so it looks and behaves identically, over this window instead of over a pane. -->
        <controls:ConsentBannerHost DataContext="{Binding Session}"/>
        </Grid>
    </Border>
</Window>
