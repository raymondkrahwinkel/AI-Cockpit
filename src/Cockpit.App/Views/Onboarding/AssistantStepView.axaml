<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="380"
             x:Class="Cockpit.App.Views.Onboarding.AssistantStepView"
             x:DataType="vm:AssistantStepViewModel">

    <Design.DataContext>
        <vm:AssistantStepViewModel/>
    </Design.DataContext>

    <!-- AC-585: explains the assistant and turns it on, reusing AssistantOptionsViewModel — the same view model
         Options → Voice → Assistant edits — for IsEnabled and the profile label/reason (criterion 3). Nothing here
         ever binds to a consent-bypass or permission-mode setting: the hard boundary the ticket draws is kept by
         this view simply never offering either control, not by hiding a preselected one. -->
    <StackPanel Margin="4,4" Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock Text="Your assistant" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource CockpitTextSecondaryBrush}"
                       Text="One assistant sits above every workspace, reachable by voice or text. It can look up what's running, and start or stop agents for you."/>
        </StackPanel>

        <Border Background="{StaticResource CockpitSecondaryBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}" Padding="10,8">
            <StackPanel Spacing="4">
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"
                           Text="Push-to-talk: hold F10 (changeable later), or use the chip in the sidebar. It never accepts consent on your behalf — a spoken &quot;yes&quot; is never an approval; that click stays yours."/>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"
                           Text="It runs as a real session the moment you wake it — that's why you pick its profile below, the same as any other session."/>
            </StackPanel>
        </Border>

        <CheckBox Content="Enable the assistant" IsChecked="{Binding AssistantOptions.IsEnabled}"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CockpitTextFaintBrush}"
                   Text="It's fine to leave this off. Skipping, like leaving it unchecked, installs and starts nothing."/>

        <StackPanel Spacing="8" IsVisible="{Binding AssistantOptions.IsEnabled}">
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"
                       IsVisible="{Binding OnlyLocalProvidersAvailable}">
                <Run Text="Only "/>
                <Run Text="{Binding LocalProvidersText}" FontWeight="SemiBold"/>
                <Run Text=" are available on this machine right now — that's not a blocker, but its profile can only run on one of those two until another provider is added."/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding AssistantOptions.ProfileLabel}"
                           IsVisible="{Binding AssistantOptions.ProfileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                <TextBlock Text="{Binding AssistantOptions.ProfileUnsetReason}"
                           IsVisible="{Binding AssistantOptions.ProfileUnsetReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                <Button Content="Choose profile…" VerticalAlignment="Center" Command="{Binding EditProfileCommand}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CockpitTextFaintBrush}"
                   Text="You can turn this on or off, or change its profile, later in Options → Voice → Assistant."/>
    </StackPanel>
</UserControl>
