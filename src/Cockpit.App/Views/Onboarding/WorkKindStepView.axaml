<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:onboarding="using:Cockpit.App.ViewModels.Onboarding"
             xmlns:plugins="using:Cockpit.Core.Plugins"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560"
             x:DataType="onboarding:WorkKindStepViewModel"
             x:Class="Cockpit.App.Views.Onboarding.WorkKindStepView">

    <!-- AC-511: one list instead of one consent dialog per plugin. The confirm button and the standing terms are
         docked and only the list scrolls — the same lesson PluginConsentDialog learned the hard way: a list long
         enough to push the answer past the bottom edge is a consent screen with no visible consent. Every row
         carries what that plugin's own dialog would have said, so the guard moved rather than went. -->
    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,10">
            <TextBlock Text="What kind of work is this for?" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"
                       Text="Picking one only ticks boxes. Nothing is installed until you press Install."/>

            <!-- AC-1316: the kinds as one framed track of segments (AC-789), the same control as the Simple/Panels
                 switch — a row of plain labels read as a sentence, not as four choices with one of them on.
                 RadioButtons, so the one already chosen cannot be clicked off; nothing is checked at the start,
                 because a preselected kind is a pre-ticked list nobody chose. -->
            <Border HorizontalAlignment="Left" Margin="0,4,0,0" Padding="2"
                    CornerRadius="{DynamicResource CockpitPillRadius}"
                    Background="{DynamicResource CockpitInsetBgBrush}"
                    BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding HasRecommendations}">
                <ItemsControl ItemsSource="{Binding WorkKinds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="onboarding:WorkKindChoiceViewModel">
                            <!-- The description hovers rather than sitting under the segments: every line spent
                                 up here is a line the plugin list — which carries the consent — does not get. -->
                            <Button Classes="Segment" Classes.on="{Binding IsSelected}" Content="{Binding Label}"
                                         ToolTip.Tip="{Binding Description}"
                                         Command="{Binding $parent[ItemsControl].((onboarding:WorkKindStepViewModel)DataContext).SelectWorkKindCommand}"
                                    CommandParameter="{Binding Option}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="No store said which work its plugins are for, so nothing is suggested — tick what you want."
                       IsVisible="{Binding !HasRecommendations}"
                       FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>

            <!-- What the choice above did to the list below, said where the list starts. -->
            <TextBlock Text="{Binding ListCaption}" IsVisible="{Binding HasRecommendations}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{x:Static vm:PluginConsentTerms.PermissionsNotice}"
                       TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Summary}"
                           IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                <Button Grid.Column="1" Classes="Accent" Content="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>
        </StackPanel>

        <ScrollViewer Name="PluginList" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">
                <TextBlock Text="Loading what the stores offer…" IsVisible="{Binding IsLoading}"
                           FontSize="12" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                <TextBlock Text="{Binding LoadError}"
                           IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>

                <ItemsControl ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="onboarding:WorkKindPluginRowViewModel">
                            <Border Background="{DynamicResource CockpitSecondaryBgBrush}"
                                    BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CockpitControlRadius}" Padding="9,7">
                                <!-- A grid, not a horizontal stack: a stack hands its children infinite width, so
                                     the description would run off the right edge instead of wrapping. -->
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <CheckBox Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                              IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Top"/>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock Text="{Binding Version}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Author}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- What it does for you, in the store's words — the line that leads the row
                                         (AC-1316). Absent when the store published none: nothing is made up. -->
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}"
                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>

                                    <!-- Folded, never hidden (AC-489): the grant, the origin and the checksum stay
                                         on every row one click away, so a developer opens the fold and a bookkeeper
                                         does not. The grant is per row by AC-511's decision; it reads the same on
                                         every row only until AC-107 narrows it per plugin. Same collapser as
                                         McpServerChecklist, state kept in the toggle itself. -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="0,4,0,0">
                                        <ToggleButton Name="Fold" Classes="Collapser" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Width="13" Height="13" VerticalAlignment="Center"
                                                                            Kind="ChevronRight" IsVisible="{Binding !#Fold.IsChecked}"/>
                                                <materialIcons:MaterialIcon Width="13" Height="13" VerticalAlignment="Center"
                                                                            Kind="ChevronDown" IsVisible="{Binding #Fold.IsChecked}"/>
                                                <TextBlock Text="What it may do, and where it comes from" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </ToggleButton>

                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="18,0,0,0"
                                              IsVisible="{Binding #Fold.IsChecked}">
                                            <!-- WorkKindConsentParityTests measures this line where it sits. -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="May:" FontSize="11" FontWeight="SemiBold"
                                                       Margin="0,2,5,0" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static vm:PluginConsentTerms.PermissionSummary}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="From:" FontSize="11" FontWeight="SemiBold"
                                                       Margin="0,2,5,0" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding From}" FontSize="10.5"
                                                       FontFamily="{StaticResource CockpitMonoFont}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256 (pinned on install):" FontSize="11" FontWeight="SemiBold"
                                                       Margin="0,2,5,0" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Checksum}" FontSize="10.5"
                                                       FontFamily="{StaticResource CockpitMonoFont}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
