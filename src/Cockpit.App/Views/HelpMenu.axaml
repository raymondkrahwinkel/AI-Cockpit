<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Views.HelpMenu"
             x:DataType="vm:CockpitViewModel">

    <!-- The Help flyout's entries, one control for both stands' Help (SidebarFooter, and the Simple rail since
         AC-1527), so the two cannot drift apart. -->
    <StackPanel Spacing="0" MinWidth="200">
        <!-- AC-1033: first, because it is the one that answers without a browser and
             covers the app and every installed plugin at once. -->
        <Button Classes="Subtle Row" Command="{Binding ShowDocumentationCommand}"
                ToolTip.Tip="Everything Cockpit and its plugins ship documentation for — a window of its own, no connection needed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="16" Height="16"/>
                <TextBlock Text="Documentation" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Classes="Subtle Row" Command="{Binding OpenGuideCommand}"
                ToolTip.Tip="Opens in your browser — the guide is online and needs a connection">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16"/>
                <TextBlock Text="Guide" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Classes="Subtle Row" Command="{Binding ShowGlossaryCommand}"
                ToolTip.Tip="Session, project, profile, plugin, MCP server — explained here, no browser needed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="BookAlphabet" Width="16" Height="16"/>
                <TextBlock Text="Glossary" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <!-- AC-397: the only window on traffic the operator is not part of. Under Help
             because it is something you go and look at, not something you act from. -->
        <Button Classes="Subtle Row" Command="{Binding ShowAgentLineCommand}"
                ToolTip.Tip="What the agents on this desk have said to each other — messages, wakes, claims and refusals. Read-only.">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="CommentArrowRightOutline" Width="16" Height="16"/>
                <TextBlock Text="Agent line" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Classes="Subtle Row" Command="{Binding RunSetupAgainCommand}"
                ToolTip.Tip="Reopens the first-run wizard">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="Restart" Width="16" Height="16"/>
                <TextBlock Text="Run setup again" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
