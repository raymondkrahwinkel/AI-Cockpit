<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             x:Class="Cockpit.App.Views.ServerProfileEditor"
             x:DataType="vm:ServerProfileEditorViewModel">

    <!-- AC-1473: a server profile's editable fields, on Profiles and (AC-1475) on Assistant. No field can carry a token or
         a password: a secret variable shows as set on the server, and a change marks itself until it is saved. -->
    <StackPanel Spacing="4">
        <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
        <TextBox Text="{Binding Model}" PlaceholderText="the provider's default"/>
        <TextBlock Classes="optionsHint" Text="changed · not saved yet" IsVisible="{Binding IsModelChanged}"
                   Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
        <TextBlock Text="Permission mode" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
        <TextBox Text="{Binding PermissionMode}" PlaceholderText="the provider's default"/>
        <TextBlock Classes="optionsHint" Text="changed · not saved yet" IsVisible="{Binding IsPermissionModeChanged}"
                   Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
        <TextBlock Text="MCP sets" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
        <TextBox Text="{Binding McpServers}" PlaceholderText="every enabled server; or names, separated by commas"/>
        <TextBlock Classes="optionsHint" Text="changed · not saved yet" IsVisible="{Binding IsMcpServersChanged}"
                   Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>

        <TextBlock Text="Environment" FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" Margin="0,6,0,0"/>
        <ItemsControl ItemsSource="{Binding Variables}" IsVisible="{Binding HasVariables}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerProfileVariableViewModel">
                    <Grid ColumnDefinitions="160,*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas,monospace" FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding IsExisting}"/>
                        <TextBox Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas,monospace" FontSize="12" Margin="0,0,6,0"
                                 PlaceholderText="NAME" IsVisible="{Binding IsNew}"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsPlain}"/>
                        <TextBlock Grid.Column="1" Text="set on the server" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsSecret}"
                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                        <Button Grid.Column="2" Classes="Subtle Compact" Content="Remove" Margin="6,0,0,0" IsVisible="{Binding IsPlain}"
                                Command="{Binding $parent[UserControl].((vm:ServerProfileEditorViewModel)DataContext).RemoveVariableCommand}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel>
            <Button DockPanel.Dock="Right" Classes="Subtle Compact" Content="+ Add variable" Command="{Binding AddVariableCommand}"/>
            <TextBlock Classes="optionsHint" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Secret values stay on the server and cannot be changed here."/>
        </DockPanel>
    </StackPanel>
</UserControl>
