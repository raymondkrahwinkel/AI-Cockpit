<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             x:Class="Cockpit.App.Views.ServerStoragePage"
             x:DataType="vm:ServerStorageViewModel">

    <!-- AC-2035: Options › Storage on a server. The same switch as the desktop's Options › Sessions. -->
    <StackPanel Margin="24,16,24,20" MaxWidth="900" Spacing="10" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Storage" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="on the server" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
        </StackPanel>
        <TextBlock Classes="optionsHint" TextWrapping="Wrap"
                   Text="The server watches its disks either way. With clean-up off it prunes nothing by itself and warns when space runs short; cleaning up and compacting by hand stay available. A change applies at once."/>
        <CheckBox Content="Automatically clean up Docker" IsChecked="{Binding AutomaticDockerCleanup}"/>
        <TextBlock Classes="optionsHint error" TextWrapping="Wrap" IsVisible="{Binding Status.Length}" Text="{Binding Status}"/>
    </StackPanel>
</UserControl>
