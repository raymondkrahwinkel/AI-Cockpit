<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:conv="using:Cockpit.App.Converters"
        xmlns:controls="using:Cockpit.App.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.ProjectDialog"
        x:DataType="vm:ProjectDialogViewModel"
        Title="Project"
        Width="900" Height="760" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:ProjectDialogViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- A field is a label with an explanation under it, then the control — the shape every section repeats. -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.FieldHint">
            <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,6"/>
        </Style>
        <Style Selector="TextBlock.SectionHeading">
            <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- AC-604: the field-origin badge — "◆ Shared" / "● This machine" next to a field's label, shown only
             once a plugin has claimed this project (HasFieldOwnership). Geometry and colour transcribed from the
             mockup (Depot Mockups/depot-project-sync-2026-08-02.html, section 3, .org/.org.shared/.org.local):
             pill radius, 10.5px semibold text, 1x8 padding. "Shared" reuses the existing isolated-badge tokens —
             the same violet the worktree-isolated chip already uses — rather than a new colour; "local" reuses the
             inset/hairline/secondary trio the rest of this dialog already uses. -->
        <Style Selector="Border.originBadge">
            <Setter Property="CornerRadius" Value="{StaticResource CockpitPillRadius}"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.originBadge > TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.originBadge.shared">
            <Setter Property="Background" Value="{StaticResource CockpitIsolatedBadgeBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CockpitIsolatedBadgeTextBrush}"/>
        </Style>
        <Style Selector="Border.originBadge.shared > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CockpitIsolatedBadgeTextBrush}"/>
        </Style>
        <Style Selector="Border.originBadge.local">
            <Setter Property="Background" Value="{StaticResource CockpitInsetBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}"/>
        </Style>
        <Style Selector="Border.originBadge.local > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.FieldReadOnlyReason">
            <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Styles>

    <!-- Two explicit rows rather than a docked fill: the footer is exactly as tall as it needs to be and the row
         above gets what is left, so the scroll area can never be handed more height than there is and paint its
         last row under the footer. The heading is the window's own title bar (CockpitWindowChrome). -->
    <Grid RowDefinitions="*,Auto">
        <!-- Footer: Cancel and the confirm button, which is the only thing gated on a name. -->
        <Border Grid.Row="1" Background="{StaticResource CockpitChromeBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="* required" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="Ghost" Content="Cancel" Command="{Binding CancelCommand}"/>
                    <Button Content="{Binding ConfirmLabel}" Command="{Binding SaveCommand}" Classes="Accent"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Horizontal scrolling off, deliberately: left on, the scroller measures its content with unbounded
             width, so a star-sized column never has to fit and a long path pushed the row's buttons off the
             window instead of shrinking the box. -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Every inset lives on the content rather than as ScrollViewer.Padding, in both directions: the
                 scroller leaves its padding out of what it measures, so the bottom rows could not scroll clear of
                 the footer and a row was measured 18px wider than the window it had to fit — which is how a long
                 path pushed the buttons beside it off the edge. -->
            <StackPanel Spacing="26" Margin="28,22,28,48">

                <!-- Three groups, in the order the questions actually arrive: what this project is, where its
                     things live, and how its sessions run. Ungrouped, the form asked for a folder between a
                     description and a memory location, and for a profile before it had said what a project was. -->
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionHeading" Text="About this project"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="FieldLabel" Text="Name *"/>
                                <Border Classes="originBadge" Classes.shared="{Binding NameOrigin.IsClaimed}"
                                        Classes.local="{Binding NameOrigin.IsLocalOrigin}"
                                        IsVisible="{Binding HasFieldOwnership}" ToolTip.Tip="{Binding NameOrigin.SourceName}">
                                    <TextBlock Text="{Binding NameOrigin.BadgeText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="FieldHint" Text="What you call this project."/>
                            <TextBox Text="{Binding Name}" PlaceholderText="Invoices" IsEnabled="{Binding !NameOrigin.IsLockedHere}"/>
                            <TextBlock Classes="FieldReadOnlyReason" Text="{Binding NameOrigin.ReadOnlyReason}"
                                       IsVisible="{Binding NameOrigin.IsLockedHere}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" MinWidth="200">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="FieldLabel" Text="Logo"/>
                                <Border Classes="originBadge" Classes.shared="{Binding LogoOrigin.IsClaimed}"
                                        Classes.local="{Binding LogoOrigin.IsLocalOrigin}"
                                        IsVisible="{Binding HasFieldOwnership}" ToolTip.Tip="{Binding LogoOrigin.SourceName}">
                                    <TextBlock Text="{Binding LogoOrigin.BadgeText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="FieldHint" Text="A file — SVG included."/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsEnabled="{Binding !LogoOrigin.IsLockedHere}">
                                <!-- The preview is the check: it shows what the card will show, so a file that is
                                     not an image is visible here rather than as a missing picture later. -->
                                <controls:ProjectLogoBadge Grid.Column="0" Size="34" ShowsInitial="False"
                                                           LogoPath="{Binding LogoSource}"
                                                           WellBackground="{StaticResource CockpitSecondaryBgBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Choose…" Command="{Binding PickLogoCommand}"/>
                                    <Button Content="Remove" Classes="Subtle"
                                            Command="{Binding ClearLogoCommand}"
                                            IsEnabled="{Binding LogoSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="FieldReadOnlyReason" Text="{Binding LogoOrigin.ReadOnlyReason}"
                                       IsVisible="{Binding LogoOrigin.IsLockedHere}"/>
                        </StackPanel>
                    </Grid>

                    <!-- AC-618: category is what the manager's list groups by ("Privé" before "Werk" — the operator's
                         own ordering, remembered the first time each name is typed). Free text, no chips yet: the
                         known-categories list would have to travel through SessionDialogService.ShowProjectDialogAsync,
                         which is out of scope here — see AC-618's own delivery notes. -->
                    <StackPanel Spacing="2">
                        <TextBlock Classes="FieldLabel" Text="Category"/>
                        <TextBlock Classes="FieldHint" Text="Where this project shows up in the list. Leave it blank to leave it uncategorized."/>
                        <TextBox Text="{Binding Category}" PlaceholderText="Work"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="FieldLabel" Text="Description"/>
                            <Border Classes="originBadge" Classes.shared="{Binding DescriptionOrigin.IsClaimed}"
                                    Classes.local="{Binding DescriptionOrigin.IsLocalOrigin}"
                                    IsVisible="{Binding HasFieldOwnership}" ToolTip.Tip="{Binding DescriptionOrigin.SourceName}">
                                <TextBlock Text="{Binding DescriptionOrigin.BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="FieldHint" Text="In plain words — what is this project for? This is what a colleague reads on its card."/>
                        <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="66"
                                 PlaceholderText="Read invoices and prepare them for the bookkeeping."
                                 IsEnabled="{Binding !DescriptionOrigin.IsLockedHere}"/>
                        <TextBlock Classes="FieldReadOnlyReason" Text="{Binding DescriptionOrigin.ReadOnlyReason}"
                                   IsVisible="{Binding DescriptionOrigin.IsLockedHere}"/>
                    </StackPanel>

                    <StackPanel Spacing="2" IsVisible="{Binding LogoSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="FieldHint" Margin="0"
                                   Text="{Binding LogoSource, StringFormat='Logo: {0}'}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Rows the operator names themselves, because the cockpit cannot know which kinds of information a
                     project needs — a repository link, the customer's website, a contact. Kept next to the
                     description rather than after the session settings: it answers the same question, "what is this
                     project", and a field per kind of information was explicitly not what was wanted. -->
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionHeading" Text="Anything else worth keeping"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                    </StackPanel>
                    <TextBlock Classes="FieldHint" Margin="0"
                               Text="Name a row whatever you like and put the value beside it. A web address becomes a link you can click from the project's card. Tick &quot;Tell sessions&quot; and a session started here is told that row when it begins — leave it off and the row is only for you to read. Tick &quot;Secret&quot; for a credential: it is stored encrypted, masked wherever the project is shown, and never told to a session."/>
                    <ItemsControl ItemsSource="{Binding AdditionalInfo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectInfoFieldViewModel">
                                <Grid ColumnDefinitions="4*,6*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                    <TextBox Grid.Column="0" Text="{Binding Label}" PlaceholderText="Repository"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="https://github.com/…"
                                             IsVisible="{Binding !IsSecret}"/>
                                    <!-- Same masking the profile editor's secret env-vars use, so a credential is not
                                         on screen while the dialog is open. -->
                                    <TextBox Grid.Column="1" Text="{Binding Value}" PasswordChar="•"
                                             IsVisible="{Binding IsSecret}"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSecret}"
                                              Content="Secret" FontSize="11" VerticalAlignment="Center"
                                              ToolTip.Tip="Store this value encrypted and masked, the way a profile stores a credential. A secret row is never told to a session and never shown on the project's card."/>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding IsSharedWithSessions}"
                                              IsEnabled="{Binding CanShareWithSessions}"
                                              ToolTip.ShowOnDisabled="True"
                                              Content="Tell sessions" FontSize="11" VerticalAlignment="Center"
                                              ToolTip.Tip="A session started on this project is told this row as it begins. Off by default: a row is yours to read unless you say otherwise. A secret row is never told to a session, so this is unavailable there."/>
                                    <Button Grid.Column="4" Classes="Subtle" VerticalAlignment="Center"
                                            ToolTip.Tip="Remove this row"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectDialogViewModel)DataContext).RemoveInfoFieldCommand}"
                                            CommandParameter="{Binding}">
                                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Add row" Classes="Subtle" HorizontalAlignment="Left"
                            Foreground="{StaticResource CockpitAccentBrush}"
                            Command="{Binding AddInfoFieldCommand}"/>
                </StackPanel>

                <!-- What a plugin needs to look this project up elsewhere (AC-317). Next to the rows above because
                     both say what a project is, and deliberately not the same thing: a row above is what the operator
                     wants to remember, a field here is an identifier a plugin queries with. The whole section stays
                     out when nothing contributes one. -->
                <StackPanel Spacing="14" IsVisible="{Binding HasPluginFields}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionHeading" Text="Where it is tracked"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding PluginFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectPluginFieldViewModel">
                                <StackPanel Spacing="2" Margin="0,0,0,10">
                                    <TextBlock Classes="FieldLabel" Text="{Binding Title}"/>
                                    <TextBlock Classes="FieldHint" Text="{Binding Hint}"
                                               IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <!-- Typing filters, and what is typed counts: a repository you cannot read is not
                                         in the list, and refusing it would be refusing the only way to link it. -->
                                    <AutoCompleteBox ItemsSource="{Binding Options}"
                                                     Text="{Binding Text, Mode=TwoWay}"
                                                     ValueMemberBinding="{Binding Display}"
                                                     FilterMode="Contains"
                                                     MinimumPrefixLength="0"
                                                     PlaceholderText="{Binding Placeholder}"
                                                     HorizontalAlignment="Stretch"/>
                                    <TextBlock Classes="FieldHint" Margin="0,4,0,0" Text="Loading…"
                                               IsVisible="{Binding IsLoadingOptions}"/>
                                    <TextBlock Classes="FieldHint" Margin="0,4,0,0"
                                               Foreground="{StaticResource CockpitStatusErrorBrush}"
                                               Text="{Binding LoadError}"
                                               IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionHeading" Text="Where its things live"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="FieldLabel" Text="Folder"/>
                            <!-- Not one of the six claimable host fields — a checkout path is always this machine's,
                                 never a plugin's to claim (AC-604 review). Fixed "local", not bound to an Origin
                                 view model: shown whenever the project has any claim at all, so its absence never
                                 reads as "unknown" next to a row that really does say so. -->
                            <Border Classes="originBadge local" IsVisible="{Binding HasFieldOwnership}">
                                <TextBlock Text="● This machine"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="FieldHint" Text="Where its sessions start. Leave empty for a project without files of its own."/>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding SourceDirectory}" PlaceholderText="No folder chosen"/>
                            <Button Grid.Column="1" Content="Choose…" Command="{Binding BrowseCommand}"/>
                            <Button Grid.Column="2" Content="Clone…" Command="{Binding CloneCommand}"/>
                        </Grid>
                        <TextBlock Classes="FieldHint" Margin="0,4,0,0" IsVisible="{Binding GitUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding GitUrl, StringFormat='Cloned from {0}'}"/>
                    </StackPanel>
                </StackPanel>

                <!-- What a session reads besides the folder (AC-483/485): a memory location it can write back to, an
                     instructions file it follows, or material it only looks up when it needs it — see
                     ProjectResourceRole. The old standalone "Memory" row above is now just one row here with that
                     role; every project that used it opens with exactly one row already in this list. -->
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionHeading" Text="Memory, instructions and reference"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                    </StackPanel>
                    <TextBlock Classes="FieldHint" Margin="0"
                               Text="Each row is something a session can read, write back to, or follow — pick which with the role. Unlike the rows above, &quot;Tell sessions&quot; is ticked by default here: a memory or instructions row exists specifically to be told to a session, not just kept for you to read."/>
                    <ItemsControl ItemsSource="{Binding ResourceRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectResourceRowViewModel">
                                <!-- The ordinary hairline, not the soft one. A row here is three or four stacked
                                     controls rather than the single line the section above it uses, so where one row
                                     ends and the next begins is not otherwise readable — and the soft hairline sits
                                     six steps off the panel it is drawn on, which is invisible at this size. Checked
                                     by rendering the scene and looking for it: a divider nobody can see is not a
                                     quieter divider, it is none.
                                     AC-485 review (FIX 8): BorderThickness is bound to IsLastRow, not fixed at
                                     "0,0,0,1" — the last row has no next row to separate itself from, so it must
                                     draw no bottom line at all (see LastResourceRowBorderThicknessConverter's and
                                     IsLastRow's own remarks on the two approaches that were tried and measured not
                                     to work before this one). -->
                                <Border Classes="resourceRowDivider" BorderBrush="{StaticResource CockpitHairlineBrush}"
                                        BorderThickness="{Binding IsLastRow, Converter={x:Static conv:LastResourceRowBorderThicknessConverter.Instance}}"
                                        Padding="0,0,0,10" Margin="0,0,0,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" MinWidth="112"
                                                      ItemsSource="{x:Static vm:ProjectResourceRowViewModel.RoleChoices}"
                                                      SelectedItem="{Binding Role}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Label}" PlaceholderText="Label (optional)"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding ReachesSessions}"
                                                      Content="Tell sessions" FontSize="11" VerticalAlignment="Center"
                                                      ToolTip.Tip="A session started on this project is told this row as it begins. On by default here — unlike the rows above, this one exists to be told to a session, not just kept for you to read."/>
                                            <!-- AC-486: Instructions only, next to "Tell sessions" rather than apart from it — both checkboxes
                                                 are about what a starting session is given for this row, and off by default (unlike the one
                                                 beside it): opening a file is a bigger step than mentioning it exists, so nothing is read until
                                                 the operator says so. See ProjectResource.SendsContent's own doc comment for the reasoning. -->
                                            <!-- AC-612: disabled (never just hidden) once IsSecretPath recognises the typed reference — a
                                                 disabled-but-still-visible control is what tells the operator this row is why the box will
                                                 not tick, rather than the box quietly doing nothing were it left enabled. -->
                                            <CheckBox Grid.Column="3" IsChecked="{Binding SendsContent}" IsVisible="{Binding ShowsSendsContentOption}"
                                                      IsEnabled="{Binding !IsSecretPath}"
                                                      Content="Send along" FontSize="11" VerticalAlignment="Center"
                                                      ToolTip.Tip="Ticked, this file's contents are read and sent to the session at start — never for anything sensitive. Unticked (the default), only where it lives is sent. Either way it is a snapshot from when the session starts; an edit made afterward is not seen by a session already running."/>
                                            <Button Grid.Column="4" Classes="Subtle" VerticalAlignment="Center"
                                                    ToolTip.Tip="Remove this row"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectDialogViewModel)DataContext).RemoveResourceRowCommand}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                            </Button>
                                        </Grid>

                                        <!-- AC-486: always shown alongside the checkbox above, not tooltip-only like "Tell sessions" is —
                                             this one decides whether a file's contents are opened and handed to a session at all, which is a
                                             bigger consequence than being mentioned, and deserves to be readable at a glance rather than only
                                             on hover. The two facts an operator cannot infer from the label alone: ticking it opens the file
                                             (so leave it off for anything sensitive), and what travels is fixed at session start, not kept
                                             live across it. -->
                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding ShowsSendsContentOption}"
                                                   Text="Ticking this reads the file and sends its contents to the session — leave it off for anything sensitive. What is sent is a snapshot from when the session starts; a change made to the file afterward is not seen by that session."/>

                                        <!-- Only for a Memory row once a plugin registered a source (AC-166), the same picker the
                                             single Memory row used to show, folded per row instead of once for the dialog. -->
                                        <ComboBox IsVisible="{Binding ShowsMemorySourcePicker}"
                                                  ItemsSource="{Binding MemorySourceChoices}"
                                                  SelectedItem="{Binding SelectedMemorySourceChoice}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MemorySourceChoice">
                                                    <TextBlock Text="{Binding Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- AC-499: the second axis — which instance (which Depot connection, say) of the family picked
                                             above this row means — shown only once that top choice actually names a family
                                             (ShowsMemorySourceServerRow); Folder and an ungrouped source have no second axis at all.
                                             The dropdown itself only appears once the family has an instance to offer — with none yet,
                                             a disabled box carrying the family's own empty hint takes its place instead, so there is
                                             never an empty, openable-but-useless ComboBox on screen. "Servers…" is only ever shown
                                             when the picked family actually offers somewhere to configure one (never a dead button,
                                             the same rule "Choose…" already follows via CanBrowse), and disables itself rather than
                                             disappearing while a previous call is still running. -->
                                        <Grid IsVisible="{Binding ShowsMemorySourceServerRow}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <ComboBox Grid.Column="0" IsVisible="{Binding HasFamilyInstances}"
                                                      ItemsSource="{Binding FamilyInstanceChoices}"
                                                      SelectedItem="{Binding SelectedFamilyInstance}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MemorySourceChoice">
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="0" IsVisible="{Binding !HasFamilyInstances}"
                                                     IsReadOnly="True" IsEnabled="False"
                                                     Text="{Binding MemorySourceInstanceEmptyHint, Mode=OneWay}"/>
                                            <Button Grid.Column="1" Content="Servers…" IsVisible="{Binding CanConfigureMemorySource}"
                                                    IsEnabled="{Binding !IsConfiguringMemorySource}"
                                                    ToolTip.Tip="Opens where this family's own connections are configured."
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectDialogViewModel)DataContext).ConfigureMemorySourceCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <TextBlock Classes="FieldHint" Margin="0" Foreground="{StaticResource CockpitStatusErrorBrush}"
                                                   IsVisible="{Binding MemorySourceConfigureError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding MemorySourceConfigureError}"/>

                                        <!-- Sits here, directly above the box it describes, rather than under the source dropdown where it
                                             lived before AC-499. Its sentence is about the value the operator types ("the name it goes by in
                                             the source above, not a path"), so inserting the server row between the two left the explanation
                                             two controls away from the field it explains — visible only in a render, which is how it was
                                             caught. Below the server row it also reads more precisely: "the source above" now lands on the
                                             instance actually chosen ("Depot (krahwinkel-it)"), and the identifier really is scoped to that
                                             one instance, not to the family. -->
                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding ShowsMemorySourcePicker}"
                                                   Text="{Binding MemoryHint}"/>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <!-- AC-485 review (MUST-FIX 2): committed on focus loss, not per keystroke.
                                                 Every edit here re-runs the broken-reference probe and the
                                                 machine-bound check for the whole dialog; with the default
                                                 per-character trigger, a single row whose path check cannot answer
                                                 quickly (an unreachable mapped drive, say) cost up to the probe's own
                                                 200 ms budget on every character typed — measured at 204 ms/call, so
                                                 roughly 7 seconds of a frozen window for 35 keystrokes. -->
                                            <TextBox Grid.Column="0" Text="{Binding Reference}" PlaceholderText="{Binding ReferencePlaceholder}"/>
                                            <Button Grid.Column="1" Content="Choose…" IsEnabled="{Binding CanBrowse}"
                                                    ToolTip.Tip="A source other than a folder is picked from the dropdown above, not browsed for."
                                                    ToolTip.ShowOnDisabled="True"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectDialogViewModel)DataContext).PickResourceCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>

                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding IsBroken}"
                                                   Foreground="{StaticResource CockpitStatusErrorBrush}"
                                                   Text="This reference could not be found."/>
                                        <!-- AC-612: a path recognised as likely credential material (see ProjectResourceSecretPathHeuristic's
                                             own remarks — a heuristic, not a security boundary) — names only the path's own shape, never a
                                             character of the file's content (Iron Law #8). Same FieldHint/error-red language as the "could
                                             not be found" hint above, since this is exactly as severe a thing to tell the operator. -->
                                        <TextBlock Classes="FieldHint" Margin="0"
                                                   IsVisible="{Binding SecretPathWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{StaticResource CockpitStatusErrorBrush}"
                                                   Text="{Binding SecretPathWarning}"/>
                                        <!-- AC-605 criterion 7: every row's scope (repo / your machines / everyone with the instance / only
                                             this machine), shown as a full sentence rather than a terse ◆/● badge — see
                                             ProjectResourceRowViewModel.ScopeLabel's own remarks on why this must not read like the
                                             AC-604 field-ownership badge on the same screen. Bound to ShowsScopeLabel, not a null-check on
                                             ScopeLabel itself — see that property's own remarks on why a row offering the repo-relative fix
                                             below hides this instead of repeating the same closing clause twice. -->
                                        <TextBlock Classes="FieldHint" Margin="0"
                                                   IsVisible="{Binding ShowsScopeLabel}"
                                                   Text="{Binding ScopeLabel}"/>
                                        <!-- AC-605 criterion 5: an absolute path already inside the project folder that never went through
                                             the picker's own ToStoredReference conversion — recognised, with a one-click fix rather than a
                                             silent rewrite (see ProjectResourcePathPortability.SuggestRepoRelativeFix's own remarks). -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasRepoRelativeFix}">
                                            <TextBlock Grid.Column="0" Classes="FieldHint" Margin="0"
                                                       Text="This absolute path lives inside the project folder but was never converted — it will not travel if the project definition is shared."/>
                                            <Button Grid.Column="1" Content="Make repo-relative"
                                                    ToolTip.Tip="Rewrites this row's reference to its repo-relative form, in place."
                                                    Command="{Binding ApplyRepoRelativeFixCommand}"/>
                                        </Grid>

                                        <!-- AC-503: the plugin-resource counterpart to the two hints above — a Memory row whose picked source
                                             can confirm a typed value gets the same visible confirmation/error treatment a broken Reference row
                                             already has. Exactly one of the four (AC-499 added the fourth) is ever visible at once (the IsXxx bools
                                             on the row are mutually exclusive, all gated on Role == Memory and a non-blank Reference), so there is
                                             no ordering concern between them. -->
                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding IsConfirmedReachable}"
                                                   Foreground="{StaticResource CockpitStatusDoneBrush}"
                                                   Text="{Binding ReachabilityDetail, TargetNullValue='Confirmed — this location was found.'}"/>
                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding IsNotFoundReachable}"
                                                   Foreground="{StaticResource CockpitStatusErrorBrush}"
                                                   Text="This location could not be found, or is not visible with the current sign-in."/>
                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding IsNotSignedIn}"
                                                   Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                                   Text="Not signed in — sign in to confirm this location."/>
                                        <!-- AC-499: the check ran and reached the connection but could not complete —
                                             kept apart from IsNotSignedIn above so a signed-in operator is never told
                                             to sign in again for a call that already proved sign-in was not the
                                             problem. Same waiting/amber treatment: this is not a claim about the
                                             value either way, only that nothing could be confirmed this time. -->
                                        <TextBlock Classes="FieldHint" Margin="0" IsVisible="{Binding IsCheckFailed}"
                                                   Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                                   Text="{Binding ReachabilityDetail, TargetNullValue='This location could not be checked right now.'}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Add row" Classes="Subtle" HorizontalAlignment="Left"
                            Foreground="{StaticResource CockpitAccentBrush}"
                            Command="{Binding AddResourceRowCommand}"/>
                </StackPanel>

                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionHeading" Text="How its sessions run"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="FieldLabel" Text="Profile"/>
                            <!-- Same reasoning as Folder above: not claimable, fixed "local", shown once the
                                 project has any claim so no field is ever left without a badge. -->
                            <Border Classes="originBadge local" IsVisible="{Binding HasFieldOwnership}">
                                <TextBlock Text="● This machine"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="FieldHint" Text="Which profile starts by default. The project uses a profile — it does not replace one."/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileLabel}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Leave the dialog's own choice"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="FieldLabel" Text="Behaviour"/>
                            <Border Classes="originBadge" Classes.shared="{Binding BehaviorOrigin.IsClaimed}"
                                    Classes.local="{Binding BehaviorOrigin.IsLocalOrigin}"
                                    IsVisible="{Binding HasFieldOwnership}" ToolTip.Tip="{Binding BehaviorOrigin.SourceName}">
                                <TextBlock Text="{Binding BehaviorOrigin.BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="FieldHint" Text="Optional — how should the profile behave here? Added to what the profile already says."/>
                        <TextBox Text="{Binding BehaviorPrompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="78"
                                 PlaceholderText="Follow the project conventions. Test before opening a PR; ask when unsure."
                                 IsEnabled="{Binding !BehaviorOrigin.IsLockedHere}"/>
                        <TextBlock Classes="FieldReadOnlyReason" Text="{Binding BehaviorOrigin.ReadOnlyReason}"
                                   IsVisible="{Binding BehaviorOrigin.IsLockedHere}"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <CheckBox Classes="Switch" IsChecked="{Binding IsolateInWorktreeByDefault}"
                                  IsEnabled="{Binding !WorktreeSwitchOrigin.IsLockedHere}">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="Isolate new sessions in a git worktree"/>
                                    <Border Classes="originBadge" Classes.shared="{Binding WorktreeSwitchOrigin.IsClaimed}"
                                            Classes.local="{Binding WorktreeSwitchOrigin.IsLocalOrigin}"
                                            IsVisible="{Binding HasFieldOwnership}" ToolTip.Tip="{Binding WorktreeSwitchOrigin.SourceName}">
                                        <TextBlock Text="{Binding WorktreeSwitchOrigin.BadgeText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="FieldHint" Margin="0"
                                           Text="For code projects — every session starts in its own worktree, still switchable per session."/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Classes="FieldReadOnlyReason" Text="{Binding WorktreeSwitchOrigin.ReadOnlyReason}"
                                   IsVisible="{Binding WorktreeSwitchOrigin.IsLockedHere}"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFieldOwnership}">
                            <TextBlock Classes="FieldLabel" Text="MCP overlay"/>
                            <Border Classes="originBadge" Classes.shared="{Binding McpOverlayOrigin.IsClaimed}"
                                    Classes.local="{Binding McpOverlayOrigin.IsLocalOrigin}"
                                    ToolTip.Tip="{Binding McpOverlayOrigin.SourceName}">
                                <TextBlock Text="{Binding McpOverlayOrigin.BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <controls:McpServerChecklist IsVisible="{Binding HasMcpServers}"
                                                     IsEnabled="{Binding !McpOverlayOrigin.IsLockedHere}"
                                                     Servers="{Binding McpServers}"
                                                     Hint="Which servers this project's sessions start with ticked. Unticking one turns it off for this project only — the server itself stays in the global configuration, and a session can tick it back on."/>
                        <TextBlock Classes="FieldReadOnlyReason" Text="{Binding McpOverlayOrigin.ReadOnlyReason}"
                                   IsVisible="{Binding McpOverlayOrigin.IsLockedHere}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
