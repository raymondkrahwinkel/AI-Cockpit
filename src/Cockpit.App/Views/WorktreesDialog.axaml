<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:conv="using:Cockpit.App.Converters"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.WorktreesDialog"
        x:DataType="vm:WorktreesViewModel"
        Title="Managed worktrees"
        Width="900" Height="480"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:WorktreesViewModel/>
    </Design.DataContext>

    <DockPanel Margin="16">

        <!-- The window's title bar states the name; this is the paragraph under it, too long to be the one line
             the title bar carries. -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12"
                   Text="Git worktrees the cockpit created to isolate sessions. A gone one — its session closed or crashed — can be reattached to a fresh session or removed. Removing a tree with unsaved changes always asks first."
                   Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="Subtle Compact" HorizontalAlignment="Left" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="12" Height="12"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="Subtle Compact" HorizontalAlignment="Left" Margin="8,0,0,0"
                    Command="{Binding CleanUpFinishedCommand}"
                    IsVisible="{Binding HasWorktrees}"
                    ToolTip.Tip="Removes every worktree that is clean (nothing to lose). Never touches one with unsaved changes.">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Broom" Width="12" Height="12"/>
                    <TextBlock Text="Clean up finished"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Content="Close" Click="OnClose"/>
        </Grid>

        <!-- Why a removal did not go through, in git's own words (AC-342). Without it a row that stays put is
             indistinguishable from a button that does nothing. Held to one line by the view model, so it never wraps
             over embedded newlines (AC-292). -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding RemoveFailure}" IsVisible="{Binding HasRemoveFailure}"
                   Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource CockpitStatusErrorBrush}"/>

        <!-- What a successful removal left behind — the repository was gone, so the worktree folder could not be
             handed back to git and was simply abandoned on disk (AC-507). Not an error: the removal went through. -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding RemoveNotice}" IsVisible="{Binding HasRemoveNotice}"
                   Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource CockpitStatusWaitingBrush}"/>

        <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitPanelRadius}" Padding="4">

            <Panel>
                <TextBlock Text="No worktrees. A session started with &quot;Isolate in a git worktree&quot; will show up here."
                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center" IsVisible="{Binding !HasWorktrees}"/>

                <ScrollViewer IsVisible="{Binding HasWorktrees}">
                    <ItemsControl ItemsSource="{Binding Worktrees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManagedWorktreeRowViewModel">
                                <Border Padding="10,8" Margin="3,2" CornerRadius="{StaticResource CockpitControlRadius}"
                                        Background="{StaticResource CockpitSecondaryBgBrush}">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children with
                                                 unbounded width, so the owner label simply drew on past the row and under the
                                                 button column once it started carrying a session name — AC-428's shape, a
                                                 data-driven element sharing a row with fixed buttons. The label takes the star
                                                 column and trims, so no name can push it out of its own row again. -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <!-- Status dot + branch chip: at a glance clean vs. work-to-lose. -->
                                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Branch, StringFormat='⑂ {0}'}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource CockpitTextPrimaryBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Classes="tag">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                               Foreground="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding OwnerLabel}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{Binding OwnerBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OwnerLabel}"/>
                                            </Grid>
                                            <!-- Same reason as the row above: a fixed MaxWidth trimmed the path but still let
                                                 the pair run under the buttons on a narrower window. The path takes what is
                                                 left of the row instead, so it shrinks with the window rather than past it. -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="16,0,0,0">
                                                <TextBlock Grid.Column="0" Text="{Binding RepositoryName}" FontSize="11"
                                                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding WorktreePath}" FontSize="11"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorktreePath}"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Look at the files yourself in the OS file manager (read-only, always available). -->
                                            <Button Classes="RowAction" Content="Open folder"
                                                    ToolTip.Tip="Open the worktree folder in your file manager"
                                                    Click="OnOpenFolder"/>
                                            <!-- Reattach only when the owning session is gone (Raymond: GONE only); a live tree
                                                 disables it so two sessions never land on one working tree. -->
                                            <Button Classes="RowAction" Content="Reattach"
                                                    IsEnabled="{Binding CanReattach}"
                                                    ToolTip.ShowOnDisabled="True"
                                                    ToolTip.Tip="Start a new session in this worktree. Only for a worktree whose session is gone."
                                                    Command="{Binding ((vm:WorktreesViewModel)DataContext).ReattachCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="RowAction" Content="Remove"
                                                    IsEnabled="{Binding CanRemove}"
                                                    ToolTip.ShowOnDisabled="True"
                                                    ToolTip.Tip="Remove this worktree (asks to confirm; a tree with unsaved changes warns first). Disabled while a session is still using it — close the session first."
                                                    Command="{Binding ((vm:WorktreesViewModel)DataContext).RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <!-- Only for a row that is "in use" solely because of an open restore offer (AC-410)
                                                 with nothing actually running behind it (AC-520 fix 6) — detaches ownership so
                                                 Remove and Reattach become available, without waiting for the operator to start
                                                 or close that pane by hand. -->
                                            <Button Classes="RowAction" Content="Release"
                                                    IsEnabled="{Binding CanRelease}"
                                                    ToolTip.ShowOnDisabled="True"
                                                    ToolTip.Tip="Detach this worktree from the session that claimed it, discarding its restore offer. Only offered while that offer is the only reason the row reads as in use."
                                                    Command="{Binding ((vm:WorktreesViewModel)DataContext).ReleaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</Window>
