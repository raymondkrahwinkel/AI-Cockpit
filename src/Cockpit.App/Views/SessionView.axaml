<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             xmlns:controls="using:Cockpit.App.Controls"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:sessions="using:Cockpit.Core.Sessions"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Cockpit.App.Views.SessionView"
             x:DataType="vm:SessionViewModel">

    <Design.DataContext>
        <vm:SessionViewModel/>
    </Design.DataContext>

    <!-- BackgroundTaskRowTemplate used to live here; it is now app-wide (Views/Shared/BackgroundTaskTemplates.axaml)
         so the assistant's chat window shows the same rows from the same template (AC-630). -->

    <!-- The pane is a Grid so the consent overlay (last child) can dim and cover the whole session. -->
    <Grid>
    <!-- Tight against the pane's own border on purpose: the pane already draws a frame and sits in a 4px grid
         gutter, so a wide inset here was a second margin inside the first — space the transcript and the composer
         can use better than the background can. -->
    <DockPanel Margin="6,6,6,8">

        <!-- Compact one-row session header (AC-37): the shared SessionHeaderBar (identity · activity · cwd · branch
             · token meter · usage pill) flexes, and this view's live controls dock right. The session is started
             from the New-session dialog (#31), so there is no Start button — only Stop plus the live
             mode/model/effort selectors, each shown only when the provider supports it. -->
        <!-- paneChrome (AC-670): out of a rail miniature. The tile carries its own identity strip, and this view
             hosts no TerminalControl, so collapsing the bar moves nothing a pty listens to — unlike TtyView's
             header, which is why that one is blanked instead of collapsed. -->
        <Border Classes="paneChrome" DockPanel.Dock="Top" Background="{StaticResource CockpitPanelBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}" Padding="8,4" Margin="0,0,0,6">
            <!-- V1 header (AC-37): a single identity/activity/usage strip that flexes, with the live controls
                 docked right. The activity column is the one that gives way (ellipsis) when the pane is narrow,
                 so name, cwd, branch and the usage pill keep their place instead of colliding — the half-width
                 overflow this redesign fixes. Same bar height as before (hard constraint). -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- The provider's own live controls (#45 D4): model, effort and permission mode, declared by the
                         driver and rendered generically. An SDK session can carry three of them, which crowded the
                         header — so they collapse behind a single sliders icon that opens a flyout to change them.
                         The driver still names, labels and values each control; the header keeps no built-in
                         provider vocabulary, and the values live in the flyout rather than on the bar.
                         The reading level (AC-138) joined them there (AC-562) — it was the last control still
                         standing loose on the bar. No IsVisible on the button any more: it used to hide with
                         HasLiveControls, which on a provider that declares none would now take the reading level
                         down with it. This is the SDK pane and the flyout always holds at least that one, so the
                         button is always warranted here; a TTY pane has neither and carries no such button. -->
                    <Button x:Name="SessionSettingsButton" Classes="toolChip" VerticalAlignment="Center" Padding="6,4"
                            ToolTip.Tip="What this session runs with, and how much of it you see — click to change">
                        <materialIcons:MaterialIcon Kind="Tune" Width="15" Height="15" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <!-- Two headings, because the flyout now mixes two kinds of setting: what the
                                     session does (model, effort, permission mode — they change the run) and how
                                     much of it is shown (reading level — it changes only this window). -->
                                <StackPanel MinWidth="200" Margin="4" Spacing="3">
                                    <TextBlock Text="Session" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"
                                               IsVisible="{Binding HasLiveControls}"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    <ItemsControl ItemsSource="{Binding LiveControls}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LiveControlViewModel">
                                                <StackPanel Spacing="3" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                    <ComboBox ItemsSource="{Binding ChoiceItems}"
                                                              SelectedValueBinding="{Binding Value}" SelectedValue="{Binding SelectedValue, Mode=TwoWay}"
                                                              DisplayMemberBinding="{Binding Label}"
                                                              PlaceholderText="{Binding Label}" Classes="Compact"
                                                              HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Display" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    <!-- Reading level (AC-138): how much of this SDK session to show — Developer
                                         (everything), Focus (tool runs fold, cost on the pill) or Simple (no tool
                                         noise, plain words). Binds the enum straight through the option's Value,
                                         so the running session still switches live from in here. -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Reading level" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <ComboBox x:Name="ReadingLevelPicker" ItemsSource="{Binding ReadingLevels}"
                                                  SelectedValueBinding="{Binding Value}" SelectedValue="{Binding ReadingLevel, Mode=TwoWay}"
                                                  DisplayMemberBinding="{Binding Label}" Classes="Compact"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="How much of the session to show — Developer, Focus or Simple"/>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton Content="Allow all tools" IsChecked="{Binding AutoApproveTools}" Classes="Compact"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowToolAutoApprove}"
                                  ToolTip.Tip="Run this local model's tool calls without an Allow prompt each time (they still show as tool rows)"/>
                </StackPanel>

                <!-- The one shared header strip (AC-37): dot · name · kind chip · activity · cwd · branch · token
                     meter · usage pill — defined once in SessionHeaderBar for every session kind, so the SDK and
                     TTY headers can no longer diverge. The live controls above dock right and stay on the bar.
                     The kind chip carries no hover here (AC-563): it used to open a card listing every tool the
                     session connected, which is the same total AC-537 took out of the status line for saying
                     nothing about the operator's own setup — a hundred-odd tool names is not an opinion about
                     anything. The KindChipTooltip slot stays; the TTY header still fills it with its render
                     diagnostics. What the operator actually wanted is the MCP-server list, and that hangs off the
                     activity column in SessionHeaderBar itself. -->
                <controls:SessionHeaderBar VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- AC-230/AC-683: the usage warning bar — one line per signal that has passed the point its provider
             called worth mentioning (a context window filling, an allowance nearly spent, the memory cap), each
             dismissible on its own. Stacked, blocking subjects first (AC-683 criterion 9), directly under the
             header so it reads as part of the same story the pills tell, in the amber they take at the same
             threshold. Built on the shared base, so this is the same bar the TTY session shows. -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionWarningItem">
                    <Border Classes="paneChrome" Margin="0,6,0,0" Padding="8,4"
                            Background="{StaticResource CockpitSecondaryBgBrush}"
                            BorderBrush="{StaticResource CockpitStatusWaitingBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CockpitControlRadius}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).ResumePrompt}"
                                         Width="150" FontSize="11" Padding="6,0"
                                         IsVisible="{Binding ShowResumeOffer}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center" MinHeight="0"
                                         ToolTip.Tip="What to send when the session picks up again. Starts on the provider's default."/>
                                <Button Content="Resume when it returns" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).ScheduleResumeCommand}"
                                        IsVisible="{Binding ShowResumeOffer}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Send this prompt a minute after the allowance rolls over."/>
                                <Button Content="At another time…" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).ChangeResumeMomentCommand}"
                                        IsVisible="{Binding ShowChangeResumeMoment}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Pick your own moment instead — the reset is the sensible default, not a rule."/>
                                <Button Content="Kill session" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).KillOverCapSessionCommand}"
                                        IsVisible="{Binding ShowKill}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Close this session now. Nothing closes it on its own once it is over its cap."/>
                                <!-- AC-782: manual context compaction, next to the automatic 80% trigger. -->
                                <Button Content="Compact" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).CompactCommand}"
                                        IsVisible="{Binding ShowCompact}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Ask the provider to summarise this conversation and carry on in it."/>
                                <!-- AC-713: opens in the row this starts (a fresh one, if none is open yet) — not
                                     here, so a login flow always plays out in the same place regardless of where
                                     it began. -->
                                <Button Content="Sign in again" Classes="Accent Compact"
                                        Command="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).SignInAgainCommand}"
                                        IsVisible="{Binding ShowSignInAgain}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Opens the sign-in flow in the transcript below."/>
                                <Button Content="Dismiss" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).DismissWarningCommand}"
                                        CommandParameter="{Binding Key}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Hide this warning. It comes back if the figure drops and climbs past the threshold again."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="GaugeFull" Width="15" Height="15"
                                                            Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- AC-231: a resume is waiting. Shown for as long as it is pending, with the moment it will fire and a way
             out — a timer that goes off at 07:30 with nothing on screen saying so is a surprise, not a feature. -->
        <Border Classes="paneChrome" DockPanel.Dock="Top" Margin="0,6,0,0" Padding="8,4"
                IsVisible="{Binding HasPendingResume}"
                Background="{StaticResource CockpitSecondaryBgBrush}"
                BorderBrush="{StaticResource CockpitAccentBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Classes="Compact"
                        Command="{Binding CancelResumeCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Drop the scheduled resume. Nothing will be sent."/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="15" Height="15"
                                                Foreground="{StaticResource CockpitAccentBrush}"/>
                    <TextBlock Text="{Binding PendingResumeLabel}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource CockpitAccentBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- AC-410: this pane was brought back after a restart — nothing has started yet. An offer, not a
             warning (hence the accent border, like the pending-resume banner above), and deliberately not
             silently dismissible: doing nothing leaves it standing, so the pane comes back again next run rather
             than vanishing without a trace. "Resume conversation" only shows when the plan is confident the
             earlier conversation is still reachable; "Start fresh" and "Close" are always offered. -->
        <Border Classes="paneChrome" DockPanel.Dock="Top" Margin="0,6,0,0" Padding="8,4"
                IsVisible="{Binding HasRestoreOffer}"
                Background="{StaticResource CockpitSecondaryBgBrush}"
                BorderBrush="{StaticResource CockpitAccentBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Resume conversation" Classes="Compact"
                            Command="{Binding ResumeConversationCommand}" IsVisible="{Binding CanResumeConversation}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Pick the earlier conversation back up where it left off."/>
                    <Button Content="Start fresh" Classes="Compact"
                            Command="{Binding StartFreshCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Start a new conversation in this pane instead."/>
                    <Button Content="Close" Classes="Compact"
                            Command="{Binding CloseRestoredPaneCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Close this pane. It was never started."/>
                </StackPanel>
                <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children with unbounded width in
                     the stacking direction, so the offer line never learns it has to stop and runs on underneath
                     the buttons docked to the right of it. The star column gives it the space that is actually
                     left. -->
                <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Restore" Width="15" Height="15"
                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RestoreOfferText}" VerticalAlignment="Center"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource CockpitAccentBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding RestoreDegradedReason}" IsVisible="{Binding !CanResumeConversation}"
                               Margin="21,0,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Input bar: queued-message chips, then pending-attachment chips, then dark multiline textbox + accent Send.
             The hairline is what tells the transcript apart from the composer's zone (AC-424). The transcript scrolls
             under it and its bottom row is cut mid-glyph — with nothing drawn between the two and the same background
             on both sides, that cut row read as colliding with the "Thinking…" indicator eight pixels below it, which
             is what the overlap report described. A boundary makes scrolled-under content read as scrolled-under. The
             8px that used to be this panel's top margin is now padding under the line, so nothing below the line
             moves; the transcript gives up the single pixel the line itself occupies. -->
        <Border x:Name="ComposerBorder" Classes="paneChrome" DockPanel.Dock="Bottom" Padding="0,8,0,0"
                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">

                <!-- "Still starting" banner: shown only while the session is actively launching (IsStarting), so it
                     never sits stuck after a failed start. It signals the session is coming up; a message typed too
                     early is answered by the composer's own "not started" notice rather than promised a send. -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding IsStarting}" Margin="0,0,0,8"
                        Background="{StaticResource CockpitSecondaryBgBrush}"
                        BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CockpitControlRadius}" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="9" Height="9"
                                   VerticalAlignment="Center" Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="Starting the session — one moment…" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- "Thinking…" indicator: shown from send until the assistant's first output, so a local model
                     that sits silent while it loads/processes visibly signals it is working rather than hung. The
                     dot pulses so it reads as live activity. Hidden while the tool-activity band below is showing
                     (AC-532) — the two occupy the same slot and are never both visible at once. -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding ShowThinkingIndicator}" Margin="2,0,0,8"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="10" Height="10"
                                   VerticalAlignment="Center" Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="Thinking…" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Tool-activity indicator (AC-532): replaces "Thinking…" for exactly the stretch it used to
                     leave blank — from a tool call surfacing to its result landing, the longest wait in a turn.
                     Names the running step (reusing the same "Tool  ·  summary" header the tool-use row itself
                     shows) plus a running elapsed time, so the composer never reads as idle while the session is
                     doing the slowest part of its work. Same slot as "Thinking…" above — one row, not a panel. -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasActiveToolActivity}" Margin="2,0,0,8"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="10" Height="10"
                                   VerticalAlignment="Center" Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="{Binding ActiveToolActivityLabel}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                        <!-- Third segment joined by the same "·" the mockup uses between all three (tool, step,
                             elapsed) — not just the first two. -->
                        <TextBlock Text="·" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                        <TextBlock Text="{Binding ActiveToolActivityAgeText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Queued messages (T8): typed while a turn was in flight, dispatched when it completes.
                     Each is a cancellable chip; hidden when the queue is empty. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding QueuedMessages}" Margin="0,0,0,8"
                              IsVisible="{Binding HasQueuedMessages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueuedMessageViewModel">
                            <Border Background="{StaticResource CockpitSecondaryBgBrush}"
                                    BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CockpitControlRadius}"
                                    Padding="8,4" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Queued" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center"
                                               MaxWidth="360" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                    <Button Command="{Binding RemoveCommand}" Classes="Subtle"
                                            VerticalAlignment="Center" Padding="4,0"
                                            ToolTip.Tip="Cancel this queued message">
                                        <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pasted-image chips: removable thumbnail + x. Hidden when there are no attachments. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,8"
                              IsVisible="{Binding HasPendingAttachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageAttachmentViewModel">
                            <Border Background="{StaticResource CockpitPanelBgBrush}"
                                    BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CockpitControlRadius}"
                                    Padding="4" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{Binding Thumbnail}" Height="44" MaxWidth="72" Stretch="Uniform"/>
                                    <Button Command="{Binding RemoveCommand}" Classes="Subtle"
                                            VerticalAlignment="Top" Padding="4,0"
                                            ToolTip.Tip="Remove image">
                                        <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Send stays enabled while busy (T8): a send mid-turn queues the message rather than
                     being blocked. CanSend gates on there being text/an image, so it is not a dead control. -->
                <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                        Classes="Accent composerAction" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                <!-- Stop sits by the composer, as an icon, only while a turn is actually running — so interrupting the
                     current turn (control_request/interrupt) is where the eye is, not a button parked in the header that
                     reads as live even when nothing is. Send stays put beside it so a follow-up can still be queued. -->
                <Button DockPanel.Dock="Right" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}"
                        Classes="Compact composerAction" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="8,6"
                        ToolTip.Tip="Stop the current turn (interrupt)">
                    <materialIcons:MaterialIcon Kind="Stop" Width="15" Height="15"/>
                </Button>
                <!-- Screenshot (AC-220): opens the desktop's own picker and attaches the result to this composer, so
                     it can be sent with a sentence of your own. ShowOnDisabled because the disabled state is the
                     interesting one — the tooltip is where a session that cannot take an image says why — and
                     Avalonia hides tooltips on disabled controls unless told otherwise. -->
                <Button DockPanel.Dock="Right" Command="{Binding CaptureScreenshotCommand}"
                        Classes="Compact composerAction" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="8,6"
                        ToolTip.Tip="{Binding ScreenshotTooltip}" ToolTip.ShowOnDisabled="True">
                    <materialIcons:MaterialIcon Kind="Monitor" Width="15" Height="15"/>
                </Button>
                <!-- Background work (AC-531): a persistent button next to Send that says how much sub-agent/shell
                     work is still running. Closes the exact gap AC-532 left open: TurnCompleted clears
                     HasActiveToolActivity and "Thinking…" both, but a detached sub-agent or shell can keep going
                     past that point, and this button's own count — driven straight off BackgroundTasksChanged,
                     never cleared by TurnCompleted itself (see the comment on that case in SessionViewModel) — is
                     what still says so. Always shown, like Stop/Screenshot; only the badge and the pop-out's own
                     contents change with the count (AC-531 #2: no badge at all at zero, not a "0" one). The detail
                     lives in the pop-out itself, not a separate pane (Raymond, 2026-07-31). -->
                <Button x:Name="BackgroundWorkButton" DockPanel.Dock="Left" Classes="Compact composerAction" VerticalAlignment="Bottom" Margin="0,0,8,0" Padding="8,6"
                        ToolTip.Tip="Sub-agents and shells still running in the background">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="Background" FontSize="12.5" VerticalAlignment="Center"/>
                        <Border x:Name="BackgroundWorkBadge" Background="{StaticResource CockpitStatusBackgroundBrush}"
                                CornerRadius="{StaticResource CockpitPillRadius}"
                                Padding="6,1" MinWidth="18" HorizontalAlignment="Center"
                                IsVisible="{Binding HasBackgroundTasks}">
                            <TextBlock Text="{Binding BackgroundTaskCount}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource CockpitTextOnStatusBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <materialIcons:MaterialIcon Kind="ChevronUp" Width="11" Height="11"
                                                    Foreground="{StaticResource CockpitTextFaintBrush}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <!-- TopEdgeAlignedLeft, not Top: Top centres the pop-out on its button, and this button sits
                             at the left edge of the composer, so a 410-wide pop-out centred on it hangs off the left
                             of the session pane and over the sidebar (Raymond, live test 2026-07-31). Aligning the
                             left edges instead makes it open rightwards, into the pane it belongs to. -->
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <StackPanel Spacing="0" Width="410">
                                <DockPanel Margin="10,9,10,7">
                                    <TextBlock DockPanel.Dock="Left" Text="Running now" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundTaskSummary}" FontSize="11.5"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                </DockPanel>

                                <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Empty state (AC-531 #3, mockup beeld 3): a provider that reports no background
                                     work at all lands here without error — same list, just nothing in it. -->
                                <TextBlock Text="No background work." FontSize="12.5" Margin="10,16"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                           IsVisible="{Binding !HasBackgroundTasks}"/>

                                <StackPanel IsVisible="{Binding HasBackgroundTasks}" Margin="0,4,0,0">
                                    <TextBlock Text="SUB-AGENTS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"
                                               IsVisible="{Binding HasBackgroundSubAgents}"/>
                                    <ItemsControl ItemsSource="{Binding BackgroundSubAgents}"
                                                  ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                                                  IsVisible="{Binding HasBackgroundSubAgents}"/>

                                    <TextBlock Text="SHELLS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"
                                               IsVisible="{Binding HasBackgroundShells}"/>
                                    <ItemsControl ItemsSource="{Binding BackgroundShells}"
                                                  ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                                                  IsVisible="{Binding HasBackgroundShells}"/>

                                    <!-- A task_type this build does not recognise (AC-276's Unknown): carried
                                         rather than dropped, so it still shows up here instead of vanishing from
                                         the count silently. -->
                                    <TextBlock Text="OTHER" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"
                                               IsVisible="{Binding HasBackgroundOtherTasks}"/>
                                    <ItemsControl ItemsSource="{Binding BackgroundOtherTasks}"
                                                  ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                                                  IsVisible="{Binding HasBackgroundOtherTasks}"/>
                                </StackPanel>

                                <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"
                                        Padding="10,7" IsVisible="{Binding HasBackgroundTasks}">
                                    <TextBlock Text="Disappears from the list once the work finishes." FontSize="10.5"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                </Border>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- AC-740: the @-mention file-/folder-picker. Anchored to the composer border rather than the
                     TextBox so it stays put regardless of caret position. IsLightDismissEnabled off because
                     open/close is driven entirely by MentionPickerViewModel's own state machine (typing, Esc,
                     Accept) — not pointer/focus heuristics — and the ListBox is never focused, so InputBox keeps
                     the caret the whole time this is showing (Iron Law #9: a Popup open while a TextBox keeps
                     focus is exactly the kind of thing that can look right in XAML and be wrong on screen). -->
                <Popup IsOpen="{Binding MentionPicker.IsOpen}" PlacementTarget="{Binding #ComposerBorder}"
                       Placement="Top" IsLightDismissEnabled="False" VerticalOffset="-4">
                    <Border Background="{StaticResource CockpitPanelBgBrush}"
                            BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CockpitControlRadius}"
                            Width="{Binding #ComposerBorder.Bounds.Width}" MaxHeight="220" Padding="0,4">
                        <Grid>
                            <TextBlock Text="Indexing…" FontSize="12" Margin="10,6"
                                       Foreground="{StaticResource CockpitTextFaintBrush}"
                                       IsVisible="{Binding MentionPicker.IsLoading}"/>
                            <ListBox Focusable="False" ItemsSource="{Binding MentionPicker.Matches}"
                                     SelectedItem="{Binding MentionPicker.Selected}"
                                     Background="Transparent" BorderThickness="0"
                                     IsVisible="{Binding !MentionPicker.IsLoading}">
                                <ListBox.Styles>
                                    <!-- Same recolour as the command palette (CommandPaletteDialog.axaml) — the
                                         theme's own selection accent read too loud for a row list this dense. -->
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MentionMatch">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,3">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ParentDirectory}"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}"
                                                       IsVisible="{Binding ParentDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <!-- IsEnabled binds IsInputEnabled (AC-174): an autonomous embedded run starts with its composer off so the
                     operator does not think they can type, until the surface's Intervene affordance re-enables it. Gating the
                     box only — not CanSend — so the host still submits the run's own opening brief through the send path. -->
                <TextBox x:Name="InputBox" Text="{Binding InputText}" IsEnabled="{Binding IsInputEnabled}"
                         PlaceholderText="Send a message...  (Enter = send, Shift+Enter = new line, Ctrl+V = paste text or image)"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Border>

        <!-- AC-802: PR/CI status and similar per-session banners, under the transcript and above the composer —
             one shared host, wired the same way in TtyView. Empty (no space taken) when no plugin registers one. -->
        <controls:PluginSessionBannerHost DockPanel.Dock="Bottom" Margin="0,0,0,6"
                                          IsVisible="{Binding ShowPluginHeaderItems}"/>

        <Grid>
        <!-- Empty-state card fills the transcript area until the first row arrives, so a fresh session
             reads as an introduced, connected model rather than a black void (L6): the model's own
             avatar, its name, provider/kind and connected-tools summary, then the prompt to start. -->
        <StackPanel IsVisible="{Binding !HasTranscript}" MaxWidth="420" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="avatarBadge" Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Creation" Width="26" Height="26"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{StaticResource CockpitAccentBrush}"/>
            </Border>
            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
            <TextBlock Text="{Binding KindLabel}" HorizontalAlignment="Center" FontSize="12.5"
                       Foreground="{StaticResource CockpitTextSecondaryBrush}"
                       IsVisible="{Binding KindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding ConnectedToolsHeading}" HorizontalAlignment="Center" FontSize="11.5"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource CockpitTextFaintBrush}"
                       IsVisible="{Binding ConnectedToolsHeading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="Type a message below to start." HorizontalAlignment="Center" FontSize="12.5"
                       IsVisible="{Binding IsSessionReady}"
                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
        </StackPanel>
            <!-- Virtualised (#memory): an ItemsControl builds a control tree for every row a session has ever
                 produced and keeps it alive forever — hundreds of megabytes of UI nobody is looking at, in a long
                 session. A VirtualizingStackPanel builds what is on screen. The rows the operator scrolled past cost
                 what they are worth: their view model, and nothing else.
                 The scroll owner is the transcript's own template, not a ScrollViewer wrapped around it (AC-686):
                 an enclosing ScrollViewer measures its content with infinite height, so the panel sizes itself
                 against a viewport it does not have and its extent is an estimate it keeps correcting. Inside the
                 template it measures against the real viewport, which is how every virtualising list in Avalonia is
                 built. x:Name still reads TranscriptScroll — the code-behind and the follow tests ask for the
                 transcript's scroll owner by that name. -->
            <!-- VisibleTranscript, not Transcript: a row the reading level hides is not an item at all, so the
                 virtualizing panel stops building a full TranscriptRowView for every folded step (see the
                 collection's own comment for the measurement). -->
            <ItemsControl x:Name="TranscriptItems" ItemsSource="{Binding VisibleTranscript}" IsVisible="{Binding HasTranscript}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="TranscriptScroll" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <!-- AC-722: the row itself lives in Controls/TranscriptRowView.axaml, shared with
                         AssistantChatWindow. The explicit views: anchor (not $parent[UserControl]) is required
                         here because TranscriptRowView is itself a UserControl and would match first. -->
                    <DataTemplate x:DataType="vm:TranscriptEntryViewModel">
                        <controls:TranscriptRowView
                            Session="{Binding $parent[views:SessionView].((vm:SessionViewModel)DataContext)}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        <!-- Scroll-to-bottom affordance: shown only when scrolled up (#21), jumps back to the newest
             row and resumes following. On top of the transcript (last Grid child), bottom-right. -->
        <Button x:Name="ScrollToBottomButton" IsVisible="False"
                Classes="Accent" Click="_OnScrollToBottomClick"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Width="32" Height="32" Padding="0" Margin="0,0,10,10"
                CornerRadius="16"
                ToolTip.Tip="Jump to the newest message">
            <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16"/>
        </Button>
        </Grid>

    </DockPanel>

    <!-- Consent overlay (#AC-47): dims the whole pane and centres the Approve/Deny card when a request
         is waiting on this session, so it plainly takes over rather than a banner that shifted the
         transcript and was easy to miss. Collapsed and hit-transparent while idle. -->
    <controls:ConsentBannerHost/>
    </Grid>
</UserControl>
