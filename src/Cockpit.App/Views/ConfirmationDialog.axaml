<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.ConfirmationDialog"
        x:DataType="vm:ConfirmationDialogViewModel"
        Title="Confirm"
        Width="440" SizeToContent="Height" CanResize="False"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:ConfirmationDialogViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CockpitChromeBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Ghost" Content="Cancel" Click="OnCancel"/>
                <!-- AC-428: the label is the caller's, and callers include plugins — ICockpitActions.ConfirmAsync
                     takes it as a free string. In a window fixed at 440 an unbounded label laid this button out
                     past the right edge (measured: an 86-character one ended at x=634), so it is bounded and
                     trimmed, with the whole label on the tooltip. 260 leaves room for Cancel and the padding. -->
                <Button Classes="Accent" Click="OnConfirm" MaxWidth="260"
                        ToolTip.Tip="{Binding ConfirmLabel}">
                    <TextBlock Text="{Binding ConfirmLabel}" TextTrimming="CharacterEllipsis"/>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,18" Spacing="8">
            <!-- The message can be a long git error (a failed worktree checkout dumps every file it could not
                 create). Bounded and scrolled so it never grows the window past its owner and pushes the action
                 buttons off-screen; short messages still size to their content. -->
            <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
