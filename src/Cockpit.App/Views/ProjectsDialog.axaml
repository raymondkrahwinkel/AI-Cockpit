<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:controls="using:Cockpit.App.Controls"
        xmlns:sharedProjects="using:Cockpit.Plugins.Abstractions.Projects"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.ProjectsDialog"
        x:DataType="vm:ProjectsViewModel"
        Title="Projects"
        Width="720" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:ProjectsViewModel/>
    </Design.DataContext>

    <!-- Projects manage themselves in their own window rather than as a tab in Options (Raymond, 2026-07-24):
         they are not a setting of the cockpit but the work it is pointed at, and where they come from is about to
         widen — a shared Depot environment as well as this machine. A tab inside the options tree would have to be
         unpicked again the moment that lands. -->
    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="1" Background="{StaticResource CockpitChromeBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="New project…" Classes="Accent" Command="{Binding AddProjectCommand}"/>
                    <Button Content="Edit…" Command="{Binding EditProjectCommand}"/>
                    <Button Content="{Binding ShareToggleLabel}" Command="{Binding ToggleSharingCommand}"/>
                    <Button Content="Remove" Command="{Binding RemoveProjectCommand}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Close" Click="OnClose"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,16,18,24" Spacing="12">
                <StackPanel Spacing="8" IsVisible="{Binding HasNothingToShow}" Margin="0,24,0,0">
                    <TextBlock Text="No projects yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource CockpitTextSecondaryBrush}"
                               Text="A project remembers the folder you work in, who works on it and what it may reach — so starting work on it is one click, every time."/>
                </StackPanel>

                <!-- AC-618: categories are the list's main grouping now; a project's origin (this machine, or which
                     Depot connection) is a badge on its own card (see ProjectCardViewModel.OriginBadge) rather than
                     AC-245's separate "On this machine" heading, which this replaces. An install where no project
                     carries a category gets exactly one group with no CategoryName, drawn with no heading at all —
                     the list looks precisely as it did before categories existed. -->
                <ItemsControl ItemsSource="{Binding ProjectCategoryGroups}" IsVisible="{Binding HasProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCategoryGroupViewModel">
                            <StackPanel Spacing="8" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                           IsVisible="{Binding HasHeader}"/>

                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                                            <!-- The same `ProjectRowView` the Projects page's List layout draws
                                                 (AC-772 criterion 22). This window used to carry its own copy of
                                                 the row, so every wording or layout change had to be made twice —
                                                 and the two had already drifted, this one still saying
                                                 "Memory: depot:cockpit" at a reader who has no idea what that is.
                                                 Selecting and double-click-to-edit stay this window's own: the row
                                                 is what a project looks like, not how a screen behaves. -->
                                            <controls:ProjectRowView PointerPressed="OnProjectPressed"
                                                                     DoubleTapped="OnProjectDoubleTapped"
                                                                     Cursor="Hand"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- AC-245: what a plugin shares elsewhere (AC-242's Depot sync) but this machine has not bound to
                     a local project yet — one section per source, populated in the background (ProjectsViewModel.
                     LoadSharedProjectsAsync) so a slow or unreachable connection never holds this window shut.
                     AC-246 adds the one action a row like this can take: "Finish setting up…", mirroring the
                     AC-158 pattern a local project without a profile already shows (a visible button on the card
                     itself, not a hidden context-menu-only action a first-time visitor to a shared connection would
                     have no reason to look for). -->
                <ItemsControl ItemsSource="{Binding SharedProjectGroups}" IsVisible="{Binding HasSharedProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SharedProjectGroupViewModel">
                            <StackPanel Spacing="6" Margin="0,10,0,0">
                                <!-- Same heading, same card and same wording as the Projects page's own section
                                     (AC-772 criterion 23) — one control rather than two templates that have to be
                                     kept in step by hand, which is how "Not set up yet" survived in two places. -->
                                <TextBlock Text="{Binding SourceName, StringFormat='From your team · {0}'}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource CockpitStatusErrorBrush}"
                                           IsVisible="{Binding HasError}"/>

                                <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sharedProjects:SharedProject">
                                            <!-- $parent[Window], not $parent[ItemsControl]: this row sits inside two
                                                 nested ItemsControls (groups, then projects), so the nearest ItemsControl
                                                 ancestor is the inner one — DataContext SharedProjectGroupViewModel, not
                                                 ProjectsViewModel. The window itself is the nearest ancestor typed right. -->
                                            <controls:SharedProjectCardView
                                                AddCommand="{Binding $parent[Window].((vm:ProjectsViewModel)DataContext).FinishSettingUpCommand}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
