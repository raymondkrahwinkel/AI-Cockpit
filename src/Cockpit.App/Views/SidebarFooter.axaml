<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="180"
             x:Class="Cockpit.App.Views.SidebarFooter"
             x:DataType="vm:CockpitViewModel">

    <!-- The panels sidebar's footer: Plugins, Menu and Help. The Simple rail shares only HelpMenu. -->
    <StackPanel Spacing="2">
        <Border Height="1" Background="{DynamicResource CockpitHairlineBrush}" Margin="0,4,0,6"/>
        <!-- The "Open mic" toggle that stood here is gone (AC-543). It drove exactly the command the
             assistant chip's listening mode now drives, so the two were one state with two switches —
             and its label still promised the old behaviour, dictating into the selected session, which
             open mic stopped doing. Comment 5 on the ticket puts that switch in the indicator on
             purpose: the chip is where you look to see who is listening, so it is where you reach to
             change it. -->
        <views:PluginsRow/>

        <!-- Everything you configure or look up once, behind one menu: the sidebar is for sessions. -->
        <Button x:Name="MenuButton" Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                ToolTip.Tip="Profiles, MCP servers, plugins, options and about">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="Menu" Width="16" Height="16"/>
                <TextBlock Text="Menu" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="Right" FlyoutPresenterClasses="Card">
                    <StackPanel Spacing="0" MinWidth="200">
                        <Button Classes="Subtle Row" Command="{Binding ManageProfilesCommand}"
                                ToolTip.Tip="Add, edit or remove session profiles">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="AccountOutline" Width="16" Height="16"/>
                                <TextBlock Text="Profiles" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Subtle Row" Command="{Binding OpenMcpServersCommand}"
                                ToolTip.Tip="Add, edit or remove shared MCP servers">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="Server" Width="16" Height="16"/>
                                <TextBlock Text="MCP servers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Subtle Row" Command="{Binding OpenVerifyRunnersCommand}"
                                ToolTip.Tip="Register the per-project command the visual verify loop may run">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16"/>
                                <TextBlock Text="Verify runners" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Subtle Row" Command="{Binding ShowCommandPaletteCommand}"
                                ToolTip.Tip="Run any app or plugin command by name — Ctrl+K">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16"/>
                                <TextBlock Text="Command palette" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Subtle Row" Command="{Binding OptionsCommand}"
                                ToolTip.Tip="Configure notifications, sessions, and voice — Ctrl+O">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16"/>
                                <TextBlock Text="Options" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Subtle Row" Command="{Binding AboutCommand}"
                                ToolTip.Tip="App version and links">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- AC-512: the guide's content lives on the website, not in the app (Raymond) — this is the
             one findable door to it, plus the two things that need no browser at all: a glossary and
             re-running first-run setup. AC-937: same flush-list Flyout shell as "Menu"/"Plugins ›". -->
        <Button x:Name="HelpButton" Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                ToolTip.Tip="The online guide, a glossary of terms, and re-running first-run setup">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                <TextBlock Text="Help" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="Right" FlyoutPresenterClasses="Card">
                    <views:HelpMenu/>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
