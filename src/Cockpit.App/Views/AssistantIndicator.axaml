<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220"
             x:Class="Cockpit.App.Views.AssistantIndicator"
             x:DataType="vm:AssistantIndicatorViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:AssistantIndicatorViewModel/>
    </Design.DataContext>

    <!-- AC-543: reusable assistant indicator — the chip lives here (never in CockpitView.axaml, criterion 21)
         so AC-238 can drop the same control into the companion window. Vormtaal transcribed from
         cockpit-assistant-indicator-2026-08-01.html: a rounded chip with a circular mic badge on the left and a
         two-line label on the right, whose badge alone (no chip chrome, no label) is what the sidebar rail
         keeps once it collapses. -->
    <StackPanel Spacing="8">
        <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="IsFeatureEnabled"/>
                <Binding Path="ShowWhenDisabled" ElementName="Root"/>
            </MultiBinding>
        </StackPanel.IsVisible>

        <!-- Rail form: shown once the sidebar collapses. Same ring, same classes, no label — see
             Theme.axaml's Border.assistantIndicatorRing remarks for why the colour/ring alone still answer
             "who is listening" without room for prose. The pulse ring sits in a Panel beside the badge, not
             inside its Border: a Border clips its child to its own bounds, so a ring meant to grow past the
             badge's edge (Theme.axaml's Ellipse.assistantIndicatorPulseRing) has to be a sibling, not a child. -->
        <Button Classes="assistantIndicatorRail" Command="{Binding ClickCommand}" IsVisible="{Binding IsCollapsed}"
                ToolTip.Tip="{Binding Label}">
            <!-- Pinned to the rail badge's 30px, clipping off — same reason as the chip's badge Panel. -->
            <Panel Width="30" Height="30" ClipToBounds="False">
                <!-- The level arc, which is why this idea was picked over the bottom-edge bars: in the rail the
                     badge is the whole indicator, and an arc around it still says how loud it is there. -->
                <Arc Classes="assistantIndicatorLevelArc rail" Classes.dictating="{Binding IsDictating}"
                     IsVisible="{Binding ShowsLevel}" SweepAngle="{Binding LevelSweep}"/>
                <Border Classes="assistantIndicatorRing"
                        Classes.listening="{Binding IsListening}"
                        Classes.listeningContinuously="{Binding IsListeningContinuously}"
                        Classes.thinking="{Binding IsWorking}"
                        Classes.speaking="{Binding IsSpeaking}"
                        Classes.dictating="{Binding IsDictating}"
                        Classes.awaitingOperator="{Binding IsAwaitingOperator}"
                        Classes.unavailable="{Binding IsUnavailable}">
                    <Grid>
                        <materialIcons:MaterialIcon Kind="Microphone" IsVisible="{Binding IsMicIcon}"/>
                        <materialIcons:MaterialIcon Kind="ThoughtBubble" IsVisible="{Binding IsWorking}"/>
                        <materialIcons:MaterialIcon Kind="VolumeHigh" IsVisible="{Binding IsSpeaking}"/>
                        <materialIcons:MaterialIcon Kind="HandBackLeftOutline" IsVisible="{Binding IsAwaitingOperator}"/>
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" IsVisible="{Binding IsUnavailable}"/>
                        <!-- Criterion 19: the standing "listening continuously" mode carries a small fixed dot the
                             momentary F10/F9 hold never shows — see the style's own remarks on why it is drawn on
                             the ring rather than on chip-only chrome, so it survives into this rail too. -->
                        <Ellipse Classes="assistantIndicatorModeDot" IsVisible="{Binding IsListeningContinuously}"/>
                    </Grid>
                </Border>
                <!-- AC-575, criterion 5: the consent bypass is visible without opening Options. A sibling of the
                     ring rather than a child of it, for the same reason the pulse ring is one — a Border clips its
                     child, and this sits on the badge's corner. It survives into the rail because the rail is the
                     only chip there is once the sidebar is collapsed, and a permission that hides itself when the
                     sidebar narrows is a permission you stop noticing. -->
                <materialIcons:MaterialIcon Classes="assistantIndicatorBypassMark" Kind="ShieldOffOutline"
                                            IsVisible="{Binding IsConsentBypassActive}"
                                            ToolTip.Tip="Some consent cards are skipped for the assistant. Change this in Options → Voice."/>
            </Panel>
        </Button>

        <!-- Expanded form: the chip plus the listening-mode picker (criterion 17), both hidden once the
             sidebar is a rail — there is nowhere for either to sit. -->
        <StackPanel Spacing="8" IsVisible="{Binding !IsCollapsed}">

            <!-- Vormgeving pass (2026-08-01): the whole chip tints per state, not only the mic badge — the
                 Classes bindings below are what let Theme.axaml paint the chip's own border/background per
                 state (Button.assistantIndicatorChip.listening etc.), the same way the ring's classes already
                 did before this pass. -->
            <Button Classes="assistantIndicatorChip"
                    Classes.listening="{Binding IsListening}"
                    Classes.listeningContinuously="{Binding IsListeningContinuously}"
                    Classes.thinking="{Binding IsWorking}"
                    Classes.speaking="{Binding IsSpeaking}"
                    Classes.dictating="{Binding IsDictating}"
                    Classes.awaitingOperator="{Binding IsAwaitingOperator}"
                    Classes.unavailable="{Binding IsUnavailable}"
                    Command="{Binding ClickCommand}">
                <!-- Three columns, not four. The mockup lays badge / label / meter / key across 340px; this chip
                     gets about 164 in the sidebar, and with the meter and the key both taking their width first
                     the star column collapsed — "Listening" and "Speaking" rendered with no label at all, and
                     "Dictating" broke one letter per line. The label is the one thing criterion 6 is about, so it
                     wins the width and the meter moves down beside the detail line, which has room to spare. -->
                <!-- Two rows rather than a StackPanel with Spacing: the preparation bar below is hidden in every
                     state but one, and a StackPanel's spacing is reserved whether or not the child it separates is
                     there — which left the chip 5px taller than its contents and everything in it sitting high.
                     A collapsed row takes nothing, and the gap rides on the bar's own margin. -->
                <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <!-- Pinned to the badge's own size, with clipping off: the pulse ring grows past it and must
                         be free to do so visually while contributing nothing to measure. Without this the ring's
                         animation resizes this Panel every frame, which resizes the chip — the jumping that
                         reached Raymond twice. -->
                    <Panel Grid.Column="0" Width="26" Height="26" ClipToBounds="False">
                        <!-- The microphone level, drawn as an arc around the badge rather than as bars along the
                             chip's bottom edge (Raymond's pick, 2026-08-08). It replaces the pulse ring that used
                             to sit here for Listening: the ring said "live", the arc says live *and* how loud,
                             and two circles around one 26px badge is one too many. -->
                        <Arc Classes="assistantIndicatorLevelArc" Classes.dictating="{Binding IsDictating}"
                             IsVisible="{Binding ShowsLevel}" SweepAngle="{Binding LevelSweep}"/>
                        <Border Classes="assistantIndicatorRing small"
                                Classes.listening="{Binding IsListening}"
                                Classes.listeningContinuously="{Binding IsListeningContinuously}"
                                Classes.thinking="{Binding IsWorking}"
                                Classes.speaking="{Binding IsSpeaking}"
                                Classes.dictating="{Binding IsDictating}"
                                Classes.awaitingOperator="{Binding IsAwaitingOperator}"
                                Classes.unavailable="{Binding IsUnavailable}">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="Microphone" IsVisible="{Binding IsMicIcon}"/>
                                <materialIcons:MaterialIcon Kind="ThoughtBubble" IsVisible="{Binding IsWorking}"/>
                                <materialIcons:MaterialIcon Kind="VolumeHigh" IsVisible="{Binding IsSpeaking}"/>
                                <materialIcons:MaterialIcon Kind="HandBackLeftOutline" IsVisible="{Binding IsAwaitingOperator}"/>
                                <materialIcons:MaterialIcon Kind="AlertCircleOutline" IsVisible="{Binding IsUnavailable}"/>
                                <Ellipse Classes="assistantIndicatorModeDot" IsVisible="{Binding IsListeningContinuously}"/>
                            </Grid>
                        </Border>
                        <!-- The same mark as the rail above — see there for why it is a sibling of the ring. -->
                        <materialIcons:MaterialIcon Classes="assistantIndicatorBypassMark" Kind="ShieldOffOutline"
                                                    IsVisible="{Binding IsConsentBypassActive}"
                                                    ToolTip.Tip="Some consent cards are skipped for the assistant. Change this in Options → Voice."/>
                    </Panel>
                    <!-- Wrapping, not trimming. The sidebar this lives in is about 170px wide, and the longest
                         label ("Listening continuously") does not fit on one line there — trimmed, it read
                         "Listening continu…", which is the one state whose whole point is that it is visibly
                         different from the momentary one. Found by rendering it in the real sidebar rather than
                         in the component's own roomier scene. -->
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Classes="assistantIndicatorLabel" Text="{Binding Label}" TextWrapping="Wrap"/>
                        <!-- The detail line carries the meter beside it. The meter is a live-capture cue, shown
                             only while something is actually moving through the mic or the speaker — Listening,
                             Speaking, Dictating. Thinking has no audio to meter, and ListeningContinuously is a
                             standing mode rather than a handeling, so neither shows it. -->
                        <!-- No level meter here, unlike the mockup. Its chip is 340px wide; this one gets ~164 in
                             the sidebar, and the five bars took exactly the width the word "Assistant" needed —
                             it rendered as "Assistan/t". Criterion 6 is about the chip saying who is listening in
                             colour AND in words, so the words win. Nothing is lost that is not said twice over:
                             the pulse ring on the badge already means live, and the push-to-talk overlay — which
                             has a full screen's width and is what you are actually looking at during a hold —
                             still carries the real waveform. -->
                        <TextBlock Classes="assistantIndicatorDetail" Text="{Binding Detail}" TextWrapping="Wrap"
                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <!-- The chip's corner: switch or key badge, never both — see ViewModel.ShowsListeningSwitch
                         for why one corner is all a 164px chip has, and which of the two each state gets. -->
                    <Border Grid.Column="2" Classes="assistantIndicatorKey" VerticalAlignment="Center"
                            IsVisible="{Binding ShowsKeyHint}">
                        <TextBlock Text="{Binding KeyHint}"/>
                    </Border>
                    <!-- The listening mode, as one switch instead of the Off / Always on row this used to carry
                         below the chip (Raymond, 2026-08-08). A stand that is on or off is what CheckBox.Switch is
                         for, and moving it into the chip drops a whole second line from the sidebar. Its click goes
                         through ToggleListeningMode, so AlwaysOn's one-time cost explanation still stands in front
                         of it; IsChecked is one-way because the stand is the host's answer, not the switch's. -->
                    <CheckBox Grid.Column="2" Classes="Switch assistantIndicatorSwitch"
                              IsVisible="{Binding ShowsListeningSwitch}"
                              IsChecked="{Binding IsListeningModeAlwaysOn, Mode=OneWay}"
                              Command="{Binding ToggleListeningModeCommand}"
                              ToolTip.Tip="On: the microphone stays open and everything you say goes to the assistant. Off: only the held assistant hotkey opens it."/>
                </Grid>
                <!-- The first-use fetch, which is a ~1.6 GB model and can take minutes (AC-543, 2026-08-08 — this
                     used to be the pill's own row). Only for a step that knows its total: one parked at an invented
                     position is worse than the counting words alone, which the label above already carries. -->
                <ProgressBar Grid.Row="1" Classes="assistantIndicatorPreparation" Margin="0,5,0,0"
                             IsVisible="{Binding ShowsPreparationProgress}"
                             Value="{Binding PreparationProgressValue}" Minimum="0" Maximum="1"/>
                </Grid>
            </Button>

            <!-- Listening mode (criteria 17/18/comment 5) is the switch inside the chip above, not a row of its
                 own down here. The Off / Always on buttons this used to be said the same thing in two controls and
                 a whole extra line of a 164px sidebar; Raymond's call, 2026-08-08. AlwaysOn's confirmation stays
                 inline below rather than in a dialog — the switch already put the operator's attention on this
                 exact chip, and a modal for a one-line, one-time warning would be a bigger interruption than the
                 thing it warns about. SelectListeningModeOff/AlwaysOn are still the commands underneath (the
                 switch delegates to them), and AssistantListeningMode.AlwaysOnWithWakeWord is still refused by
                 AssistantIndicatorCoordinator rather than offered anywhere. -->

            <!-- The one-time AlwaysOn cost explanation (criterion 18) — shown once, on the pick, never again
                 once AlwaysOnCostAcknowledged is true (see AssistantIndicatorViewModel.SelectListeningModeAlwaysOn). -->
            <Border Classes="assistantIndicatorConfirm" IsVisible="{Binding IsAlwaysOnConfirmationPending}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="Everything you say will be sent to the assistant, and every utterance costs. This is asked once."/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Turn on" Classes="Accent Compact" Command="{Binding ConfirmAlwaysOnCommand}"/>
                        <Button Content="Cancel" Classes="Ghost Compact" Command="{Binding CancelAlwaysOnConfirmationCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
</UserControl>
