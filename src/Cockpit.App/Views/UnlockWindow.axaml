<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:config="using:Cockpit.Core.Configuration"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.UnlockWindow"
        x:DataType="vm:UnlockViewModel"
        Icon="/Assets/AppIcon.ico"
        Title="{x:Static config:CockpitProduct.DisplayName}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:UnlockViewModel/>
    </Design.DataContext>

    <StackPanel Margin="28,26" Spacing="14">
        <!-- The mark, where a tile with the letters "AI" in it used to stand in for one (AC-430). Only the
             height is set: the mark is wider than it is tall and squaring it off would deform it. -->
        <Image Source="/Assets/BrandMark.png" Height="48" Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               HorizontalAlignment="Center"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Locked" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Your API keys and tokens are encrypted. Type the password to unlock them."
                       FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
        </StackPanel>

        <!-- AC-1879: the screen-lock unlock offers the same Hello button as the splash; the prompt waits for a click here. -->
        <Button Classes.Accent="{Binding !HelloTried}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                IsVisible="{Binding OffersHello}" IsEnabled="{Binding !IsBusy}" Click="OnHello">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#x263A;" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HelloButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <TextBox Name="PasswordBox" PasswordChar="•" PlaceholderText="Password"
                 Text="{Binding Password}" IsEnabled="{Binding !IsBusy}"
                 KeyDown="OnPasswordKeyDown"/>

        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource CockpitStatusErrorBrush}"/>

        <TextBlock Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>

        <Button Content="Unlock" Classes.Accent="{Binding UnlockIsPrimary}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsEnabled="{Binding !IsBusy}" Click="OnUnlock"/>

        <Button Content="I forgot my password" HorizontalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource CockpitTextSecondaryBrush}" FontSize="12"
                IsEnabled="{Binding !IsBusy}" IsVisible="{Binding OffersReset}" Click="OnForgot"/>
    </StackPanel>
</Window>
