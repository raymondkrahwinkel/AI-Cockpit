<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cockpit.App.Views.CompanionWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <!-- Chrome copied from VoiceOverlayWindow (no decorations, rounded translucent card), but interactive and
         draggable — see CompanionWindow.axaml.cs for why it skips the overlay's X11 click-through input shape. -->
    <Border x:Name="Card" Margin="16" BoxShadow="{DynamicResource CockpitFloatingCardShadow}" Background="{DynamicResource CockpitFloatingCardBrush}" BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1" CornerRadius="16">
        <StackPanel x:Name="Strip" Margin="6" Spacing="4">
            <Border x:Name="Grip" Background="Transparent" Padding="4" Cursor="SizeAll" ToolTip.Tip="Drag to move">
                <materialIcons:MaterialIcon x:Name="GripIcon" Width="16" Height="16" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            </Border>
            <!-- AC-2209: while the assistant may look at the screen; the card's border turns cyan with it. -->
            <StackPanel x:Name="LookAlong" IsVisible="False" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Eye" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{DynamicResource CockpitStatusBusyBrush}" ToolTip.Tip="The assistant may look at your screen"/>
                <TextBlock x:Name="LookAlongTimer" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource CockpitTextPrimaryBrush}"/>
                <Button x:Name="LookAlongStop" Classes="Compact" Content="Stop" HorizontalAlignment="Center"
                        ToolTip.Tip="Stop the assistant looking at your screen"/>
            </StackPanel>
            <TextBlock x:Name="EmptyState" Text="No tools available" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            <StackPanel x:Name="ToolsHost" Spacing="4"/>
            <Button x:Name="MoreButton" Classes="Subtle Compact" ToolTip.Tip="More">
                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16"/>
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="Card">
                        <StackPanel MinWidth="220">
                            <Button x:Name="OrientationItem" Classes="Subtle Row">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <materialIcons:MaterialIcon Kind="RotateRight" Width="16" Height="16"/>
                                    <TextBlock x:Name="OrientationLabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TopmostItem" Classes="Subtle Row">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <materialIcons:MaterialIcon x:Name="TopmostIcon" Width="16" Height="16"/>
                                    <TextBlock Text="Always on top" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CustomizeItem" Classes="Subtle Row">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="16" Height="16"/>
                                    <TextBlock Text="Customize strip…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Separator/>
                            <Button x:Name="HideItem" Classes="Subtle Row">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16"/>
                                    <TextBlock Text="Hide" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Border>
</Window>
