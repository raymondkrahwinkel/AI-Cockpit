<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cockpit.App.Views.ScreenshotSelectionWindow"
        x:DataType="vm:ScreenshotSelectionViewModel"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        CanResize="False"
        Cursor="Cross">

  <Window.Styles>
    <!-- The panel's own controls. Styled here rather than in Theme.axaml because nothing else in the app is a
         chip-sized tool button over a frozen screenshot, and a token nobody else reads is a token in the wrong
         place. The colours themselves all come from the theme. -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="{StaticResource CockpitInsetBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{StaticResource CockpitTextSecondaryBrush}" />
      <!-- The surface handles every key itself, and a focused button would take them. Clicking a tool must not
           cost you the keyboard — the two are meant to be interchangeable, not exclusive. -->
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource CockpitTextPrimaryBrush}" />
    </Style>
    <!-- The chosen tool, said in the accent rather than only by a shade of grey: which mode you are in is the
         one thing this panel exists to answer. -->
    <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource CockpitAccentBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource CockpitTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Both panels are the same object with different tools on it, so they are one style rather than two copies
         of five setters that would drift apart the first time one of them was adjusted. -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource CockpitPanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
      <!-- The hand you get when the pointer is over something you can pick up, which is the only thing that says
           a panel can be moved at all. -->
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Border.panel Button.tool">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- The ink and weight buttons. Smaller than a tool and unlabelled: what they are is what they look like. -->
    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}" />
    </Style>
    <!-- The chosen one, said with the same accent ring the tools use, so "which is on" reads the same way twice. -->
    <Style Selector="Button.swatch.active">
      <Setter Property="BorderBrush" Value="{StaticResource CockpitAccentBrush}" />
      <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Background" Value="{StaticResource CockpitWindowBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CockpitHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinWidth" Value="18" />
    </Style>
    <Style Selector="Border.key > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource CockpitTextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <!-- The captured image is the background, not a transparent layer over the live screen: what feels like
       dragging on your desktop is dragging on a frozen picture of it. Stretch="Fill" is deliberate — the window
       covers exactly the desktop the capture came off, so filling it is what makes the view model's one ratio
       between window units and image pixels true. -->
  <Panel Name="Surface">
    <Image Name="Capture" Stretch="Fill" />

    <!-- Everything outside the selection is dimmed by four rectangles rather than a cut-out, which Avalonia has
         no primitive for. Their bounds are set in code from the same conversion the pointer goes through.
         The dim is the one value with no token behind it: nothing else in the app darkens a whole screen, and
         the theme has no shade for it — the same reason VoiceOverlayWindow hardcodes its own translucent pill. -->
    <Canvas Name="Shade" IsHitTestVisible="False">
      <Rectangle Name="ShadeTop" Fill="#99000000" />
      <Rectangle Name="ShadeBottom" Fill="#99000000" />
      <Rectangle Name="ShadeLeft" Fill="#99000000" />
      <Rectangle Name="ShadeRight" Fill="#99000000" />
      <Rectangle Name="Marquee" Stroke="{StaticResource CockpitAccentBrush}" StrokeThickness="1" />
      <Border Name="Readout"
              Background="{StaticResource CockpitSecondaryBgBrush}"
              BorderBrush="{StaticResource CockpitHairlineBrush}"
              BorderThickness="1"
              CornerRadius="3"
              Padding="6,3">
        <TextBlock Name="ReadoutText" Foreground="{StaticResource CockpitTextPrimaryBrush}" FontSize="12" />
      </Border>
    </Canvas>

    <!-- The control panels (AC-358, split in AC-374), on a Canvas of their own so each can be put where the
         pointer's display is and then moved by hand. The Canvas has no background, so only the panels themselves
         take the pointer — the rest of the surface still starts a drag.

         Two of them rather than one: what is being taken, and what is being put on it. They were one panel on two
         rows until an operator wanted the marking tools somewhere else — which is the whole reason to split them,
         because the reason to move a panel is almost always that *one* of the two groups is over the thing you
         are working on, and that is the one that has to move. -->
    <Canvas>
      <Border Name="Controls" Classes="panel">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="RegionTool" Classes="tool" Classes.active="{Binding DraggingRegion}" Click="_OnRegionTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="SelectDrag" Width="15" Height="15" />
                <TextBlock Text="Region" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="R" /></Border>
              </StackPanel>
            </Button>

            <!-- Disabled where the desktop will not say where its windows are (Wayland). ShowOnDisabled, because
                 Avalonia hides a tooltip on a disabled control by default — and the reason it is off is exactly
                 what an operator hovering it wants to know. -->
            <Button Name="WindowTool" Classes="tool" Classes.active="{Binding PickingWindow}"
                    IsEnabled="{Binding CanPickWindow}"
                    ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="{Binding WindowToolTip}"
                    Click="_OnWindowTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="WindowMaximize" Width="15" Height="15" />
                <TextBlock Text="Window" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="W" /></Border>
              </StackPanel>
            </Button>

            <!-- Grouped with the two above it because all three answer what is being taken; Hide answers what is
                 being left out of it. "Everything" rather than "Full screen" because the capture is every screen
                 at once — on two displays a full screen would be the wrong half of what this takes.
                 Lit by what is marked out rather than by a mode, since taking everything is not one: it is on
                 while the selection is the whole capture and goes out the moment anything smaller is dragged. -->
            <Button Name="EverythingTool" Classes="tool" Classes.active="{Binding TakingEverything}" Click="_OnEverythingTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="SelectAll" Width="15" Height="15" />
                <TextBlock Text="Everything" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="A" /></Border>
              </StackPanel>
            </Button>

        </StackPanel>
      </Border>

      <!-- The marking panel. Everything on it goes on the picture rather than deciding what it is, and they share
           a drag, a list and one Ctrl+Z. This is the panel the epic keeps adding to, so its row wraps within a
           fixed width rather than growing sideways without limit. -->
      <Border Name="MarkControls" Classes="panel">
        <StackPanel Spacing="9">
          <WrapPanel MaxWidth="430" ItemSpacing="6" LineSpacing="6">
            <Button Name="OutlineTool" Classes="tool" Classes.active="{Binding Outlining}" Click="_OnOutlineTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="RectangleOutline" Width="15" Height="15" />
                <TextBlock Text="Outline" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="O" /></Border>
              </StackPanel>
            </Button>

            <!-- The one tool that says "that" rather than "this area" — which is what an operator most often
                 wants from a screenshot, and the reason the mark layer exists at all. -->
            <Button Name="ArrowTool" Classes="tool" Classes.active="{Binding Pointing}" Click="_OnArrowTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="ArrowTopRight" Width="15" Height="15" />
                <TextBlock Text="Arrow" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="P" /></Border>
              </StackPanel>
            </Button>

            <!-- The only tool that says what to think rather than where to look, which is why it is last on the
                 row and last in this epic. -->
            <Button Name="LabelTool" Classes="tool" Classes.active="{Binding Labelling}" Click="_OnLabelTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="FormatText" Width="15" Height="15" />
                <TextBlock Text="Note" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="T" /></Border>
              </StackPanel>
            </Button>

            <!-- The tool for everything the shapes cannot say: round a thing, through a thing, along a path. -->
            <Button Name="DrawTool" Classes="tool" Classes.active="{Binding Drawing}" Click="_OnDrawTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Draw" Width="15" Height="15" />
                <TextBlock Text="Draw" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="D" /></Border>
              </StackPanel>
            </Button>

            <!-- Next to Hide on purpose: the two do opposite things to the same drag, and the row is where an
                 operator picks between "make sure they read this" and "make sure they never see it". -->
            <Button Name="HighlightTool" Classes="tool" Classes.active="{Binding Highlighting}" Click="_OnHighlightTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Marker" Width="15" Height="15" />
                <TextBlock Text="Highlight" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="H" /></Border>
              </StackPanel>
            </Button>

            <Button Name="RedactTool" Classes="tool" Classes.active="{Binding Redacting}" Click="_OnRedactTool">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="EyeOff" Width="15" Height="15" />
                <TextBlock Text="Hide" FontSize="12" VerticalAlignment="Center" />
                <Border Classes="key"><TextBlock Text="B" /></Border>
              </StackPanel>
            </Button>
          </WrapPanel>

          <Rectangle Height="1" Fill="{StaticResource CockpitHairlineBrush}" MaxWidth="430" />

          <!-- What the next mark is drawn in (AC-375). Inks on the left, line weight on the right, because they
               are two different questions about the same next mark. Redaction is missing from both on purpose: it
               pixelates, and has neither a colour nor a line. -->
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Name="InkAccent" Classes="swatch" Click="_OnInkAccent"><Ellipse Name="InkAccentDot" Classes="dot" /></Button>
              <Button Name="InkRed" Classes="swatch" Click="_OnInkRed"><Ellipse Name="InkRedDot" Classes="dot" /></Button>
              <Button Name="InkYellow" Classes="swatch" Click="_OnInkYellow"><Ellipse Name="InkYellowDot" Classes="dot" /></Button>
              <Button Name="InkGreen" Classes="swatch" Click="_OnInkGreen"><Ellipse Name="InkGreenDot" Classes="dot" /></Button>
              <Button Name="InkWhite" Classes="swatch" Click="_OnInkWhite"><Ellipse Name="InkWhiteDot" Classes="dot" /></Button>
            </StackPanel>

            <Rectangle Width="1" Height="18" Fill="{StaticResource CockpitHairlineBrush}" VerticalAlignment="Center" />

            <!-- The weights are drawn rather than named: "thin" and "thick" are the same length in words and
                 nothing at all in pixels, and what is being chosen is a line. -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Name="WeightThin" Classes="swatch" Click="_OnWeightThin">
                <Rectangle Width="18" Height="1.5" Fill="{StaticResource CockpitTextPrimaryBrush}" VerticalAlignment="Center" />
              </Button>
              <Button Name="WeightMedium" Classes="swatch" Click="_OnWeightMedium">
                <Rectangle Width="18" Height="3.5" Fill="{StaticResource CockpitTextPrimaryBrush}" VerticalAlignment="Center" />
              </Button>
              <Button Name="WeightThick" Classes="swatch" Click="_OnWeightThick">
                <Rectangle Width="18" Height="6" Fill="{StaticResource CockpitTextPrimaryBrush}" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </StackPanel>

          <TextBlock Name="HintText"
                     Foreground="{StaticResource CockpitTextSecondaryBrush}"
                     FontSize="12"
                     MaxWidth="430"
                     TextWrapping="Wrap"
                     Text="{Binding Hint}" />
        </StackPanel>
      </Border>
    </Canvas>
  </Panel>
</Window>
