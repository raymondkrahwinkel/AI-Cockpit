<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:controls="using:Cockpit.App.Controls"
             xmlns:sessions="using:Cockpit.Core.Sessions"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="600"
             x:Class="Cockpit.App.Views.AssistantChatView"
             x:Name="Root"
             x:DataType="vm:AssistantChatViewModel">

    <!-- AC-952: the assistant's chat surface, host-agnostic. Everything window-shaped (bounds, drag-to-move,
         Topmost, resize grip, the Windows caption roles) stays in AssistantChatWindow, which is now a thin
         shell around this. The AC-543 reasoning below is unchanged, only one level further in. -->
    <!-- AC-543 criterion 5/7: a pop-out onto the assistant's own standing conversation, not a pane in the
         workspace grid — precedent is Autopilot's plan pop-out (AutopilotPlanWorkspaceBody._ShowPlanningPopoutAsync),
         a small floating window rather than another tab.
         AC-636 reverses AC-543's "no 'bigger' affordance (COMMENT 6 #1, decided)": `Controls/WindowResizeGrip`
         gives it the same edges/corners — and the same decorations — every other cockpit window resizes by
         (AC-678/AC-755), from the constructor. MinWidth/MinHeight stay the floor. -->

    <!-- Root is a Grid, NOT a Border: a Border wrapping this window's transcript VirtualizingStackPanel pins every
         recycled TranscriptRowView via the border's CompositionBorderVisual — the same leak as the session grid's
         PaneRoot (rows leave the visual tree but the border's composition visual holds their draw-lists until the
         window closes; ~600 rows/360MB on a long assistant conversation). The rounded hairline frame is a SIBLING
         overlay at the end of this Grid; the window's outer corners are rounded by the OS (Win11 DWM under
         ExtendClientAreaToDecorationsHint), so dropping the old frame's ClipToBounds changes no visible corner. -->
    <Grid>
        <DockPanel>

            <!-- Header: profile name, the read-aloud switch (criterion 9 — the same switch Options carries, via
                 IAssistantSpeakToggle), and Close. Nothing else — no reading-level picker, no live-control tune
                 button: those belong to a full session pane, and this window is a
                 peephole, not one. Draggable by the bar, like every other chromeless window in this app
                 (Controls/CockpitWindowChrome does the same for dialogs; not reused here because it has no room
                 for a toggle button, only a title and caption buttons). -->
            <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{StaticResource CockpitChromeBgBrush}"
                    BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,0,0,1"
                    Padding="12,9">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Border Grid.Column="0" Classes="avatarBadge" Width="28" Height="28" CornerRadius="9" Margin="0,0,8,0">
                        <materialIcons:MaterialIcon Kind="Creation" Width="14" Height="14"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <!-- AC-1040: the assistant's own page, from the window it is read in. The row is the
                             title's; the `?` is added to it in the code-behind and is absent when the page is. -->
                        <StackPanel x:Name="TitleRow" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Assistant" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Session.ActiveProfileLabel}" FontSize="11"
                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                   IsVisible="{Binding Session.ActiveProfileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- AC-575, criterion 5. This window is where the assistant's work is read, so it is also
                             where "some of these were never shown to you" has to be legible. Says that it is on,
                             not which sources — that list is Options', and a header is not a settings page. -->
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ConsentBypassActive}">
                            <materialIcons:MaterialIcon Kind="ShieldOffOutline" Width="11" Height="11"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                            <TextBlock Text="Consent card skipped for some sources" FontSize="10.5"
                                       Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                       ToolTip.Tip="Set in Options → Voice. Every skipped card is still written to the consent trail."/>
                        </StackPanel>
                    </StackPanel>
                    <!-- AC-662/AC-694: the sidebar chip's listening mode (AssistantIndicator.axaml), driven through
                         `Indicator` so the one-time cost confirmation stays in step instead of being copied. An icon
                         button, not the chip's `CheckBox.Switch`: a track reads as a stray control in a strip of icons. -->
                    <ToggleButton x:Name="ListeningModeToggle" Grid.Column="2" Classes="Subtle Compact" VerticalAlignment="Center" Margin="0,0,4,0"
                                  IsVisible="{Binding Indicator, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  IsChecked="{Binding Indicator.IsListeningModeAlwaysOn, Mode=OneWay, FallbackValue=False}"
                                  Command="{Binding Indicator.ToggleListeningModeCommand}"
                                  ToolTip.Tip="{Binding Indicator.IsListeningModeAlwaysOn, Converter={x:Static conv:ListeningModeIconConverter.Tip}, FallbackValue=False}">
                        <materialIcons:MaterialIcon Kind="{Binding Indicator.IsListeningModeAlwaysOn, Converter={x:Static conv:ListeningModeIconConverter.Icon}, FallbackValue=False}"
                                                    Width="14" Height="14"/>
                    </ToggleButton>

                    <!-- AC-694 reverts AC-685's `Subtle` here; the style stays in Theme.axaml for the listen toggle. -->
                    <ToggleButton x:Name="ReadAloudToggle" Grid.Column="3" IsChecked="{Binding SpeakReplies}" Classes="Compact"
                                  VerticalAlignment="Center" Margin="0,0,4,0"
                                  ToolTip.Tip="{Binding SpeakReplies, Converter={x:Static conv:ReadAloudIconConverter.Tip}}">
                        <materialIcons:MaterialIcon Kind="{Binding SpeakReplies, Converter={x:Static conv:ReadAloudIconConverter.Icon}}"
                                                    Width="14" Height="14"/>
                    </ToggleButton>

                    <!-- AC-776 Deel 2: history and export merged into one dropdown (decision B2) — the
                         Flyout-with-rows pattern from Controls/PluginToolbarHost.cs:94-120. A Flyout can carry
                         anything, so the spawn-log panel below moves in unchanged, lazy load included; a "Save
                         conversation" row sits under it instead of being its own button. Not a MenuFlyout
                         (rejected as B1): the spawn log is a whole panel, not a command, so it cannot be a
                         MenuItem without inventing a submenu-hosts-a-panel trick this project has no precedent for. -->
                    <Button x:Name="HistoryButton" Grid.Column="4" Classes="Subtle Compact" VerticalAlignment="Center" Margin="0,0,4,0"
                            ToolTip.Tip="History and export">
                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opened="_OnSpawnLogFlyoutOpened">
                                <StackPanel Width="280" Spacing="0">
                                    <TextBlock Text="Spawn log" FontSize="11.5" FontWeight="SemiBold"
                                               Margin="10,8,10,6"
                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

                                    <!-- Empty state: nothing recorded yet — a fresh install, or a window opened
                                         before the assistant has ever asked to start anything. -->
                                    <TextBlock Text="The assistant has not started anything yet." FontSize="11.5"
                                               Margin="10,14" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"
                                               IsVisible="{Binding !HasSpawnLogEntries}"/>

                                    <ScrollViewer MaxHeight="320" IsVisible="{Binding HasSpawnLogEntries}">
                                        <ItemsControl ItemsSource="{Binding SpawnLogEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AssistantSpawnLogRowViewModel">
                                                    <StackPanel Spacing="2" Margin="10,7">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding When}" FontSize="10.5"
                                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                            <TextBlock Text="{Binding What}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                                                            <!-- Criterion 5's first field. One word today, because
                                                                 the assistant is the only caller there is; the day
                                                                 AC-436's coordinator writes to this trail its rows
                                                                 are otherwise indistinguishable from these. -->
                                                            <TextBlock Text="{Binding Who}" FontSize="10.5"
                                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Where}" FontSize="11"
                                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        <!-- The session by name, so the trail reads without anyone
                                                             having to match pane ids by eye. Absent on a refused
                                                             start, which produced no session to name. -->
                                                        <TextBlock Text="{Binding Session}" FontSize="10.5"
                                                                   IsVisible="{Binding HasSession}"
                                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding StartDetails}" FontSize="10.5" TextWrapping="Wrap"
                                                                   IsVisible="{Binding HasStartDetails}"
                                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                        <TextBlock Text="{Binding Refusal}" FontSize="10.5" FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                                   IsVisible="{Binding HasRefusal}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

                                    <!-- Save the conversation as text. This window is the assistant's only surface,
                                         so a conversation that went wrong here can only be shown to anyone else by
                                         describing it from memory or photographing the screen. Plain text, every
                                         row, folded ones included — same _OnExportClick as before the merge. -->
                                    <Button Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="10,8" Margin="4" Click="_OnExportClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Save conversation as text file…" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

                                    <!-- AC-1261: empties the transcript on screen and starts a new conversation.
                                         The old one stays readable in transcripts/ (AC-947 retention, unchanged),
                                         and memory/current-state survive it untouched — the confirmation dialog
                                         says so. -->
                                    <Button Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="10,8" Margin="4" Command="{Binding ClearConversationCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="Broom" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Clear conversation…" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- No restart button here, deliberately. It was here first, on the reasoning that a restart is
                         a handling and this window carries handlings — which argues that it *may* stand here, not
                         that it belongs. It belongs beside the setting that needs it: the permission mode in
                         Options → Voice → Assistant Profile, where the sentence "this applies at the next start"
                         and the start that answers it are one thing instead of two windows apart. -->
                    <!-- AC-953: the one button that differs per host — Dock into the right-hand rail, or Undock
                         back out to this floating window. One flag on the view model instead of a second copy of
                         this whole button row per host; the coordinator does the swap (it is what knows which
                         hosts there are), this only asks for it. -->
                    <Button x:Name="DockToggleButton" Grid.Column="5" Classes="Subtle Compact" VerticalAlignment="Center" Margin="0,0,4,0"
                            Command="{Binding ToggleDockCommand}"
                            ToolTip.Tip="{Binding IsDocked, Converter={x:Static conv:DockToggleConverter.Tip}}">
                        <materialIcons:MaterialIcon Kind="{Binding IsDocked, Converter={x:Static conv:DockToggleConverter.Icon}}"
                                                    Width="14" Height="14"/>
                    </Button>

                    <!-- AC-1009: hidden while docked, same reason as Close — a docked panel has no window of its
                         own to minimise. -->
                    <Button x:Name="MinimizeButton" Grid.Column="6" Classes="Subtle Compact" VerticalAlignment="Center" Margin="0,0,4,0"
                            IsVisible="{Binding !IsDocked}"
                            Click="_OnMinimizeClick" ToolTip.Tip="Minimize">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" Width="13" Height="13"/>
                    </Button>

                    <!-- AC-952: hidden while docked, where Undock takes its place (AC-953) — the docked host's
                         TopLevel is MainWindow, so there is no window of its own here to close. -->
                    <Button x:Name="CloseButton" Grid.Column="7" Classes="Subtle Compact" VerticalAlignment="Center"
                            IsVisible="{Binding !IsDocked}"
                            Click="_OnCloseClick" ToolTip.Tip="Close (the conversation keeps running)">
                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- AC-683: usage-pill row, the same segmented pill SessionHeaderBar renders for a session pane —
                 this window has no SessionHeaderBar of its own (it is a peephole, not a full session header,
                 with its own title/dot/kind chip already drawn above), so the pill pattern is reproduced here
                 rather than the whole control reused, which would drag those in too.
                 AC-776: wrapped in a WrapPanel together with the session-status pill below, so a window too
                 narrow for both breaks the second pill onto its own line instead of clipping it or shoving the
                 usage pill aside — same WrapPanel/340px-MinWidth precedent as the warning bar's own button row
                 further down ("T2's narrow-window layout"). -->
            <WrapPanel DockPanel.Dock="Top" Margin="10,6,10,0" ItemSpacing="8" LineSpacing="6">
                <Border ClipToBounds="True"
                        Background="{StaticResource CockpitSecondaryBgBrush}"
                        BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CockpitPillRadius}"
                        IsVisible="{Binding Session.HasUsagePillRegion, FallbackValue=False}">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Session.UsagePillItems}" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UsagePillItem">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="1" Background="{StaticResource CockpitHairlineBrush}"
                                                IsVisible="{Binding ShowLeadingDivider}"/>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="10" Padding="8,2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding SeverityBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                                   ToolTip.Tip="{Binding Tooltip}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Width="1" Background="{StaticResource CockpitHairlineBrush}"
                                IsVisible="{Binding Session.ShowChevronDivider, FallbackValue=False}"/>
                        <Button VerticalAlignment="Stretch" Padding="6,2"
                                MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                IsVisible="{Binding Session.HasUsagePill, FallbackValue=False}"
                                ToolTip.Tip="{Binding Session.LimitsTooltip}">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource CockpitTextFaintBrush}"/>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="8" MinWidth="210" Margin="4">
                                        <TextBlock Text="Usage" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <controls:LimitBar Label="ctx" Percent="{Binding Session.ContextUsedPercent}" Threshold="{Binding Session.ContextThreshold}" FontSize="10" Height="14"
                                                           StretchTrack="True" HorizontalAlignment="Stretch"/>
                                        <ItemsControl ItemsSource="{Binding Session.RateLimits}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sessions:SessionRateWindow">
                                                    <StackPanel Spacing="1" Margin="0,4,0,0">
                                                        <controls:LimitBar Label="{Binding Label}" Percent="{Binding UsedPercent}" Threshold="{Binding ThresholdPercent}" FontSize="10" Height="14"
                                                                           StretchTrack="True" HorizontalAlignment="Stretch"/>
                                                        <TextBlock Text="{Binding ResetsAt, Converter={x:Static conv:RateWindowResetConverter.Instance}}"
                                                                   FontSize="10" Foreground="{StaticResource CockpitTextFaintBrush}"
                                                                   IsVisible="{Binding ResetsAt, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Session.UnreportedWindowsNotice}" FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                   IsVisible="{Binding Session.UnreportedWindowsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- AC-776 Deel 1: session-status pill, same shape as the usage pill above — same
                     CockpitSecondaryBgBrush/CockpitHairlineBrush/CockpitPillRadius, 1px dividers between segments —
                     one segment per live agent session (statusdot + name). Its own Border/IsVisible (pitfall 3): it
                     must not disappear along with the usage pill just because the assistant has not reported usage yet. -->
                <Border x:Name="SessionPill" ClipToBounds="True"
                        Background="{StaticResource CockpitSecondaryBgBrush}"
                        BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CockpitPillRadius}"
                        IsVisible="{Binding HasLiveSessions}">
                    <StackPanel Orientation="Horizontal">
                        <!-- The list's one fixed entry (criterion 4): always first, never itself clickable content —
                             a real Button+Flyout, not a TextBlock in the same Border, so the flyout gets its own popup
                             layer (pitfall 2). A5a's WrapPanel leaves nothing for it to actually drop (pitfall 5's "no
                             MaxSessions cap" plus the wrap already giving every name a line), so it always reads "⋯" —
                             a numbered "⋯n" would need the A5b measuring panel this ticket keeps out of scope. -->
                        <Button x:Name="SessionListButton" Classes="Subtle Compact" Padding="8,2" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="All sessions">
                            <TextBlock Text="⋯" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="2" MinWidth="220" MaxWidth="280" Margin="4">
                                        <TextBlock Text="Sessions" FontSize="11.5" FontWeight="SemiBold"
                                                   Margin="6,4" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding LiveSessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SessionPanelViewModel">
                                                    <!-- AC-949: same click as a session badge (_OnSessionSegmentPressed) —
                                                         identical DataContext type, so no new command or VM change needed. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,4"
                                                                Cursor="Hand" Background="Transparent"
                                                                PointerPressed="_OnSessionSegmentPressed">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                                       MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                <TextBlock Text="{Binding SessionStatusLabel}" FontSize="10.5"
                                                                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                                <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                                <TextBlock FontSize="10.5" Foreground="{StaticResource CockpitTextSecondaryBrush}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{x:Static conv:SessionDeskNameConverter.Instance}">
                                                                            <Binding Path="PaneId"/>
                                                                            <Binding Path="#Root.((vm:AssistantChatViewModel)DataContext).DeskNameByPaneId"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Statusline}" FontSize="10.5" TextWrapping="Wrap"
                                                                       MaxWidth="220"
                                                                       Foreground="{StaticResource CockpitAccentBrush}"
                                                                       IsVisible="{Binding Statusline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ItemsControl x:Name="SessionSegments" ItemsSource="{Binding LiveSessions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionPanelViewModel">
                                    <!-- AC-895: clickable-without-a-Button (same idiom as CockpitView's widget header,
                                         OnWidgetHeaderPressed) — a Button here would need transparent chrome to keep
                                         today's look, while this row already carries the tooltip and needs no flyout. -->
                                    <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                                PointerPressed="_OnSessionSegmentPressed">
                                        <ToolTip.Tip>
                                            <MultiBinding Converter="{x:Static conv:SessionTooltipConverter.Instance}">
                                                <Binding Path="Title"/>
                                                <Binding Path="SessionStatusLabel"/>
                                                <Binding Path="PaneId"/>
                                                <Binding Path="Statusline"/>
                                                <Binding Path="#Root.((vm:AssistantChatViewModel)DataContext).DeskNameByPaneId"/>
                                            </MultiBinding>
                                        </ToolTip.Tip>
                                        <Border Width="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding SessionStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="10" MaxWidth="110"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- AC-230/AC-683: the same usage-warning bar the SDK session view shows, bound through Session so a
                 5h/wk crossing (or the memory cap) appears here too — this window had none, so a running-out
                 allowance was invisible on the one surface with no pane in the grid to show it on. -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Session.Warnings}" Margin="10,6,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionWarningItem">
                        <!-- Buttons docked right, sentence filling the rest (AC-893), same DockPanel shape as
                             SessionView.axaml. The sentence is a Grid, not a StackPanel: a StackPanel measures
                             its stacked child with unbounded width, so TextWrapping never fires there. -->
                        <Border Padding="8,4"
                                Background="{StaticResource CockpitSecondaryBgBrush}"
                                BorderBrush="{StaticResource CockpitStatusWaitingBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CockpitControlRadius}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                                    <TextBox Text="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.ResumePrompt}"
                                             Width="150" FontSize="11" Padding="6,0" Margin="0,0,6,4"
                                             IsVisible="{Binding ShowResumeOffer}"
                                             VerticalContentAlignment="Center" MinHeight="0"
                                             ToolTip.Tip="What to send when the session picks up again. Starts on the provider's default."/>
                                    <Button Content="Resume when it returns" Classes="Compact" Margin="0,0,6,4"
                                            Command="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.ScheduleResumeCommand}"
                                            IsVisible="{Binding ShowResumeOffer}"
                                            ToolTip.Tip="Send this prompt a minute after the allowance rolls over."/>
                                    <Button Content="At another time…" Classes="Compact" Margin="0,0,6,4"
                                            Command="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.ChangeResumeMomentCommand}"
                                            IsVisible="{Binding ShowChangeResumeMoment}"
                                            ToolTip.Tip="Pick your own moment instead — the reset is the sensible default, not a rule."/>
                                    <Button Content="Kill session" Classes="Compact" Margin="0,0,6,4"
                                            Command="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.KillOverCapSessionCommand}"
                                            IsVisible="{Binding ShowKill}"
                                            ToolTip.Tip="Close this session now. Nothing closes it on its own once it is over its cap."/>
                                    <!-- AC-782: manual context compaction, next to the automatic 80% trigger. -->
                                    <Button Content="Compact" Classes="Compact" Margin="0,0,6,4"
                                            Command="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.CompactCommand}"
                                            IsVisible="{Binding ShowCompact}"
                                            ToolTip.Tip="Ask the provider to summarise this conversation and carry on in it."/>
                                    <!-- AC-713: opens in the row this starts (a fresh one, if none is open yet) —
                                         not here, so a login flow always plays out in the same place regardless
                                         of where it began. -->
                                    <Button Content="Sign in again" Classes="Accent Compact" Margin="0,0,6,4"
                                            Command="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.SignInAgainCommand}"
                                            IsVisible="{Binding ShowSignInAgain}"
                                            ToolTip.Tip="Opens the sign-in flow in the transcript below."/>
                                    <Button Content="Dismiss" Classes="Compact" Margin="0,0,0,4"
                                            Command="{Binding $parent[views:AssistantChatView].((vm:AssistantChatViewModel)DataContext).Session.DismissWarningCommand}"
                                            CommandParameter="{Binding Key}"
                                            ToolTip.Tip="Hide this warning. It comes back if the figure drops and climbs past the threshold again."/>
                                </WrapPanel>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="GaugeFull" Width="13" Height="13"
                                                                Margin="0,0,6,0" VerticalAlignment="Top"
                                                                Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- AC-662: the switch's one-time cost explanation (criterion 18 on the sidebar chip), reused here
                 rather than re-worded — same Indicator, same command, so acknowledging it once covers both
                 surfaces. -->
            <Border DockPanel.Dock="Top" Classes="assistantIndicatorConfirm" Margin="10,8,10,0"
                    IsVisible="{Binding Indicator.IsAlwaysOnConfirmationPending, FallbackValue=False}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="Everything you say will be sent to the assistant, and every utterance costs. This is asked once."/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Turn on" Classes="Accent Compact" Command="{Binding Indicator.ConfirmAlwaysOnCommand}"/>
                        <Button Content="Cancel" Classes="Ghost Compact" Command="{Binding Indicator.CancelAlwaysOnConfirmationCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer: the text field plus what a message can carry with it (AC-630 — queued chips, image
                 attachments, the screenshot button). Still no send button: Enter sends, Shift+Enter inserts a
                 newline, Ctrl+V attaches an image and Arrow-Up recalls the last queued message, so the whole
                 composer stays reachable from the keyboard alone (criterion 8). -->
            <Border x:Name="ComposerBorder" DockPanel.Dock="Bottom" Padding="10,6,10,10" BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="6">
                    <!-- Progress, read straight off the session the same way SessionView.axaml reads it. The window
                         is a narrower frame on the same SDK view, so it owes the operator the same answer to "is it
                         doing anything" — and without these it did not have one: a turn that called two tools showed
                         an unchanged window until the rows landed afterwards, which reads exactly like an assistant
                         that did not hear you. No new state; all three of these are properties SessionViewModel
                         already maintains for the main view. -->

                    <!-- "Thinking…" from send until the first output, and only while no tool is running — the same
                         ShowThinkingIndicator that already encodes that rule, rather than a second opinion here. -->
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                IsVisible="{Binding Session.ShowThinkingIndicator, FallbackValue=False}">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="9" Height="9"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="Thinking…" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Replaces "Thinking…" for the stretch it used to leave blank (AC-532): a tool call is the
                         longest wait in a turn, and naming the running step is the difference between a window that
                         looks stuck and one that is visibly working. Same slot, one row. -->
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                IsVisible="{Binding Session.HasActiveToolActivity, FallbackValue=False}">
                        <materialIcons:MaterialIcon Kind="Circle" Classes="pulse" Width="9" Height="9"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Text="{Binding Session.ActiveToolActivityLabel}" FontSize="11.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Background work (AC-531): a detached sub-agent or shell outlives both indicators above, and
                         this count is what still says so. No badge at zero rather than a "0" one, the same rule the
                         main view applies. Clickable since AC-630: the detail used to be "in the main view", but the
                         assistant has no pane in any workspace (BelongsToNoWorkspace), so there was nowhere at all to
                         see what it was running. Same rows, same template as the session pane
                         (Views/Shared/BackgroundTaskTemplates.axaml) — not a second copy. -->
                    <!-- Subtle alone: Button.Compact is declared after Button.Subtle, so it puts the filled
                         28px surface back and Padding="0" then pushes the pill and chevron into its corners. -->
                    <Button Classes="Subtle" HorizontalAlignment="Left" Padding="0"
                            IsVisible="{Binding Session.HasBackgroundTasks, FallbackValue=False}"
                            ToolTip.Tip="Sub-agents and shells still running in the background">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="Background" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            <Border Background="{StaticResource CockpitStatusBackgroundBrush}"
                                    CornerRadius="{StaticResource CockpitPillRadius}"
                                    Padding="6,1" MinWidth="18">
                                <TextBlock Text="{Binding Session.BackgroundTaskCount}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource CockpitTextOnStatusBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="11" Height="11"
                                                        Foreground="{StaticResource CockpitTextFaintBrush}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft">
                                <StackPanel Spacing="0" Width="330">
                                    <DockPanel Margin="10,9,10,7">
                                        <TextBlock DockPanel.Dock="Left" Text="Running now" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Session.BackgroundTaskSummary}" FontSize="11.5"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    </DockPanel>

                                    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"/>

                                    <!-- Work that finishes while the flyout is open empties the list rather than
                                         closing it — same empty state the session pane's pop-out shows. -->
                                    <TextBlock Text="No background work." FontSize="12.5" Margin="10,16"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource CockpitTextFaintBrush}"
                                               IsVisible="{Binding !Session.HasBackgroundTasks}"/>

                                    <StackPanel IsVisible="{Binding Session.HasBackgroundTasks}" Margin="0,4,0,0">
                                        <TextBlock Text="SUB-AGENTS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                   IsVisible="{Binding Session.HasBackgroundSubAgents}"/>
                                        <ItemsControl ItemsSource="{Binding Session.BackgroundSubAgents}"
                                                      ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                                                      IsVisible="{Binding Session.HasBackgroundSubAgents}"/>

                                        <TextBlock Text="SHELLS" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                   IsVisible="{Binding Session.HasBackgroundShells}"/>
                                        <ItemsControl ItemsSource="{Binding Session.BackgroundShells}"
                                                      ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                                                      IsVisible="{Binding Session.HasBackgroundShells}"/>

                                        <TextBlock Text="OTHER" FontSize="10" FontWeight="SemiBold" Margin="10,4,10,2"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                   IsVisible="{Binding Session.HasBackgroundOtherTasks}"/>
                                        <ItemsControl ItemsSource="{Binding Session.BackgroundOtherTasks}"
                                                      ItemTemplate="{StaticResource BackgroundTaskRowTemplate}"
                                                      IsVisible="{Binding Session.HasBackgroundOtherTasks}"/>
                                    </StackPanel>

                                    <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="0,1,0,0"
                                            Padding="10,7" IsVisible="{Binding Session.HasBackgroundTasks}">
                                        <TextBlock Text="Disappears from the list once the work finishes." FontSize="10.5"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Criterion 9: read-aloud off is a text-assistant, said plainly rather than left to a
                         silent speaker icon — a switched-off toggle a few pixels up in the header is easy to miss
                         the one time it matters (a reply that never gets read out loud). -->
                    <TextBlock Text="Read-aloud is off — replies land here only." FontSize="10.5"
                               Foreground="{StaticResource CockpitTextFaintBrush}"
                               IsVisible="{Binding !SpeakReplies}"/>
                    <!-- AC-935: the reply target a row's reply button set, shown above the composer until sent
                         or cancelled — the same Session.PendingReplyTo the send path itself reads and clears,
                         not a separate chip-only flag. -->
                    <Border x:Name="ReplyChip" Background="{StaticResource CockpitSecondaryBgBrush}"
                            BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CockpitControlRadius}"
                            Padding="8,4" Margin="0,0,0,6"
                            IsVisible="{Binding Session.HasPendingReplyTo, FallbackValue=False}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CommentArrowLeftOutline" Width="13" Height="13"
                                                        Foreground="{StaticResource CockpitTextFaintBrush}"/>
                            <TextBlock Text="Replying to" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                            <TextBlock Text="{Binding Session.PendingReplyExcerpt}" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            <Button x:Name="ReplyChipCancelButton" Command="{Binding Session.ClearReplyTargetCommand}" Classes="Subtle"
                                    VerticalAlignment="Center" Padding="4,0"
                                    ToolTip.Tip="Cancel this reply">
                                <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Queued messages (AC-630): typed while a turn was in flight, dispatched when it completes.
                         Same chips as the session pane, on the same Session.QueuedMessages — without them the input
                         box emptied, nothing appeared, and the message landed minutes later unannounced.
                         Arrow-Up on an empty box pulls the last one back to edit (see the code-behind). -->
                    <ItemsControl ItemsSource="{Binding Session.QueuedMessages}"
                                  IsVisible="{Binding Session.HasQueuedMessages, FallbackValue=False}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueuedMessageViewModel">
                                <Border Background="{StaticResource CockpitSecondaryBgBrush}"
                                        BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CockpitControlRadius}"
                                        Padding="8,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Queued" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center"
                                                   MaxWidth="240" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <Button Command="{Binding RemoveCommand}" Classes="Subtle"
                                                VerticalAlignment="Center" Padding="4,0"
                                                ToolTip.Tip="Cancel this queued message">
                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pasted/captured images waiting to go with the next message (AC-630) — the same chips and the
                         same Session.PendingAttachments the session pane's composer shows. -->
                    <ItemsControl ItemsSource="{Binding Session.PendingAttachments}"
                                  IsVisible="{Binding Session.HasPendingAttachments, FallbackValue=False}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageAttachmentViewModel">
                                <Border Background="{StaticResource CockpitPanelBgBrush}"
                                        BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CockpitControlRadius}"
                                        Padding="4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Height="44" MaxWidth="72" Stretch="Uniform"/>
                                        <Button Command="{Binding RemoveCommand}" Classes="Subtle"
                                                VerticalAlignment="Top" Padding="4,0"
                                                ToolTip.Tip="Remove image">
                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel>
                        <!-- AC-855: a clickable send button next to Enter, same convention as SessionView.axaml. -->
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Command="{Binding SendCommand}"
                                IsEnabled="{Binding CanSend}"
                                Classes="Accent composerAction" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                Content="Send"/>
                        <!-- AC-942: same shape and placement as SessionView.axaml's Stop button, only visible while a
                             turn is running. Also cuts read-aloud (AssistantChatViewModel.StopCommand). -->
                        <Button x:Name="StopButton" DockPanel.Dock="Right" Command="{Binding StopCommand}"
                                IsVisible="{Binding Session.IsBusy, FallbackValue=False}"
                                Classes="Compact composerAction" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="8,6"
                                ToolTip.Tip="Stop the current turn (interrupt)">
                            <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14"/>
                        </Button>
                        <!-- Screenshot (AC-220, reaching this window in AC-630): the desktop's own region picker with
                             its marking tools, landing as an attachment on the composer rather than a message of its
                             own. ShowOnDisabled because the disabled state is the interesting one — the tooltip is
                             where a session that cannot take an image says why. -->
                        <Button x:Name="ScreenshotButton" DockPanel.Dock="Right" Command="{Binding Session.CaptureScreenshotCommand}"
                                Classes="Compact composerAction" VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="8,6"
                                ToolTip.Tip="{Binding Session.ScreenshotTooltip}" ToolTip.ShowOnDisabled="True">
                            <materialIcons:MaterialIcon Kind="Monitor" Width="14" Height="14"/>
                        </Button>
                        <TextBox x:Name="InputBox" Text="{Binding InputText}"
                                 PlaceholderText="{Binding PushToTalkKeyName, StringFormat='Type, or hold {0} to talk…'}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" VerticalContentAlignment="Top"/>
                    </DockPanel>

                    <!-- AC-740: the @-mention picker — same shape as SessionView.axaml's. IsLightDismissEnabled off
                         because open/close is driven entirely by MentionPickerViewModel's own state, and the
                         ListBox is never focused, so InputBox keeps the caret throughout. -->
                    <Popup IsOpen="{Binding MentionPicker.IsOpen}" PlacementTarget="{Binding #ComposerBorder}"
                           Placement="Top" IsLightDismissEnabled="False" VerticalOffset="-4">
                        <Border Background="{StaticResource CockpitPanelBgBrush}"
                                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CockpitControlRadius}"
                                Width="{Binding #ComposerBorder.Bounds.Width}" MaxHeight="220" Padding="0,4">
                            <Grid>
                                <TextBlock Text="Indexing…" FontSize="12" Margin="10,6"
                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                           IsVisible="{Binding MentionPicker.IsLoading}"/>
                                <ListBox Focusable="False" ItemsSource="{Binding MentionPicker.Matches}"
                                         SelectedItem="{Binding MentionPicker.Selected}"
                                         Background="Transparent" BorderThickness="0"
                                         IsVisible="{Binding !MentionPicker.IsLoading}">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{StaticResource CockpitSecondaryBgBrush}"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MentionMatch">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,3">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ParentDirectory}"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                                           IsVisible="{Binding ParentDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>

            <Grid>
                <!-- The assistant cannot be reached at all (criterion 1): says why, rather than sitting on an
                     empty transcript that looks like nothing was ever said. -->
                <StackPanel IsVisible="{Binding IsUnavailable}" MaxWidth="280" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="24" Height="24"
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource CockpitTextFaintBrush}"/>
                    <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Empty state: no session started yet, or one with nothing said in it yet — same message
                     either way, since both read as "nothing to show" to the operator. -->
                <StackPanel IsVisible="{Binding !IsUnavailable}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="260" Spacing="10">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsUnavailable"/>
                            <Binding Path="!HasMessages"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <Border Classes="avatarBadge" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Creation" Width="22" Height="22"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                    </Border>
                    <TextBlock Text="Type a message to start talking with the assistant." TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource CockpitTextFaintBrush}"/>
                </StackPanel>

                <!-- The transcript itself: SessionView.axaml's own row (Controls/TranscriptRowView.axaml, AC-722),
                     just in a narrower frame — the scroller stays this window's own (always-follow, not
                     SessionView's stick-only-while-at-bottom), see the code-behind.
                     Virtualised (AC-774): AC-722 shared TranscriptRowView with SessionView but only wired
                     SessionView's own copy to the viewport-safe VirtualizingStackPanel (AC-686) — this copy kept
                     the plain StackPanel inside an enclosing ScrollViewer, so every row a session ever produced
                     stayed a live control tree forever. Mirrors SessionView.axaml's ItemsControl exactly: the
                     ScrollViewer lives in the ItemsControl's own template so the panel measures against a real
                     viewport, not the infinite height an enclosing ScrollViewer would hand it. x:Name still reads
                     TranscriptScroll — the code-behind and the follow tests ask for the transcript's scroll owner
                     by that name. -->
                <ItemsControl x:Name="TranscriptItems" ItemsSource="{Binding Session.VisibleTranscript}" IsVisible="{Binding HasMessages}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="TranscriptScroll">
                                <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:StableExtentPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!-- AC-722: same row as SessionView.axaml, via Controls/TranscriptRowView.axaml —
                             this is what makes AC-715's question card (and everything else the old, narrower
                             copy of this template never grew) work in this window too. AC-990: same source for
                             the session as SessionView now — the row's own view model, not a $parent lookup. -->
                        <DataTemplate x:DataType="vm:TranscriptEntryViewModel">
                            <controls:TranscriptRowView Compact="True" ReplyEnabled="True"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Jump-to-newest chevron (mirrors SessionView, #21): shown only while scrolled up. -->
                <Button x:Name="ScrollToBottomButton" IsVisible="False"
                        Classes="Accent" Click="_OnScrollToBottomClick"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Width="32" Height="32" Padding="0" Margin="0,0,10,10"
                        CornerRadius="16"
                        ToolTip.Tip="Jump to the newest message">
                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16"/>
                </Button>
            </Grid>
        </DockPanel>

        <!-- The cockpit's own consent gate (#AC-47), which is a different thing from the SDK's Allow/Deny row in
             the transcript above: a k8s, docker or terminal tool asks the host, not the model's runtime. It is
             routed here because the assistant has no pane and CockpitViewModel cannot find it — until it was, every
             one of those requests was denied before anything reached the screen, and the tool came back "the
             operator did not approve this action" for an action they were never shown. Same control the session
             panes use, so it looks and behaves identically, over this window instead of over a pane. -->
        <controls:ConsentBannerHost DataContext="{Binding Session}"/>
        <!-- Rounded hairline frame: a SIBLING overlay (no child), never the PARENT of the transcript subtree (see the
             root-Grid note above). Hit-transparent so it never eats a click; drawn on top at the window edge. -->
        <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1" CornerRadius="10"
                IsHitTestVisible="False"/>
        </Grid>
</UserControl>
