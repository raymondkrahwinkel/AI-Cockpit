<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Cockpit.App.Views"
        x:Class="Cockpit.App.Views.WhatsNewDialog"
        Title="What's new"
        Width="640" Height="560" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CockpitPanelBgBrush}">

    <!-- AC-1515: what an update brings, from the build you run up to the one on offer. Close is docked so a long
         list scrolls under it rather than pushing it off the window. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CockpitChromeBgBrush}"
                BorderBrush="{DynamicResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Close" Classes="Accent" IsDefault="True" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10" Spacing="2">
            <TextBlock Text="What's new" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="Range" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
        </StackPanel>

        <Panel Margin="20,0,20,14">
            <TextBlock x:Name="Status" Text="Reading the changelog…" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            <ScrollViewer x:Name="Changes" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                <views:MarkdownView x:Name="ChangesText" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
