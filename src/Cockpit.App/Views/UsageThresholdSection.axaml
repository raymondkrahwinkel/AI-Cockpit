<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cockpit.App.Views.UsageThresholdSection">

    <!-- AC-289: on the declaring plugin's own Options page. No ItemsControl: search reads it before the page is shown. -->
    <StackPanel Spacing="8">
        <TextBlock Classes="optionsSectionHeader" Text="USAGE WARNINGS"/>
        <TextBlock Classes="optionsHint" TextWrapping="Wrap"
                   Text="A session started after Apply shows a warning line at the top of its pane once one of these figures passes the number set here."/>
        <StackPanel x:Name="SessionsBlock" Spacing="8">
            <TextBlock Text="Warn me when a session is running out" FontWeight="SemiBold" FontSize="12"/>
            <StackPanel x:Name="SessionGroups"/>
        </StackPanel>
        <StackPanel x:Name="AssistantBlock" Spacing="8">
            <TextBlock Text="Warn me when the Assistant is running out" FontWeight="SemiBold" FontSize="12"/>
            <StackPanel x:Name="AssistantGroups"/>
        </StackPanel>
    </StackPanel>
</UserControl>
