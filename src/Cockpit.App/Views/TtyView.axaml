<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:Cockpit.App.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:term="using:Exclr8.Terminal"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Cockpit.App.Views.TtyView"
             x:DataType="vm:TtyViewModel">

    <Design.DataContext>
        <vm:TtyViewModel/>
    </Design.DataContext>

    <!-- The pane is a Grid so the consent overlay (last child) can dim and cover the whole session. -->
    <Grid>
    <DockPanel Margin="6,6,6,8">

        <!-- Compact one-row session header: the session data (TTY tag with render diagnostics on hover,
             status, profile, working directory, redraw) is left-aligned; the session title is docked right.
             Always top-docked, including the stacked-vertical grid layout (#54). -->
        <!-- paneChromeBlank, not paneChrome (AC-670): this bar shares a DockPanel with the terminal, so collapsing
             it in a rail miniature hands the terminal two more rows and the pty hears about it (measured: 39 -> 41
             at 1000x640). Blanking keeps the box where it is; the tile's identity strip covers the band it leaves. -->
        <Border x:Name="HeaderPanel" Classes="paneChromeBlank" DockPanel.Dock="Top" Background="{StaticResource CockpitPanelBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}" Padding="8,4" Margin="0,0,0,6">
            <DockPanel>
                <!-- Controls dock right and stay on the bar (AC-37): the debug redraw. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- Redraw is a diagnostic, not part of the work: shown only with the debug controls on (#73). -->
                    <Button Content="Redraw" Click="OnRedrawClick" Classes="Compact" VerticalAlignment="Center"
                            IsVisible="{Binding ShowDebugControls}"
                            ToolTip.Tip="Force the terminal to repaint from scratch — recovers the TUI if a resize/focus change left it misaligned or stacked at the top"/>
                </StackPanel>

                <!-- The one shared header strip (AC-37): dot · name · kind chip · activity · cwd · branch · token
                     meter · usage pill — SessionHeaderBar, the same control the SDK header uses. The controls above
                     dock right. The kind chip's hover is this view's own render diagnostics. -->
                <controls:SessionHeaderBar VerticalAlignment="Center">
                    <controls:SessionHeaderBar.KindChipTooltip>
                        <TextBlock Text="{Binding Diagnostics}" MaxWidth="440" TextWrapping="Wrap" FontSize="11"/>
                    </controls:SessionHeaderBar.KindChipTooltip>
                </controls:SessionHeaderBar>
            </DockPanel>
        </Border>

        <!-- AC-230/AC-683: the usage warning bar — one line per signal that has passed the point its provider
             called worth mentioning, each dismissible on its own, blocking subjects first (AC-683 criterion 9).
             Same shape as the agent bar below it, in the amber the pill uses at the same threshold, so one
             language says "watch this" wherever it appears. -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionWarningItem">
                    <Border Margin="0,0,0,6" Padding="8,4"
                            Background="{StaticResource CockpitSecondaryBgBrush}"
                            BorderBrush="{StaticResource CockpitStatusWaitingBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CockpitControlRadius}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding $parent[UserControl].((vm:TtyViewModel)DataContext).ResumePrompt}"
                                         Width="150" FontSize="11" Padding="6,0"
                                         IsVisible="{Binding ShowResumeOffer}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center" MinHeight="0"
                                         ToolTip.Tip="What to send when the session picks up again. Starts on the provider's default."/>
                                <Button Content="Resume when it returns" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:TtyViewModel)DataContext).ScheduleResumeCommand}"
                                        IsVisible="{Binding ShowResumeOffer}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Send this prompt a minute after the allowance rolls over."/>
                                <Button Content="At another time…" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:TtyViewModel)DataContext).ChangeResumeMomentCommand}"
                                        IsVisible="{Binding ShowChangeResumeMoment}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Pick your own moment instead — the reset is the sensible default, not a rule."/>
                                <Button Content="Kill session" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:TtyViewModel)DataContext).KillOverCapSessionCommand}"
                                        IsVisible="{Binding ShowKill}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Close this session now. Nothing closes it on its own once it is over its cap."/>
                                <Button Content="Dismiss" Classes="Compact"
                                        Command="{Binding $parent[UserControl].((vm:TtyViewModel)DataContext).DismissWarningCommand}"
                                        CommandParameter="{Binding Key}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Hide this warning. It comes back if the figure drops and climbs past the threshold again."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="GaugeFull" Width="15" Height="15"
                                                            Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- AC-231: a resume is waiting. Shown for as long as it is pending, with the moment it will fire and a way
             out — a timer that goes off at 07:30 with nothing on screen saying so is a surprise, not a feature. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,4"
                IsVisible="{Binding HasPendingResume}"
                Background="{StaticResource CockpitSecondaryBgBrush}"
                BorderBrush="{StaticResource CockpitAccentBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Classes="Compact"
                        Command="{Binding CancelResumeCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Drop the scheduled resume. Nothing will be sent."/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="15" Height="15"
                                                Foreground="{StaticResource CockpitAccentBrush}"/>
                    <TextBlock Text="{Binding PendingResumeLabel}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource CockpitAccentBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- AC-410: this pane was brought back after a restart — nothing has started yet. An offer, not a
             warning (hence the accent border, like the pending-resume banner above), and deliberately not
             silently dismissible: doing nothing leaves it standing, so the pane comes back again next run rather
             than vanishing without a trace. "Resume conversation" only shows when the plan is confident the
             earlier conversation is still reachable; "Start fresh" and "Close" are always offered. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,4"
                IsVisible="{Binding HasRestoreOffer}"
                Background="{StaticResource CockpitSecondaryBgBrush}"
                BorderBrush="{StaticResource CockpitAccentBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Resume conversation" Classes="Compact"
                            Command="{Binding ResumeConversationCommand}" IsVisible="{Binding CanResumeConversation}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Pick the earlier conversation back up where it left off."/>
                    <Button Content="Start fresh" Classes="Compact"
                            Command="{Binding StartFreshCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Start a new conversation in this pane instead."/>
                    <Button Content="Close" Classes="Compact"
                            Command="{Binding CloseRestoredPaneCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Close this pane. It was never started."/>
                </StackPanel>
                <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children with unbounded width in
                     the stacking direction, so the offer line never learns it has to stop and runs on underneath
                     the buttons docked to the right of it. The star column gives it the space that is actually
                     left. -->
                <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Restore" Width="15" Height="15"
                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Foreground="{StaticResource CockpitAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RestoreOfferText}" VerticalAlignment="Center"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource CockpitAccentBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding RestoreDegradedReason}" IsVisible="{Binding !CanResumeConversation}"
                               Margin="21,0,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- AC-34: the "agent connected" bar — always visible while an agent is coupled to this pane through the
             terminal-access MCP, the counterpart to both the operator and the agent being able to type. It says which
             of the two was approved ("reading" vs "connected"), because those are separate consents. Its Disconnect is
             the reactive kill-switch: it breaks the coupling at once, interrupting a driving agent's command first. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,4"
                IsVisible="{Binding AgentConnected}"
                Background="{StaticResource CockpitSecondaryBgBrush}"
                BorderBrush="{StaticResource CockpitAccentBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Disconnect" Classes="Compact" Click="OnAgentDisconnect"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding AgentDisconnectTip}"/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="RobotOutline" Width="15" Height="15"
                                                Foreground="{StaticResource CockpitAccentBrush}"/>
                    <TextBlock Text="{Binding AgentConnectedLabel}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource CockpitAccentBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The terminal surface: Exclr8.Terminal, a pure Avalonia terminal-emulator renderer with no
             PTY plumbing of its own. The code-behind hosts the ConPTY/Porta.Pty process, feeds pty
             output in via Write(...), forwards the control's Input/Output byte events to the pty, and
             relays Resized to the pty. -->
        <Border BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CockpitControlRadius}" Padding="4"
                Background="Black">
            <!-- TerminalControl.FontFamily/FontSize are plain CLR properties (not registered
                 AvaloniaProperties), so Avalonia's compiled-binding XAML compiler can't target them
                 directly (AVLN3000) — the code-behind applies the VM's font settings imperatively
                 instead (#40), the same "code-behind owns the terminal plumbing" pattern already used
                 for Input/Output/Resized below. Default mirrors the old hardcoded fallback list:
                 "Cascadia Mono" is Windows-only, so without the monospace fallback the terminal dropped
                 to the proportional UI font on Linux/macOS, which put a phantom gap between the text and
                 the block cursor. -->
            <term:TerminalControl x:Name="Terminal" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13"/>
        </Border>
    </DockPanel>

    <!-- Consent overlay (#AC-47): dims the whole pane and centres the Approve/Deny card when a request
         is waiting on this session, so it plainly takes over rather than a banner that shifted the TUI
         and was easy to miss. Collapsed and hit-transparent while idle. -->
    <controls:ConsentBannerHost/>
    </Grid>
</UserControl>
