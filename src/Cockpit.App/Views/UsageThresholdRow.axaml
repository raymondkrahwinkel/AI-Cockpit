<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             x:Class="Cockpit.App.Views.UsageThresholdRow"
             x:DataType="vm:UsageThresholdRowViewModel">

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,4">
        <TextBlock Text="{Binding Label}" Width="150" FontSize="11" VerticalAlignment="Center"/>
        <NumericUpDown Value="{Binding Threshold}" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="130"
                       HorizontalContentAlignment="Center"/>
        <TextBlock Text="{Binding FollowsLabel}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
