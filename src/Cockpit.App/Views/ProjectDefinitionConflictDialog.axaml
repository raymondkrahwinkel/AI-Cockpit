<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.ProjectDefinitionConflictDialog"
        x:DataType="vm:ProjectDefinitionConflictViewModel"
        Title="Can't save — someone beat you to it"
        Width="520" Height="420" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:ProjectDefinitionConflictViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- The one row-level accent this window needs: "your version" reads in the waiting/amber tone exactly
             where the operator's own edit differs from the base they opened with — the same color the mockup
             uses for a colliding field, reused here for every changed row, not only a colliding one. -->
        <Style Selector="TextBlock.changed">
            <Setter Property="Foreground" Value="{StaticResource CockpitStatusWaitingBrush}"/>
        </Style>
    </Window.Styles>

    <!-- AC-247, mockup section 6: opened by ProjectDialogViewModel.SaveAsync when a write-back's baseChecksum no
         longer matches. Never overwrites silently — every row here is a field Depot's own copy moved on since the
         operator opened the editor; the operator picks per the whole set, not per row (mockup's own "note ask":
         Raymond chose the three-button merge-per-veld variant over the safer two-button overwrite-or-cancel one). -->
    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="1" Background="{StaticResource CockpitChromeBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Ghost" Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Content="Take theirs" Command="{Binding TakeTheirsCommand}"/>
                <Button Content="Apply only my change" Command="{Binding ApplyMineCommand}" Classes="Accent"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="24,20,24,28">
                <TextBlock Text="Someone else changed this project while you were editing." TextWrapping="Wrap"
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                <TextBlock Text="Your changes weren't thrown away. Choose what happens to the shared definition."
                           TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>

                <Border CornerRadius="{StaticResource CockpitPanelRadius}"
                        Background="{StaticResource CockpitInsetBgBrush}" Padding="12">
                    <StackPanel Spacing="0">
                        <TextBlock IsVisible="{Binding HasNoVisibleRows}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                   Text="Something else in the shared project's definition changed — not one of the fields shown here. Your own edit is unaffected either way."/>
                        <Grid IsVisible="{Binding !HasNoVisibleRows}" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Field" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Now in Depot" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Your version" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectDefinitionConflictRowViewModel">
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" Text="{Binding FieldLabel}" FontSize="12.5"
                                                   FontWeight="Medium" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DepotValue}" FontSize="12.5"
                                                   TextWrapping="Wrap" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding MineValue}" FontSize="12.5"
                                                   TextWrapping="Wrap" Classes.changed="{Binding MineChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasCollision}" CornerRadius="{StaticResource CockpitPanelRadius}"
                        Background="{StaticResource CockpitStatusWaitingChipTintBrush}" Padding="10">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource CockpitTextPrimaryBrush}">
                        <Run Text="At least one field changed on both sides." FontWeight="SemiBold"/>
                        <Run Text="&quot;Apply only my change&quot; overwrites Depot's own edit on exactly those fields — every other field that changed remotely is kept as-is."/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
