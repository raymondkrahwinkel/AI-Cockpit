<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Cockpit.App.Services"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Views.CompanionNotificationsPanel">
    <!-- AC-2190: the companion-strook mockup's alerts pop-out — "N need you" over one card per row: its icon in the
         row's colour, a title with the age at the end, the message, and its answers as pills. -->
    <UserControl.Styles>
        <Style Selector="Border.attentionRow">
            <Setter Property="Background" Value="{DynamicResource CockpitSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CockpitControlRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.attentionRow.attention">
            <Setter Property="Background" Value="{DynamicResource CockpitStatusWaitingRowTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitStatusWaitingRingTintBrush}"/>
        </Style>
        <Style Selector="materialIcons|MaterialIcon.attentionGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CockpitStatusWaitingBrush}"/>
        </Style>
        <Style Selector="materialIcons|MaterialIcon.attentionGlyph.done">
            <Setter Property="Foreground" Value="{DynamicResource CockpitStatusDoneBrush}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <!-- The mockup's .opt: a hairline pill, the first answer filled with the accent. -->
        <Style Selector="Button.attentionOption">
            <Setter Property="CornerRadius" Value="{StaticResource CockpitPillRadius}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitHairlineHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.attentionOption /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitHairlineHoverBrush}"/>
        </Style>
        <Style Selector="Button.attentionOption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CockpitGhostHoverBrush}"/>
        </Style>
        <Style Selector="Button.attentionOption TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.attentionOption.primary /template/ ContentPresenter, Button.attentionOption.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CockpitAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitAccentBrush}"/>
        </Style>
        <Style Selector="Button.attentionOption.primary TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CockpitTextOnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <DockPanel Margin="14,10,10,8">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Classes="Ghost" Width="24" Height="24" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Keep them under the bell" AutomationProperties.Name="Close">
                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            </Button>
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Margin="14,0,14,12" Spacing="6">
            <TextBlock x:Name="EmptyText" Text="Nothing is waiting for you." TextWrapping="Wrap" Margin="0,0,0,4"
                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:CompanionAttentionItem">
                        <Border Classes="attentionRow" Classes.attention="{Binding NeedsYou}">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <materialIcons:MaterialIcon Classes="attentionGlyph" Classes.done="{Binding IsDone}" Kind="{Binding Glyph}"
                                                            Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding SessionTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="11" VerticalAlignment="Top" Margin="0,1,0,0"
                                           Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,-6">
                                    <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsQuestion}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Classes="attentionOption" Click="OnOption" Loaded="OnOptionLoaded">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel IsVisible="{Binding AllowsFreeText}" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Send" Classes="Compact Accent" Margin="6,0,0,0" Click="OnSendReply"/>
                                        <TextBox Text="{Binding Reply}" PlaceholderText="Your answer" AcceptsReturn="False" KeyDown="OnReplyKeyDown"/>
                                    </DockPanel>
                                    <WrapPanel>
                                        <Button Classes="attentionOption primary" IsVisible="{Binding IsPermission}" Click="OnAllow">
                                            <TextBlock Text="Allow"/>
                                        </Button>
                                        <Button Classes="attentionOption" IsVisible="{Binding IsPermission}" Click="OnDeny">
                                            <TextBlock Text="Deny"/>
                                        </Button>
                                        <Button Classes="attentionOption" Click="OnOpen">
                                            <TextBlock Text="Open"/>
                                        </Button>
                                        <Button Classes="attentionOption" IsVisible="{Binding IsDone}" Click="OnDismiss">
                                            <TextBlock Text="Dismiss"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
