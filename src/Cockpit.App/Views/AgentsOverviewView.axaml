<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cockpit.App.ViewModels"
             xmlns:views="using:Cockpit.App.Views"
             xmlns:conv="using:Cockpit.App.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cockpit.App.Views.AgentsOverviewView"
             x:DataType="vm:AgentsOverviewViewModel">
    <UserControl.Styles>
        <Style Selector="Border.agentCard">
            <Setter Property="Background" Value="{DynamicResource CockpitPanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
        </Style>
        <Style Selector="Border.agentCard.attention">
            <Setter Property="Background" Value="{DynamicResource CockpitStatusWaitingRowTintBrush}"/>
        </Style>
        <Style Selector="Border.agentCard.asleep">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Border.agentBadge">
            <Setter Property="Background" Value="{DynamicResource CockpitInsetBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource CockpitHairlineThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CockpitPillRadius}"/>
            <Setter Property="Padding" Value="7,1"/>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12" Spacing="8">
            <TextBox PlaceholderText="Search title or statusline" Text="{Binding SearchText, Mode=TwoWay}"/>
            <WrapPanel Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding ShowOnlyWaiting, Mode=TwoWay}" Margin="0,0,6,6">
                    <TextBlock Text="{Binding WaitingCount, StringFormat='Waiting for you · {0}'}" Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                </ToggleButton>
                <ToggleButton Content="Delegated tasks" IsChecked="{Binding ShowDelegatedTasks, Mode=TwoWay}" Margin="0,0,6,6"/>
                <ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine, Mode=TwoWay}" Margin="0,0,6,6" AutomationProperties.Name="Machine"/>
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" Margin="0,0,6,6" AutomationProperties.Name="Project"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ShowOlder}">
                <TextBlock Text="Done / Idle · last 24 hours" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                <Button Content="Show more" Command="{Binding ShowMoreCommand}" IsVisible="{Binding ShowsMore}" ToolTip.Tip="Show Done and Idle older than 24 hours"/>
            </StackPanel>
        </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Columns}" Margin="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentsOverviewColumnViewModel">
                    <StackPanel Width="{Binding $parent[views:AgentsOverviewView].ColumnWidth}" Spacing="6">
                    <StackPanel Spacing="6" Margin="4,4,4,10">
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,2">
                            <Ellipse Width="7" Height="7" Fill="{Binding BrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                            <Border Classes="agentBadge">
                                <TextBlock Text="{Binding Cards.Count}" FontSize="10.5" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="No sessions" FontSize="11" Margin="0,0,0,6"
                                   Foreground="{DynamicResource CockpitTextFaintBrush}" IsVisible="{Binding !Cards.Count}"/>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AgentOverviewCardViewModel">
                                    <Border Classes="sessionItem agentCard" Classes.active="{Binding IsSelected}" Classes.attention="{Binding ShowsAttention}" Classes.asleep="{Binding IsAsleep}"
                                            CornerRadius="{StaticResource CockpitControlRadius}" Margin="0,0,0,6">
                                        <Grid>
                                        <Rectangle IsVisible="{Binding IsDelegatedTask}" IsHitTestVisible="False" StrokeDashArray="3,3"
                                                   Stroke="{DynamicResource CockpitTextFaintBrush}" StrokeThickness="1" RadiusX="5" RadiusY="5"/>
                                        <StackPanel>
                                        <Button Classes="Subtle" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Statusline}">
                                            <StackPanel Spacing="4">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Border Classes="agentBadge" Margin="0,0,5,0">
                                                        <TextBlock Text="{Binding Machine}" FontSize="10.5"/>
                                                    </Border>
                                                    <Border Classes="agentBadge">
                                                        <TextBlock Text="{Binding Project}" FontSize="10.5" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <icons:MaterialIcon Grid.Column="2" Kind="AlertOutline" Width="13" Height="13"
                                                                        Foreground="{DynamicResource CockpitStatusWaitingBrush}" IsVisible="{Binding ShowsAttention}"/>
                                                </Grid>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource CockpitTextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Profile}"/><Run Text=" · "/><Run Text="{Binding StatusLabel}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LastSeenLabel}" FontSize="11" Foreground="{DynamicResource CockpitTextFaintBrush}"
                                                           IsVisible="{Binding IsAsleep}"/>
                                                <TextBlock Text="{Binding Statusline}" FontSize="11" Foreground="{DynamicResource CockpitAccentBrush}"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding Statusline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <Border Classes="agentBadge" HorizontalAlignment="Left" IsVisible="{Binding TerminalOnly}">
                                                        <TextBlock Text="Terminal only" FontSize="10.5" Foreground="{DynamicResource CockpitAccentBrush}"/>
                                                    </Border>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel IsVisible="{Binding HasChildren}" Margin="8,0,8,8" Spacing="4">
                                            <ToggleButton Classes="Collapser" IsChecked="{Binding AreChildrenExpanded, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          AutomationProperties.Name="Provider sub-agents">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                                    <icons:MaterialIcon Kind="ChevronRight" Width="12" Height="12" IsVisible="{Binding !AreChildrenExpanded}"/>
                                                    <icons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" IsVisible="{Binding AreChildrenExpanded}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Provider sub-agents" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ChildSummary}" FontSize="10.5" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                </StackPanel>
                                                </Grid>
                                            </ToggleButton>
                                            <StackPanel Spacing="6" IsVisible="{Binding AreChildrenExpanded}" Margin="10,0,0,0">
                                                <ItemsControl ItemsSource="{Binding Children}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ChildAgentViewModel">
                                                            <Button Classes="Subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Padding="4,7" CommandParameter="{Binding}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:AgentOverviewCardViewModel)DataContext).OpenChildCommand}"
                                                                    ToolTip.Tip="Open this provider child's read-only transcript">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                                    <Grid Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0">
                                                                        <Ellipse StrokeThickness="1" Stroke="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                                        <Ellipse Opacity="{Binding DotFillOpacity}" Fill="{Binding StatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                                        <Border Classes="agentBadge" HorizontalAlignment="Left">
                                                                            <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="{DynamicResource CockpitStatusBackgroundBrush}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" TextWrapping="Wrap"/>
                                                                        <WrapPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding LastToolText, StringFormat='Last tool: {0}'}" Margin="0,0,6,0"
                                                                                       FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                                            <TextBlock Text="{Binding TokensText, StringFormat='Tokens: {0}'}"
                                                                                       FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding TimeText}" FontSize="10.5" HorizontalAlignment="Right"/>
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" HorizontalAlignment="Right"
                                                                                   Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                                                                        <TextBlock Text="Open ›" FontSize="10" HorizontalAlignment="Right"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Read-only · Child tokens are a breakdown of owner usage."
                                                           FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    </DockPanel>
</UserControl>
