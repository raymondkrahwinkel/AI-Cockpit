<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:controls="using:Cockpit.App.Controls"
        xmlns:conv="using:Cockpit.App.Converters"
        xmlns:projects="using:Cockpit.Core.Projects"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.OptionsDialog"
        x:DataType="vm:CockpitViewModel"
        Title="Options"
        Width="880" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CockpitPanelBgBrush}">

    <Design.DataContext>
        <vm:CockpitViewModel/>
    </Design.DataContext>

  <Panel>
    <DockPanel>

        <!-- Footer (AC-999): the dialog is a transaction now. Restore Defaults fills the buffer, Cancel throws it
             away, Apply and Close is the only thing that writes. The old "Saved" label is gone with the old Save
             button — under a staged model it could only ever appear on the click that closes the window. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CockpitChromeBgBrush}"
                BorderBrush="{StaticResource CockpitHairlineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Content="Restore Options Defaults…" Click="OnRestoreDefaults"
                        ToolTip.Tip="Restores Options settings in every category. Profiles, MCP servers, and plugin settings are unchanged."/>
                <TextBlock Grid.Column="1" x:Name="PluginSettingsErrorText" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="360"
                           IsVisible="False"
                           Foreground="{StaticResource CockpitStatusWaitingBrush}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Unsaved changes" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           IsVisible="{Binding HasPendingOptionChanges}"
                           Foreground="{StaticResource CockpitAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                <!-- IsCancel, so Escape is a Cancel rather than the nothing it used to be. -->
                <Button Grid.Column="2" Content="Cancel" Click="OnCancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="Apply and Close" Classes="Accent" Click="OnApplyAndClose"/>
            </Grid>
        </Border>

        <!-- AC-1000: the eight top tabs are gone. A searchable sidebar (Border.subnavRail, the same rail style
             AC-69 used per-tab, raised here to be the whole dialog's one navigation) replaces them with 12
             categories in 3 groups. Category pages are stacked ScrollViewers switched by Tag rather than a
             Carousel's SelectedIndex, because the 3 group-header rows share the nav ListBox's index space with
             the 12 real categories and a Tag comparison sidesteps that arithmetic entirely (CategoryTagEqualsConverter). -->
        <Grid ColumnDefinitions="Auto,*">

            <Border Grid.Column="0" Classes="subnavRail" Width="240">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Text="{Binding OptionsSearchText}"
                             PlaceholderText="Search settings…" Margin="0,0,0,10">
                        <TextBox.InnerLeftContent>
                            <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14"
                                                         Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                         Margin="8,0,0,0"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <!-- SelectedIndex=1: index 0 is the first group header, which Focusable="False" +
                         IsHitTestVisible="False" below keep out of Tab order and pointer selection (AC5) —
                         "Sessions" is the first real, selectable category. -->
                    <ListBox x:Name="CategoryNav" Classes="subnav" SelectedIndex="1">

                        <ListBoxItem Classes="navGroupHeader" Focusable="False" IsHitTestVisible="False">
                            <TextBlock Classes="subnavGroup" Text="WORKING"/>
                        </ListBoxItem>

                        <ListBoxItem Tag="sessions">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Monitor" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Sessions" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="profiles">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="AccountMultiple" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Profiles" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="appearance">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Palette" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Appearance" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="terminal">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Console" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Terminal" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="notifications">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Bell" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Notifications" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="shortcuts">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Keyboard" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Shortcuts" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Classes="navGroupHeader" Focusable="False" IsHitTestVisible="False">
                            <TextBlock Classes="subnavGroup" Text="VOICE &amp; ASSISTANT"/>
                        </ListBoxItem>

                        <ListBoxItem Tag="voice">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Microphone" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Voice" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="assistant">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Creation" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Assistant" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Classes="navGroupHeader" Focusable="False" IsHitTestVisible="False">
                            <TextBlock Classes="subnavGroup" Text="SYSTEM"/>
                        </ListBoxItem>

                        <ListBoxItem Tag="security">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldLock" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Security" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <!-- AC-1002: replaces the standalone McpServersDialog window, the same deep-link move
                             AC-1001 made for Profiles. Next to Nodes — the other MCP-related SYSTEM topic. -->
                        <ListBoxItem Tag="mcp-servers">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Server" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="MCP Servers" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="nodes">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Lan" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Nodes" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="backup">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Archive" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Backup" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="updates">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Download" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Updates" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="debug">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Bug" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Debug" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="searchMatchBadge">
                                    <TextBlock/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                    </ListBox>
                </DockPanel>
            </Border>

            <Panel Grid.Column="1" x:Name="CategoryContent">

                <!-- ================= SESSIONS ================= -->
                <ScrollViewer Tag="sessions"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=sessions}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="SessionsHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Sessions" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="How sessions behave and where their worktrees and clones live." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. SESSION BEHAVIOUR"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Close a session when you type &quot;exit&quot;"
                                      IsChecked="{Binding AutoCloseOnExit}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="The message is still sent; the session closes once that turn finishes."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Combine messages queued during a turn into one"
                                      IsChecked="{Binding CombineQueuedMessages}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="When you type several messages while the agent is working, send them together as one follow-up when the turn finishes, instead of one at a time. Off: each queued message gets its own turn."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Let agents wake each other for urgent messages"
                                      IsChecked="{Binding WakeAgentsByDefault}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="When an agent marks a message to a neighbour on the same desk as urgent, the cockpit starts a turn for that neighbour there and then — so a warning about a branch or a worktree arrives before the damage. A woken agent is handed a labelled block saying who caused it; it grants nothing. Never interrupts: only a session standing still is woken, never one mid-turn and never one with a question in front of you. Off: urgent messages simply wait like any other. A session can override this for itself."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Let sessions delegate work to other profiles (orchestrator MCP)"
                                      IsChecked="{Binding OrchestratorMcpEnabled}"
                                      ToolTip.Tip="Offers the cockpit-orchestrator tools (delegate_task, add_profile, …) to sessions. Turn it off to keep delegation out of every session; a session still won't get them unless it was started with delegation enabled."/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. RUNNING OUT OF ROOM"/>
                        <StackPanel x:Name="MemoryBudgetRow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Warn when all sessions together pass" Width="230" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding MemoryBudgetPercent}" Minimum="10" Maximum="100"
                                           Increment="5" FormatString="0" Width="104"/>
                            <TextBlock Text="% of this machine's memory" FontSize="11" VerticalAlignment="Center"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="One budget over everything the cockpit runs, rather than a separate cap per session — several sessions each staying under their own cap could still promise more memory than the machine has, and then the system picks which one to end. The figure it is measured against is this app plus every process the sessions now open have spawned, including ones whose parent has since gone; what a session left behind after being closed is not in it. Crossing the budget warns you and names the heaviest session; nothing is closed and no session is refused."/>
                        </StackPanel>
                        <!-- AC-233/AC-805 merged: both used to hang off separate tabs (Sessions, Voice → Assistant);
                             they are the same "running out" concept for two different runners, so one subsection. -->
                        <StackPanel Spacing="8" IsVisible="{Binding UsageThresholdSettings.HasProviders}">
                            <TextBlock Text="Warn me when a session is running out" FontWeight="SemiBold" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding UsageThresholdSettings.Providers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageThresholdProviderViewModel">
                                        <StackPanel Spacing="6" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Signals}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:UsageThresholdRowViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    VerticalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Label}" Width="150" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <NumericUpDown Value="{Binding Threshold}" Minimum="0" Maximum="100"
                                                                           Increment="5" FormatString="0" Width="130"
                                                                           HorizontalContentAlignment="Center"/>
                                                            <TextBlock Text="{Binding FollowsLabel}" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding UsageThresholdSettings.HasAssistantProviders}">
                            <TextBlock Text="Warn me when the Assistant is running out" FontWeight="SemiBold" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding UsageThresholdSettings.AssistantProviders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageThresholdProviderViewModel">
                                        <StackPanel Spacing="6" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Signals}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:UsageThresholdRowViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    VerticalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Label}" Width="150" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <NumericUpDown Value="{Binding Threshold}" Minimum="0" Maximum="100"
                                                                           Increment="5" FormatString="0" Width="130"
                                                                           HorizontalContentAlignment="Center"/>
                                                            <TextBlock Text="{Binding FollowsLabel}" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="WhereWorkLandsHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="optionsSectionHeader" Text="3. WHERE WORK LANDS"/>
                        </StackPanel>
                        <!-- Worktree isolation location (AC-85): where new isolated-session worktrees are created. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Worktree location" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Where the cockpit creates the git worktrees that isolate sessions (AC-85). Blank uses the default under the app's config directory; existing worktrees keep their location."/>
                        </StackPanel>
                        <TextBox Text="{Binding WorktreeRoot}" PlaceholderText="{Binding WorktreeRootPlaceholder}"/>

                        <!-- Clone location (AC-90): where repositories cloned from a URL are checked out. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Clone location" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Where the cockpit clones repositories from a URL (AC-90), each under a host/org/repo folder. Blank uses the default under the app's config directory; existing clones keep their location."/>
                        </StackPanel>
                        <TextBox Text="{Binding CloneRoot}" PlaceholderText="{Binding CloneRootPlaceholder}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= PROFILES ================= -->
                <!-- AC-1001: replaces the standalone ManageProfilesDialog window. Flat on the page background —
                     no card, no filled list-column background, no rounded border — the only structure is the
                     Border.hairline divider between the list and detail columns and the ListBox's own selection
                     highlight (criterion 2).
                     AC-1019: list and detail used to share one page-wide ScrollViewer, so Add/Remove (docked to
                     the bottom of the list column) sat below however long the selected profile's detail form
                     was — sometimes off-screen. The header (title/hint/hairline) is now a non-scrolling Grid.Row
                     above the columns, and each column gets its own ScrollViewer, so the list (and its Add/Remove)
                     scrolls independently of the detail form beside it.
                     Field checklist against ManageProfilesDialog.axaml (criterion 1 — every one must be here):
                     IDENTITY: Label / Provider / Purpose / Default working directory / System prompt / Memory cap.
                     Claude: Config directory / Executable. Local (Ollama/LM Studio): Server base URL / Model+Fetch /
                     API key / Base system prompt / Auto-approve tool calls. Plugin provider: its embedded
                     IPluginProviderConfigView, unchanged. SESSION DEFAULTS: Mode / Model / Effort (Claude) or the
                     plugin's own declared start options. DEFAULT KIND & VIEW: SDK/TTY toggle (or "SDK-only") /
                     reading level. LOGIN: status + Login button + login flow. DELEGATION: allow-as-target toggle,
                     Good for, Only these kinds of work, May work in these directories, Tool permission ceiling,
                     Auto-runnable tools, Tasks at once, Stop a task after, may-delegate-further toggle. MCP
                     SERVERS: pre-select toggle + checklist + token estimate. ENVIRONMENT VARIABLES: NAME/value/
                     Secret rows + Add variable. -->
                <Grid Tag="profiles" RowDefinitions="Auto,*"
                      IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=profiles}">
                    <StackPanel Grid.Row="0" Margin="24,20,24,0" Spacing="8">
                        <StackPanel x:Name="ProfilesHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Profiles" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="The profiles sessions start under: provider, session defaults, delegation and environment." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="180,1,*" Margin="24,4,24,20" IsVisible="{Binding Profiles, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- Profile list + Add/Remove. Remove stays a button beside the list (not the shared
                             footer): removing a profile is a staged edit like any other field, undone by
                             Cancel and written by Apply and Close — see ManageProfilesDialogViewModel.ConfirmRemove.
                             Add/Remove are docked to the column's bottom, outside the ListBox's own ScrollViewer,
                             so they stay reachable regardless of list length. -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,12,0" Spacing="6">
                                <Button Content="+ Add profile" Classes="Subtle" HorizontalAlignment="Left"
                                        Foreground="{StaticResource CockpitAccentBrush}"
                                        Command="{Binding Profiles.AddProfileCommand}"/>

                                <StackPanel Spacing="6" IsVisible="{Binding Profiles.SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button Content="Remove" Classes="Subtle" HorizontalAlignment="Left"
                                            Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                            Command="{Binding Profiles.RemoveProfileCommand}"
                                            IsVisible="{Binding !Profiles.IsConfirmingRemove}"/>
                                    <StackPanel Spacing="4" IsVisible="{Binding Profiles.IsConfirmingRemove}">
                                        <TextBlock Text="{Binding Profiles.PendingRemovalLabel, StringFormat='Remove ‘{0}’?'}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="No" Classes="Compact" Command="{Binding Profiles.CancelRemoveCommand}"/>
                                            <Button Content="Yes" Classes="Compact Accent" Command="{Binding Profiles.ConfirmRemoveCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Profiles.StatusMessage}" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding Profiles.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding Profiles.Profiles}" SelectedItem="{Binding Profiles.SelectedProfile}"
                                         Background="Transparent" Padding="0" Margin="0,0,12,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EditableProfileViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding LoginStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                                <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- The one functional divider criterion 2 allows: no border/card anywhere else on this page. -->
                        <Border Grid.Column="1" Width="1" Background="{StaticResource CockpitHairlineBrush}" HorizontalAlignment="Center"/>

                        <!-- Detail: the selected profile's fields, scrolling independently of the list column. -->
                        <ScrollViewer Grid.Column="2"
                                      IsVisible="{Binding Profiles.SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Margin="16,0,0,0" Spacing="11">
                                <StackPanel Spacing="11" DataContext="{Binding Profiles.SelectedProfile}" x:DataType="vm:EditableProfileViewModel">

                                    <TextBlock Text="IDENTITY" FontSize="11" Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Label" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Label}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Provider (fixed after creation)" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                                  DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding CanChooseProvider}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Purpose" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Purpose}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Default working directory" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Browse" Classes="Compact" Margin="6,0,0,0"
                                                    Click="OnBrowseProfileWorkingDirectory"/>
                                            <TextBox Text="{Binding DefaultWorkingDirectory}" FontFamily="{StaticResource CockpitMonoFont}"
                                                     PlaceholderText="Optional — pre-fills a new session's folder for this profile"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- AC-1071: its own field, not a sentence in the prompt below — the cockpit states
                                         the choice and withdraws the "which brain do you want?" question a session's
                                         own instruction files ask first. -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Assistant" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Assistant}" MaxWidth="340" HorizontalAlignment="Left"
                                                 PlaceholderText="Optional — who a session under this profile is, e.g. “Zyra”"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="System prompt" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding ProfileSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="94"
                                                 PlaceholderText="Optional — added to every session under this profile, e.g. “You are Olaf. Your memory lives in the Depot MCP; look yourself up there before answering.”"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Memory cap (MB)" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <NumericUpDown Value="{Binding MemoryCapMegabytes}" Minimum="512" Maximum="1048576"
                                                       Increment="512" FormatString="0" ClipValueToMinMax="True"
                                                       HorizontalAlignment="Left" Width="180"
                                                       PlaceholderText="Blank = default"
                                                       ToolTip.Tip="How much this session's whole process tree may hold before the OS stops it, in megabytes. Blank uses the default."/>
                                    </StackPanel>

                                    <!-- Claude-CLI provider fields — no header of their own, they follow Identity directly. -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsClaudeProvider}">
                                        <TextBlock Text="Config directory (CLAUDE_CONFIG_DIR)" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Browse" Classes="Compact" Margin="6,0,0,0"
                                                    Click="OnBrowseProfileConfigDir"/>
                                            <TextBox Text="{Binding ConfigDir}" FontFamily="{StaticResource CockpitMonoFont}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="4" IsVisible="{Binding IsClaudeProvider}">
                                        <TextBlock Text="Executable (empty = bundled default)" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Browse" Classes="Compact" Margin="6,0,0,0"
                                                    Click="OnBrowseProfileExecutable"/>
                                            <TextBox Text="{Binding ExecutablePath}" FontFamily="{StaticResource CockpitMonoFont}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Local (Ollama / LM Studio) provider fields. -->
                                    <StackPanel Spacing="11" IsVisible="{Binding IsLocalProvider}">
                                        <TextBlock Text="LOCAL PROVIDER (OLLAMA / LM STUDIO)" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Server base URL" FontSize="11"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <TextBox Text="{Binding BaseUrl}" FontFamily="{StaticResource CockpitMonoFont}"
                                                     PlaceholderText="{Binding BaseUrlPlaceholder}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Model" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="Fetch" Classes="Compact" Margin="6,0,0,0"
                                                        Command="{Binding $parent[Window].((vm:CockpitViewModel)DataContext).Profiles.RefreshModelsCommand}"
                                                        ToolTip.Tip="List the models installed on this server (/v1/models)"/>
                                                <AutoCompleteBox Text="{Binding Model}" ItemsSource="{Binding AvailableModels}"
                                                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                                                 FontFamily="{StaticResource CockpitMonoFont}"
                                                                 PlaceholderText="Click to pick a fetched model, or type an id"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding $parent[Window].((vm:CockpitViewModel)DataContext).Profiles.ModelFetchStatus}"
                                                       FontSize="11" Foreground="{StaticResource CockpitTextFaintBrush}"
                                                       IsVisible="{Binding $parent[Window].((vm:CockpitViewModel)DataContext).Profiles.ModelFetchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4" IsVisible="{Binding IsLmStudioProvider}">
                                            <TextBlock Text="API key (optional, only behind a proxy)" FontSize="11"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <TextBox Text="{Binding ApiKey}" PasswordChar="•"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Base system prompt (optional)" FontSize="11"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <TextBox Text="{Binding SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="70" MaxHeight="146"
                                                     PlaceholderText="Sent as the first system message of every conversation"/>
                                        </StackPanel>

                                    </StackPanel>

                                    <!-- Outside the local-provider block (AC-1219): every provider that gates tool
                                         calls per call rather than through a permission mode can set this. -->
                                    <CheckBox Content="Auto-approve tool calls" IsChecked="{Binding AutoApproveTools}"
                                              IsVisible="{Binding ShowAutoApproveTools}"
                                              ToolTip.Tip="New sessions under this profile start with 'Allow all tools' already on"/>

                                    <!-- Plugin-registered provider fields (#45): embedded unchanged, same contract
                                         (TryGetConfigJson) — a false blocks Apply, see IsValid below. -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsPluginProviderMissing}">
                                        <TextBlock Text="Provider plugin not installed" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                        <TextBlock Text="This profile's provider plugin is missing, disabled, or failed to load. Its settings are kept as-is and cannot be edited here until the plugin is available again."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4" IsVisible="{Binding IsPluginProvider}" IsEnabled="{Binding !IsPluginProviderMissing}">
                                        <TextBlock Text="Provider settings" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                   IsVisible="{Binding !IsPluginProviderMissing}"/>
                                        <ContentControl Content="{Binding PluginConfigView.View}" IsVisible="{Binding !IsPluginProviderMissing}"/>
                                    </StackPanel>

                                    <!-- SESSION DEFAULTS: Claude's typed Mode/Model/Effort, or a plugin's own declared
                                         start options — mutually exclusive, so one shared header reads either way. -->
                                    <StackPanel Spacing="11" IsVisible="{Binding IsClaudeProvider}">
                                        <TextBlock Text="SESSION DEFAULTS" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <TextBlock Text="Used to launch every new session. Live-switching these mid-session (the per-session dropdowns) is SDK-only — a TTY session only ever uses them as start defaults."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>

                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Mode" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:CockpitViewModel)DataContext).Profiles.PermissionModes}"
                                                          SelectedItem="{Binding SelectedPermissionMode}"
                                                          DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Model" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <AutoCompleteBox ItemsSource="{Binding ClaudeModelSuggestions}" Text="{Binding ClaudeModel}"
                                                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                                                                 HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                                <TextBlock Text="Effort" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:CockpitViewModel)DataContext).Profiles.Efforts}"
                                                          SelectedItem="{Binding SelectedEffort}"
                                                          DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="11" IsVisible="{Binding HasPluginOptionDefaults}">
                                        <TextBlock Text="SESSION DEFAULTS" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <TextBlock Text="Pre-selected for every new session under this profile; each can still be changed when a session is started."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <ItemsControl ItemsSource="{Binding PluginOptionDefaults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PluginTtyOptionSelectionViewModel">
                                                    <Grid ColumnDefinitions="120,*" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"
                                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ChoiceItems}"
                                                                  SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Value, Mode=TwoWay}"
                                                                  DisplayMemberBinding="{Binding Label}"
                                                                  IsVisible="{Binding !IsFreeText}" HorizontalAlignment="Stretch"
                                                                  PlaceholderText="Not set — provider default"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsFreeText}"
                                                                 PlaceholderText="Not set — provider default"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- DEFAULT KIND & VIEW: which route (SDK/TTY) and reading level a new session
                                         under this profile pre-selects. -->
                                    <StackPanel Spacing="11" IsVisible="{Binding HasTtyProvider}">
                                        <TextBlock Text="DEFAULT KIND &amp; VIEW" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Default kind" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="SDK" Classes.Accent="{Binding IsDefaultKindSdk}" Command="{Binding SelectDefaultKindSdkCommand}"/>
                                                <Button Content="TTY" Classes.Accent="{Binding IsDefaultKindTty}" Command="{Binding SelectDefaultKindTtyCommand}"/>
                                            </StackPanel>
                                            <TextBlock Text="Which kind of session the New-session dialog's Kind toggle opens on for this profile."
                                                       Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6" IsVisible="{Binding IsDefaultKindEffectivelySdk}">
                                            <TextBlock Text="Default view" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding ReadingLevels}" SelectedItem="{Binding SelectedReadingLevel}"
                                                      DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="{Binding SelectedReadingLevel.Description}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="6" IsVisible="{Binding !HasTtyProvider}">
                                        <TextBlock Text="DEFAULT KIND &amp; VIEW" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <TextBlock Text="SDK-only" FontSize="12.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <StackPanel Spacing="6" IsVisible="{Binding IsDefaultKindEffectivelySdk}">
                                            <TextBlock Text="Default view" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding ReadingLevels}" SelectedItem="{Binding SelectedReadingLevel}"
                                                      DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="{Binding SelectedReadingLevel.Description}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- LOGIN: provider-neutral, gated on CanStartLogin rather than just "not local". -->
                                    <StackPanel Spacing="11" IsVisible="{Binding CanStartLogin}">
                                        <TextBlock Text="LOGIN" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding LoginStatusBrushKey, Converter={x:Static conv:StatusBrushConverter.Instance}}"/>
                                            <TextBlock Text="{Binding LoginStatusLabel}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <Button Content="Login" Classes="Compact" Command="{Binding LoginCommand}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding HasLoginFlow}">
                                            <controls:LoginFlowView DataContext="{Binding LoginFlow}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- DELEGATION: whether another session may hand work to this profile. -->
                                    <StackPanel Spacing="11">
                                        <TextBlock Text="DELEGATION" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>

                                        <CheckBox Content="Other sessions may delegate work to this profile"
                                                  IsChecked="{Binding AllowedAsTarget}"
                                                  ToolTip.Tip="Lets a session hand a task to this profile, which then runs it as its own background session"/>

                                        <StackPanel Spacing="11" IsVisible="{Binding AllowedAsTarget}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Good for" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <TextBox Text="{Binding DelegationPurpose}"
                                                         PlaceholderText="e.g. cheap bulk refactors and summarising — no web access"/>
                                                <TextBlock Text="Told to the delegating agent so it picks the right profile for the job."
                                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Only these kinds of work" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <TextBox Text="{Binding AllowedTaskTypes}" PlaceholderText="summarize, refactor  (leave empty to accept anything)"/>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="May work in these directories" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <TextBox Text="{Binding AllowedWorkingDirs}"
                                                         AcceptsReturn="True"
                                                         MinHeight="66"
                                                         TextWrapping="NoWrap"
                                                         PlaceholderText="/home/you/projects/webshop&#x0a;one directory per line"/>
                                                <TextBlock Text="A delegated task may only run in these directories, and in what lies under them. Empty means a task may not choose a directory at all — so delegation can never reach an arbitrary part of the disk."
                                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Tool permission ceiling (delegated, local models)" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding PermissionCeilingChoices}"
                                                          SelectedItem="{Binding PermissionCeiling}"
                                                          HorizontalAlignment="Left" MinWidth="200"
                                                          ToolTip.Tip="How far a delegated local-model session may go without a human: plan/default = read-only tools only, acceptEdits = also non-destructive writes, bypassPermissions = everything. Ignored when 'Auto-Approve tool calls' is on."/>
                                                <TextBlock Text="plan / default = read-only only · acceptEdits = also writes · bypassPermissions = everything"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Auto-runnable tools (allow-list)" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <TextBox Text="{Binding AllowedTools}"
                                                         AcceptsReturn="True"
                                                         MinHeight="66"
                                                         TextWrapping="NoWrap"
                                                         PlaceholderText="get_current_user&#x0a;one tool name per line"/>
                                                <TextBlock Text="Tools a delegated session may run unattended regardless of the ceiling — the explicit trust anchor for tools whose MCP server gives no read-only/destructive hint (those are otherwise blocked). One tool name per line."
                                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Tasks at once" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <NumericUpDown Value="{Binding MaxConcurrentTasks}" Minimum="1" Maximum="8"
                                                               Increment="1" FormatString="0" Width="110"
                                                               HorizontalContentAlignment="Center"
                                                               ToolTip.Tip="How many delegated tasks may run on this profile at the same time — keeps a burst of sub-tasks from eating this provider's usage (or the GPU, for a local model)"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Stop a task after" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <NumericUpDown Value="{Binding DelegationTimeoutMinutes}" Minimum="0" Maximum="240"
                                                               Increment="1" FormatString="0" Width="110"
                                                               HorizontalContentAlignment="Center"
                                                               ToolTip.Tip="Minutes a delegated task may run here before the cockpit stops it. Nobody is watching a delegated session, so a model that loops or waits on something that never comes would otherwise hold this profile's slot indefinitely. 0 = no limit."/>
                                                <TextBlock Text="minutes (0 = no limit)" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                            </StackPanel>

                                            <CheckBox Content="Tasks on this profile may delegate further"
                                                      IsChecked="{Binding MayDelegateFurther}"
                                                      ToolTip.Tip="Off by default: without this, a delegated task cannot hand work on again, so a chain of agents cannot start"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- MCP SERVERS: pre-selection for a New session under this profile. -->
                                    <StackPanel Spacing="11" IsVisible="{Binding HasMcpServers}">
                                        <TextBlock Text="MCP SERVERS" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <CheckBox Content="Pre-select MCP servers for this profile"
                                                  IsChecked="{Binding RestrictMcpServers}"
                                                  ToolTip.Tip="Off: a new session ticks every enabled server (and future ones). On: only the servers ticked below."/>
                                        <controls:McpServerChecklist IsVisible="{Binding RestrictMcpServers}"
                                                                     Servers="{Binding McpServers}"
                                                                     Hint="Ticked servers are pre-selected for every new session under this profile; each can still be changed when a session is started."
                                                                     TokenSummary="{Binding McpToolTokenSummary}"
                                                                     ShowTokenSummary="{Binding HasMcpTokenSummary}"
                                                                     RefreshCommand="{Binding RefreshMcpTokensCommand}"/>
                                    </StackPanel>

                                    <!-- ENVIRONMENT VARIABLES: injected into every session spawned under this profile. -->
                                    <StackPanel Spacing="11" IsVisible="{Binding SupportsEnvVars}">
                                        <TextBlock Text="ENVIRONMENT VARIABLES" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}"/>
                                        <TextBlock Text="Injected into every session spawned under this profile, terminal and headless alike. Mark a value as secret to store it encrypted and masked."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProfileEnvironmentVariableViewModel">
                                                    <Grid ColumnDefinitions="4*,5*,Auto,Auto" RowDefinitions="Auto,Auto"
                                                          ColumnSpacing="6" Margin="0,0,0,6">
                                                        <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="NAME"
                                                                 FontFamily="{StaticResource CockpitMonoFont}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="value"
                                                                 FontFamily="{StaticResource CockpitMonoFont}"
                                                                 IsVisible="{Binding !IsSecret}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="value"
                                                                 PasswordChar="•" IsVisible="{Binding IsSecret}"/>
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSecret}" Content="Secret"
                                                                  FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Classes="Subtle" VerticalAlignment="Center"
                                                                Command="{Binding $parent[ItemsControl].((vm:EditableProfileViewModel)DataContext).RemoveEnvironmentVariableCommand}"
                                                                CommandParameter="{Binding}">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                        </Button>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0"
                                                                   Text="Not a valid variable name — letters, digits and underscores, not starting with a digit."
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                                                   IsVisible="{Binding !IsKeyValid}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add variable" Classes="Subtle" HorizontalAlignment="Left"
                                                Foreground="{StaticResource CockpitAccentBrush}"
                                                Command="{Binding AddEnvironmentVariableCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ================= APPEARANCE ================= -->
                <ScrollViewer Tag="appearance"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=appearance}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="AppearanceHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="How sessions lay out on screen, and what the transcript and usage pill show." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. LAYOUT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Layout" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="The cockpit-wide default for every sessions workspace. A workspace can arrange itself differently from its own ⚙, above the grid."/>
                        </StackPanel>
                        <!-- These bind to the Global… properties on purpose: a sessions workspace can override
                             them from its own ⚙, and binding the effective value here would save that
                             workspace's choice over the default the moment Options was opened on it. Kept as
                             three checkboxes rather than one choice list (AC-1000 scope cut — the ComboBox
                             conversion isn't in the acceptance criteria and would need new derived state
                             interacting with the AC-999 staging buffer for no behaviour change). -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Show one session at a time (no grid)"
                                      IsChecked="{Binding GlobalSingleSessionLayout}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Switch between sessions from the sidebar or with the session-switch shortcut."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Stack sessions vertically (one column)"
                                      IsChecked="{Binding GlobalStackSessionsVertically}"
                                      IsEnabled="{Binding !GlobalSingleSessionLayout}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="In the grid, place sessions one above the other instead of side by side. Off = the adaptive grid (two sessions sit side by side; three or four form a 2×2). Either way, drag the gutters between panes to resize and the header grip to reorder. No effect when showing one session at a time."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Focus + rail (one session large, the rest as a mini-rail)"
                                      IsChecked="{Binding GlobalFocusRailLayout}">
                                <CheckBox.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!GlobalSingleSessionLayout"/>
                                        <Binding Path="!GlobalStackSessionsVertically"/>
                                    </MultiBinding>
                                </CheckBox.IsEnabled>
                            </CheckBox>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Shows one session large (the focus) with the rest as a live miniature rail beside it — drag the divider between them to resize. No effect when showing one session at a time or stacking vertically."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Minimize to tray when closing the window"
                                      IsChecked="{Binding MinimizeToTrayOnClose}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Keeps the app running in the system tray instead of quitting. Check that the tray icon appears before relying on it."/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. TRANSCRIPT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Show a timestamp on each message"
                                      IsChecked="{Binding ShowTimestamps}"/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="3. USAGE PILL"/>
                        <TextBlock Classes="hint" Text="Which metrics show on the session header, each as its own mini-pill."/>
                        <StackPanel Spacing="6">
                            <CheckBox Content="Context window (ctx %)" IsChecked="{Binding ShowUsagePillContext}"/>
                            <CheckBox Content="Session usage (tokens · cost)" IsChecked="{Binding ShowUsagePillSessionUsage}"/>
                            <CheckBox Content="Rate windows (e.g. 5-hour, weekly — whatever the provider reports)" IsChecked="{Binding ShowUsagePillRateWindows}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= TERMINAL ================= -->
                <ScrollViewer Tag="terminal"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=terminal}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="TerminalHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Terminal" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="The shell and font every TTY session opens with." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. SHELL"/>
                        <!-- Which shell a New terminal opens (#AC-25). "OS default" (blank) uses the machine's
                             preferred shell; the list is what was detected on this machine. Applies to terminal
                             panes only — an AI session runs its provider's CLI, not a shell. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Default shell"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding TerminalShellChoices}"
                                      SelectedItem="{Binding SelectedTerminalShell}"
                                      Width="260"
                                      ToolTip.Tip="Which shell a new terminal opens; OS default uses your system's preferred shell">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TerminalShellChoice">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding IsTerminalShellCustom}">
                            <TextBlock Text="Custom shell"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBox Text="{Binding TerminalCustomShell}" Width="260"
                                     PlaceholderText="e.g. /usr/bin/fish or nu"
                                     ToolTip.Tip="Full path or command of any shell — a third-party shell (fish, nushell, …) not in the list works too"/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. FONT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Font family"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding TerminalFontChoices}"
                                      SelectedItem="{Binding TerminalFontSelection}"
                                      Width="260"
                                      ToolTip.Tip="Pick a common monospace font, or choose Custom… to enter your own"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding IsTerminalFontCustom}">
                            <TextBlock Text="Custom font"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBox Text="{Binding TerminalCustomFontFamily}" Width="260"
                                     PlaceholderText="e.g. JetBrains Mono, monospace"
                                     ToolTip.Tip="Type a font family name; a comma-separated fallback list also works"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Font size"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding TerminalFontSize}" Minimum="8" Maximum="32"
                                           Increment="1" FormatString="0" Width="130" HorizontalContentAlignment="Center"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Applies live to every open TTY session — only the real interactive claude terminal, not the SDK chat view."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= NOTIFICATIONS ================= -->
                <ScrollViewer Tag="notifications"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=notifications}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="NotificationsHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Notifications" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="When the cockpit tells you a session needs you, locally or on Discord." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. LOCAL NOTIFICATIONS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Show a local notification when a session needs you (while you're at the PC)"
                                      IsChecked="{Binding LocalNotificationsEnabled}"/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. DISCORD (WHEN AWAY)"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Send a Discord notification when a session needs you while you're away"
                                      IsChecked="{Binding DiscordNotificationsEnabled}"/>
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding DiscordNotificationsEnabled}">
                            <TextBlock Text="Discord webhook URL"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding WebhookUrl}" PlaceholderText="https://discord.com/api/webhooks/..."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Away after (idle minutes)"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding IdleThresholdMinutes}" Minimum="1" Maximum="240"
                                           Increment="1" FormatString="0" Width="130" HorizontalContentAlignment="Center"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="How long without keyboard/mouse before you count as away (used for the Discord channel)."/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="3. SESSIONS FINISHING AND FALLING QUIET"/>
                        <StackPanel Spacing="8">
                            <CheckBox Content="Tell me when a session is done (only when I'm not looking at it)"
                                      IsChecked="{Binding NotifyOnSessionFinished}"/>
                            <CheckBox Content="Tell me when a session goes idle"
                                      IsChecked="{Binding NotifyOnSessionIdle}"/>
                            <CheckBox Content="Tell me when every session is idle — nothing is running any more"
                                      IsChecked="{Binding NotifyWhenAllSessionsIdle}"/>
                            <CheckBox Content="Tell me when CI goes red on a branch a session is working on"
                                      IsChecked="{Binding NotifyOnCiFailure}"
                                      ToolTip.Tip="Asks gh every five minutes whether the pull request of each session's branch has a failing check. Nothing is started about it — you decide."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Session goes idle after (minutes)"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding SessionIdleMinutes}" Minimum="0" Maximum="240"
                                           Increment="1" FormatString="0" Width="130" HorizontalContentAlignment="Center"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="How long a finished session stays &quot;done&quot; before it counts as idle. 0 leaves it on &quot;done&quot;. This is about a session having nothing to do — not about you being away."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= SHORTCUTS ================= -->
                <!-- AC-1000 "hotkeys together": every ShortcutCaptureControl in the dialog now lives here —
                     screenshot, dictation push-to-talk and the assistant's own push-to-talk — plus the general
                     shortcut list, instead of three of the four being scattered across Sessions/Voice/Assistant. -->
                <ScrollViewer Tag="shortcuts"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=shortcuts}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="ShortcutsHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Shortcuts" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Every key the cockpit captures — screenshot, push-to-talk, and the shortcut list." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. SCREENSHOT"/>
                        <!-- Screenshots (AC-220): a capture goes to the session in view, the same way push-to-talk
                             does. The button in the composer needs nothing configured; only the desktop-wide key
                             is a choice, because it takes a key from every other application on the machine. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Screenshot hotkey (works without focus)"
                                      IsChecked="{Binding ScreenshotGlobalHotkeyEnabled}"/>
                            <materialIcons:MaterialIcon Classes="hint" IsVisible="{Binding IsLinuxPlatform}"
                                ToolTip.Tip="On Linux, the physical key is assigned via System Settings → Shortcuts — the field below is only a hint."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Screenshot key"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <controls:ShortcutCaptureControl Gesture="{Binding ScreenshotHotkeyKeyName, Mode=TwoWay}"
                                                             Mode="SingleKey" MinWidth="110"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Pressed to capture. macOS has no desktop-wide key at all — the composer button is the way there."/>
                        </StackPanel>
                        <!-- Both keys are registered as one set, so two features on one key means one of them
                             stops firing. Said while it is being typed, not after saving — by then the silence
                             has already started. -->
                        <TextBlock Text="{Binding HotkeyConflict}"
                                   IsVisible="{Binding HotkeyConflict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitStatusWaitingBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ScreenshotHotkeyTrigger, StringFormat='Global hotkey: {0}'}"
                                   IsVisible="{Binding ScreenshotHotkeyTrigger, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <!-- AC-566: a preview between confirming a selection and it landing in the session.
                             Off by default — Raymond's own argument, not everyone wants the extra window. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Preview before sending"
                                      IsChecked="{Binding ScreenshotPreviewEnabled}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Shows exactly what would be sent — the cropped image with any marks already burnt in — and asks before it goes, whether you confirmed with Enter, a double-click, or a single click while picking a window."/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. DICTATION PUSH-TO-TALK"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Push-to-talk key"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <controls:ShortcutCaptureControl Gesture="{Binding VoicePushToTalkKeyName, Mode=TwoWay}"
                                                             Mode="SingleKey" MinWidth="110"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Held to dictate. In the cockpit's own windows this is the key; the global hotkey below may not get it — see there."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Global push-to-talk (works without focus)"
                                      IsChecked="{Binding VoiceGlobalPushToTalk}"/>
                            <materialIcons:MaterialIcon Classes="hint" IsVisible="{Binding IsLinuxPlatform}"
                                ToolTip.Tip="On Linux, the physical key is assigned via System Settings → Shortcuts — this field is only a hint."/>
                        </StackPanel>
                        <!-- What the hotkey is really triggered by, which the cockpit does not always decide: a
                             Wayland compositor owns the binding and takes the key above only as a hint, and macOS
                             has no global hotkey at all. Reported rather than assumed — the field above looked
                             like it settled all three and on Linux was not even read. Only shown once global
                             push-to-talk is on, since off means there is nothing to report. -->
                        <TextBlock Text="{Binding VoiceGlobalHotkeyTrigger, StringFormat='Global hotkey: {0}'}"
                                   IsVisible="{Binding VoiceGlobalHotkeyTrigger, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <!-- Linux only: the global hotkey is a desktop-portal binding the compositor takes at
                             startup, so a change to it applies on the next launch, not live (Windows re-arms it
                             live and has no such line). The Restart-now button appears once a change is saved. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsLinuxPlatform}">
                            <TextBlock Text="Requires restarting the cockpit to take effect."
                                       Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Content="Restart now" Classes="Accent"
                                    Command="{Binding RestartAppCommand}"
                                    IsVisible="{Binding VoiceGlobalPushToTalkNeedsRestart}"/>
                        </StackPanel>
                        <!-- Wayland only (AC-691): the GlobalShortcuts portal ties permission to the app's
                             binary path, so moving the AppImage looks like a new app to KDE and the old
                             permission never fires again. This forces a fresh CreateSession/BindShortcuts
                             cycle; it cannot touch the stale registration KDE kept for the old path. -->
                        <StackPanel Orientation="Vertical" Spacing="4" IsVisible="{Binding IsLinuxWayland}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Re-request shortcut permission" Classes="Accent"
                                        Command="{Binding RetryHotkeyPortalPermissionCommand}"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Forces a fresh permission prompt from your desktop's shortcuts portal — try this if global hotkeys stopped working after moving the AppImage."/>
                            </StackPanel>
                            <TextBlock Text="This does not remove your desktop's old registration for the previous location — clean that up yourself in System Settings → Shortcuts."
                                       Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="3. ASSISTANT PUSH-TO-TALK"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Push to talk"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <controls:ShortcutCaptureControl Gesture="{Binding AssistantOptions.PushToTalkKeyName, Mode=TwoWay}"
                                                             Mode="SingleKey" MinWidth="110"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Hold to speak to the assistant. Works while Cockpit is in the background."/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="4. KEYBOARD SHORTCUTS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Click a shortcut and press the keys you want (Esc cancels, ✕ clears; clearing it unbinds the shortcut). Shortcuts don't fire while you're typing in a text box or the terminal, so they never hijack a keystroke — except the session switch, which stays live over the terminal. Plugin-contributed shortcuts (marked 'plugin') can be changed here too."/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ShortcutRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                    <Grid ColumnDefinitions="*,200" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <controls:ShortcutCaptureControl Grid.Column="1" Gesture="{Binding Gesture, Mode=TwoWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= VOICE ================= -->
                <!-- Dictation + transcription only. The assistant's own push-to-talk moved to Shortcuts, its
                     speech/TTS settings moved to Assistant, its consent-bypass moved to Security — the four
                     AC-1000 "kernverplaatsingen". "While you're talking" moved IN from the old Assistant page:
                     the table places it here even though it physically sat on Assistant's page before. -->
                <ScrollViewer Tag="voice"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=voice}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="VoiceHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Voice" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Push-to-talk dictation and its transcription model, plus mic behaviour while the assistant talks." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. DICTATION"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Enable push-to-talk dictation"
                                      IsChecked="{Binding VoiceEnabled}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Off by default: the Whisper model only downloads once you turn this on."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Microphone"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding InputDevices}"
                                      SelectedItem="{Binding SelectedInputDevice}"
                                      DisplayMemberBinding="{Binding Label}" MinWidth="220"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Which microphone the dictation captures from. 'System default' follows your OS setting."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Dictation language"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding SttLanguages}"
                                      SelectedItem="{Binding SelectedSttLanguage}"
                                      DisplayMemberBinding="{Binding Label}" MinWidth="120"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Set a fixed language for more reliable transcription than auto-detect."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Send automatically after dictation (press Enter)"
                                      IsChecked="{Binding VoiceAutoSubmit}"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="On: the transcript is submitted straight away. Off: it is placed in the input for you to review first."/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. TRANSCRIPTION"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Transcription" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Turns your speech into text with Whisper, on-device. What Whisper hears is what you get — the model and backend below (and the calibration further down) are the only levers on accuracy."/>
                        </StackPanel>
                        <!-- AC-68: detected acceleration, so the choices below read as host-aware rather than generic. -->
                        <Border Background="{StaticResource CockpitSecondaryBgBrush}"
                                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="8,5" HorizontalAlignment="Left" MaxWidth="440" Margin="0,2">
                            <TextBlock Text="{Binding TranscriptionHardware}"
                                       FontFamily="{StaticResource CockpitMonoFont}" FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                        </Border>
                        <!-- Curated model dropdown (AC-68): presets with an accuracy-vs-load hint, plus a
                             "Custom…" item that reveals the old free-text box for any other ggml name. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Transcription model"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding TranscriptionModelChoices}"
                                      SelectedItem="{Binding SelectedTranscriptionModel}"
                                      MinWidth="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TranscriptionModelOption">
                                        <Grid ColumnDefinitions="*,Auto" MinWidth="196">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Hint}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}"
                                                       FontFamily="{StaticResource CockpitMonoFont}" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding IsTranscriptionModelCustom}">
                            <TextBlock Text="Custom model"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBox Text="{Binding VoiceCustomModelName}" Width="220"
                                     PlaceholderText="e.g. large-v3-turbo-q5_0"
                                     ToolTip.Tip="Any Whisper ggml model name; quantized variants (q5_0, q8_0) work too"/>
                        </StackPanel>
                        <!-- Host-aware backend (AC-68): only Auto/CPU plus a GPU entry when a GPU runtime
                             actually loads here — never CUDA on a non-NVIDIA machine. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Transcription backend"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding VoiceBackendPreferences}"
                                      SelectedItem="{Binding SelectedVoiceBackendPreference}"
                                      DisplayMemberBinding="{Binding Label}" MinWidth="150"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TranscriptionAdvice}"
                                   IsVisible="{Binding TranscriptionAdvice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>

                        <!-- AC-68: first-use calibration — a real measurement of speed + desktop hitch on
                             every backend this machine can use (CPU and, if a runtime loads, GPU), each timed
                             in its own process, that decides what Auto runs on with a CPU preference. -->
                        <StackPanel Spacing="8" IsVisible="{Binding ShowCalibration}" Margin="0,6,0,0">
                            <TextBlock Classes="optionsSectionHeader" Text="3. FIRST-USE CALIBRATION"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="First-use calibration" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <materialIcons:MaterialIcon Classes="hint"
                                        ToolTip.Tip="Times a sentence on every backend this machine can use and measures how much each one hitches the desktop, then picks the one Auto uses — preferring the CPU unless the GPU is meaningfully faster. Remembered for this machine."/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CalibrationStatus}"
                                           IsVisible="{Binding CalibrationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource CockpitAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding HasCalibration}">
                                <ItemsControl ItemsSource="{Binding CalibrationResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="6"
                                                    Background="{StaticResource CockpitSecondaryBgBrush}">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Border IsVisible="{Binding IsChosen}" CornerRadius="3" Padding="5,1"
                                                                    Background="{StaticResource CockpitAccentBrush}" VerticalAlignment="Center">
                                                                <TextBlock Text="AUTO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" FontFamily="{StaticResource CockpitMonoFont}" FontSize="12"/>
                                                    </Grid>
                                                    <ProgressBar Minimum="0" Value="{Binding LatencyMs}"
                                                                 Maximum="{Binding $parent[ItemsControl].DataContext.CalibrationSpeedMaxMs}"
                                                                 Height="7"/>
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Grid.Column="0" Text="desktop hitch" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="10" Margin="0,0,8,0"/>
                                                        <ProgressBar Grid.Column="1" Minimum="0" Value="{Binding HitchMs}"
                                                                     Maximum="{Binding $parent[ItemsControl].DataContext.CalibrationHitchMaxMs}"
                                                                     Height="5" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding HitchText}" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" FontFamily="{StaticResource CockpitMonoFont}"
                                                                   FontSize="10" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding CalibrationChosenText}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource CockpitAccentBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CalibrationRationale}"
                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CalibrationModelText}"
                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11"
                                           FontFamily="{StaticResource CockpitMonoFont}"/>

                                <!-- AC-68: the model ladder — the same model timed at several sizes on the
                                     winning backend, to advise the accuracy-vs-speed trade-off. -->
                                <StackPanel Spacing="5" IsVisible="{Binding HasModelLadder}" Margin="0,4,0,0">
                                    <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,2"/>
                                    <TextBlock Text="Model speed on the chosen backend" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding CalibrationModelResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="150,*,60" Margin="0,1">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Model}" FontSize="11" VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource CockpitMonoFont}"/>
                                                        <Border IsVisible="{Binding IsRecommended}" CornerRadius="3" Padding="5,1"
                                                                Background="{StaticResource CockpitAccentBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="PICK" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <ProgressBar Grid.Column="1" Minimum="0" Value="{Binding LatencyMs}"
                                                                 Maximum="{Binding $parent[ItemsControl].DataContext.CalibrationModelMaxMs}"
                                                                 Height="6" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" FontFamily="{StaticResource CockpitMonoFont}" FontSize="11"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding CalibrationModelRecommendation}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource CockpitAccentBrush}"/>
                                    <TextBlock Text="{Binding CalibrationModelAdvice}"
                                               Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Run calibration" Command="{Binding RunCalibrationCommand}"
                                        IsEnabled="{Binding CanRunCalibration}"/>
                                <TextBlock Text="Turn on push-to-talk dictation above first — calibration needs the model."
                                           IsVisible="{Binding !VoiceEnabled}" VerticalAlignment="Center"
                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- AC-746: this is assistant material (open-mic has only talked to the assistant
                             since AC-543, and barge-in stops the assistant's own read-aloud), so it needs
                             both the mic pipeline (VoiceEnabled) and the assistant on — without either,
                             open-mic cannot run. Header + rows share one IsVisible so an empty heading
                             can't survive with its content hidden. Moved in from the old Assistant page (AC-1000). -->
                        <StackPanel Spacing="8">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="VoiceEnabled"/>
                                    <Binding Path="AssistantOptions.IsEnabled"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>

                            <TextBlock Classes="optionsSectionHeader" Text="4. WHILE YOU'RE TALKING"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <CheckBox Content="Stop the assistant when I start talking"
                                          IsChecked="{Binding VoiceStopReadAloudWhenSpeaking}"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Needs open mic — without it there is no microphone listening. Holding the push-to-talk key already stops the assistant and needs neither. Use headphones: on speakers the microphone hears the assistant's own voice and stops it straight away."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding VoiceStopReadAloudWhenSpeaking}">
                                <TextBlock Text="…when the microphone is louder than"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding VoiceStopReadAloudLevelThreshold}" Minimum="0.02" Maximum="0.9"
                                               Increment="0.01" FormatString="0.00" Width="120" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding VoiceStopReadAloudWhenSpeaking}">
                                <ToggleButton Content="Test microphone" IsChecked="{Binding IsTestingMic}" Classes="Compact"
                                              ToolTip.Tip="Opens the microphone while it is on — a test, not a setting, so Cancel has nothing to undo here."/>
                                <controls:MicLevelMeter Level="{Binding MicTestLevel}" Threshold="{Binding VoiceStopReadAloudThresholdValue}"
                                                        Width="200" Height="12" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Talk and watch the bar — it turns orange once you cross the marker (the threshold above). The assistant only stops speaking when it hears real speech above this level, not on a stray noise. Set the threshold so normal speech crosses it but the room does not."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Open-mic: end utterance after (silence ms)"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding VoiceOpenMicSilenceTimeoutMs}" Minimum="300" Maximum="3000"
                                               Increment="100" FormatString="0" Width="130" HorizontalContentAlignment="Center"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Open mic is turned on/off at runtime from the sidebar mic button, not here — this is only its tuning."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ASSISTANT ================= -->
                <!-- Own hotkey moved OUT to Shortcuts; consent-bypass moved OUT to Security; Speech (voice/speed/
                     language/output device) moved IN from the old Voice page — a judgement call (not in the
                     ticket's table), since those are literally "Speak replies"'s own parameters. -->
                <ScrollViewer Tag="assistant"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=assistant}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="AssistantHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Assistant" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Talk to the assistant and let it answer — its own profile, replies and speech." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. VOICE ASSISTANT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Voice assistant" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Talk to the assistant and let it answer. Off until you turn it on — nothing listens, and no model is loaded."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox Content="Enable the assistant"
                                      IsChecked="{Binding AssistantOptions.IsEnabled}"/>
                        </StackPanel>

                        <StackPanel Spacing="8" IsEnabled="{Binding AssistantOptions.IsEnabled}">
                            <TextBlock Classes="optionsSectionHeader" Text="2. ASSISTANT PROFILE"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Assistant Profile" FontWeight="SemiBold"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="The assistant's own profile — which provider and model it runs on, and what it may do. It is not in the profile list and cannot be deleted; editing a profile elsewhere never changes it."/>
                            </StackPanel>

                            <!-- A name and an editor, not a picker. This used to be a dropdown over the
                                 profile list, which read as "the assistant uses that profile" — so an
                                 operator set bypassPermissions on it, saw no change, and was right to be
                                 confused: the slot has always held a whole record of its own, copied once.
                                 Naming it as the assistant's own removes the belief instead of annotating
                                 it (which is what a staleness note and a refresh button were doing here). -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AssistantOptions.ProfileLabel}"
                                           IsVisible="{Binding AssistantOptions.ProfileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                                <TextBlock Text="{Binding AssistantOptions.ProfileUnsetReason}"
                                           IsVisible="{Binding AssistantOptions.ProfileUnsetReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                                <Button Content="Edit…" VerticalAlignment="Center"
                                        Command="{Binding EditAssistantProfileCommand}"
                                        ToolTip.Tip="Provider, session defaults, MCP servers and environment variables — and the restart that applies a permission mode"/>
                            </StackPanel>

                            <TextBlock Classes="optionsSectionHeader" Text="3. REPLIES"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Read replies out loud" FontWeight="SemiBold"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="The assistant speaks its answers. Turn off to keep it text only — its own switch, independent of the assistant being on."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <CheckBox Content="Speak replies"
                                          IsChecked="{Binding AssistantOptions.SpeakReplies}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Keep chat window on top" FontWeight="SemiBold"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Keeps the chat pop-out above every other window. Turn off to let it sit behind other windows like any other."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <CheckBox Content="Always on top"
                                          IsChecked="{Binding AssistantOptions.AlwaysOnTop}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Chat window reading level" FontWeight="SemiBold"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="How much the chat window shows: Developer sees everything (tool calls, thinking, costs, jargon); Focus folds tool runs and moves cost to the usage pill; Simple drops tool noise and jargon. The same three levels an SDK session's own header dropdown offers — set here instead, since the chat window is a display, not a control panel."/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding AssistantOptions.ReadingLevels}"
                                      SelectedItem="{Binding AssistantOptions.SelectedReadingLevel}"
                                      DisplayMemberBinding="{Binding Label}" MinWidth="150"
                                      HorizontalAlignment="Left"/>

                            <!-- Moved here from the old Voice → Read-aloud page (AC-546 follow-up, then AC-1000
                                 relocated Read-aloud's remainder here too): these settings exist because the
                                 assistant speaks, and sessions no longer do — so they belong with the rest of the
                                 assistant's settings, not on a page named after a feature that was removed. -->
                            <TextBlock Classes="optionsSectionHeader" Text="4. SPEECH"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Speech" FontWeight="SemiBold"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="The voice the assistant speaks in, and the language it defaults to. The voice model downloads on first use."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Voice"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding TtsVoices}"
                                          SelectedItem="{Binding SelectedTtsVoice}"
                                          DisplayMemberBinding="{Binding Label}" MinWidth="150"/>
                                <Button Content="▶ Hear it" Command="{Binding PreviewVoiceCommand}"
                                        ToolTip.Tip="Speaks one sentence in this voice and language, at the saved speed. The voice model downloads on first use, so the very first press can take a moment."/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="One multilingual voice speaks both Dutch and English — mixed replies are spoken by the same voice, with each part pronounced in its own language."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Speed"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding VoiceTtsSpeed}" Minimum="0.5" Maximum="2.0"
                                               Increment="0.05" FormatString="0.00" Width="120" HorizontalContentAlignment="Center"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="How fast the assistant speaks. 1.00 is the voice's natural pace; higher is faster."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Language"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding ReadAloudLanguages}"
                                          SelectedItem="{Binding SelectedReadAloudLanguage}"
                                          DisplayMemberBinding="{Binding Label}" MinWidth="150"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="The assistant speaks its replies in this language."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Output device"
                                           Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedOutputDevice}"
                                          DisplayMemberBinding="{Binding Label}" MinWidth="220"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Which speaker/headset the assistant's speech plays to. 'System default' follows your OS setting."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= SECURITY ================= -->
                <!-- Consent-bypass moved IN from the old Assistant page (AC-1000: "consent naar Security").
                     Node pairing moved OUT to its own Nodes category. -->
                <ScrollViewer Tag="security"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=security}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="SecurityHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Security" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Encryption, screen lock, terminal access, and the assistant's consent bypass." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. ENCRYPTION"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Encrypt your credentials" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Your provider API keys, MCP bearer tokens and the plugins' tokens are stored in cockpit.json. Encrypting them means the file gives up nothing without your password — if it is copied, synced, backed up, or the laptop walks off."/>
                        </StackPanel>

                        <Border Background="{StaticResource CockpitSecondaryBgBrush}"
                                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,4">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Encrypted — the cockpit asks for your password when it starts"
                                           IsVisible="{Binding Security.IsEncrypted}"
                                           FontSize="12.5" Foreground="{StaticResource CockpitStatusDoneBrush}"/>
                                <TextBlock Text="Not encrypted — your keys and tokens are readable in cockpit.json"
                                           IsVisible="{Binding !Security.IsEncrypted}"
                                           FontSize="12.5" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Encrypt with a password…" Classes="Accent"
                                    IsVisible="{Binding !Security.IsEncrypted}" Click="OnEnableEncryption"/>
                            <Button Content="Change password…"
                                    IsVisible="{Binding Security.IsEncrypted}" Click="OnChangePassword"/>
                            <Button Content="Turn off encryption…"
                                    IsVisible="{Binding Security.IsEncrypted}" Click="OnDisableEncryption"/>
                        </StackPanel>

                        <!-- AC-999: these three rewrite every stored credential the moment they run, so they sit
                             outside the dialog's Apply/Cancel and say so. -->
                        <TextBlock Classes="immediate"
                                   Text="These three run straight away and are not undone by Cancel."/>

                        <TextBlock Text="{Binding Security.Status}"
                                   IsVisible="{Binding Security.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <!-- AC-5: only meaningful while encryption is on, so the row is shown then rather than
                             sitting disabled — a control that does nothing is worse than an absent one. -->
                        <CheckBox Content="Lock the cockpit when the computer locks (screen lock)"
                                  IsChecked="{Binding Security.LockWithOperatingSystem}"
                                  IsVisible="{Binding Security.IsEncrypted}" Margin="0,8,0,0"
                                  ToolTip.Tip="When your screen locks, the cockpit locks too: it clears the password from memory and asks for it again, exactly as it does at startup. On by default; the sessions you left running keep running behind the lock screen."/>

                        <TextBlock Classes="optionsSectionHeader" Text="2. TERMINAL ACCESS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Let an agent read a terminal" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="When on, an agent can ask to read a terminal pane you have open — you approve each pane, watch every line live, and it reads only from the moment you approve (never the earlier scrollback). It cannot type into a terminal yet. Off by default: while off the feature is not offered to any agent at all."/>
                        </StackPanel>
                        <CheckBox Content="Allow agents to read my open terminals (with per-pane approval)"
                                  IsChecked="{Binding Security.TerminalAccessEnabled}"/>

                        <!-- AC-1066: a session on a provider with no built-in shell (every non-Claude, non-ACP
                             provider) otherwise cannot run rg/git/dotnet/python3 at all. Off by default, like
                             terminal access above; the permission ceiling (not a command list) decides what runs. -->
                        <TextBlock Classes="optionsSectionHeader" Text="3. SHELL ACCESS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Let an agent run shell commands" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="When on, any session — including a delegated one on a provider with no built-in shell (Bash is a Claude Code CLI feature, not something the cockpit supplies) — can run a command such as rg, git, dotnet or python3 and read its exit code, stdout and stderr. There is no command allow-list: what runs is decided by the session's permission mode, exactly as for any other write/destructive tool. Off by default: while off the feature is not offered to any agent at all."/>
                        </StackPanel>
                        <CheckBox Content="Allow agents to run shell commands"
                                  IsChecked="{Binding Security.ShellAccessEnabled}"/>

                        <!-- AC-575: the assistant may skip the Cockpit consent card, per source. Two
                             checkboxes per row rather than one three-state picker, and the rows come from
                             sources the host has stamped — there is no field to type a source name into,
                             deliberately. AC-637 puts "Allow all" above them, on by default: every source,
                             both risk classes. The per-source rows are hidden while it is on — they are
                             still stored, so switching it off shows them exactly as they were left.
                             Moved in from the old Assistant page (AC-1000: "consent naar Security"). -->
                        <TextBlock Classes="optionsSectionHeader" Text="4. ASSISTANT CONSENT BYPASS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Skip Cockpit's consent card" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Normally every host-side action the assistant takes raises Cockpit's own consent card and waits for you. Allow all skips it for everything the assistant does; turn it off to decide per source instead, and you are giving that approval now, once, instead of each time. This is Cockpit's card only: Claude's own Allow/Deny inside the chat is a separate gate and keeps asking regardless of this setting. Only the assistant is ever exempt; an ordinary session is asked about exactly as before, and every skipped card is still written to the consent trail."/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <CheckBox Content="Allow all — every source, everyday and dangerous"
                                      IsChecked="{Binding AssistantOptions.ConsentBypassAll}"
                                      ToolTip.Tip="Skip Cockpit's consent card for everything the assistant asks, including dangerous actions: shell commands, handing over a session with your rights, arbitrary network access. Turn it off to fall back to the per-source list, which keeps whatever you ticked there."/>
                            <TextBlock Text="Skips Cockpit's own consent card — Claude's own Allow/Deny in the chat still asks. Every skip is still recorded in the consent trail."
                                       IsVisible="{Binding AssistantOptions.HasConsentBypass}"
                                       Foreground="{StaticResource CockpitStatusWaitingBrush}" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,120,120" Margin="0,2,0,0"
                              IsVisible="{Binding !AssistantOptions.ConsentBypassAll}">
                            <TextBlock Grid.Column="1" Text="Everyday" FontSize="11"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Dangerous" FontSize="11"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AssistantOptions.ConsentBypassSources}"
                                      IsVisible="{Binding !AssistantOptions.ConsentBypassAll}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsentBypassSourceViewModel">
                                    <Grid ColumnDefinitions="*,120,120" Margin="0,3">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <!-- The host-stamped key, when it is not the label itself: a plugin
                                                 names its own label, so this is what says which plugin a row
                                                 really belongs to. -->
                                            <TextBlock Text="{Binding KeyDetail}" FontSize="10"
                                                       IsVisible="{Binding KeyDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                            <!-- Switched on but not a source this build recognises any more —
                                                 typically a stored key from before a source's id changed
                                                 underneath it. Still shown, still switchable off; never
                                                 hidden or silently migrated to a new key (#K11). -->
                                            <TextBlock Text="Unknown source — no longer in use" FontSize="10"
                                                       IsVisible="{Binding IsOrphan}"
                                                       Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BypassLowRisk}"
                                                  ToolTip.Tip="Skip the card for this source's everyday, repeatable actions."/>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding BypassDangerous}"
                                                  ToolTip.Tip="Skip it for this source's dangerous actions too: shell commands, handing over a session with your rights, arbitrary network access. Separate on purpose — the box on the left does not include these."/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= MCP SERVERS ================= -->
                <!-- AC-1002: replaces the standalone McpServersDialog window. Flat on the page background, same
                     venster-in-venster correction as Profiles (AC-1001) — the one hairline divider between the
                     server list and its detail, no wrapping card. Field checklist against McpServersDialog.axaml
                     (criterion 1 — every one must be here): server list with scope/off/auth label, + Add server,
                     the "local models auto-get…" hint, Remove. Per server: Name, Transport, Enabled, Available to.
                     Stdio: Command, Arguments. Http: URL, Authentication, API key, OAuth authority/client id/
                     scopes, Sign-in (Sign in/Sign out + status), Custom headers.
                     Validation (criterion 5, per the answered open question — AC-1005's PluginSettingsError
                     pattern, reused rather than duplicated): the incomplete-server message lands on the Name field
                     itself (below), the dialog-wide ones (duplicate names, a reserved name clash) on
                     McpServers.StatusMessage next to the list, and either way CockpitViewModel.ApplyOptionsAsync
                     also folds it into the shared footer as "MCP Servers: {reason}" via PluginSettingsErrorText —
                     so an operator looking at a different category still learns which one refused. -->
                <ScrollViewer Tag="mcp-servers"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=mcp-servers}">
                    <StackPanel Margin="24,20" Spacing="8">
                        <StackPanel x:Name="McpServersHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="MCP Servers" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Shared MCP servers: which ones exist, who may use them, and how they sign in." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <Grid ColumnDefinitions="180,1,*" Margin="0,4,0,0" IsVisible="{Binding McpServers, Converter={x:Static ObjectConverters.IsNotNull}}">

                            <!-- Server list + Add/Remove. Remove stays a button beside the list (not the shared
                                 footer): removing a server is a staged edit like any other field, undone by Cancel
                                 and written by Apply and Close — see McpServersViewModel.RemoveServer. -->
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,12,0" Spacing="6">
                                    <Button Content="+ Add server" Classes="Subtle" HorizontalAlignment="Left"
                                            Foreground="{StaticResource CockpitAccentBrush}"
                                            Command="{Binding McpServers.AddServerCommand}"/>
                                    <TextBlock Text="Local models auto-get filesystem, fetch, git &amp; memory. Add a server to override one or reach Claude."
                                               FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    <Button Content="Remove" Classes="Subtle" HorizontalAlignment="Left"
                                            Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                            Command="{Binding McpServers.RemoveServerCommand}"
                                            IsVisible="{Binding McpServers.SelectedServer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <!-- Dialog-wide validation refusals (duplicate names, a reserved-name clash) and
                                         the hidden-servers notice — the two things no single field can carry. -->
                                    <TextBlock Text="{Binding McpServers.StatusMessage}" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding McpServers.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{StaticResource CockpitStatusWaitingBrush}"/>
                                </StackPanel>

                                <ListBox ItemsSource="{Binding McpServers.Servers}" SelectedItem="{Binding McpServers.SelectedServer}"
                                         Background="Transparent" Padding="0" Margin="0,0,12,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EditableMcpServerViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedScope.ShortLabel}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                                           IsVisible="{Binding SelectedScope.IsScoped}"/>
                                                <TextBlock Text="(off)" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                                           IsVisible="{Binding !Enabled}"/>
                                                <TextBlock Text="{Binding AuthStatusLabel}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextFaintBrush}"
                                                           IsVisible="{Binding ShowAuthStatus}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- The one functional divider criterion 2 allows: no border/card anywhere else on this page. -->
                            <Border Grid.Column="1" Width="1" Background="{StaticResource CockpitHairlineBrush}" HorizontalAlignment="Center"/>

                            <!-- Detail: the selected server's fields. -->
                            <StackPanel Grid.Column="2" Margin="16,0,0,0" Spacing="11"
                                        IsVisible="{Binding McpServers.SelectedServer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="11" DataContext="{Binding McpServers.SelectedServer}" x:DataType="vm:EditableMcpServerViewModel">

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Name" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Name}"/>
                                        <!-- Field-level half of the answered open question: the incomplete-server
                                             message lands here, not only in the shared footer. -->
                                        <TextBlock Text="Every server needs a name, plus a command (stdio) or a URL (http)."
                                                   FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                                   IsVisible="{Binding !IsValid}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Transport" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}"
                                                      HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Available to" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                                                  DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Local models need servers like filesystem; Claude Code already has its own file/shell/web tools."
                                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                    </StackPanel>

                                    <!-- stdio -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsStdio}">
                                        <TextBlock Text="Command" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Command}" FontFamily="{StaticResource CockpitMonoFont}"
                                                 PlaceholderText="e.g. npx"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsStdio}">
                                        <TextBlock Text="Arguments (one per line)" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Args}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 MinHeight="76" MaxHeight="146" FontFamily="{StaticResource CockpitMonoFont}"
                                                 PlaceholderText="-y&#x0a;@modelcontextprotocol/server-filesystem&#x0a;."/>
                                    </StackPanel>

                                    <!-- http -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsHttp}">
                                        <TextBlock Text="URL" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Url}" FontFamily="{StaticResource CockpitMonoFont}"
                                                 PlaceholderText="https://host/mcp"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsHttp}">
                                        <TextBlock Text="Authentication" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding AuthModes}" SelectedItem="{Binding Auth}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsApiKeyAuth}">
                                        <TextBlock Text="API key" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding ApiKey}" PasswordChar="•"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsOAuthAuth}">
                                        <TextBlock Text="OAuth authority (discovery base)" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding OAuthAuthority}" FontFamily="{StaticResource CockpitMonoFont}"
                                                 PlaceholderText="https://login.example.com"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsOAuthAuth}">
                                        <TextBlock Text="OAuth client id (optional — dynamic registration if empty)" FontSize="11"
                                                   Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding OAuthClientId}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsOAuthAuth}">
                                        <TextBlock Text="OAuth scopes (optional — space-separated, replaces what is derived automatically; include offline_access yourself if you want a refresh token)"
                                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBox Text="{Binding OAuthScopes}" FontFamily="{StaticResource CockpitMonoFont}"
                                                 PlaceholderText="openid offline_access depot"/>
                                    </StackPanel>

                                    <!-- Sign-in status (AC-355/AC-499/AC-1002): a handling, not a value (AC-999) —
                                         it saves and authorizes immediately, outside the Options transaction, so
                                         Cancel cannot undo it and does not pretend to. Sign in is offered as soon
                                         as the row itself is valid; sign out only withdraws whatever is already
                                         stored, so it stays disabled until there is something to withdraw. -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsOAuthAuth}">
                                        <TextBlock Text="Sign-in" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="{Binding SignInButtonLabel}" Classes="Subtle"
                                                    Foreground="{StaticResource CockpitAccentBrush}"
                                                    Command="{Binding SignInCommand}"/>
                                            <Button Grid.Column="1" Content="Sign out" Classes="Subtle"
                                                    Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                    Command="{Binding SignOutCommand}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AuthStatusLabel}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource CockpitTextFaintBrush}" IsVisible="{Binding ShowAuthStatus}"/>
                                        </Grid>
                                        <TextBlock Text="Working…" FontSize="10" Foreground="{StaticResource CockpitTextFaintBrush}"
                                                   IsVisible="{Binding IsAuthBusy}"/>
                                        <TextBlock Text="{Binding SignInUnavailableReason}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitTextFaintBrush}"
                                                   IsVisible="{Binding SignInUnavailableReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding AuthMessage}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CockpitStatusWaitingBrush}"
                                                   IsVisible="{Binding AuthMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <!-- Custom headers (AC-354): independent of the auth choice above, since Auth
                                         only covers the Authorization: Bearer shape — a server that expects
                                         X-Api-Key or another scheme needs a free header instead. -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsHttp}">
                                        <TextBlock Text="Custom headers" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <TextBlock Text="For a server that expects X-Api-Key or another scheme instead of Authorization: Bearer."
                                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource CockpitTextFaintBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Headers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:McpHeaderRowViewModel">
                                                    <Grid ColumnDefinitions="4*,5*,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                                        <TextBox Grid.Column="0" Text="{Binding Name}" PlaceholderText="X-Api-Key"
                                                                 FontFamily="{StaticResource CockpitMonoFont}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="value"
                                                                 PasswordChar="•"/>
                                                        <Button Grid.Column="2" Classes="Subtle" VerticalAlignment="Center"
                                                                Command="{Binding $parent[ItemsControl].((vm:EditableMcpServerViewModel)DataContext).RemoveHeaderCommand}"
                                                                CommandParameter="{Binding}">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add header" Classes="Subtle" HorizontalAlignment="Left"
                                                Foreground="{StaticResource CockpitAccentBrush}"
                                                Command="{Binding AddHeaderCommand}"/>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= NODES ================= -->
                <!-- Split out of the old Security tab (AC-1000: "nodes los van security"). -->
                <ScrollViewer Tag="nodes"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=nodes}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="NodesHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Nodes" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Pair with another Cockpit to share MCP access, and run sessions on its machine." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. ACCEPT CONNECTIONS FROM A SECOND COCKPIT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Accept connections from a second Cockpit" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Off by default: every MCP endpoint this cockpit hosts stays reachable only from this machine. Turning it on adds a second, TLS-protected listener on your network for each one, guarded by a shared key (generated for you below) instead of this run's own key — a second Cockpit types the address and key into its 'Add MCP server' dialog to reach this one as a node. Takes effect the next time you start Cockpit, not immediately."/>
                        </StackPanel>
                        <CheckBox Content="Accept MCP connections from another Cockpit on this network"
                                  IsChecked="{Binding Security.NodeEndpointEnabled}"/>
                        <StackPanel Spacing="4" Margin="24,4,0,0" IsVisible="{Binding Security.NodeEndpointEnabled}">
                            <TextBlock Text="Pairing address — type this into the other Cockpit" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Security.NodePairingAddress}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="11.5"/>
                            <TextBlock Text="Address" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding Security.NodeEndpointAddressText}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="11.5"/>
                            <TextBlock Text="Shared key" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding Security.NodeEndpointSharedSecret}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="11.5"/>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Visible outside this network" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="This node is always visible on its own local network. Past that, nothing — not a discovery reply, not a pairing request — until you list the ranges allowed to reach it here, comma-separated CIDR notation (e.g. 203.0.113.0/24). Empty by default, on purpose."/>
                            </StackPanel>
                            <TextBox Text="{Binding Security.AllowedDiscoveryRangesText, UpdateSourceTrigger=LostFocus}" PlaceholderText="e.g. 203.0.113.0/24"
                                     FontFamily="Consolas,monospace" FontSize="11.5"/>

                            <Border IsVisible="{Binding Security.IsPaired}" Margin="0,8,0,0" Padding="10"
                                    CornerRadius="9" Background="{StaticResource CockpitInsetBgBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Security.PairedControllerText}" TextWrapping="Wrap" FontSize="11.5"/>
                                    <Button Content="Unpair" HorizontalAlignment="Left" Command="{Binding Security.UnpairNodeCommand}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="What this controller may use here" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                        <materialIcons:MaterialIcon Classes="hint"
                                            ToolTip.Tip="Nothing, until you tick a profile or project below — a fresh pairing starts able to reach none of them, and unticking one here takes effect immediately, without unpairing."/>
                                    </StackPanel>
                                    <TextBlock Text="Profiles" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Security.ScopedProfiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsAllowed}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No profiles saved yet." FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                               IsVisible="{Binding !Security.ScopedProfiles.Count}"/>

                                    <TextBlock Text="Projects" FontSize="11" Foreground="{StaticResource CockpitTextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Security.ScopedProjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsAllowed}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No projects saved yet." FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                               IsVisible="{Binding !Security.ScopedProjects.Count}"/>
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding Security.HasIncomingPairing}" Margin="0,8,0,0" Padding="10"
                                    CornerRadius="9" Background="{StaticResource CockpitInsetBgBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Security.IncomingPairingCaption}" TextWrapping="Wrap" FontSize="11.5"/>
                                    <TextBlock Text="{Binding Security.IncomingPairingCode}" FontFamily="Consolas,monospace" FontSize="24" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="The codes match — pair" Command="{Binding Security.ConfirmIncomingPairingCommand}"/>
                                        <Button Content="Refuse" Command="{Binding Security.RefuseIncomingPairingCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="2. PAIR WITH ANOTHER COCKPIT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Pair with another Cockpit" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Type the pairing address the other Cockpit shows on its own Security tab. Both screens then show the same six digits: check they match before continuing, because a different number means something other than that machine is answering. The pairing goes live only after both of you have confirmed, and this cockpit remembers that machine's certificate so nothing else can take its place later."/>
                        </StackPanel>
                        <StackPanel Spacing="6" Margin="24,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Discover nodes on this network" Command="{Binding Security.DiscoverNodesCommand}"
                                        IsEnabled="{Binding !Security.IsDiscoveringNodes}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Security.DiscoveryStatus}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                       IsVisible="{Binding Security.DiscoveryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding Security.FoundNodes}" IsVisible="{Binding Security.FoundNodes.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
                                            <TextBlock Text="{Binding Address}" FontFamily="Consolas,monospace" FontSize="11.5" VerticalAlignment="Center"/>
                                            <Button Content="Use" Command="{Binding $parent[ItemsControl].DataContext.Security.UseFoundNodeCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding Security.PairWithNodeAddress}" PlaceholderText="192.168.1.20:7331" Width="240"
                                         FontFamily="Consolas,monospace" FontSize="11.5"
                                         IsEnabled="{Binding !Security.IsComparingPairingCode}"/>
                                <Button Content="Start pairing" Command="{Binding Security.StartPairingCommand}"
                                        IsEnabled="{Binding !Security.IsPairingBusy}"/>
                            </StackPanel>

                            <Border IsVisible="{Binding Security.IsComparingPairingCode}" Padding="10"
                                    CornerRadius="9" Background="{StaticResource CockpitInsetBgBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Security.OutgoingPairingCaption}" TextWrapping="Wrap" FontSize="11.5"/>
                                    <TextBlock Text="{Binding Security.OutgoingPairingCode}" FontFamily="Consolas,monospace" FontSize="24" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="The codes match — continue" Command="{Binding Security.ConfirmPairingCodeCommand}"
                                                IsEnabled="{Binding !Security.IsPairingBusy}"/>
                                        <Button Content="Cancel" Command="{Binding Security.CancelPairingCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Security.PairingStatus}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                       IsVisible="{Binding Security.PairingStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="3. SESSIONS ON YOUR NODES"
                                    IsVisible="{Binding Security.PairedNodes.Count}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding Security.PairedNodes.Count}">
                            <TextBlock Text="Sessions on your nodes" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="These run on the other machine, under its account and on its bill — nothing here is a session on this computer. You can start one only under a profile or project that machine's operator has ticked for you, and what you start keeps running there after you close this window, lose the network or unpair. Stopping is the only thing that ends it."/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Security.PairedNodes}" Margin="24,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="9" Background="{StaticResource CockpitInsetBgBrush}">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NodeName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="another machine" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Sessions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Profile}" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Statusline}" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"/>
                                                            <Button Content="Stop" Command="{Binding $parent[ItemsControl].DataContext.StopCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                                          MinWidth="180" PlaceholderText="Profile">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                                          MinWidth="160" PlaceholderText="Project">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Text="{Binding NewSessionName}" PlaceholderText="Name it" Width="150" FontSize="11.5"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox Text="{Binding NewSessionPrompt}" PlaceholderText="What it should do (optional)"
                                                         Width="320" FontSize="11.5"/>
                                                <Button Content="Start there" Command="{Binding StartCommand}" IsEnabled="{Binding !IsBusy}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="optionsSectionHeader" Text="4. IF SOMETHING GOES WRONG"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock Text="If you forget the password" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Nobody can decrypt your tokens — the password is stored nowhere, and that is the whole point. The lock screen offers one way back: clear the credentials and enter them again. Your profiles, sessions, layout and shortcuts are untouched by that."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="If something goes wrong halfway" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="It cannot leave you with half a file. The new config is written beside the old one and renamed over it in one step, so you have either the old one or the new one — never a mix — and the previous version is kept as cockpit.json.bak. A value that will not convert aborts the whole thing and touches nothing. And an already-encrypted value is never encrypted a second time, so a config that ended up mixed anyway (a restored backup, a hand edit) still opens, and the rest is encrypted on the next save."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="What this does not do" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="It protects the file, not the cockpit while it runs. While the app is unlocked the credentials are in memory and are handed to the sessions and tool servers that need them — and a plugin you installed runs inside this app and can read them. The plugins you trust are the ones you install."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= BACKUP ================= -->
                <ScrollViewer Tag="backup"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=backup}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="BackupHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Backup" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="One archive with your settings, profiles and plugins — and the assistant's memory on its own." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. BACK UP THE COCKPIT"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Back up the cockpit" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="One archive with your settings, profiles, plugins and everything they saved. The speech models are left out on purpose — they are gigabytes, and they download again in minutes. The same archive is what you carry to another machine."/>
                        </StackPanel>

                        <CheckBox Content="Include my keys and tokens" IsChecked="{Binding BackupIncludesCredentials}"
                                  ToolTip.Tip="Provider API keys, the Discord webhook, plugin tokens. Off by default: an archive you can drop in a cloud folder must not be a key ring. Without them the archive is safe to store anywhere, and a restore tells you which ones to enter again."/>

                        <CheckBox Content="Include the profiles' own config directories" IsChecked="{Binding BackupIncludesProfiles}"
                                  ToolTip.Tip="~/.claude and friends — the agents' own logins, which live outside the cockpit's directory. Needed to move a machine; not needed to undo a mistake."/>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Plugins to include" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="A plugin's binaries and everything it stored travel together, or not at all. All of them unless you say otherwise."/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding BackupPlugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackupPluginViewModel">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Create backup…" Classes="Accent" Click="OnCreateBackup" IsEnabled="{Binding CanBackUp}"/>
                            <Button Content="Restore from a backup…" Click="OnRestoreBackup" IsEnabled="{Binding CanBackUp}"/>
                            <Button Content="Stop" Click="OnStopBackup"
                                    IsVisible="{Binding IsBackupRunning}" IsEnabled="{Binding CanStopBackup}"
                                    ToolTip.Tip="A backup can be stopped at any point — it is built aside and only moved into place when it is whole. A restore can be stopped while it unpacks and while it fetches plugins, which is where the minutes go; a stop there takes effect between plugins, and what was already fetched stays. Once the settings themselves are being written back, stopping would leave the cockpit half-restored, so the offer is withdrawn."/>
                        </StackPanel>

                        <TextBlock Classes="immediate"
                                   Text="Both run straight away and are not undone by Cancel."/>

                        <TextBlock Text="Restoring replaces every setting, profile and plugin here. What is in place now is moved aside rather than deleted, and the cockpit restarts afterwards."
                                   Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding BackupStatus}" IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <TextBlock Classes="optionsSectionHeader" Text="2. ASSISTANT MEMORY ONLY"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Assistant memory only" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Just assistant-memory.md and assistant-state.md — what the assistant was told to remember and where a conversation last stood. Loose from the backup above: no settings, no plugins, nothing to scrub."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Export…" Click="OnExportAssistantMemory" IsEnabled="{Binding CanBackUpAssistantMemory}"/>
                            <Button Content="Import…" Click="OnImportAssistantMemory" IsEnabled="{Binding CanBackUpAssistantMemory}"/>
                        </StackPanel>

                        <TextBlock Classes="immediate"
                                   Text="Both run straight away and are not undone by Cancel."/>

                        <TextBlock Text="Importing replaces the assistant's memory. What is in place now is moved aside rather than deleted."
                                   Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding AssistantMemoryBackupStatus}" IsVisible="{Binding AssistantMemoryBackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= UPDATES ================= -->
                <ScrollViewer Tag="updates"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=updates}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="UpdatesHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Updates" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Whether the cockpit checks for a newer build, and how to get one." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. UPDATES"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Updates" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="The cockpit asks GitHub whether a newer build exists. It does not install itself: replacing a running, unsigned application on three platforms is a promise this project cannot keep, and an updater that half-keeps it is worse than a link you click yourself."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="This build:" Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentBuild}" FontFamily="{StaticResource CockpitMonoFont}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <CheckBox Content="Look for a newer build when the cockpit starts" IsChecked="{Binding CheckForUpdatesOnStartup}"/>
                            <CheckBox Content="Also tell me about nightly builds" IsChecked="{Binding IncludeNightlyBuilds}"
                                      ToolTip.Tip="The rolling build of main, built last night — useful for trying something that landed today, but things there are expected to break; not what you run a working day on."/>
                        </StackPanel>

                        <!-- Said plainly rather than left to be discovered: a copy the updater did not install
                             cannot fetch a newer build over itself (AC-385). That is the ordinary case for a
                             tarball, a checkout, or a distribution's own package — so it gets a sentence and
                             the release page, not a button that would quietly do nothing.
                             Since AC-387 it cannot look, either: the check reads the same installation the
                             update would replace, so there is nothing here to compare a feed against. Promising
                             to tell them anyway, as this said until that landed, would be a promise the cockpit
                             stopped being able to keep. -->
                        <TextBlock x:Name="SelfUpdateNotice" IsVisible="{Binding !CanUpdateItself}"
                                   Text="This copy cannot update itself — it was not installed by the cockpit's installer, so it cannot check for a newer build either. Get a newer build from the release page, or update it the way you installed this one."
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Check now" Click="OnCheckForUpdates" IsEnabled="{Binding CanCheckForUpdates}"
                                    ToolTip.Tip="Reaches the network straight away — a check, not a setting, so Cancel has nothing to undo here."/>
                            <!-- Self-updating build (AC-385, AC-388): the same download-and-restart pair as the
                                 persistent banner, in place of the plain release link a copy the updater did not
                                 install keeps below. -->
                            <Button x:Name="UpdateNowButton" Content="Update now" Classes="Accent"
                                    Command="{Binding UpdateNowCommand}"
                                    IsVisible="{Binding ShowSelfUpdateButtons}"
                                    IsEnabled="{Binding !IsUpdateDownloading}"/>
                            <Button x:Name="InstallOnNextStartButton" Content="Install on next start"
                                    Command="{Binding InstallUpdateOnNextStartCommand}"
                                    IsVisible="{Binding ShowSelfUpdateButtons}"
                                    IsEnabled="{Binding !IsUpdateDownloading}"
                                    ToolTip.Tip="Downloads now and applies the next time the cockpit starts, without restarting it now"/>
                            <Button x:Name="OpenReleaseButton" Content="Open the release" Classes="Accent" Click="OnOpenUpdate"
                                    IsVisible="{Binding ShowOpenReleaseButton}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsUpdateDownloading}">
                            <ProgressBar Width="160" Height="6" VerticalAlignment="Center"
                                         Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                       Text="{Binding UpdateDownloadProgress, StringFormat='{}{0}%'}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding UpdateStatus}" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource CockpitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= DEBUG ================= -->
                <ScrollViewer Tag="debug"
                              IsVisible="{Binding #CategoryNav.SelectedItem, Converter={x:Static conv:CategoryTagEqualsConverter.Instance}, ConverterParameter=debug}">
                    <StackPanel Margin="24,20" MaxWidth="900" Spacing="8">
                        <StackPanel x:Name="DebugHelp" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Debug" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Controls for investigating the cockpit itself, not for doing the work." Classes="optionsHint"/>
                        <Border Height="1" Background="{StaticResource CockpitHairlineBrush}" Margin="0,4"/>

                        <TextBlock Classes="optionsSectionHeader" Text="1. DIAGNOSTICS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Diagnostics" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="Controls that exist to investigate the cockpit itself, rather than to do the work. They are hidden by default: a session header is a strip, and a button you never need does not belong in it."/>
                        </StackPanel>
                        <CheckBox Content="Show debug controls" IsChecked="{Binding ShowDebugControls}"
                                  ToolTip.Tip="Adds the Redraw button to every TTY session's header — it forces the terminal to repaint when a resize or focus change left the TUI misaligned"/>

                        <CheckBox Content="Log diagnostic snapshots" IsChecked="{Binding LogDiagnosticSnapshots}"
                                  ToolTip.Tip="Writes one line to the log every few seconds — memory, GC, handles, threads — so a slow leak or a freeze leaves a trail. Off by default; takes effect immediately, no restart needed. The UI-freeze heartbeat itself is separate and always on."/>

                        <!-- Render backend (AC-67). Only meaningful on macOS, so shown there — plus in any dev build,
                             so it can be verified off-Mac. The backend is fixed at startup, so a saved change offers
                             a restart, the same affordance the Voice tab uses for the Linux global hotkey. -->
                        <StackPanel Spacing="6" IsVisible="{Binding ShowRenderBackendSetting}">
                            <TextBlock Classes="optionsSectionHeader" Text="2. RENDER BACKEND (MACOS)"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Render backend (macOS)" FontWeight="SemiBold"/>
                                <materialIcons:MaterialIcon Classes="hint"
                                    ToolTip.Tip="Which graphics backend the cockpit draws with. Auto lets macOS pick (Metal); switch to OpenGL or Software to test whether the Metal path is behind runaway memory growth (AC-57). No effect on Windows/Linux."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Backend" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding RenderBackendChoices}"
                                          SelectedItem="{Binding RenderBackendSelection}"
                                          Width="180"/>
                                <TextBlock Text="{Binding RenderingSettingsStatus}"
                                           IsVisible="{Binding RenderingSettingsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource CockpitAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding RenderBackendNeedsRestart}">
                                <TextBlock Text="Saved — restart to apply the new render backend."
                                           Foreground="{StaticResource CockpitTextFaintBrush}" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Content="Restart Cockpit" Classes="Accent"
                                        Command="{Binding RestartAppCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Classes="optionsSectionHeader" Text="3. SYSTEM DIAGNOSTICS"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="System diagnostics" FontWeight="SemiBold"/>
                            <materialIcons:MaterialIcon Classes="hint"
                                ToolTip.Tip="What this install runs on, how it draws, and what it is holding in memory — plus any crash or out-of-memory logs the OS wrote. Copy it into a report instead of hunting through Activity Monitor and crash-report folders."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="OnRefreshDiagnostics"/>
                            <Button Content="Copy diagnostics" Click="OnCopyDiagnostics"/>
                            <TextBlock Text="{Binding Diagnostics.Status}"
                                       IsVisible="{Binding Diagnostics.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource CockpitAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Border Background="{StaticResource CockpitSecondaryBgBrush}"
                                BorderBrush="{StaticResource CockpitHairlineBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,4">
                            <!-- AC-755: the report holds paths and OS lines longer than the dialog is wide, and
                                 the tab's own ScrollViewer only scrolls down, so they were simply cut off. -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding Diagnostics.Report}"
                                                     FontFamily="{StaticResource CockpitMonoFont}" FontSize="12"
                                                     Foreground="{StaticResource CockpitTextSecondaryBrush}"
                                                     TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Panel>
        </Grid>
    </DockPanel>

    <!-- The migration overlay. It blocks the dialog on purpose: this is the one operation that rewrites every
         credential the operator has, and letting them edit settings underneath it is how you get a half file. -->
    <Border IsVisible="{Binding Security.IsMigrating}" Background="#CC0f1116">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Width="300">
            <TextBlock Text="{Binding Security.MigrationCaption}" HorizontalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"/>
            <ProgressBar Minimum="0" Maximum="100" Height="6"
                         Value="{Binding Security.MigrationProgress}"
                         Foreground="{StaticResource CockpitAccentBrush}"/>
            <TextBlock Text="Do not close the cockpit while this runs." HorizontalAlignment="Center"
                       FontSize="11" Foreground="{StaticResource CockpitTextFaintBrush}"/>
        </StackPanel>
    </Border>

    <!-- The calibration overlay (AC-68). It blocks the dialog while a measurement runs: each backend is timed in a
         child process and the desktop hitch is sampled here, so letting the operator drive the UI underneath would
         both muddy the hitch reading and invite a settings change mid-run. -->
    <Border IsVisible="{Binding IsCalibrating}" Background="#CC0f1116">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Width="330">
            <TextBlock Text="Calibrating transcription" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CalibrationStatus}" HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="12" Foreground="{StaticResource CockpitTextSecondaryBrush}" TextWrapping="Wrap"/>
            <ProgressBar Minimum="0" Maximum="100" Height="6"
                         IsIndeterminate="{Binding CalibrationProgressIndeterminate}"
                         Value="{Binding CalibrationProgressValue}"
                         Foreground="{StaticResource CockpitAccentBrush}"/>
            <TextBlock Text="Measuring each backend in its own process — this can take a few minutes, especially the CPU run and the first-time model or runtime download." HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="11" Foreground="{StaticResource CockpitTextFaintBrush}" TextWrapping="Wrap"/>
            <Button Content="Cancel" Command="{Binding CancelCalibrationCommand}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
  </Panel>
</Window>
