<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cockpit.App.ViewModels"
        xmlns:controls="using:Cockpit.App.Controls"
        mc:Ignorable="d"
        x:Class="Cockpit.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="Wispslate Cockpit"
        Width="560" Height="400" CanResize="False" ShowInTaskbar="True"
        WindowDecorations="None" Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <Style Selector="Button.unlockLink :is(TextBlock)">
            <Setter Property="Foreground" Value="{DynamicResource CockpitTextSecondaryBrush}"/>
        </Style>
        <!-- AC-2318: top-aligned in both layouts, so the unlock layout is a Margin and size transition, not a jump. -->
        <Style Selector="StackPanel.splashContent">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,44,0,0"/>
            <Setter Property="Transitions">
                <Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.55" Easing="QuarticEaseOut"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.splashContent.unlock">
            <Setter Property="Margin" Value="0,30,0,0"/>
        </Style>
        <Style Selector="Grid.mark">
            <Setter Property="Width" Value="168"/>
            <Setter Property="Height" Value="126"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.55" Easing="QuarticEaseOut"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.55" Easing="QuarticEaseOut"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.55" Easing="QuarticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.unlock Grid.mark">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="StackPanel.steps">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.steps.shown">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TextBox.unlockError">
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitStatusErrorBrush}"/>
        </Style>
        <Style Selector="TextBox.unlockError:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitStatusErrorBrush}"/>
        </Style>
        <Style Selector="Border.segment">
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource CockpitInsetBgBrush}"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style Selector="Border.segment.done">
            <Setter Property="Background" Value="{DynamicResource CockpitAccentBrush}"/>
        </Style>
        <Style Selector="Border.segment.skipped">
            <Setter Property="Background" Value="{DynamicResource CockpitHairlineHoverBrush}"/>
        </Style>
        <Style Selector="Border.segment.failed">
            <Setter Property="Background" Value="{DynamicResource CockpitStatusErrorBrush}"/>
        </Style>
        <Style Selector="Border.segment.active">
            <Setter Property="Background" Value="{DynamicResource CockpitAccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.headline.failed">
            <Setter Property="Foreground" Value="{DynamicResource CockpitStatusErrorBrush}"/>
        </Style>
    </Window.Styles>

    <Border x:Name="Card" Background="{DynamicResource CockpitPanelBgBrush}"
            BorderBrush="{DynamicResource CockpitHairlineBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource CockpitPanelRadius}">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Border.Transitions>

        <StackPanel Classes="splashContent" Classes.unlock="{Binding UnlockLayout}" HorizontalAlignment="Center" Width="446" Spacing="0">
            <!-- AC-2318: the start state; SplashEntrance animates the pieces on the compositor, or shows the end state at once. Two halves with static masks
                 build the arrival, the whole image takes over, and one gradient band runs through the mark. -->
            <Grid x:Name="MarkBox" Classes="mark" HorizontalAlignment="Center">
                <Image x:Name="MarkFull" Source="/Assets/BrandMark.png" Stretch="Uniform" Opacity="0"/>
                <Image x:Name="MarkTrail" Source="/Assets/BrandMark.png" Stretch="Uniform" Opacity="0">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#FF000000" Offset="0.24"/>
                            <GradientStop Color="#00000000" Offset="0.33"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image x:Name="MarkBody" Source="/Assets/BrandMark.png" Stretch="Uniform" Opacity="0">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#00000000" Offset="0.24"/>
                            <GradientStop Color="#FF000000" Offset="0.33"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Grid IsHitTestVisible="False" ClipToBounds="True">
                    <Grid.OpacityMask>
                        <ImageBrush Source="/Assets/BrandMark.png" Stretch="Uniform"/>
                    </Grid.OpacityMask>
                    <Border x:Name="SheenBand" Width="104" HorizontalAlignment="Left" Margin="-114,0,0,0" Opacity="0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,20%">
                                <GradientStop Color="#0019D8F0" Offset="0"/>
                                <GradientStop Color="#19D8F0" Offset="0.26"/>
                                <GradientStop Color="#FFFFFF" Offset="0.40"/>
                                <GradientStop Color="#1E90F0" Offset="0.50"/>
                                <GradientStop Color="#2F4BE0" Offset="0.64"/>
                                <GradientStop Color="#9B5CF6" Offset="0.78"/>
                                <GradientStop Color="#009B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>
            <StackPanel x:Name="NameBox" Opacity="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="Wispslate" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource CockpitTextPrimaryBrush}"/>
                    <TextBlock Text="Cockpit" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource CockpitTextFaintBrush}" Margin="0,4,0,28"/>
            </StackPanel>

            <StackPanel Classes="steps" Classes.shown="{Binding StepsVisible}" Spacing="0">
                <TextBlock Text="{Binding Headline}" FontSize="13" TextWrapping="Wrap" MinHeight="18" Classes="headline" Classes.failed="{Binding HasFailure}"
                           Foreground="{DynamicResource CockpitTextPrimaryBrush}"/>
                <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" MinHeight="16" Margin="0,4,0,10"
                           Foreground="{DynamicResource CockpitTextSecondaryBrush}"/>
                <StackPanel IsVisible="{Binding IsUnlocking}">
                    <!-- AC-1879: Windows Hello first, the password beside it; only while Hello can open this configuration here. -->
                    <StackPanel IsVisible="{Binding Unlock.OffersHello}" Spacing="6" Margin="0,0,0,8" IsEnabled="{Binding !Unlock.IsBusy}">
                        <Button Classes.Accent="{Binding !Unlock.HelloTried}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Command="{Binding Unlock.TryHelloCommand}" IsEnabled="{Binding !Unlock.IsWaitingForHello}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="FaceRecognition" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Unlock.HelloButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="or type your password" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,104" ColumnSpacing="8" IsEnabled="{Binding !Unlock.IsBusy}">
                        <TextBox x:Name="PasswordBox" PasswordChar="•" PlaceholderText="Password" Classes.unlockError="{Binding HasUnlockError}"
                                 Text="{Binding Unlock.Password, Mode=TwoWay}" KeyDown="OnPasswordKeyDown"/>
                        <Button Grid.Column="1" Classes.Accent="{Binding Unlock.UnlockIsPrimary}" Content="Unlock" HorizontalAlignment="Stretch" Click="OnUnlock"/>
                    </Grid>
                    <TextBlock Text="{Binding Unlock.Error}" FontSize="11" MinHeight="30" Padding="0,4,0,0" TextWrapping="Wrap"
                               IsVisible="{Binding Unlock.Notice, Converter={x:Static ObjectConverters.IsNull}}"
                               Foreground="{DynamicResource CockpitStatusErrorBrush}"/>
                    <TextBlock Text="{Binding Unlock.Notice}" FontSize="11" MinHeight="30" Padding="0,4,0,0" TextWrapping="Wrap"
                               IsVisible="{Binding Unlock.Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource CockpitStatusWaitingBrush}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Segments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SplashSegment">
                            <Border Classes="segment" Classes.done="{Binding IsDone}" Classes.active="{Binding IsActive}"
                                    controls:CompositionPulse.IsOn="{Binding IsActive}"
                                    Classes.failed="{Binding IsFailed}" Classes.skipped="{Binding IsSkipped}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Position}" FontSize="11"
                               Foreground="{DynamicResource CockpitTextFaintBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsUnlocking}"
                                IsEnabled="{Binding !Unlock.IsBusy}">
                        <Button Classes="Subtle unlockLink" FontSize="11" Content="I forgot my password" Click="OnForgot"/>
                        <Button Classes="Subtle unlockLink" FontSize="11" Content="Quit" Click="OnQuit"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
