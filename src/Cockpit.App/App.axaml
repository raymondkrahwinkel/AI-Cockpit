<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cockpit.App.App"
             xmlns:local="using:Cockpit.App"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Dark">
             <!-- Dark until settings load; Styles/Theme.axaml carries both variants and `App._FollowTheme` moves
                  this to the operator's choice (AC-860). -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- Templates two views share. App-wide so both the session pane and the assistant's chat window resolve the
         same one (AC-630) — a flyout's contents look resources up from here whichever window opened it. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Cockpit.App/Views/Shared/BackgroundTaskTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Material icon styles, app-wide, so the host and every plugin draw from the same bundled icon set (AC-33). -->
        <materialIcons:MaterialIconStyles />
        <!-- DataGrid theme, app-wide, so plugin dialogs (#14) can host a DataGrid without shipping/theming their own. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://Cockpit.App/Styles/Theme.axaml"/>
    </Application.Styles>
</Application>