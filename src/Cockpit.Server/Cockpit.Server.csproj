<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC-1444: the backend as its own process, for a container. Core and Infrastructure only: no Cockpit.App and no
       Cockpit.Plugins.Abstractions.UI, so its output carries no Avalonia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Core\Cockpit.Core.csproj" />
    <ProjectReference Include="..\Cockpit.Infrastructure\Cockpit.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The plugins the desktop ships, built and never referenced, beside the output as bundled-plugins (AC-1392). -->
  <Import Project="..\BundledPlugins.targets" />

</Project>
