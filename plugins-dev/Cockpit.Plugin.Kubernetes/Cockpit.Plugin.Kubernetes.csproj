<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kubernetes plugin (AC-80): register clusters and inject an mcp__k8s__* MCP server so an agent can work with
       them under strict, human-approved control. Proxy model — the plugin talks to the kube-apiserver itself via
       KubernetesClient, keeps the credentials, and gates every call (connection, namespace jail, mutation, exec).
       Built OUTSIDE the main solution (plugins-dev/) like the other plugins; package bin/<config>/net10.0 into a
       .zip and install it via the plugin store. EnableDynamicLoading emits the .deps.json the host's
       AssemblyDependencyResolver needs. Shared assemblies (Cockpit.Plugins.Abstractions, the DI abstractions,
       ModelContextProtocol) are compile-only (Private=false / ExcludeAssets=runtime) so the host's copies load and
       shared types keep one identity. KubernetesClient is this plugin's own runtime dependency (like Workflows
       ships Jint), so it and its transitive deps are packaged into the plugin folder.
       AC-1394: the settings view and its toolbar button live in Ui/, their own project (Avalonia, Material.Icons),
       which builds into this project's bin/ (the reference below orders the build and references no assembly);
       this project names no Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);Ui\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration. Without it MSBuild strips Configuration off a reference
         made outside a solution, the UI part lands in bin/Debug, and a Release copy of the plugin has no UI assembly;
         discovery then skips the whole plugin, as its manifest names a file that is not there. -->
    <ProjectReference Include="Ui\Cockpit.Plugin.Kubernetes.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The [McpServerTool] attributes for the k8s MCP (AC-80). Host-provided (the cockpit already loads
         ModelContextProtocol), so compile-only — the plugin ships no copy and the attribute types keep one identity. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The plugin's own runtime dependency: the official Kubernetes C# client. Not compile-only — it and its
         transitive deps ship in the plugin folder. One of those transitive deps is YamlDotNet, which the Helm
         rollback's manifest reader uses directly (AC-1061 fase 2): the same assembly at the same version the client
         already pins, so there is no second copy and still no runtime dependency beyond this one. -->
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.Kubernetes.Tests" />
  </ItemGroup>

</Project>
