<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cockpit plugin (AC-166): registers Depot as a place a project's memory can live, via
       ICockpitHost.AddProjectMemorySource — the first consumer of that extension point. Built OUTSIDE
       Cockpit.slnx (plugins-dev/) like the other example plugins. Shared assemblies are compile-only
       (Private=false / ExcludeAssets=runtime) so the host's copies load and shared types keep one identity —
       the plugin folder ships only its own DLL + plugin.json.
       AC-1394: split into this backend part (no Avalonia — the settings view and its connection rows moved to
       UI/, its own project, which builds into this project's bin/; the reference below orders the build and
       references no assembly) and the UI part. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The UI part lives in Ui\ (lowercase — the folder that already held DepotSettingsControl/
         DepotConnectionRowControl), not UI\; CI runs on Linux, where a case mismatch here would leave the
         exclude a no-op and the backend project would try to compile Ui\**\*.cs as its own sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Ui\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration — see Cockpit.Plugin.GitStatus.csproj's identical note. -->
    <ProjectReference Include="Ui\Cockpit.Plugin.Depot.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- AC-499: resolved from ICockpitHost.Services (the app's own shared container already carries an
         ILoggerFactory registration — see Program.cs) so a failed reachability check leaves a line in the same
         dev log every other host-side failure does, rather than nowhere at all. Compile-only, like the reference
         above: the host's own already-loaded copy answers this type at runtime. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1586: the inbox hub's client. Not in the host, so it ships in the plugin folder; its protocol is not one to
         hand-roll. Its Microsoft.Extensions dependencies resolve to the host's own copies. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1897: the live note's Y.Doc runs in Jint (BSD-2, pure managed), with Depot's own yjs in Notes/Live/Bundle (PIN.md). Jint is
         loaded on the first live note and not before; it ships in the plugin folder, never in the host. -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <EmbeddedResource Include="Notes/Live/Bundle/room.bundle.js" />
  </ItemGroup>

  <!-- AC-1899: the room bundle's pin, the AI-Depot commit it is built from and its SHA-256 (a schema hash alone misses a change of marked,
       AC-1896 G3). Notes/Live/Bundle/build.mjs builds it and prints both; moving the pin is changing both here. -->
  <PropertyGroup>
    <DepotBundleCommit>6fe38ee8190553341b909770d12c48a57c202bbb</DepotBundleCommit>
    <DepotBundleSha256>788fcdd294d95d58bf868550882b911d930b78a5eb830bcb943ab3b277bd62e2</DepotBundleSha256>
  </PropertyGroup>

  <!-- The build refuses a bundle that is not the pinned one, and takes the schema version Join sends (protocol §5.4: SHA-256[:12] of
       schema.json) from the schema.json build.mjs copied beside it, into the assembly's metadata for DepotNoteSchema. -->
  <Target Name="DepotRoomBundlePin" BeforeTargets="GetAssemblyAttributes">
    <GetFileHash Files="Notes/Live/Bundle/room.bundle.js" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_DepotBundleHash" />
    </GetFileHash>
    <Error Condition="'$(_DepotBundleHash.ToLowerInvariant())' != '$(DepotBundleSha256)'"
           Text="Notes/Live/Bundle/room.bundle.js is not the bundle of AI-Depot $(DepotBundleCommit) (sha256 $(_DepotBundleHash.ToLowerInvariant()), pinned $(DepotBundleSha256)). Rebuild it with Notes/Live/Bundle/build.mjs." />
    <GetFileHash Files="Notes/Live/Bundle/schema.json" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_DepotSchemaHash" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>DepotNoteSchema</_Parameter1>
        <_Parameter2>$(_DepotSchemaHash.ToLowerInvariant().Substring(0, 12))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Lets Cockpit.Plugin.Depot.Tests unit-test the registration without a host, same pattern as the
         YouTrack and GitHub Issues plugins' project fields. -->
    <InternalsVisibleTo Include="Cockpit.Plugin.Depot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
