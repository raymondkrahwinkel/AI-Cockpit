<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the GitHub-issues plugin (#77) — kept OUTSIDE Cockpit.slnx and outside Cockpit.Core.Tests,
       in its own project alongside the plugin under plugins-dev/, same as the other plugin test projects. Run
       explicitly with `dotnet test` against this .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Full refs (unlike the plugin's compile-only ones): the tests build GitHubIssuesDialogControl for real, so
         the Avalonia stack, the DataGrid and MaterialIconKind all need a runtime copy present, which the host
         would otherwise supply. Avalonia.Headless is the platform those controls ask for a cursor and a font
         from — see HeadlessAvalonia. The same set the YouTrack plugin's test project carries; the two dialogs are
         separate copies by design (plugins ship and version on their own), so each proves its own. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- Parses the host's Theme.axaml off disk (AC-338), the same way Cockpit.Plugin.Workflows.Tests does: the
         plugin cannot reference Cockpit.App, so this is the only way DialogTestApp can load the real cockpit
         theme rather than bare Fluent. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1396: the UI part as the backend project's build leaves it in its bin/, not as a project reference of
         its own, so the backend project dropping the build of UI/ fails this project rather than going unseen.
         Aliased: Contracts/*.cs is linked source, compiled once per assembly, so this project — which needs both
         parts' internals — would otherwise see two identically-named GitHubIssue types. -->
    <Reference Include="Cockpit.Plugin.GitHubIssues.UI">
      <HintPath>..\Cockpit.Plugin.GitHubIssues\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.GitHubIssues.UI.dll</HintPath>
      <Aliases>UiAsm</Aliases>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.GitHubIssues\Cockpit.Plugin.GitHubIssues.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
    <!-- ThemePalette.Describe and RepositoryPaths, shared with the host's own theme-palette baseline (AC-338). -->
    <ProjectReference Include="..\..\tests\Cockpit.TestSupport\Cockpit.TestSupport.csproj" />
  </ItemGroup>

</Project>
