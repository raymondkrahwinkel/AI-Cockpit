<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- The store's package check (scripts/verify-plugin-packages.sh, AC-1709) refuses a Windows apphost without the
       Windows 10 supportedOS id, so every subprocess a plugin ships carries this manifest. -->
  <assemblyIdentity version="1.0.0.0" name="HookRelay"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
