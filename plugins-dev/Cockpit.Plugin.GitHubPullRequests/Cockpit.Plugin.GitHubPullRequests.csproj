<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin #41: GitHub open pull requests inline in the left menu (up to 5, click-to-inject) plus a
       "view all" dialog, mirroring the GitHub Issues plugin (#14). Built OUTSIDE the main solution
       (plugins-dev/) so the app build stays clean; package its bin/<config>/net10.0 output into a .zip and
       install it via Options -> Plugins. EnableDynamicLoading emits the .deps.json the host's
       AssemblyDependencyResolver needs. The shared assemblies (Cockpit.Plugins.Abstractions, Avalonia, the
       DI abstractions) are compile-only (Private=false / ExcludeAssets=runtime) so the host's copies load
       and shared types keep one identity — the plugin folder ships only its own DLL + plugin.json.
       AC-1396: the two-assembly layout AC-1390 pilots. The badge, dialog, widget, dock panel, banner and settings
       live in UI/, their own project, which builds into this project's bin/ (the reference below orders the build
       and references no assembly); this project names no Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it a Release build has
         no UI assembly and discovery skips the whole plugin. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="UI\Cockpit.Plugin.GitHubPullRequests.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Cockpit.Plugin.GitHubPullRequests.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The [McpServerTool] attributes for get_pr_status (AC-818). Host-provided (the cockpit already loads
         ModelContextProtocol), so compile-only — the plugin ships no copy and the attribute types keep one identity. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Cockpit.Plugin.GitHubPullRequests.Tests unit-test the internal review-request reconciliation and
         the gh query it runs (#74), same pattern as Cockpit.Plugin.YouTrack's grant to its own Tests project. -->
    <InternalsVisibleTo Include="Cockpit.Plugin.GitHubPullRequests.Tests" />
  </ItemGroup>

</Project>
