<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the usage-trend widget's pure logic (AC-54): the sample-mapping, the debounce/jump rules and
       the fourteen-day retention, exercised on lists rather than a live session — which is the whole point of
       keeping those rules out of the widget and its storage. AC-1395 adds the backend's channel handlers (Get/
       Append/Seed), which is where the widget's IPluginCache access moved once the widget itself became UI-only.
       Kept outside Cockpit.slnx, like the other plugin test projects. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- ICockpitHost's Cache/Channel are stubbed rather than hand-faked: UsageTrendPluginTests only touches the
         two members the channel handlers use. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.UsageTrend\Cockpit.Plugin.UsageTrend.csproj" />
    <!-- Full ref (unlike the plugin's compile-only one): the tests build samples from SessionUsageSnapshot /
         PluginRateLimitWindow, so the shared Cockpit.Plugins.Abstractions needs a runtime copy present, which the
         host would otherwise supply. -->
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj" />
    <!-- InProcessChannel implements IPluginUiChannel too, mirroring GitStatus.Tests' own copy of this double. -->
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
  </ItemGroup>

</Project>
