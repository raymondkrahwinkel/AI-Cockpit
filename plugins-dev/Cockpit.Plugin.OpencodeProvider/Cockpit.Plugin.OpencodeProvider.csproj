<Project Sdk="Microsoft.NET.Sdk">

  <!-- Provider plugin (AC-783): registers "opencode (ACP)" as a selectable session provider, driven as a
       persistent `opencode acp` subprocess speaking the Agent Client Protocol (JSON-RPC 2.0 over stdio) —
       same architecture as Cockpit.Plugin.KimiProvider, re-measured against a real opencode process rather
       than assumed to behave identically (see OpencodeAcpSessionDriver's header comment for what actually
       differs). Built OUTSIDE the main solution (plugins-dev/) so the app build stays clean; package its
       bin/<config>/net10.0 output into a .zip and install it via Options -> Plugins. EnableDynamicLoading
       emits the .deps.json the host's AssemblyDependencyResolver needs. The shared assemblies
       (Cockpit.Plugins.Abstractions, Avalonia, the DI abstractions) are compile-only (Private=false /
       ExcludeAssets=runtime) so the host's own copies load and shared types keep one identity — the plugin
       folder ships only its own DLL + plugin.json. No Cockpit.Infrastructure reference: this plugin's
       ICliSubprocess/OpencodeAcpConnection are a copy of the Kimi provider's own transport pair, not a
       dependency — plugins reference Abstractions only, so the subprocess-I/O seam lives in this plugin's own
       assembly.
       AC-1393: the config view lives in UI/, its own project, which builds into this project's bin/ (the
       reference below orders the build and references no assembly); this project names no Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration. Without it MSBuild strips Configuration off a reference
         made outside a solution, the UI part lands in bin/Debug, and a Release copy of the plugin has no UI assembly;
         discovery then skips the whole plugin, as its manifest names a file that is not there. -->
    <ProjectReference Include="UI\Cockpit.Plugin.OpencodeProvider.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The transport/driver (OpencodeAcpConnection, OpencodeAcpSessionDriver, ProcessCliSubprocess) is real
         logic worth its own unit tests against a fake ICliSubprocess, mirroring the Kimi provider's own
         KimiAcpConnectionTests/KimiAcpSessionDriverTests. Its dedicated test project (own solution, not part
         of Cockpit.slnx) needs this grant since the driver/config types stay internal, matching this plugin's
         own style. -->
    <InternalsVisibleTo Include="Cockpit.Plugin.OpencodeProvider.Tests" />
  </ItemGroup>

</Project>
