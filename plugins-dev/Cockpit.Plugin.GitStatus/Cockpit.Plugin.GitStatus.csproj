<Project Sdk="Microsoft.NET.Sdk">

  <!-- Git status plugin (#14 / idea #1): a per-session header indicator for the branch / uncommitted / unpushed
       status of the repo that session is working in, click to drop a status summary into it (AC-522 removed the
       plugin's other half, a left-menu dialog over a manually configured repository list). Built OUTSIDE the
       main solution (plugins-dev/) like the other example plugins; package bin/<config>/net10.0 into a .zip and
       install it via the Plugin store. EnableDynamicLoading emits the .deps.json the host's
       AssemblyDependencyResolver needs. Shared assemblies (Cockpit.Plugins.Abstractions, Avalonia, the DI
       abstractions) are compile-only (Private=false / ExcludeAssets=runtime) so the host's copies load and
       shared types keep one identity — the plugin folder ships only its own DLL + plugin.json. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Cockpit.Plugin.GitStatus.Tests unit-test the workflow steps against a real repository (#69), same
         pattern as the other plugins' test projects. -->
    <InternalsVisibleTo Include="Cockpit.Plugin.GitStatus.Tests" />
  </ItemGroup>

</Project>
