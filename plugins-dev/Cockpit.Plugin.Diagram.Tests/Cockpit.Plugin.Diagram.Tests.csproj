<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin references these compile-only (AC-809, host-provided at runtime); the test host has no host
         app to fall through to, so the real packages are needed here. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!-- AC-836: the whiteboard's snapshot tests came with the merge and read real pixels back, so Skia drawing
         on a headless platform, not headless drawing. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <!-- AC-924: a ContextMenu's Popup renders through the overlay layer a theme's Window template provides —
         with no theme loaded there is no such layer in headless mode, and Popup.Open throws. -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- F2.13/AC-1401: aliased because DiagramSettings and Contracts/DiagramChannelContract.cs are linked as source
         into the UI project too (below) — with both assemblies referenced plainly, an unqualified DiagramSettings
         is ambiguous (CS0433). "backend" makes this project's own types (DiagramChannel, DiagramMcpTools/
         WhiteboardMcpTools/WireframeMcpTools, DiagramSettings) reachable only via `extern alias backend;`.
         Deliberately the opposite side from GitHubIssues.Tests' "UiAsm" (AC-1396): that plugin's UI lives in its
         own Cockpit.Plugin.GitHubIssues.UI namespace, so aliasing the UI reference costs it nothing extra. Diagram's
         UI/ kept the backend's own namespace tree (Cockpit.Plugin.Diagram(.Whiteboard/.Wireframe/.Collab)) to avoid
         a repo-wide rename, so aliasing the *smaller* touch surface here (the six backend-only types) is aliasing
         the backend instead — the two conventions solve the same ambiguity from opposite sides on purpose. -->
    <ProjectReference Include="..\Cockpit.Plugin.Diagram\Cockpit.Plugin.Diagram.csproj" Aliases="backend" />
    <!-- The plugin references this compile-only (AC-809); the test host has no host app to fall through to,
         so IDiagramAccessRegistry's real assembly is needed here at run time too. -->
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
    <!-- AC-889: the DiagramMcpTools tests drive the concrete DiagramAccessRegistry directly (real coupling/
         proposal/fidelity behaviour, not a mock) — it stays in this assembly, so its tests need the real thing,
         granted via InternalsVisibleTo. Test-only, the shipped plugin does not reference Infrastructure. Also
         carries the real ModelContextProtocol package the plugin references compile-only, so no separate
         PackageReference for it is needed here. -->
    <ProjectReference Include="..\..\src\Cockpit.Infrastructure\Cockpit.Infrastructure.csproj" />
    <!-- F2.13/AC-1401: the UI part's own host contract — the plugin references it compile-only, the test host has
         no app to fall through to. -->
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1390's pattern (see GitStatus.Tests): the UI part as the backend project's build leaves it in its bin/,
         not as a project reference of its own, so the backend project dropping the build of UI/ fails this
         project rather than going unseen. -->
    <Reference Include="Cockpit.Plugin.Diagram.UI">
      <HintPath>..\Cockpit.Plugin.Diagram\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.Diagram.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
