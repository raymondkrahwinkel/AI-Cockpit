<Project Sdk="Microsoft.NET.Sdk">

  <!-- Diagram-builder plugin-schil (AC-809). F2.13 (AC-1401): the physical split GitStatus piloted (AC-1390) — this
       project is the backend half (the registries' channel and the MCP tools) and names no Avalonia; the windows,
       the workspace bodies and everything else that needs a window live in UI/, its own project, which builds into
       this project's bin/ (the reference below orders the build and references no assembly). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </ProjectReference>
    <!-- Compile-only, same pattern as the packages below (AC-809): only the registry interfaces' shape is needed at
         compile time, and PluginLoadContext falls the actual type through to the host's own already-loaded copy
         at runtime — a plugin cannot ship a second identity of a type the host hands it through host.Services. -->
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration. Without it MSBuild strips Configuration off a reference
         made outside a solution, the UI part lands in bin/Debug, and a Release copy of the plugin has no UI assembly;
         discovery then skips the whole plugin, as its manifest names a file that is not there. -->
    <ProjectReference Include="UI\Cockpit.Plugin.Diagram.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <!-- The [McpServerTool] attributes for the cockpit-diagram MCP (AC-889). Host-provided (the cockpit already
         loads ModelContextProtocol), so compile-only — the plugin ships no copy and the attribute types keep one
         identity. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.Diagram.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- AC-525's DoD: attribution travels with the plugin zip itself, not only via the repo's own NOTICE. -->
    <None Include="NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
