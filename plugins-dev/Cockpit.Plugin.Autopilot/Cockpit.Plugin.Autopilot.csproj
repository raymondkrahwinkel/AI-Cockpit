<Project Sdk="Microsoft.NET.Sdk">

  <!-- Autopilot (AC-94, skeleton AC-149): the operator-triggered "issue → merge-ready PR" plugin. AC-1418 (F2.10b):
       this project is the backend half — the runs, the plan, the MCP tools and the channel — and names no Avalonia;
       the workspace and the settings view live in UI/, its own project, which builds into this project's bin/ (the
       reference below orders the build and references no assembly). Built OUTSIDE Cockpit.slnx (plugins-dev/) like
       the other bundled plugins; shared assemblies are compile-only (Private=false / ExcludeAssets=runtime) so the
       host's copies load and shared types keep one identity. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration, so a Release copy of the plugin carries its UI assembly. -->
    <ProjectReference Include="UI\Cockpit.Plugin.Autopilot.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The [McpServerTool] attributes for the in-process report endpoint; the host provides the runtime copy (AC-116). -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.Autopilot.Tests" />
  </ItemGroup>

</Project>
