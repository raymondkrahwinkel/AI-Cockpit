<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Depot plugin (AC-166) — kept OUTSIDE Cockpit.slnx and outside Cockpit.slnx's own test
       projects, in its own project alongside the plugin under plugins-dev/, same as the other plugin test
       projects. Run explicitly with `dotnet test` against this .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Substituting ICockpitHost pulls in the Avalonia- and DI-typed members of every contribution point on the
         interface (NSubstitute's proxy has to resolve the whole surface, not only AddProjectMemorySource), which
         the plugin itself references compile-only (ExcludeAssets=runtime, host-provided). This test project runs
         standalone with no host to provide them, so it carries runtime copies — the same reason the FanOut and
         Autopilot plugin test projects do. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!-- AC-423 added a DataGridRow selector to the host's shared Theme.axaml; this project loads that theme file
         off disk (see the Avalonia.Markup.Xaml.Loader reference below) for the IL#9 render test, so the XAML
         compiler needs DataGridRow resolvable even though this plugin has no DataGrid of its own. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- IL#9 render test (AC-243): a real Skia headless platform plus the cockpit's own theme, same set the
         Workflows plugin's render tests use — see HeadlessAvalonia.cs for why headless drawing (no glyphs) is not enough. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <!-- AC-499: DepotMemorySource resolves ILoggerFactory from ICockpitHost.Services — proving that seam here
         needs a real ServiceCollection/BuildServiceProvider, not only the Abstractions package above. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1394: the UI part as the backend project's build leaves it in its bin/, not as a project reference of
         its own, so the backend project dropping the build of UI/ fails this project rather than going unseen —
         see Cockpit.Plugin.GitStatus.Tests.csproj's identical note.
         Aliased: Contracts/*.cs is linked source, compiled once per assembly (never shared as a reference), so
         this project — which needs both parts' internals — would otherwise see two identically-named DepotChannel
         types and every plain use of it would be ambiguous; same fix as Cockpit.Plugin.GitHubActions.Tests.csproj. -->
    <Reference Include="Cockpit.Plugin.Depot.UI">
      <HintPath>..\Cockpit.Plugin.Depot\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.Depot.UI.dll</HintPath>
      <Aliases>UiAsm</Aliases>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.Depot\Cockpit.Plugin.Depot.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
    <!-- AC-605 criterion 4: this is the test project, not the plugin itself — the "a plugin must not reference
         Cockpit.Core" rule (AC-244) binds Cockpit.Plugin.Depot, not its own test project. Referenced only so
         ProjectResourceScopeParityTests can pin the host's ProjectResourcePathPortability.ClassifyScope and this
         plugin's own ProjectResourcePortabilityClassifier.Classify against the same shared table. -->
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
  </ItemGroup>

</Project>
