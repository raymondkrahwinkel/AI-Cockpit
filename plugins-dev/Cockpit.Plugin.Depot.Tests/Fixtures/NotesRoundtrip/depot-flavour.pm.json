        "level": 1
      },
      "content": [
        {
          "type": "text",
          "text": "What a Depot note carries"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Links between notes are wikilinks: see [[Docs/Edit]], [[Docs/Edit|with an alias]] and [[Page#Heading]], not a "
        },
        {
          "type": "text",
          "text": "[link](url)",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "An alert block is a quote:"
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "[!NOTE]\nWritten by the renderer, so the brackets must survive."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Words with & signs, a < b > c, snake_case_names, 2 * 3 and a bare address "
        },
        {
          "type": "text",
          "text": "https://example.com/a?b=1&c=2",
          "marks": [
            {
              "type": "link",
              "attrs": {
                "href": "https://example.com/a?b=1&c=2",
                "title": null
              }
            }
          ]
        },
        {
          "type": "text",
          "text": " stay as typed.\nLabel [gemeten] and a <host> placeholder too, but "
        },
        {
          "type": "text",
          "text": "code & <tags>",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": " and fences are never touched:"
        }
      ]
    },
    {
      "type": "codeBlock",
      "attrs": {
        "language": "html"
      },
      "content": [
        {
          "type": "text",
          "text": "<details>\n  <summary>a & b</summary>\n</details>"
        }
      ]
    },
