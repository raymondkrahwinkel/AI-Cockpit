<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI part of Proxmox (AC-1394): the settings view, the settings toolbar shortcut and the read-only
       overview workspace — everything that needs a window. It lives inside the plugin folder so the version guard,
       the publish discovery and the change classification all see it as part of the plugin, and it builds into the
       backend project's bin/, so `dotnet build` of the backend project yields both assemblies in the one folder the
       zip, the bundle and the dev installer take. It never references the backend project: what the two share is
       the linked Contracts source (the channel) and the linked certificate probe (BCL-only, no backend state).
       This part keeps its own ProxmoxSettings (Ui/ProxmoxSettings.cs) rather than linking the backend's —
       Cockpit.Plugin.Proxmox.Tests references both assemblies, and a linked copy under the same namespace made
       the type ambiguous (CS0433) for the existing backend tests that already construct one. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <BaseOutputPath>..\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Contracts\*.cs" Link="Contracts\%(Filename)%(Extension)" />
    <!-- A self-contained TLS probe (BCL only, no engine/settings dependency): reads whatever certificate the typed
         host presents so the operator can eyeball the fingerprint before trusting it. Linked rather than turned
         into a channel action — there is no backend state to reach through, only a socket. -->
    <Compile Include="..\Engine\ProxmoxCertificateProbe.cs" Link="Engine\ProxmoxCertificateProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.Proxmox.Tests" />
  </ItemGroup>

</Project>
