<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin #42, reworked in #48: a left-menu button opens a dialog listing open YouTrack issues across one
       or more configured instances (instance/project/state filters, click-to-inject), mirroring the GitHub
       Issues plugin. YouTrack has no gh-CLI equivalent, so this plugin is HTTP-only per instance — a base URL
       + permanent token each, no CLI-vs-HTTP toggle.
       Built OUTSIDE the main solution (plugins-dev/) so the app build stays clean; package its
       bin/<config>/net10.0 output into a .zip and install it via Options -> Plugins. EnableDynamicLoading
       emits the .deps.json the host's AssemblyDependencyResolver needs. The shared assemblies
       (Cockpit.Plugins.Abstractions, the DI abstractions) are compile-only (Private=false / ExcludeAssets=runtime)
       so the host's copies load and shared types keep one identity — the plugin folder ships only its own DLLs +
       plugin.json.
       AC-1397: the two-assembly layout of GitStatus's pilot (AC-1390). The dialog, the session header, the picker
       and the settings live in UI/, their own project, which builds into this project's bin/ (the reference below
       orders the build and references no assembly); this project names no Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration, so a Release copy of the plugin has its UI assembly. -->
    <ProjectReference Include="UI\Cockpit.Plugin.YouTrack.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MaterialIconKind for the workflow steps' icons. The host ships the runtime copy. -->
    <PackageReference Include="Material.Icons" Version="3.0.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The [McpServerTool] attributes for the fallback attach tool (AC-116). Host-provided (the cockpit already
         loads ModelContextProtocol), so compile-only — the plugin ships no copy and the attribute types keep one
         identity. Same pattern as Cockpit.Plugin.Workflows. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Cockpit.Plugin.YouTrack.Tests unit-test YouTrackMcpRegistration's internal per-instance mapping
         directly (#60), same pattern as Cockpit.Plugin.GeminiProvider's grant to its own Tests project. -->
    <InternalsVisibleTo Include="Cockpit.Plugin.YouTrack.Tests" />
  </ItemGroup>

</Project>
