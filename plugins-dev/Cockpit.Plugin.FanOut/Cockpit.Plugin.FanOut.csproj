<Project Sdk="Microsoft.NET.Sdk">

  <!-- The fan-out plugin (AC-467): a full-surface workspace type that starts one task on N agents at once, each in
       its own worktree, and tiles their sessions side by side. Built OUTSIDE Cockpit.slnx (plugins-dev/) like the
       other plugins. Shared assemblies are compile-only (Private=false / ExcludeAssets=runtime) so the host's copies
       load and shared types keep one identity — the plugin folder ships only its own DLL + plugin.json.

       AC-1395 (F2.1, following GitStatus's pilot AC-1390): pure UI — its only contribution, AddWorkspaceType,
       needs a window, so it has no backend part at all; plugin.json names only a uiAssembly. The whole project
       is the UI project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.FanOut.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
