<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin references Avalonia types (the settings view), compile-only; the test host brings them at runtime. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1394: the UI part as the backend project's build leaves it in its bin/, not as a project reference of
         its own, so the backend project dropping the build of UI/ fails this project rather than going unseen. -->
    <Reference Include="Cockpit.Plugin.LocalCi.UI">
      <HintPath>..\Cockpit.Plugin.LocalCi\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.LocalCi.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.LocalCi\Cockpit.Plugin.LocalCi.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
    <!-- The plugin references this compile-only; the test host has no host app to fall through to, so
         IWorktreeManager's real assembly is needed here at run time too (AC-1015). -->
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
