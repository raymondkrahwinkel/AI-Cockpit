<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser plugin (AC-1708): the backend half, which names no Avalonia and asks for no CEF (AC-1727). The CEF
       runtime fetch and the browser UI live in UI/, their own project, which builds into this project's bin/ —
       the two-assembly layout of GitStatus (AC-1390), so the server never loads, let alone fetches, an engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**;Subprocess\**</DefaultItemExcludes>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- Keeps the plugin's own Configuration on the UI part (see GitStatus, AC-1392). -->
    <ProjectReference Include="UI\Cockpit.Plugin.Browser.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="Subprocess\Cockpit.Plugin.Browser.Subprocess.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The cockpit log for an agent browser that did not come up; host-provided, so compile-only, as in Depot. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The [McpServerTool] attributes for cockpit-browser (AC-1714). Host-provided, so compile-only, as in Diagram. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.Browser.Tests" />
  </ItemGroup>

</Project>
