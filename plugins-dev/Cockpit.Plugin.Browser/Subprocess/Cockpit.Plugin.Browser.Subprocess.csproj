<Project Sdk="Microsoft.NET.Sdk">

  <!-- The CEF subprocess (renderer, GPU, utility) of the browser plugin (AC-1711). Its own exe so it can carry its
       own app.manifest; builds into the backend project's bin/ next to the UI part, like UI/ (AC-1390). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BaseOutputPath>..\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefGlue.Next.Core" Version="154.8037.98" />
  </ItemGroup>

</Project>
