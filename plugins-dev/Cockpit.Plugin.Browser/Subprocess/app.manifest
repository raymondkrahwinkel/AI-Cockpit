<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Without supportedOS, CEF in offscreen rendering paints one or two frames of a heavy page and then freezes
       (AC-1709, measured). Static pages keep working, which hides it. -->
  <assemblyIdentity version="1.0.0.0" name="Cockpit.Plugin.Browser.Subprocess"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
