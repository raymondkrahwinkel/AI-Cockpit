<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the YouTrack plugin's own MCP-registration logic (#60) — kept OUTSIDE Cockpit.slnx and
       outside Cockpit.Core.Tests, in its own project alongside the plugin under plugins-dev/, same as
       Cockpit.Plugin.GeminiProvider.Tests / Cockpit.Plugin.CliAgentProvider.Tests. Unlike Cockpit.Core.Tests'
       plugin references (ReferenceOutputAssembly=false, loaded only through PluginActivator to prove type
       identity), this project references the plugin normally: it tests YouTrackMcpRegistration's pure
       per-instance mapping directly, which needs no type-identity proof. Run explicitly with `dotnet test`
       in this folder (or against this .csproj) — it is not picked up by `dotnet test` at the repo root,
       which only discovers Cockpit.slnx's test project (which does still get the plugin's real-assembly
       load-through-PluginActivator proof, see YouTrackPluginLoadTests in Cockpit.Core.Tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- Full refs (unlike the plugin's compile-only ones): the tests run the plugin's workflow steps and build
         YouTrackDialogControl for real, so the Avalonia stack, the DataGrid and MaterialIconKind all need a
         runtime copy present, which the host would otherwise supply. Avalonia.Headless is the platform those
         controls ask for a cursor and a font from — see HeadlessAvalonia. -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <!-- Parses the host's Theme.axaml off disk (AC-338), the same way Cockpit.Plugin.Workflows.Tests does: the
         plugin cannot reference Cockpit.App, so this is the only way DialogTestApp can load the real cockpit
         theme rather than bare Fluent. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.5" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.YouTrack\Cockpit.Plugin.YouTrack.csproj" />
    <!-- The loopback test server these attachment tests post against (AC-371). Shared with the host's test
         projects rather than copied, because a copy is how the port race in AC-350 got to exist twice. -->
    <ProjectReference Include="..\..\tests\Cockpit.TestSupport\Cockpit.TestSupport.csproj" />
  </ItemGroup>

</Project>
