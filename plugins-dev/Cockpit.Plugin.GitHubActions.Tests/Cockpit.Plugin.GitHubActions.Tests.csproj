<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the GitHub Actions plugin's non-UI logic (AC-52): gh argument construction, run-list JSON
       parsing, run-state derivation and URL validation — no shelling out, no Avalonia. Kept outside Cockpit.slnx,
       like the other plugin test projects. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Full refs (unlike the plugin's compile-only ones): CiStatusHeaderControlTests and
         CiWorkflowRunsDockPanelRegistrarTests construct real Avalonia media/icon values and an ICockpitUiHost
         fake, so a runtime copy needs to be present, which the host would otherwise supply. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1394: the UI part as the backend project's build leaves it in its bin/, not as a project reference of
         its own, so the backend project dropping the build of UI/ fails this project rather than going unseen.
         Aliased: Contracts/*.cs is linked source, compiled once per assembly (never shared as a reference), so
         this project — which needs both parts' internals — would otherwise see two identically-named CiRun
         types and every plain use of it would be ambiguous. -->
    <Reference Include="Cockpit.Plugin.GitHubActions.UI">
      <HintPath>..\Cockpit.Plugin.GitHubActions\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.GitHubActions.UI.dll</HintPath>
      <Aliases>UiAsm</Aliases>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.GitHubActions\Cockpit.Plugin.GitHubActions.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
  </ItemGroup>

</Project>
