<Project Sdk="Microsoft.NET.Sdk">

  <!-- GitHub Actions CI-status plugin (AC-52): the workflow-run status of the branch a session is working in, shown
       in that session's header — a coloured dot (green pass / red fail / amber running) with the run's details on
       hover, click to open it on GitHub. Completes the GitHub trio (issues + PRs + git status → + CI). Built OUTSIDE
       the main solution like the other example plugins; package bin/<config>/net10.0 into a .zip for the store.
       EnableDynamicLoading emits the .deps.json the host's AssemblyDependencyResolver needs. Shared assemblies
       (Abstractions, the DI abstractions) are compile-only (Private=false / ExcludeAssets=runtime) so the host's
       copies load and shared types keep one identity.
       AC-1394: the two-assembly layout AC-1390 pilots. The header indicator, widget and dock panel live in UI/,
       their own project, which builds into this project's bin/ (the reference below orders the build and
       references no assembly); this project names no Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it a Release build has
         no UI assembly and discovery skips the whole plugin. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="UI\Cockpit.Plugin.GitHubActions.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.GitHubActions.Tests" />
  </ItemGroup>

</Project>
