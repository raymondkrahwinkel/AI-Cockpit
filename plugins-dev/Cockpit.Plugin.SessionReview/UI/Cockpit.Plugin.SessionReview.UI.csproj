<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI part of Session Review (AC-1395, following GitStatus's pilot, AC-1390): the review dialog and all the
       diff-parsing/reading logic it alone uses. Builds into the backend project's bin/, so `dotnet build` of the
       backend project yields both assemblies in the one folder the zip, the bundle and the dev installer take. It
       never references the backend project: only the small channel contract is shared, as linked source. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <BaseOutputPath>..\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the channel contract is shared with the backend; DiffParser/FileTree/GitDiffReader/ReviewPrompt etc.
         are used solely by this dialog, so they live here outright rather than as linked source. -->
    <Compile Include="..\Contracts\*.cs" Link="Contracts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.SessionReview.Tests" />
  </ItemGroup>

</Project>
