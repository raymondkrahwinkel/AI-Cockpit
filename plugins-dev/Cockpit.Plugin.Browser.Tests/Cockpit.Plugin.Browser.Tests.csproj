<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <!-- The UI part's own dependencies, which a HintPath reference does not bring along. -->
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="CefGlue.Next.Core" Version="154.8037.98" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI part as the backend project's build leaves it in its bin/ (AC-1390), so dropping the build of UI/
         from the backend project fails this project rather than going unseen. -->
    <Reference Include="Cockpit.Plugin.Browser.UI">
      <HintPath>..\Cockpit.Plugin.Browser\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.Browser.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.Browser\Cockpit.Plugin.Browser.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
  </ItemGroup>

</Project>
