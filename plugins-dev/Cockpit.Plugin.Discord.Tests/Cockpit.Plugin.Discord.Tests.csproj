<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!-- AC-1084: the settings view is a control, so the "not set up yet" tests need a platform to build it on —
         the same headless runtime the Kubernetes plugin's staging tests use. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC-1394: the UI part as the backend project's build leaves it in its bin/, not as a project reference of
         its own, so the backend project dropping the build of UI/ fails this project rather than going unseen —
         see Cockpit.Plugin.GitStatus.Tests.csproj's identical note. -->
    <Reference Include="Cockpit.Plugin.Discord.UI">
      <HintPath>..\Cockpit.Plugin.Discord\bin\$(Configuration)\$(TargetFramework)\Cockpit.Plugin.Discord.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.Discord\Cockpit.Plugin.Discord.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
