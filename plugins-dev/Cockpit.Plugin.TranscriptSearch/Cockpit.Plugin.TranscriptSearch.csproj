<Project Sdk="Microsoft.NET.Sdk">

  <!-- Transcript search as a plugin: searching the claude CLI's on-disk JSONL transcripts is Claude-specific,
       so it belongs with the provider rather than in a multi-provider core. Built OUTSIDE the main solution
       (plugins-dev/) so the app build stays clean; package its bin/<config>/net10.0 output into a .zip and
       install it via Options → Plugins. EnableDynamicLoading emits the .deps.json the host's
       AssemblyDependencyResolver needs. The shared assemblies (Cockpit.Plugins.Abstractions, Avalonia) are
       compile-only (Private=false / ExcludeAssets=runtime) so the host's copies load and shared types keep one
       identity — the plugin folder ships only its own DLL + plugin.json.
       AC-1395 (F2.7, following GitStatus's pilot AC-1390): pure UI, per F2.1 — its only contributions (a
       left-menu button, a shortcut, a conversation picker, all opening a dialog) need a window, so it has no
       backend part at all; plugin.json names only a uiAssembly. The whole project is the UI project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions.UI\Cockpit.Plugins.Abstractions.UI.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Plugin.TranscriptSearch.Tests" />
  </ItemGroup>

</Project>
