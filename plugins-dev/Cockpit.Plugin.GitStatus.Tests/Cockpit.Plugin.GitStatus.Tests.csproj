<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the git plugin's workflow steps (#69) — against a real git repository in a temp directory,
       because what these steps promise is about what git actually does, and a fake git would prove nothing. Kept
       outside Cockpit.slnx, like the other plugin test projects. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Full refs (unlike the plugin's compile-only ones): GitStatusHeaderControlTests builds the real header
         control headless, so the Avalonia stack and MaterialIconKind (via the workflow steps' icons) need a
         runtime copy present, which the host would otherwise supply. Same set the GitHubIssues/YouTrack plugins'
         test projects carry — see HeadlessAvalonia for why Skia rather than headless drawing. -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <!-- Not needed by this plugin any more (AC-522 removed its only DataGrid, the dialog) — kept only because
         GitStatusTestApp parses the host's own Theme.axaml off disk, and that file styles DataGridRow for the
         plugins that do still use one; XamlX cannot resolve that selector without the assembly loaded. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <!-- Parses the host's Theme.axaml off disk (AC-338), the same way the other plugin test projects do: the
         plugin cannot reference Cockpit.App, so this is the only way DialogTestApp can load the real cockpit
         theme rather than bare Fluent. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.5" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <!-- The concrete ServiceCollection (the plugin's own reference is Abstractions-only, compile-only): needed
         to hand GitStatusPlugin.ConfigureServices a real IServiceCollection in GitStatusPluginLoadTests. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.Plugin.GitStatus\Cockpit.Plugin.GitStatus.csproj" />
    <!-- TestGitDirectory (AC-339), taken from the project that exists to be shared rather than copied here: git
         leaves its objects read-only and Windows will not delete those, which failed every test in the workflow-
         steps fixture from its teardown. Four other plugin test projects take the same reference. -->
    <ProjectReference Include="..\..\tests\Cockpit.TestSupport\Cockpit.TestSupport.csproj" />
  </ItemGroup>

</Project>
