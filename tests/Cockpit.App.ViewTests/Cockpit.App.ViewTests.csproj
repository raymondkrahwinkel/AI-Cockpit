<Project Sdk="Microsoft.NET.Sdk">

  <!--
    View-level tests, in their own assembly on purpose. They need a headless Avalonia, and Avalonia's dispatcher is
    global and belongs to one thread: the moment a platform exists, any test in the same process that touches an
    Avalonia object from another thread kills the *test host* rather than failing. It did, intermittently, and a run
    that reports "1093 passed" after aborting halfway is a run that told you nothing.

    So this lives in its own process, exactly like the plugin test projects.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UsageSnapshotContract.cs" Link="UsageSnapshotContract.cs" />
    <Compile Include="..\Shared\TestSessions.cs" Link="TestSessions.cs" />
    <Compile Include="..\..\plugins-dev\_shared\UI\SharedCharts.cs" Link="SharedUI\SharedCharts.cs" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cockpit.App/Cockpit.App.csproj" />
    <ProjectReference Include="../Cockpit.TestSupport/Cockpit.TestSupport.csproj" />
    <!-- AC-1131: the measurement harness's decision functions are tested from here, because they are the
         part that needs no window and so the part CI can run. The harness itself is an exe; referencing it
         gets the types without running it. -->
    <ProjectReference Include="../Cockpit.MeasurementHarness/Cockpit.MeasurementHarness.csproj" />
    <!-- AC-809: a build dependency only (ReferenceOutputAssembly=false) — DiagramPluginLoadTests loads it
         through the real PluginActivator/PluginLoadContext from its build output, the same end-to-end proof
         Cockpit.Core.Tests uses for the other example plugins. Lives here rather than there because this is
         the one plugin whose contribution is an Avalonia control, which needs a real platform to construct. -->
    <ProjectReference Include="../../plugins-dev/Cockpit.Plugin.Diagram/Cockpit.Plugin.Diagram.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- AC-1546: the Schedules screen's journey test builds the real screen on the real backend part, here because
         this harness is the one with the app's own theme, so the renders it writes look as the cockpit draws them. -->
    <ProjectReference Include="../../plugins-dev/Cockpit.Plugin.Schedules/Cockpit.Plugin.Schedules.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <!-- Aliased: both parts compile the shared Contracts as source, so their internal types would clash by name. -->
    <ProjectReference Include="../../plugins-dev/Cockpit.Plugin.Schedules/UI/Cockpit.Plugin.Schedules.UI.csproj"
                      Aliases="schedulesUi" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="../../plugins-dev/Cockpit.Plugin.Productivity/Cockpit.Plugin.Productivity.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="../../plugins-dev/Cockpit.Plugin.Productivity/UI/Cockpit.Plugin.Productivity.UI.csproj"
                      Aliases="productivityUi" SetConfiguration="Configuration=$(Configuration)" />
    <!-- AC-1147: a build dependency only, same reasoning as the Diagram plugin above — LogPidPositiveControlTests
         runs its build output as two real processes rather than linking its types. -->
    <ProjectReference Include="../Cockpit.LogPidProbe/Cockpit.LogPidProbe.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- AC-1509: the scenes of route C draw the bundled Depot plugin's own UI part, loaded from bundled-plugins as the app does. -->
  <Import Project="..\..\src\BundledPlugins.targets" />

</Project>
