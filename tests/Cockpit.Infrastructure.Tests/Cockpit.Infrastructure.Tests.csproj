<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logo store rasterises an SVG through Skia. In the app those natives arrive with Avalonia; a test
         assembly has no UI framework, so it brings them itself — otherwise the SVG tests fail on a missing
         libSkiaSharp rather than on anything about the code. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Infrastructure\Cockpit.Infrastructure.csproj" />
    <ProjectReference Include="..\Cockpit.TestSupport\Cockpit.TestSupport.csproj" />
    <!-- AC-1221: a build dependency only — SingleInstanceClaimAcrossProcessesTests runs this build output as a
         second cockpit rather than linking its types, because deriving the claim name inside this process is the
         very thing it cannot do. Unlike Cockpit.LogPidProbe it does sit in Cockpit.slnx: a reference out of the
         solution is built with the referencing project's configuration unset, so a Release solution build would
         leave a Debug probe behind for CI's Release test run, which rebuilds nothing, to find. -->
    <ProjectReference Include="..\Cockpit.SingleInstanceProbe\Cockpit.SingleInstanceProbe.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
