<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC-1356: writes what an operator sets up before a headless first start (the node door on, credential encryption
       on) into a state root, for the container smoke. Core and Infrastructure only, like Cockpit.Server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cockpit.Core/Cockpit.Core.csproj" />
    <ProjectReference Include="../../src/Cockpit.Infrastructure/Cockpit.Infrastructure.csproj" />
  </ItemGroup>

</Project>
