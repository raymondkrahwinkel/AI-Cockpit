<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC-1356: turns credential encryption on in a state root, for the container smoke's fail-closed control
       (the server needs an unlock password only once encryption is on). Core and Infrastructure only, like Cockpit.Server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cockpit.Core/Cockpit.Core.csproj" />
    <ProjectReference Include="../../src/Cockpit.Infrastructure/Cockpit.Infrastructure.csproj" />
  </ItemGroup>

</Project>
