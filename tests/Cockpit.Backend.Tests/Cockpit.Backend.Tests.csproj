<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- AC-1373: the backend without the desktop. Core and Infrastructure only: no Cockpit.App and no
       Cockpit.TestSupport, which pulls in the Avalonia package. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Infrastructure\Cockpit.Infrastructure.csproj" />
  </ItemGroup>

  <!-- AC-1448: the journeys' fake provider, so the launcher's own tests start a session the way the journeys do. -->
  <ItemGroup>
    <Compile Include="..\Cockpit.Journeys\EchoDriver.cs" Link="EndToEnd\EchoDriver.cs" />
  </ItemGroup>

</Project>
