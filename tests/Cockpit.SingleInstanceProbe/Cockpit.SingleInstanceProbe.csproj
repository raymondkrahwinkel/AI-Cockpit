<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AC-1221: a second real process for SingleInstanceClaimAcrossProcessesTests, which is the only place the
    claim name can be checked at all — a name derived twice inside one process agrees with itself however it
    is derived. The test locates and runs this build output rather than linking its types, so the reference to
    it carries ReferenceOutputAssembly="false"; it is in Cockpit.slnx all the same, because that is what gets it
    built in the same configuration CI then tests in without rebuilding. Cockpit.LogPidProbe sits there for the
    same reason.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cockpit.Infrastructure/Cockpit.Infrastructure.csproj" />
  </ItemGroup>

</Project>
