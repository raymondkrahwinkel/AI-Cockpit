<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- AC-577: this project sets up no Avalonia application, so Dispatcher.UIThread binds to whichever thread
       touches it first — a coin flip under the parallel xUnit run (see BannedSymbols.Avalonia.txt for the two
       failure modes this produced). A test that needs a real, pumped UI-thread dispatcher belongs in
       Cockpit.App.ViewTests instead.

       RS0030 (the banned-API diagnostic) is a warning by default and only becomes an error repo-wide under CI's
       "-warnaserror" build flag (Directory.Build.props sets no TreatWarningsAsErrors). That is too late and in the
       wrong place for a guardrail whose entire point is to turn eighteen minutes of silent CI hang into a mistake
       the next developer sees as a red squiggle while typing — a warning that only turns hard on CI reaches
       nobody until the push, and by then the mistake is already committed. Forced to an error here, and only
       here: the rest of the repo keeps leaning on the CI flag, since this project is the one whose specific
       failure mode (a hang with a passing summary) is not a warning-shaped problem. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.Avalonia.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cockpit.TestSupport\Cockpit.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.App\Cockpit.App.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Core\Cockpit.Core.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Infrastructure\Cockpit.Infrastructure.csproj" />
    <!-- Builds the example plugin (#14) so the loader integration test can load its real assembly, but
         does not reference it (ReferenceOutputAssembly=false) — the test must load it through the plugin
         ALC, not the default one, or the type-identity proof would be meaningless. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.GitHubIssues\Cockpit.Plugin.GitHubIssues.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the GitHub Pull Requests plugin (#41), mirroring the Issues plugin. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.GitHubPullRequests\Cockpit.Plugin.GitHubPullRequests.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the YouTrack plugin (#42) — HTTP-only (no CLI), mirroring the Pull Requests plugin. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.YouTrack\Cockpit.Plugin.YouTrack.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the Gemini/OpenAI provider plugin (#45) — the first session-provider plugin, so
         the loader integration test can load its real assembly and prove AddSessionProvider registers. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.GeminiProvider\Cockpit.Plugin.GeminiProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the CLI agent (Codex) provider plugin (#45 fase B1) — the first subprocess-backed
         session-provider plugin, so the loader integration test can load its real assembly and prove
         AddSessionProvider registers it too. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.CliAgentProvider\Cockpit.Plugin.CliAgentProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the GitHub Models provider plugin (#63) — GitHub Models via the same OpenAiCompat
         session-provider stack the Gemini/OpenAI provider plugin (#45) uses, so the loader integration test
         can load its real assembly and prove AddSessionProvider registers it too. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.GitHubModelsProvider\Cockpit.Plugin.GitHubModelsProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Claude as a provider plugin (Fase 4): the loader integration test loads its real assembly and proves
         AddTtyProvider registers Claude's TTY route through the actual PluginActivator. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.ClaudeProvider\Cockpit.Plugin.ClaudeProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the OpenRouter provider plugin (AC-806) — OpenRouter via the same OpenAiCompat
         session-provider stack the Gemini/OpenAI (#45) and GitHub Models (#63) provider plugins use, so the
         loader integration test can load its real assembly and prove AddSessionProvider registers it too. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.OpenRouterProvider\Cockpit.Plugin.OpenRouterProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the Grok provider plugin (AC-724) — Grok (xAI) via the same OpenAiCompat
         session-provider stack the Gemini/OpenAI (#45) and GitHub Models (#63) provider plugins use, so the
         loader integration test can load its real assembly and prove AddSessionProvider registers it too. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.GrokProvider\Cockpit.Plugin.GrokProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same pattern for the opencode ACP provider plugin (AC-783) — a persistent `opencode acp` subprocess
         over the Agent Client Protocol, the same shape Cockpit.Plugin.KimiProvider uses, so the loader
         integration test can load its real assembly and prove AddSessionProvider registers it with real-agent
         (tools/permissions) capabilities. -->
    <ProjectReference Include="..\..\plugins-dev\Cockpit.Plugin.OpencodeProvider\Cockpit.Plugin.OpencodeProvider.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>