<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test infrastructure shared by the host's test projects and the plugin test projects under plugins-dev/
       (AC-371). Those two live in different places and neither can see the other's internals, so a helper both
       need has nowhere else to go: the alternative was a second copy, which is exactly what AC-350 set out to
       remove. Nothing here is a test itself — it holds only what more than one test project needs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- LoopbackHttpServer runs on Kestrel. Declared here rather than leaned on transitively, because the
         plugin test projects reference no ASP.NET of their own. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- ThemePalette walks a rendered visual tree. Avalonia only — no headless platform and no Skia: this reads
         a tree that its caller has already shown, and each caller brings the runtime it shows it with. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

</Project>
