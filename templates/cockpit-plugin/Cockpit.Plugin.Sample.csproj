<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cockpit plugin (#14), the backend part: what works without a window. The UI part lives in UI/, its own
       project that builds into this project's bin/; the reference below only orders that build, so one
       `dotnet build` of this project leaves both assemblies in one folder (AC-1390). This project never names
       Avalonia, and the UI project never references this one — they talk over the plugin's channel. The shared
       assemblies are compile-only (Private=false / ExcludeAssets=runtime) so the host's copies load and shared
       types keep one identity. Scaffold under plugins-dev/ so the ../../src relative reference resolves;
       out-of-repo, swap it for a PackageReference to Cockpit.Plugins.Abstractions. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>
    <!-- AC-1392: keeps the parent's Configuration on the UI part's reference below; without it SetConfiguration is undone. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Plugins.Abstractions\Cockpit.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- AC-1392: built in this project's own configuration. Without it MSBuild strips Configuration off a reference
         made outside a solution, the UI part lands in bin/Debug, and a Release copy of the plugin has no UI assembly;
         discovery then skips the whole plugin, as its manifest names a file that is not there. -->
    <ProjectReference Include="UI\Cockpit.Plugin.Sample.UI.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
